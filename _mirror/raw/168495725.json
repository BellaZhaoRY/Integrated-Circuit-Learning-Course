  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h2 data-lake-id=\"wohPl\" id=\"wohPl\"><span data-lake-id=\"uc4220b21\" id=\"uc4220b21\">配置断言输出</span></h2><p data-lake-id=\"u59e7fcce\" id=\"u59e7fcce\"><span data-lake-id=\"u9b5dd2fe\" id=\"u9b5dd2fe\">在</span><code data-lake-id=\"u48f17a24\" id=\"u48f17a24\"><span data-lake-id=\"u09c07676\" id=\"u09c07676\">FreeRTOSConfig.h</span></code><span data-lake-id=\"uf7078e66\" id=\"uf7078e66\">中注释掉原来的</span><code data-lake-id=\"ubd9c9073\" id=\"ubd9c9073\"><span data-lake-id=\"u8ef42bef\" id=\"u8ef42bef\">configASSERT</span></code><span data-lake-id=\"u5c52a6d1\" id=\"u5c52a6d1\">代码，并声明如下内容：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22FreeRTOSConfig%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%2F*%20%E6%96%AD%E8%A8%80%E7%BB%93%E6%9E%9C%E9%80%9A%E8%BF%87printf%E8%BE%93%E5%87%BA%20*%2F%5Cn%23define%20vAssertCalled(char%2C%20int)%20printf(%5C%22Error%3A%20%25s%2C%20%25d%5C%5Cr%5C%5Cn%5C%22%2C%20char%2C%20int)%5Cn%23define%20configASSERT(%20x%20)%20if(%20(%20x%20)%20%3D%3D%200%20)%20vAssertCalled(%20__FILE__%2C%20__LINE__%20)%5Cn%5Ct%5Cn%2F%2F%23define%20configASSERT(%20x%20)%20if(%20(%20x%20)%20%3D%3D%200%20)%20%7B%20taskDISABLE_INTERRUPTS()%3B%20for(%20%3B%3B%20)%3B%20%7D%5Cn%2F%2F%23define%20configASSERT(%20x%20)%200%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22FreeRTOSConfig%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Night%20Owl%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Fndlf%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u2c8113c5\" id=\"u2c8113c5\"><span data-lake-id=\"ud9259faf\" id=\"ud9259faf\">则可以在串口中得到报错时的文件及所在行</span></p><p data-lake-id=\"u29f6256a\" id=\"u29f6256a\"><span data-lake-id=\"u7754b0bd\" id=\"u7754b0bd\">​</span><br></p><h2 data-lake-id=\"MkmyC\" id=\"MkmyC\"><span data-lake-id=\"ua8b427ff\" id=\"ua8b427ff\">M3及以上内核阻塞式睡眠</span></h2><p data-lake-id=\"u148d2714\" id=\"u148d2714\"><strong><span data-lake-id=\"ufdeadf57\" id=\"ufdeadf57\">基于DWT的延时函数</span></strong></p><blockquote data-lake-id=\"ue35fd824\" id=\"ue35fd824\"><p data-lake-id=\"u4927e996\" id=\"u4927e996\"><span data-lake-id=\"u7335e75e\" id=\"u7335e75e\"> DWT（Data Watchpoint and Trace）是 ARM 内核中的一个调试组件，用于支持高级调试功能，如数据监视点、性能分析和事件跟踪。它并不是所有 ARM 内核都支持，而是出现在支持 </span><strong><span data-lake-id=\"u1c939865\" id=\"u1c939865\">Cortex-M3 及以上</span></strong><span data-lake-id=\"u32eda992\" id=\"u32eda992\">的内核中。  </span></p></blockquote><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22delay.h%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23ifndef%20_DELAY_H_%5Cn%23define%20_DELAY_H_%5Cn%5Cn%23include%20%5C%22stdint.h%5C%22%5Cn%5Cn%2F**%5Cn***********************************************************%5Cn*%20%40brief%20DWT%E5%88%9D%E5%A7%8B%E5%8C%96%E9%85%8D%E7%BD%AE%5Cn*%20%40param%5Cn*%20%40return%20%5Cn***********************************************************%5Cn*%2F%5Cnvoid%20DelayInit(void)%3B%5Cn%5Cn%2F**%5Cn***********************************************************%5Cn*%20%40brief%20%E5%BE%AE%E7%A7%92%E7%BA%A7%E5%BB%B6%E6%97%B6%E5%87%BD%E6%95%B0%5Cn*%20%40param%20nUs%EF%BC%8C%E6%9C%80%E5%A4%A7%E5%BB%B6%E6%97%B6%E6%97%B6%E9%97%B4(%202%5E32%20%2F%20%E5%86%85%E6%A0%B8%E4%B8%BB%E9%A2%91%20)%20*%2010%5E6%20us%20%5Cn*%20%40return%20%5Cn***********************************************************%5Cn*%2F%5Cnvoid%20DelayNus(uint32_t%20nUs)%3B%5Cn%5Cn%2F**%5Cn***********************************************************%5Cn*%20%40brief%20%E6%AF%AB%E7%A7%92%E7%BA%A7%E5%BB%B6%E6%97%B6%E5%87%BD%E6%95%B0%5Cn*%20%40param%20nMs%EF%BC%8C%E5%BB%B6%E6%97%B6%E6%97%B6%E9%97%B4n%E6%AF%AB%E7%A7%92%5Cn*%20%40return%20%5Cn***********************************************************%5Cn*%2F%5Cnvoid%20DelayNms(uint32_t%20nMs)%3B%5Cn%5Cn%23endif%5Cn%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Atrue%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22delay.h%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Night%20Owl%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22zUyJR%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22delay.c%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdint.h%3E%5Cn%23include%20%5C%22gd32f4xx.h%5C%22%5Cn%5Cn%2F**%5Cn***********************************************************%5Cn*%20%40brief%20DWT%E5%88%9D%E5%A7%8B%E5%8C%96%E9%85%8D%E7%BD%AE%5Cn*%20%40param%5Cn*%20%40return%20%5Cn***********************************************************%5Cn*%2F%5Cnvoid%20DelayInit(void)%20%5Cn%7B%5Cn%5Ct%2F*%20%E5%85%B3%E9%97%AD%20TRC%20*%2F%5Cn%5CtCoreDebug-%3EDEMCR%20%26%3D%20~CoreDebug_DEMCR_TRCENA_Msk%3B%5Cn%5Ct%2F*%20%E6%89%93%E5%BC%80%20TRC%20*%2F%5Cn%5CtCoreDebug-%3EDEMCR%20%7C%3D%20CoreDebug_DEMCR_TRCENA_Msk%3B%5Cn%5Cn%5Ct%2F*%20%E5%85%B3%E9%97%AD%E8%AE%A1%E6%95%B0%E5%8A%9F%E8%83%BD%20*%2F%5Cn%5CtDWT-%3ECTRL%20%26%3D%20~DWT_CTRL_CYCCNTENA_Msk%3B%5Cn%5Ct%2F*%20%E6%89%93%E5%BC%80%E8%AE%A1%E6%95%B0%E5%8A%9F%E8%83%BD%20*%2F%5Cn%5CtDWT-%3ECTRL%20%7C%3D%20DWT_CTRL_CYCCNTENA_Msk%3B%5Cn%5Cn%5Ct%2F*%20%E8%AE%A1%E6%95%B0%E6%B8%85%E9%9B%B6%20*%2F%5Cn%5CtDWT-%3ECYCCNT%20%3D%200%3B%5Cn%7D%5Cn%5Cn%2F**%5Cn***********************************************************%5Cn*%20%40brief%20%E5%BE%AE%E7%A7%92%E7%BA%A7%E5%BB%B6%E6%97%B6%E5%87%BD%E6%95%B0%5Cn*%20%40param%20nUs%EF%BC%8C%E6%9C%80%E5%A4%A7%E5%BB%B6%E6%97%B6%E6%97%B6%E9%97%B4(%202%5E32%20%2F%20%E5%86%85%E6%A0%B8%E4%B8%BB%E9%A2%91%20)%20*%2010%5E6%20us%20%5Cn*%20%40return%20%5Cn***********************************************************%5Cn*%2F%5Cnvoid%20DelayNus(uint32_t%20nUs)%5Cn%7B%5Cn%5Ctuint32_t%20tickStart%20%3D%20DWT-%3ECYCCNT%3B%5Cn%5Cn%5Ct%2F*%20%E8%BD%AC%E6%8D%A2%E4%B8%BAnUs%E5%AF%B9%E5%BA%94%E7%9A%84%E6%97%B6%E9%92%9F%E8%B7%B3%E5%8A%A8%E6%AC%A1%E6%95%B0*%2F%5Cn%2F%2F%5CtnUs%20*%3D%20(rcu_clock_freq_get(CK_AHB)%20%2F%201000000)%3B%5Cn%5CtnUs%20*%3D%20(SystemCoreClock%20%2F%201000000)%3B%5Cn%5Cn%5Ct%2F*%20%E5%BB%B6%E6%97%B6%E7%AD%89%E5%BE%85%20*%2F%5Cn%5Ctwhile%20((DWT-%3ECYCCNT%20-%20tickStart)%20%3C%20nUs)%3B%5Cn%7D%5Cn%5Cn%2F**%5Cn***********************************************************%5Cn*%20%40brief%20%E6%AF%AB%E7%A7%92%E7%BA%A7%E5%BB%B6%E6%97%B6%E5%87%BD%E6%95%B0%5Cn*%20%40param%20nMs%EF%BC%8C%E5%BB%B6%E6%97%B6%E6%97%B6%E9%97%B4n%E6%AF%AB%E7%A7%92%5Cn*%20%40return%20%5Cn***********************************************************%5Cn*%2F%5Cnvoid%20DelayNms(uint32_t%20nMs)%5Cn%7B%5Cn%5Ctwhile(nMs--)%7B%5Cn%5Ct%5CtDelayNus(1000)%3B%5Cn%5Ct%7D%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Atrue%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22delay.c%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Night%20Owl%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22TzEHP%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>",
