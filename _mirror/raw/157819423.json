  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h1 data-lake-id=\"WtlSQ\" id=\"WtlSQ\"><span data-lake-id=\"u2293c6c7\" id=\"u2293c6c7\">国内常用pip源</span></h1><p data-lake-id=\"ud257416e\" id=\"ud257416e\"><span data-lake-id=\"ufceb365c\" id=\"ufceb365c\">(经测试，豆瓣源最快）</span></p><p data-lake-id=\"u0bd768c2\" id=\"u0bd768c2\"><span data-lake-id=\"uc55006a3\" id=\"uc55006a3\">豆瓣源：</span><a href=\"https://pypi.doubanio.com/simple\" target=\"_blank\" data-lake-id=\"u5000c870\" id=\"u5000c870\"><span data-lake-id=\"u4dd57835\" id=\"u4dd57835\">https://pypi.doubanio.com/simple</span></a><span data-lake-id=\"uc68f610c\" id=\"uc68f610c\">\t\t  trusted-host：</span><code data-lake-id=\"u56d015c0\" id=\"u56d015c0\"><span data-lake-id=\"ub6266053\" id=\"ub6266053\">pypi.doubanio.com</span></code></p><p data-lake-id=\"u3f9674d2\" id=\"u3f9674d2\"><span data-lake-id=\"u99934c1d\" id=\"u99934c1d\">清华源：</span><a href=\"https://pypi.tuna.tsinghua.edu.cn/simple\" target=\"_blank\" data-lake-id=\"u3ab07451\" id=\"u3ab07451\"><span data-lake-id=\"ub04c035c\" id=\"ub04c035c\">https://pypi.tuna.tsinghua.edu.cn/simple</span></a><span data-lake-id=\"ubc68003c\" id=\"ubc68003c\"> trusted-host：</span><code data-lake-id=\"u1a6d8334\" id=\"u1a6d8334\"><span data-lake-id=\"uee85141c\" id=\"uee85141c\">pypi.tuna.tsinghua.edu.cn</span></code></p><p data-lake-id=\"ubfc7bd3f\" id=\"ubfc7bd3f\"><span data-lake-id=\"u09bd61e2\" id=\"u09bd61e2\">阿里源：</span><a href=\"https://mirrors.aliyun.com/pypi/simple/\" target=\"_blank\" data-lake-id=\"ucc915508\" id=\"ucc915508\"><span data-lake-id=\"uc1919fb9\" id=\"uc1919fb9\">https://mirrors.aliyun.com/pypi/simple</span></a><span data-lake-id=\"u604102d4\" id=\"u604102d4\">\t  trusted-host：</span><code data-lake-id=\"u5c758311\" id=\"u5c758311\"><span data-lake-id=\"u4a635d42\" id=\"u4a635d42\">mirrors.aliyun.com</span></code></p><p data-lake-id=\"u88af0a6b\" id=\"u88af0a6b\"><span data-lake-id=\"u9200b1a0\" id=\"u9200b1a0\">百度源：</span><a href=\"https://mirror.baidu.com/pypi/simple\" target=\"_blank\" data-lake-id=\"u8277468d\" id=\"u8277468d\"><span data-lake-id=\"u1bf53740\" id=\"u1bf53740\">https://mirror.baidu.com/pypi/simple</span></a><span data-lake-id=\"u9ac4c8e4\" id=\"u9ac4c8e4\">\t  trusted-host：</span><code data-lake-id=\"u0bdc4210\" id=\"u0bdc4210\"><span data-lake-id=\"u0646bfe3\" id=\"u0646bfe3\">mirror.baidu.com</span></code></p><h1 data-lake-id=\"yXrlX\" id=\"yXrlX\"><span data-lake-id=\"ucb33ab33\" id=\"ucb33ab33\">方式一：自动配置（荐）</span></h1><p data-lake-id=\"uc42315b0\" id=\"uc42315b0\"><span data-lake-id=\"u9c826c23\" id=\"u9c826c23\">可使用如下命令进行自动配置，打开控制台，运行如下命令：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22powershell%22%2C%22code%22%3A%22pip%20config%20set%20global.index-url%20https%3A%2F%2Fpypi.doubanio.com%2Fsimple%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22cjoyW%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u234bd52a\" id=\"u234bd52a\"><span data-lake-id=\"u9685dc5b\" id=\"u9685dc5b\">重置源：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22powershell%22%2C%22code%22%3A%22pip%20config%20unset%20global.index-url%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Gf9Zs%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"Ohyn8\" id=\"Ohyn8\"><span data-lake-id=\"ubd4dd7f6\" id=\"ubd4dd7f6\">方式二：手动配置</span></h1><h2 data-lake-id=\"dzhSc\" id=\"dzhSc\"><span data-lake-id=\"uf547254a\" id=\"uf547254a\">windows的pip镜像</span></h2><ol list=\"ufd3e8aad\"><li fid=\"u45a723b2\" data-lake-id=\"u7d8c6df6\" id=\"u7d8c6df6\"><span data-lake-id=\"u22f9fc36\" id=\"u22f9fc36\">在</span><code data-lake-id=\"ud0246aa8\" id=\"ud0246aa8\"><span data-lake-id=\"u562f6834\" id=\"u562f6834\">C:\\Users\\当前用户\\</span></code><span data-lake-id=\"u087dd060\" id=\"u087dd060\">下创建</span><code data-lake-id=\"uba97487e\" id=\"uba97487e\"><span data-lake-id=\"u1d070d2f\" id=\"u1d070d2f\">pip</span></code><span data-lake-id=\"uda05d3fd\" id=\"uda05d3fd\">文件夹</span></li><li fid=\"u45a723b2\" data-lake-id=\"u0f22867c\" id=\"u0f22867c\"><span data-lake-id=\"ufe03e31a\" id=\"ufe03e31a\">在</span><code data-lake-id=\"u9bca95fa\" id=\"u9bca95fa\"><span data-lake-id=\"ue1d35c29\" id=\"ue1d35c29\">pip</span></code><span data-lake-id=\"ud7144a27\" id=\"ud7144a27\">下创建</span><code data-lake-id=\"ua9e20567\" id=\"ua9e20567\"><span data-lake-id=\"uac6c0f92\" id=\"uac6c0f92\">pip.ini</span></code><span data-lake-id=\"ua6390028\" id=\"ua6390028\">文件</span></li><li fid=\"u45a723b2\" data-lake-id=\"ue8e511f7\" id=\"ue8e511f7\"><span data-lake-id=\"u558cf3ad\" id=\"u558cf3ad\">编辑</span><code data-lake-id=\"ufef0989d\" id=\"ufef0989d\"><span data-lake-id=\"u189a219b\" id=\"u189a219b\">pip.ini</span></code><span data-lake-id=\"u923ab1ff\" id=\"u923ab1ff\">添加如下内容</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22%5Bglobal%5D%5Cnindex-url%20%3D%20https%3A%2F%2Fmirrors.aliyun.com%2Fpypi%2Fsimple%2F%5Cn%5Binstall%5D%5Cntrusted-host%3Dmirrors.aliyun.com%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22GYVWa%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"Axtxu\" id=\"Axtxu\"><span data-lake-id=\"ub493ada0\" id=\"ub493ada0\">ubuntu的pip镜像</span></h2><h3 data-lake-id=\"CpkZQ\" id=\"CpkZQ\"><span data-lake-id=\"uae3c73a8\" id=\"uae3c73a8\">当前用户的pip镜像</span></h3><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%221.%20%E8%BF%9B%E5%85%A5%E7%94%A8%E6%88%B7%E7%9B%AE%E5%BD%95%20%20%20%20%20%20cd%20~%5Cn2.%20%E5%88%9B%E5%BB%BA.pip%E6%96%87%E4%BB%B6%E5%A4%B9%20%20%20%20mkdir%20.pip%5Cn3.%20%E8%BF%9B%E5%85%A5.pip%E6%96%87%E4%BB%B6%E5%A4%B9%20%20%20%20cd%20.pip%20%20%5Cn4.%20%E5%88%9B%E5%BB%BApip.conf%E6%96%87%E4%BB%B6%20%20touch%20pip.conf%20%20%5Cn5.%20%E7%BC%96%E8%BE%91pip.conf%E6%96%87%E4%BB%B6%20%20vim%20pip.conf%20%20%20%5Cn%5Cn%5Bglobal%5D%5Cnindex-url%20%3D%20https%3A%2F%2Fmirrors.aliyun.com%2Fpypi%2Fsimple%2F%5Cn%5Binstall%5D%5Cntrusted-host%3Dmirrors.aliyun.com%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Night%20Owl%22%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22nkLAd%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h3 data-lake-id=\"phCiw\" id=\"phCiw\"><span data-lake-id=\"u2bd59c1e\" id=\"u2bd59c1e\">root用户的pip镜像</span></h3><card type=\"inline\" name=\"codeblock\" value=\"d