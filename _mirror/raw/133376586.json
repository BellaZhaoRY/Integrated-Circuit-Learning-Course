  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h1 data-lake-id=\"WSuwu\" id=\"WSuwu\"><span data-lake-id=\"u3ca77586\" id=\"u3ca77586\" style=\"color: rgb(51, 51, 51)\">1. 创建package</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20pkg%20create%20--build-type%20ament_python%20py_srvcli%20--dependencies%20rclpy%20example_interfaces%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22VAhYi%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u2d6b8491\" id=\"u2d6b8491\"><span data-lake-id=\"u89953ee2\" id=\"u89953ee2\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">可以修改</span><span data-lake-id=\"uf53ed219\" id=\"uf53ed219\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"u3cfece5e\" id=\"u3cfece5e\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">文件如下信息</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22xml%22%2C%22code%22%3A%22%3Cdescription%3EC%2B%2B%20client%20server%20tutorial%3C%2Fdescription%3E%5Cn%3Cmaintainer%20email%3D%5C%22you%40email.com%5C%22%3EYour%20Name%3C%2Fmaintainer%3E%5Cn%3Clicense%3EApache%20License%202.0%3C%2Flicense%3E%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22aIwWk%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"ZrTJR\" id=\"ZrTJR\"><span data-lake-id=\"u89cfea6b\" id=\"u89cfea6b\" style=\"color: rgb(51, 51, 51)\">2. 编写server节点代码</span></h1><h2 data-lake-id=\"IBE71\" id=\"IBE71\"><span data-lake-id=\"uab5fce33\" id=\"uab5fce33\" style=\"color: rgb(51, 51, 51)\">2.1 编写代码</span></h2><ol list=\"u171de831\"><li fid=\"u0635d509\" data-lake-id=\"ua13a2742\" id=\"ua13a2742\"><span data-lake-id=\"u34b0e1ee\" id=\"u34b0e1ee\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在package的</span><span data-lake-id=\"u1143131f\" id=\"u1143131f\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">py_srvcli</span><span data-lake-id=\"u2a57753a\" id=\"u2a57753a\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">下创建</span><span data-lake-id=\"ue7c27567\" id=\"ue7c27567\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">server.py</span><span data-lake-id=\"u6049f7fd\" id=\"u6049f7fd\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,代码如下</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22from%20example_interfaces.srv%20import%20AddTwoInts%5Cnimport%20rclpy%5Cnfrom%20rclpy.node%20import%20Node%5Cn%5Cnclass%20MyServer(Node)%3A%5Cn%20%20%20%20def%20__init__(self)%3A%5Cn%20%20%20%20%20%20%20%20super(MyServer%2C%20self).__init__('py_server')%5Cn%20%20%20%20%20%20%20%20self.service%20%3D%20self.create_service(AddTwoInts%2C%20'py_service'%2C%20self.call_back)%5Cn%5Cn%20%20%20%20def%20call_back(self%2Creq%2Cres)%3A%5Cn%20%20%20%20%20%20%20%20res.sum%20%3D%20req.a%2Breq.b%5Cn%20%20%20%20%20%20%20%20return%20res%5Cn%5Cn%5Cndef%20main()%3A%5Cn%20%20%20%20rclpy.init()%5Cn%20%20%20%20node%20%3D%20MyServer()%5Cn%20%20%20%20rclpy.spin(node)%5Cn%20%20%20%20rclpy.shutdown()%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20main()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22odZG8%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"HyZX0\" id=\"HyZX0\"><span data-lake-id=\"u6ce997e5\" id=\"u6ce997e5\" style=\"color: rgb(51, 51, 51)\">2.2 添加配置</span></h2><ol list=\"uc3d503b0\"><li fid=\"ue43aeee0\" data-lake-id=\"u60d1d040\" id=\"u60d1d040\"><span data-lake-id=\"u5648942b\" id=\"u5648942b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">打开</span><span data-lake-id=\"u3db17ec4\" id=\"u3db17ec4\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">setup.py</span><span data-lake-id=\"uc1d911bb\" id=\"uc1d911bb\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,在</span><span data-lake-id=\"u81db3c0b\" id=\"u81db3c0b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">console_scripts</span><span data-lake-id=\"u861ae5a4\" id=\"u861ae5a4\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">节点下添加配置</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22'server%20%3D%20py_srvcli.server%3Amain'%2C%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ou0CX%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"PeXFm\" id=\"PeXFm\"><span data-lake-id=\"u4c6f8470\" id=\"u4c6f8470\" style=\"color: rgb(51, 51, 51)\">3. 编译工程</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22colcon%20build%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22UmAHO%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"whPWj\" id=\"whPWj\"><span data-lake-id=\"u379ca5ca\" id=\"u379ca5ca\" style=\"color: rgb(51, 51, 51)\">4. 运行节点</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20run%20py_srvcli%20service%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22fS9JJ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ub2ea09d9\" id=\"ub2ea09d9\"><span data-lake-id=\"u066cec8b\" id=\"u066cec8b\"><br /></span><span data-lake-id=\"u108a4369\" id=\"u108a4369\"> </span></p>",
