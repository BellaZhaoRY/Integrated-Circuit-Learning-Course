  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h1 data-lake-id=\"ofiGW\" id=\"ofiGW\"><span data-lake-id=\"uc3c8d222\" id=\"uc3c8d222\" style=\"color: rgb(51, 51, 51)\">1. 创建package(创建过可以省略)</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20pkg%20create%20--build-type%20ament_python%20py_pubsub%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22G1qPP%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uec554da9\" id=\"uec554da9\"><span data-lake-id=\"uf97b4c2a\" id=\"uf97b4c2a\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">可以修改</span><span data-lake-id=\"ude1c20f9\" id=\"ude1c20f9\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"uc8d2b16a\" id=\"uc8d2b16a\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">文件如下信息</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22xml%22%2C%22code%22%3A%22%3Cdescription%3EC%2B%2B%20client%20server%20tutorial%3C%2Fdescription%3E%5Cn%3Cmaintainer%20email%3D%5C%22you%40email.com%5C%22%3EYour%20Name%3C%2Fmaintainer%3E%5Cn%3Clicense%3EApache%20License%202.0%3C%2Flicense%3E%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22pPn1D%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"xnjXH\" id=\"xnjXH\"><span data-lake-id=\"uecdf7090\" id=\"uecdf7090\" style=\"color: rgb(51, 51, 51)\">2. 编写publisher节点代码</span></h1><h2 data-lake-id=\"Pd0OX\" id=\"Pd0OX\"><span data-lake-id=\"u6a4b942b\" id=\"u6a4b942b\" style=\"color: rgb(51, 51, 51)\">2.1 下载示例代码</span></h2><ol list=\"ua5576a44\"><li fid=\"u2d3883b2\" data-lake-id=\"u22e2956f\" id=\"u22e2956f\"><span data-lake-id=\"ufc706730\" id=\"ufc706730\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在package的</span><span data-lake-id=\"uc7b49e9f\" id=\"uc7b49e9f\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">py_pubsub</span><span data-lake-id=\"ude5a3e40\" id=\"ude5a3e40\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">下创建</span><span data-lake-id=\"u87103245\" id=\"u87103245\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">subscriber.py</span><span data-lake-id=\"uc2d010e0\" id=\"uc2d010e0\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,代码如下</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20rclpy%5Cnfrom%20rclpy.node%20import%20Node%5Cnfrom%20std_msgs.msg%20import%20String%5Cn%5Cnclass%20SubNode(Node)%3A%5Cn%20%20%20%20def%20__init__(self)%3A%5Cn%20%20%20%20%20%20%20%20super(SubNode%2C%20self).__init__('py_sub')%5Cn%20%20%20%20%20%20%20%20self.create_subscription(String%2C'py_topic'%2Cself.call_back%2C10)%5Cn%5Cn%20%20%20%20def%20call_back(self%2Cmsg)%3A%5Cn%20%20%20%20%20%20%20%20self.get_logger().info(msg.data)%5Cn%5Cndef%20main()%3A%5Cn%20%20%20%20rclpy.init()%5Cn%20%20%20%20node%20%3D%20SubNode()%5Cn%20%20%20%20rclpy.spin(node)%5Cn%20%20%20%20node.destroy_node()%5Cn%20%20%20%20rclpy.shutdown()%5Cn%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20main()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Nbvzh%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"sZTvn\" id=\"sZTvn\"><span data-lake-id=\"u1553d0e3\" id=\"u1553d0e3\" style=\"color: rgb(51, 51, 51)\">2.2 添加依赖</span></h2><ol list=\"u4825d923\"><li fid=\"u28c1ddb9\" data-lake-id=\"uc89320eb\" id=\"uc89320eb\"><span data-lake-id=\"u95efc5d2\" id=\"u95efc5d2\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">打开</span><span data-lake-id=\"ue44e63b5\" id=\"ue44e63b5\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"u39de493d\" id=\"u39de493d\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,添加下面两行</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22xml%22%2C%22code%22%3A%22%3Cdepend%3Erclpy%3C%2Fdepend%3E%5Cn%3Cdepend%3Estd_msgs%3C%2Fdepend%3E%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22GqHXw%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><ol list=\"u135af5dc\"><li fid=\"u410f490f\" data-lake-id=\"u05077a9d\" id=\"u05077a9d\"><span data-lake-id=\"u8e5394e1\" id=\"u8e5394e1\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">打开 </span><span data-lake-id=\"ud94cbf30\" id=\"ud94cbf30\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">setup.py</span><span data-lake-id=\"u0ab25a26\" id=\"u0ab25a26\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">,确保如下内容和</span><span data-lake-id=\"u66161a0b\" id=\"u66161a0b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"u8b963b28\" id=\"u8b963b28\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">中一致</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22maintainer%3D'YourName'%2C%5Cnmaintainer_email%3D'you%40email.com'%2C%5Cndescription%3D'Examples%20of%20minimal%20publisher%2Fsubscriber%20using%20rclpy'%2C%5Cnlicense%3D'Apache%20License%202.0'%2C%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22dYKSf%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><ol list=\"u1d0a7be8\"><li fid=\"uead55fc7\" data-lake-id=\"ucfadcb06\" id=\"ucfadcb06\"><span data-lake-id=\"uc57ce4f4\" id=\"uc57ce4f4\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">setup.py</span><span data-lake-id=\"u3bf69dd6\" id=\"u3bf69dd6\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">中</span><span data-lake-id=\"ud97cba64\" id=\"ud97cba64\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">console_scripts</span><span data-lake-id=\"u0351c678\" id=\"u0351c678\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在字段的括号内添加以下行</span><span data-lake-id=\"u06aa4cd6\" id=\"u06aa4cd6\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">entry_points</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22entry_points%3D%7B%5Cn%20%20%20%20'console_scripts'%3A%20%5B%5Cn%20%20%20%20%20%20%20%20'talker%20%3D%20py_pubsub.publisher%3Amain'%2C%5Cn%20%20%20%20%20%20%20%20'subscriber%20%3D%20py_pubsub.subscriber%3Amain'%2C%5Cn%20%20%20%20%5D%2C%5Cn%7D%2C%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22vQLPf%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ucfd6804c\" id=\"ucfd6804c\"><span data-lake-id=\"ua9a74f0d\" id=\"ua9a74f0d\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">注意py_pubsub是包名 publisher是py文件名 main是执行的函数</span></p><h1 data-lake-id=\"I50eb\" id=\"I50eb\"><span data-lake-id=\"ud3423734\" id=\"ud3423734\" style=\"color: rgb(51, 51, 51)\">3. 回到工程目录,编译代码</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22colcon%20build%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Ieim5%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"TCM5q\" id=\"TCM5q\"><span data-lake-id=\"u86903064\" id=\"u86903064\" style=\"color: rgb(51, 51, 51)\">4. 使构建生效</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22source%20install%2Fsetup.bash%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22zjhXe%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"bxT5c\" id=\"bxT5c\"><span data-lake-id=\"u2f77be50\" id=\"u2f77be50\" style=\"color: rgb(51, 51, 51)\">5. 运行发布节点</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20run%20py_pubsub%20subscriber%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22hH4ec%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ubff26265\" id=\"ubff26265\"><span data-lake-id=\"ucf134eb5\" id=\"ucf134eb5\"><br /> </span></p>",
