abSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22OrNjb%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ud8d280f8\" id=\"ud8d280f8\"><span data-lake-id=\"uf8f32124\" id=\"uf8f32124\" class=\"lake-fontsize-12\">野指针：指针变量保存的地址是非法的。</span></p><card type=\"block\" name=\"hr\" value=\"data:%7B%22id%22%3A%22M0ECZ%22%7D\"></card><h1 data-lake-id=\"BQOdW\" id=\"BQOdW\"><span data-lake-id=\"u38a62bc1\" id=\"u38a62bc1\">3&gt; 相关函数</span></h1><h2 data-lake-id=\"QlKZ5\" id=\"QlKZ5\"><span data-lake-id=\"u52deeb95\" id=\"u52deeb95\">3.1&gt; calloc( )</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22contiguous%20allocation%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22void*%20calloc(size_t%20num%2C%20size_t%20size)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22contiguous%20allocation%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22sZXs4%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22int*%20ptr%20%3D%20(int*)calloc(5%2C%20sizeof(int))%3B%5Cn%5Cn1%3E%20%E9%85%8D%E5%8F%AF%E4%BB%A5%E5%AD%98%E5%82%A85%E4%B8%AAint%E7%B1%BB%E5%9E%8B%E6%95%B0%E6%8D%AE%E7%9A%84%E5%86%85%E5%AD%98%E7%A9%BA%E9%97%B4%EF%BC%8C%5Cn2%3E%20%E5%B9%B6%E4%B8%94%E6%89%80%E6%9C%89%E5%85%83%E7%B4%A0%E9%83%BD%E5%88%9D%E5%A7%8B%E5%8C%96%E4%B8%BA%200%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atr