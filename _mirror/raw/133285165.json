  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h1 data-lake-id=\"pTm20\" id=\"pTm20\"><span data-lake-id=\"u384e136f\" id=\"u384e136f\" style=\"color: rgb(51, 51, 51)\">1. 创建package</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20pkg%20create%20--build-type%20ament_python%20py_pubsub%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22fwjqW%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u1a700f2b\" id=\"u1a700f2b\"><span data-lake-id=\"uabbda325\" id=\"uabbda325\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">可以修改</span><span data-lake-id=\"u87075b3a\" id=\"u87075b3a\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"u27279e20\" id=\"u27279e20\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">文件如下信息</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22xml%22%2C%22code%22%3A%22%3Cdescription%3EC%2B%2B%20client%20server%20tutorial%3C%2Fdescription%3E%5Cn%3Cmaintainer%20email%3D%5C%22you%40email.com%5C%22%3EYour%20Name%3C%2Fmaintainer%3E%5Cn%3Clicense%3EApache%20License%202.0%3C%2Flicense%3E%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22nR0Gj%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"wRlRG\" id=\"wRlRG\"><span data-lake-id=\"uab535df7\" id=\"uab535df7\" style=\"color: rgb(51, 51, 51)\">2. 编写publisher节点代码</span></h1><h2 data-lake-id=\"DDzi1\" id=\"DDzi1\"><span data-lake-id=\"u352fc0cd\" id=\"u352fc0cd\" style=\"color: rgb(51, 51, 51)\">2.1 编写代码</span></h2><ol list=\"u14b20677\"><li fid=\"ub331b49b\" data-lake-id=\"u1873cdd5\" id=\"u1873cdd5\"><span data-lake-id=\"u936e9261\" id=\"u936e9261\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在package的</span><span data-lake-id=\"ub1f51aa9\" id=\"ub1f51aa9\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">py_pubsub</span><span data-lake-id=\"ucbdb167c\" id=\"ucbdb167c\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">下创建</span><span data-lake-id=\"u329af025\" id=\"u329af025\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">publisher.py</span><span data-lake-id=\"ue90cfdae\" id=\"ue90cfdae\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,代码如下</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20rclpy%5Cnfrom%20rclpy.node%20import%20Node%5Cnfrom%20std_msgs.msg%20import%20String%5Cn%5Cnclass%20PyPublisher(Node)%3A%5Cn%20%20%20%20def%20__init__(self)%3A%5Cn%20%20%20%20%20%20%20%20super(PyPublisher%2C%20self).__init__('py_publisher')%5Cn%20%20%20%20%20%20%20%20self.publisher%20%3D%20self.create_publisher(String%2C%20'py_topic'%2C%2010)%5Cn%20%20%20%20%20%20%20%20timer_period%20%3D%200.5%20%20%23%20seconds%5Cn%20%20%20%20%20%20%20%20self.timer%20%3D%20self.create_timer(timer_period%2C%20self.timer_callback)%5Cn%20%20%20%20%20%20%20%20self.i%20%3D%200%5Cn%5Cn%20%20%20%20def%20timer_callback(self)%3A%5Cn%20%20%20%20%20%20%20%20msg%20%3D%20String()%5Cn%20%20%20%20%20%20%20%20msg.data%20%3D%20'Hello%20World%3A%20%25d'%20%25%20self.i%5Cn%20%20%20%20%20%20%20%20self.publisher.publish(msg)%5Cn%20%20%20%20%20%20%20%20self.get_logger().info('Publishing%3A%20%5C%22%25s%5C%22'%20%25%20msg.data)%5Cn%20%20%20%20%20%20%20%20self.i%20%2B%3D%201%5Cn%5Cndef%20main()%3A%5Cn%20%20%20%20rclpy.init()%5Cn%20%20%20%20node%20%3D%20PyPublisher()%5Cn%20%20%20%20rclpy.spin(node)%5Cn%20%20%20%20node.destroy_node()%5Cn%20%20%20%20rclpy.shutdown()%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20main()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22mccYX%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"jq3yV\" id=\"jq3yV\"><span data-lake-id=\"u45c943bf\" id=\"u45c943bf\" style=\"color: rgb(51, 51, 51)\">2.2 添加依赖</span></h2><ol list=\"u5a3a290f\"><li fid=\"uae413b0b\" data-lake-id=\"u5823c138\" id=\"u5823c138\"><span data-lake-id=\"u9bab6913\" id=\"u9bab6913\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">打开</span><span data-lake-id=\"u3ab0bf34\" id=\"u3ab0bf34\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"ue3ded4f2\" id=\"ue3ded4f2\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,添加下面两行</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22xml%22%2C%22code%22%3A%22%3Cexec_depend%3Erclpy%3C%2Fexec_depend%3E%5Cn%3Cexec_depend%3Estd_msgs%3C%2Fexec_depend%3E%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22CyZGg%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><ol list=\"u2c6dee3c\" start=\"2\"><li fid=\"udbf28792\" data-lake-id=\"u164cab05\" id=\"u164cab05\"><span data-lake-id=\"u32d52a03\" id=\"u32d52a03\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">打开 </span><span data-lake-id=\"u8046bb97\" id=\"u8046bb97\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">setup.py</span><span data-lake-id=\"u1161cd50\" id=\"u1161cd50\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">,保证如下字段和</span><span data-lake-id=\"u4af4adc9\" id=\"u4af4adc9\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"uc5565fb4\" id=\"uc5565fb4\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">中相同</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22maintainer%3D'YourName'%2C%5Cnmaintainer_email%3D'you%40email.com'%2C%5Cndescription%3D'Examples%20of%20minimal%20publisher%2Fsubscriber%20using%20rclpy'%2C%5Cnlicense%3D'Apache%20License%202.0'%2C%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22w3sWM%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><ol list=\"uaeb5b535\" start=\"3\"><li fid=\"u2654770d\" data-lake-id=\"ua9ca4d10\" id=\"ua9ca4d10\"><span data-lake-id=\"uc58b09ab\" id=\"uc58b09ab\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">setup.py</span><span data-lake-id=\"u553350d7\" id=\"u553350d7\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">中</span><span data-lake-id=\"u786aa593\" id=\"u786aa593\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">console_scripts</span><span data-lake-id=\"u889436b3\" id=\"u889436b3\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在字段的括号内添加以下行</span><span data-lake-id=\"u3c28a245\" id=\"u3c28a245\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">entry_points</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22entry_points%3D%7B%5Cn%20%20%20%20'console_scripts'%3A%20%5B%5Cn%20%20%20%20%20%20%20%20'talker%20%3D%20py_pubsub.publisher%3Amain'%2C%5Cn%20%20%20%20%5D%2C%5Cn%7D%2C%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22WB2iy%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u835f1729\" id=\"u835f1729\"><span data-lake-id=\"u132e3ccc\" id=\"u132e3ccc\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">注意py_pubsub是包名 publisher是py文件名 main是执行的函数</span></p><h1 data-lake-id=\"hqX3C\" id=\"hqX3C\"><span data-lake-id=\"uc47ea29a\" id=\"uc47ea29a\" style=\"color: rgb(51, 51, 51)\">3. 回到工程目录,编译代码</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22colcon%20build%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22OIWmF%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"uBD3U\" id=\"uBD3U\"><span data-lake-id=\"ua5dbb9d5\" id=\"ua5dbb9d5\" style=\"color: rgb(51, 51, 51)\">4. 使构建生效</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22source%20install%2Fsetup.bash%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22NXlCs%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"em1O5\" id=\"em1O5\"><span data-lake-id=\"u8efd6478\" id=\"u8efd6478\" style=\"color: rgb(51, 51, 51)\">5. 运行发布节点</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20run%20py_pubsub%20talker%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22r3azN%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u1acb46b2\" id=\"u1acb46b2\"><span data-lake-id=\"ufae99325\" id=\"ufae99325\"><br /></span><span data-lak