  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h2 data-lake-id=\"trXaq\" id=\"trXaq\"><span data-lake-id=\"ucec582cc\" id=\"ucec582cc\">学习目标</span></h2><ol list=\"uc2daaec9\"><li fid=\"ub3076963\" data-lake-id=\"uf5f09f01\" id=\"uf5f09f01\"><span data-lake-id=\"u31a9a7e4\" id=\"u31a9a7e4\">掌握ADC配置方式</span></li><li fid=\"ub3076963\" data-lake-id=\"ub875b642\" id=\"ub875b642\"><span data-lake-id=\"u263a62d6\" id=\"u263a62d6\">掌握ADC采样数据操作</span></li></ol><h2 data-lake-id=\"xJPlf\" id=\"xJPlf\"><span data-lake-id=\"ue10d87c4\" id=\"ue10d87c4\">学习内容</span></h2><h2 data-lake-id=\"asjLA\" id=\"asjLA\"><span data-lake-id=\"ub40cba4b\" id=\"ub40cba4b\">需求</span></h2><p data-lake-id=\"ufa0f1511\" id=\"ufa0f1511\"><span data-lake-id=\"ua26507df\" id=\"ua26507df\">采样芯片温度和外部电位器电压。</span></p><p data-lake-id=\"ua43e154e\" id=\"ua43e154e\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F27903758%2F1716366651684-1c4cd360-0bde-4ed3-88a0-9888bdd4526e.png%22%2C%22taskId%22%3A%22u9df0608e-4237-40fc-a804-837372d2609%22%2C%22clientId%22%3A%22uf39182c2-f7f6-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A684%2C%22height%22%3A380%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A23290%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A684%2C%22originHeight%22%3A380%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E7%94%B5%E4%BD%8D%E5%99%A8%22%2C%22x%22%3A510%2C%22y%22%3A29%2C%22width%22%3A168%2C%22height%22%3A57%7D%2C%7B%22text%22%3A%22POTENTIOMETER%22%2C%22x%22%3A199%2C%22y%22%3A57%2C%22width%22%3A154%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22POTENTIOMETER%22%2C%22x%22%3A397%2C%22y%22%3A123%2C%22width%22%3A156%2C%22height%22%3A18%7D%2C%7B%22text%22%3A%22100NF%22%2C%22x%22%3A381%2C%22y%22%3A278%2C%22width%22%3A49%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%22PC4%22%2C%22x%22%3A66%2C%22y%22%3A58%2C%22width%22%3A35%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22PR1%22%2C%22x%22%3A404%2C%22y%22%3A151%2C%22width%22%3A44%2C%22height%22%3A20%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23fcfbfb%22%2C%22id%22%3A%22uef0c5a5f%22%7D\"></card></p><ul list=\"u60bdc734\"><li fid=\"u73837d91\" data-lake-id=\"ua1062592\" id=\"ua1062592\"><span data-lake-id=\"u1d959ee3\" id=\"u1d959ee3\">ADC1 IN16 TEMP (芯片内部温度)</span></li><li fid=\"u73837d91\" data-lake-id=\"ua040168c\" id=\"ua040168c\"><span data-lake-id=\"uc7960c56\" id=\"uc7960c56\">ADC1 IN14 PC4  (电位器)</span></li></ul><h3 data-lake-id=\"vN8Ci\" id=\"vN8Ci\"><span data-lake-id=\"uddc7473f\" id=\"uddc7473f\">ADC配置</span></h3><ul list=\"uaf45032e\"><li fid=\"u13f9b0a0\" data-lake-id=\"u6d0147d0\" id=\"u6d0147d0\"><span data-lake-id=\"u735b65f5\" id=\"u735b65f5\">选中ADC1，</span></li><li fid=\"u13f9b0a0\" data-lake-id=\"u2cffa48d\" id=\"u2cffa48d\"><span data-lake-id=\"u69e04e83\" id=\"u69e04e83\">选中两个通道，IN16和IN14</span></li><li fid=\"u13f9b0a0\" data-lake-id=\"ud275ec4f\" id=\"ud275ec4f\"><span data-lake-id=\"udc9123b3\" id=\"udc9123b3\">配置采样序列数量为2</span></li><li fid=\"u13f9b0a0\" data-lake-id=\"u10e253e5\" id=\"u10e253e5\"><span data-lake-id=\"u8b8c18da\" id=\"u8b8c18da\">配置Rank1为温度传感器通道, 采样15 Cycles</span></li><li fid=\"u13f9b0a0\" data-lake-id=\"uddc0c235\" id=\"uddc0c235\"><span data-lake-id=\"u3f4b39af\" id=\"u3f4b39af\">配置Rank2为Channel14,  采样15 Cycles</span></li></ul><p data-lake-id=\"u7d1e205d\" id=\"u7d1e205d\"><span data-lake-id=\"u9c96506e\" id=\"u9c96506e\">这里不能使用默认的3Cycles, 会导致得不到结果</span></p><p data-lake-id=\"u1a86b3cf\" id=\"u1a86b3cf\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F27903758%2F1716368028411-8972b93a-60d6-43ed-a5f3-122dcf202be4.png%22%2C%22taskId%22%3A%22ud3881210-dcfc-4a83-b9fb-ae2f5398ff3%22%2C%22clientId%22%3A%22ub22f8116-64cb-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A853%2C%22height%22%3A855%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A98652%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A853%2C%22originHeight%22%3A855%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23eed19d%22%2C%22id%22%3A%22u4bd37239%22%7D\"></card></p><h3 data-lake-id=\"HwYYa\" id=\"HwYYa\"><span data-lake-id=\"uc6257678\" id=\"uc6257678\">ADC采样编码</span></h3><p data-lake-id=\"u106166cc\" id=\"u106166cc\"><span data-lake-id=\"u25fad83c\" id=\"u25fad83c\">开发流程：</span></p><ol list=\"u7276f0de\"><li fid=\"ufddcd64b\" data-lake-id=\"u438d052f\" id=\"u438d052f\"><span data-lake-id=\"u26c7c8e7\" id=\"u26c7c8e7\">开始采样</span></li><li fid=\"ufddcd64b\" data-lake-id=\"u41141e25\" id=\"u41141e25\"><span data-lake-id=\"ua33270c0\" id=\"ua33270c0\">等待转换完成</span></li><li fid=\"ufddcd64b\" data-lake-id=\"u60adf244\" id=\"u60adf244\"><span data-lake-id=\"uac29a5db\" id=\"uac29a5db\">按照序列顺序获取采样结果。</span></li></ol><p data-lake-id=\"u6413ec90\" id=\"u6413ec90\"><span data-lake-id=\"u1e4a9d39\" id=\"u1e4a9d39\">编码实现</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22main%E5%87%BD%E6%95%B0%E5%AE%9E%E7%8E%B0%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%20%20while%20(1)%5Cn%20%20%7B%5Cn%20%20%20%20%2F%2F%20ADC%E9%87%87%E6%A0%B7%5Cn%20%20%20%20%2F%2F%201.%20%E5%BC%80%E5%A7%8B%E9%87%87%E6%A0%B7%5Cn%20%20%20%20HAL_ADC_Start(%26hadc1)%3B%5Cn%20%20%20%20%2F%2F%202.%20%E7%AD%89%E5%BE%85%E9%87%87%E6%A0%B7%E5%AE%8C%E6%88%90%5Cn%20%20%20%20while(HAL_OK%20!%3D%20HAL_ADC_PollForConversion(%26hadc1%2C%20HAL_MAX_DELAY))%3B%5Cn%20%20%20%20%2F%2F%203.%20%E8%AF%BB%E5%8F%96%E9%87%87%E6%A0%B7%E7%BB%93%E6%9E%9C%5Cn%5Ctuint16_t