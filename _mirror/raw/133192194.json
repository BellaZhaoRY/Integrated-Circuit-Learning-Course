2%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22OlE4L%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><blockquote data-lake-id=\"uc39295d3\" id=\"uc39295d3\"><p data-lake-id=\"ud30ab2f1\" id=\"ud30ab2f1\"><span data-lake-id=\"u33693b09\" id=\"u33693b09\" class=\"lake-fontsize-12\">r,g,b控制画笔的颜色值。取值范围为0-255.</span></p><p data-lake-id=\"u33cef960\" id=\"u33cef960\"><span data-lake-id=\"u7ea96237\" id=\"u7ea96237\" class=\"lake-fontsize-12\">with控制的是画笔的粗细。</span></p><p data-lake-id=\"uba1d2e63\" id=\"uba1d2e63\"><span data-lake-id=\"u87747363\" id=\"u87747363\" class=\"lake-fontsize-12\">off表示是否使用画笔，0代表是使用，1为不使用。</span></p></blockquote><h2 data-lake-id=\"jocxd\" id=\"jocxd\"><span data-lake-id=\"u4269cecd\" id=\"u4269cecd\" style=\"color: rgb(51, 51, 51)\">设置绝对位置</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20service%20call%20%2Fturtle1%2Fteleport_absolute%20turtlesim%2Fsrv%2FTeleportAbsolute%20%5C%22%7B'x'%3A%203.0%2C'y'%3A%203.0%2C'theta'%3A%201.0%7D%5C%22%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22xUUcj%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ub9182188\" id=\"ub9182188\"><span data-lake-id=\"u4c931a6b\" id=\"u4c931a6b\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">通过设置</span><span data-lake-id=\"u72513d3f\" id=\"u72513d3f\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119); background-color: rgb(243, 244, 244)\">x</span><span data-lake-id=\"u70ee9e9f\" id=\"u70ee9e9f\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">,</span><span data-lake-id=\"u9129f550\" id=\"u9129f550\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119); background-color: rgb(243, 244, 244)\">y</span><span data-lake-id=\"uf28b1cac\" id=\"uf28b1cac\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">来设置新乌龟的位置。通过设置</span><span data-lake-id=\"u8fdde82e\" id=\"u8fdde82e\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119); background-color: rgb(243, 244, 244)\">theta</span><span data-lake-id=\"u312ac7ed\" id=\"u312ac7ed\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">来设置小乌龟头的朝向</span></p><h2 data-lake-id=\"wOUic\" id=\"wOUic\"><span data-lake-id=\"u66a69e4c\" id=\"u66a69e4c\" style=\"color: rgb(51, 51, 51)\">设置相对位置</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20service%20call%20%2Fturtle1%2Fteleport_relative%20turtlesim%2Fsrv%2FTeleportRelative%20%5C%22%7B'linear'%3A%201.0%2C'angular'%3A%201.0%7D%5C%22%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22quTRL%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><blockquote data-lake-id=\"u79aa7699\" id=\"u79aa7699\"><p data-lake-id=\"ub21630d3\" id=\"ub21630d3\"><code data-lake-id=\"uc8dd5e1a\" id=\"uc8dd5e1a\"><span data-lake-id=\"ue8a40aa1\" id=\"ue8a40aa1\" class=\"lake-fontsize-12\">linear</span></code><span data-lake-id=\"u35749bec\" id=\"u35749bec\" class=\"lake-fontsize-12\">负责线速度</span></p><p data-lake-id=\"u99128e01\" id=\"u99128e01\"><code data-lake-id=\"uec0efda1\" id=\"uec0efda1\"><span data-lake-id=\"ud9999a84\" id=\"ud9999a84\" class=\"lake-fontsize-12\">angular</span></code><span data-lake-id=\"ubaecffbb\" id=\"ubaecffbb\" class=\"lake-fontsize-12\">复杂角速度</span></p><p data-lake-id=\"u3b6d1d75\" id=\"u3b6d1d75\"><span data-lake-id=\"u0025baed\" id=\"u0025baed\" class=\"lake-fontsize-12\">按照单位为1s的时间运行</span></p><p data-lake-id=\"ue7fb6142\" id=\"ue7fb6142\"><span data-lake-id=\"uda94a5b4\" id=\"uda94a5b4\" class=\"lake-fontsize-12\">直接显示在1s后的位置上</span></p></blockquote>",
