  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><p data-lake-id=\"u16f04486\" id=\"u16f04486\"><span data-lake-id=\"u74fa8201\" id=\"u74fa8201\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">Linux提供的文件操作系统调用常用的有open、write、read、lseek、close等。</span></p><h3 data-lake-id=\"a46a90d4\" id=\"a46a90d4\"><span data-lake-id=\"uf18eb256\" id=\"uf18eb256\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">open函数</span></h3><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Csys%2Ftypes.h%3E%5Cn%23include%20%3Csys%2Fstat.h%3E%5Cn%23include%20%3Cfcntl.h%3E%5Cnint%20open(const%20char%20*pathname%2C%20int%20flags)%3B%5Cnint%20open(const%20char%20*pathname%2C%20int%20flags%2C%20mode_t%20mode)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22mCVZw%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><ul list=\"u53593693\"><li fid=\"uecd49bdf\" data-lake-id=\"uc33134f8\" id=\"uc33134f8\"><span data-lake-id=\"u14219085\" id=\"u14219085\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">pathname：要打开或创建的文件名；</span></li><li fid=\"uecd49bdf\" data-lake-id=\"u84a4c283\" id=\"u84a4c283\"><span data-lake-id=\"ud5751695\" id=\"ud5751695\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">flag：指定文件的打开方式，具体有以下参数，见下表 flag参数值。</span></li></ul><p data-lake-id=\"u7c286e25\" id=\"u7c286e25\"><span data-lake-id=\"ue95c5c8f\" id=\"ue95c5c8f\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">表 flag参数值</span></p><table data-lake-id=\"ZJj1e\" id=\"ZJj1e\" margin=\"true\" width-mode=\"normal\" fit-width=\"true\" class=\"lake-table\" style=\"width: 681px\"><colgroup><col width=\"100\"><col width=\"581\"></colgroup><tbody><tr data-lake-id=\"uf32cf880\" id=\"uf32cf880\"><td data-lake-id=\"uc95c7465\" id=\"uc95c7465\" style=\"background-color: rgb(252, 252, 252)\"><p data-lake-id=\"u7b144ab8\" id=\"u7b144ab8\"><strong><span data-lake-id=\"u94ceb901\" id=\"u94ceb901\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">标志位</span></strong></p></td><td data-lake-id=\"ub04520be\" id=\"ub04520be\" style=\"background-color: rgb(252, 252, 252)\"><p data-lake-id=\"ud84551ba\" id=\"ud84551ba\"><strong><span data-lake-id=\"u3a3d3aef\" id=\"u3a3d3aef\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">含义</span></strong></p></td></tr><tr data-lake-id=\"ue75ed0f1\" id=\"ue75ed0f1\"><td data-lake-id=\"u4ac645f1\" id=\"u4ac645f1\" style=\"background-color: rgb(243, 246, 246)\"><p data-lake-id=\"u40adcdda\" id=\"u40adcdda\"><span data-lake-id=\"u28286877\" id=\"u28286877\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">O_RDONLY</span></p></td><td data-lake-id=\"u31db9c4f\" id=\"u31db9c4f\" style=\"background-color: rgb(243, 246, 246)\"><p data-lake-id=\"u9388ae4f\" id=\"u9388ae4f\"><span data-lake-id=\"u143b2a7d\" id=\"u143b2a7d\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">以只读的方式打开文件，该参数与O_WRONLY和O_RDWR只能三选一</span></p></td></tr><tr data-lake-id=\"u9205fe78\" id=\"u9205fe78\"><td data-lake-id=\"u677ac2c0\" id=\"u677ac2c0\" style=\"background-color: rgb(252, 252, 252)\"><p data-lake-id=\"u0e74573b\" id=\"u0e74573b\"><span data-lake-id=\"u61085d93\" id=\"u61085d93\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">O_WRONLY</span></p></td><td data-lake-id=\"u60ef01ae\" id=\"u60ef01ae\" style=\"background-color: rgb(252, 252, 252)\"><p data-lake-id=\"u974dede4\" id=\"u974dede4\"><span data-lake-id=\"u1c4af25b\" id=\"u1c4af25b\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">以只写的方式打开文件</span></p></td></tr><tr data-lake-id=\"uf70f0678\" id=\"uf70f0678\"><td data-lake-id=\"ufe277263\" id=\"ufe277263\" style=\"background-color: rgb(243, 246, 246)\"><p data-lake-id=\"uc2357b7c\" id=\"uc2357b7c\"><span data-lake-id=\"u9b0d327c\" id=\"u9b0d327c\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">O_RDWR</span></p></td><td data-lake-id=\"ufb6cc4db\" id=\"ufb6cc4db\" style=\"background-color: rgb(243, 246, 246)\"><p data-lake-id=\"u81f22684\" id=\"u81f22684\"><span data-lake-id=\"u881565aa\" id=\"u881565aa\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">以读写的方式打开文件</span></p></td></tr><tr data-lake-id=\"ua2b393a9\" id=\"ua2b393a9\"><td data-lake-id=\"u73cb839e\" id=\"u73cb839e\" style=\"background-color: rgb(252, 252, 252)\"><p data-lake-id=\"ud93d1b7c\" id=\"ud93d1b7c\"><span data-lake-id=\"ubb555229\" id=\"ubb555229\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">O_CREAT</span></p></td><td data-lake-id=\"u9f047bc1\" id=\"u9f047bc1\" style=\"background-color: rgb(252, 252, 252)\"><p data-lake-id=\"u5c21c590\" id=\"u5c21c590\"><span data-lake-id=\"u777f9d49\" id=\"u777f9d49\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">创建一个新文件</span></p></td></tr><tr data-lake-id=\"u12e21df9\" id=\"u12e21df9\"><td data-lake-id=\"ue62e1ca2\" id=\"ue62e1ca2\" style=\"background-color: rgb(243, 246, 246)\"><p data-lake-id=\"uba1de567\" id=\"uba1de567\"><span data-lake-id=\"uc4e13b28\" id=\"uc4e13b28\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">O_APPEND</span></p></td><td data-lake-id=\"ue4ff9636\" id=\"ue4ff9636\" style=\"background-color: rgb(243, 246, 246)\"><p data-lake-id=\"u1fd8332c\" id=\"u1fd8332c\"><span data-lake-id=\"u5ea00b91\" id=\"u5ea00b91\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">将数据写入到当前文件的结尾处</span></p></td></tr><tr data-lake-id=\"u73b919dd\" id=\"u73b919dd\"><td data-lake-id=\"uc1ebdf28\" id=\"uc1ebdf28\" style=\"background-color: rgb(252, 252, 252)\"><p data-lake-id=\"ub5088a1f\" id=\"ub5088a1f\"><span data-lake-id=\"u9961a08a\" id=\"u9961a08a\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">O_TRUNC</span></p></td><td data-lake-id=\"u409813d8\" id=\"u409813d8\" style=\"background-color: rgb(252, 252, 252)\"><p data-lake-id=\"uc7b84c41\" id=\"uc7b84c41\"><span data-lake-id=\"u2d18e088\" id=\"u2d18e088\" class=\"lake-fontsize-11\" style=\"color: rgb(64, 64, 64)\">如果pathname文件存在，则清除文件内容</span></p></td></tr></tbody></table><h3 data-lake-id=\"b9169af9\" id=\"b9169af9\"><span data-lake-id=\"ufb9856ef\" id=\"ufb9856ef\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">read函数</span></h3><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cunistd.h%3E%5Cnssize_t%20read(int%20fd%2C%20void%20*buf%2C%20size_t%20count)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22UjFgI%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h3 data-lake-id=\"39df3875\" id=\"39df3875\"><span data-lake-id=\"u6e870193\" id=\"u6e870193\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">write函数</span></h3><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cunistd.h%3E%5Cnssize_t%20write(int%20fd%2C%20const%20void%20*buf%2C%20size_t%20count)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22f3Y7M%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h3 data-lake-id=\"e80b5006\" id=\"e80b5006\"><span data-lake-id=\"ucac35b96\" id=\"ucac35b96\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">close函数</span></h3><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22int%20close(int%20fd)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22g6xaN%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h3 data-lake-id=\"ba246e64\" id=\"ba246e64\"><span data-lake-id=\"uadf3f1c5\" id=\"uadf3f1c5\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">lseek函数</span></h3><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22off_t%20lseek(int%20fd%2C%20off_t%20offset%2C%20int%20whence)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22rxjs7%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u222e5f41\" id=\"u222e5f41\"><span data-lake-id=\"udbfc284e\" id=\"udbfc284e\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">它的用法与flseek一样，其中的offset参数用于指定位置，whence参数则定义了offset的意义，whence的可取值如下：</span></p><ul list=\"u30eea0ff\"><li fid=\"ua32e4c53\" data-lake-id=\"uab099919\" id=\"uab099919\"><span data-lake-id=\"ucb375734\" id=\"ucb375734\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">SEEK_SET：offset是一个绝对位置。</span></li><li fid=\"ua32e4c53\" data-lake-id=\"ubced4599\" id=\"ubced4599\"><span data-lake-id=\"u85883005\" id=\"u85883005\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">SEEK_END：offset是以文件尾为参考点的相对位置。</span></li><li fid=\"ua32e4c53\" data-lake-id=\"u444a9567\" id=\"u444a9567\"><span data-lake-id=\"ued7bc8df\" id=\"ued7bc8df\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">SEEK_CUR：offset是以当前位置为参考点的相对位置。</span></li></ul><h3 data-lake-id=\"rVs8i\" id=\"rVs8i\"><span data-lake-id=\"ue2a59099\" id=\"ue2a59099\" style=\"color: rgb(64, 64, 64); background-color: rgb(252, 252, 252)\">案例</span></h3><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Csys%2Fstat.h%3E%5Cn%23include%20%3Cunistd.h%3E%5Cn%23include%20%3Cfcntl.h%3E%5Cn%23include%20%3Cstdio.h%3E%5Cn%23include%20%3Cstring.h%3E%5Cn%5Cn%2F%2F%E6%96%87%E4%BB%B6%E6%8F%8F%E8%BF%B0%E7%AC%A6%5Cnint%20fd%3B%5Cnchar%20str%5B100%5D%3B%5Cn%5Cn%5Cnint%20main(void)%5Cn%7B%5Cn%20%20%20%2F%2F%E5%88%9B%E5%BB%BA%E4%B8%80%E4%B8%AA%E6%96%87%E4%BB%B6%5Cn%20%20%20fd%20%3D%20open(%5C%22test.txt%5C%22%2C%20O_RDWR%7CO_CREAT%7CO_TRUNC%2C%20S_IRWXU)%3B%5Cn%20%20%20%2F%2F%E6%96%87%E4%BB%B6%E6%8F%8F%E8%BF%B0%E7%AC%A6fd%E4%B8%BA%E9%9D%9E%E8%B4%9F%E6%95%B4%E6%95%B0%5Cn%20%20%20if(fd%20%3C%200)%7B%5Cn%20%20%20%20%20%20printf(%5C%22Fail%20to%20Open%20File%5C%5Cn%5C%22)%3B%5Cn%20%20%20%20%20%20return%200%3B%5Cn%20%20%20%7D%5Cn%20%20%20%2F%2F%E5%86%99%E5%85%A5%E5%AD%97%E7%AC%A6%E4%B8%B2pwd%5Cn%20%20%20write(fd%2C%20%5C%22pwd%5C%5Cn%5C%22%2C%20strlen(%5C%22pwd%5C%5Cn%5C%22))%3B%5Cn%5Cn%20%20%20%2F%2F%E5%86%99%E5%85%A5%E5%AD%97%E7%AC%A6%E4%B8%B2ls%5Cn%20%20%20write(fd%2C%20%5C%22ls%5C%5Cn%5C%22%2C%20strlen(%5C%22ls%5C%5Cn%5C%22))%3B%5Cn%5Cn%20%20%20%2F%2F%E6%AD%A4%E6%97%B6%E7%9A%84%E6%96%87%E4%BB%B6%E6%8C%87%E9%92%88%E4%BD%8D%E4%BA%8E%E6%96%87%E4%BB%B6%E7%9A%84%E7%BB%93%E5%B0%BE%E5%A4%84%EF%BC%8C%E4%BD%BF%E7%94%A8lseek%E5%87%BD%E6%95%B0%E4%BD%BF%E6%96%87%E4%BB%B6%E6%8C%87%E9%92%88%E5%9B%9E%E5%88%B0%E6%96%87%E4%BB%B6%E5%A4%B4%5Cn%20%20%20lseek(fd%2C%200%2C%20SEEK_SET)%3B%5Cn%5Cn%20%20%20%2F%2F%E4%BB%8E%E6%96%87%E4%BB%B6%E4%B8%AD%E8%AF%BB%E5%8F%96100%E4%B8%AA%E5%AD%97%E8%8A%82%E7%9A%84%E5%86%85%E5%AE%B9%E5%88%B0str%E4%B8%AD%EF%BC%8C%E8%AF%A5%E5%87%BD%E6%95%B0%E4%BC%9A%E8%BF%94%E5%9B%9E%E5%AE%9E%E9%99%85%E8%AF%BB%E5%88%B0%E7%9A%84%E5%AD%97%E8%8A%82%E6%95%B0%5Cn%20%20%20read(fd%2C%20str%2C%20100)%3B%5Cn%5Cn%20%20%20printf(%5C%22File%20content%3A%5C%5Cn%25s%20%5C%5Cn%5C%22%2C%20str)%3B%5Cn%5Cn%20%20%20close(fd)%3B%5Cn%5Cn%20%20%20return%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22rUbnC%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><ul list=\"ub8bea7f4\"><li fid=\"u33753b10\" data-lake-id=\"u4cb3e005\" id=\"u4cb3e005\"><span data-lake-id=\"u27735f28\" id=\"u27735f28\" class=\"lake-fontsize-12\">flags为</span><code data-lake-id=\"u27cc6d5c\" id=\"u27cc6d5c\"><span data-lake-id=\"ufff42ce7\" id=\"ufff42ce7\" class=\"lake-fontsize-12\">O_RDWR|O_CREAT|O_TRUNC</span></code><span data-lake-id=\"u8a816ab5\" id=\"u8a816ab5\" class=\"lake-fontsize-12\">表示如果文件不存在，则创建。存在则清空内容再写入。</span></li></ul>",
