  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><h2 data-lake-id=\"wv4W2\" id=\"wv4W2\" data-lake-index-type=\"2\"><span data-lake-id=\"u2607184c\" id=\"u2607184c\">单选框</span></h2><p data-lake-id=\"u0174324a\" id=\"u0174324a\"><code data-lake-id=\"u213049d7\" id=\"u213049d7\"><span data-lake-id=\"u32e737de\" id=\"u32e737de\">QRadioButton</span></code><span data-lake-id=\"uc5b19268\" id=\"uc5b19268\">是单选按钮,它提供了一组可供选择的按钮和文本标签,用户可以选择其中一个选项</span></p><p data-lake-id=\"u1fd31afe\" id=\"u1fd31afe\"><span data-lake-id=\"u4b7145e4\" id=\"u4b7145e4\">单选框选中的信号是:</span><code data-lake-id=\"u0e28dc23\" id=\"u0e28dc23\"><span data-lake-id=\"u463233e0\" id=\"u463233e0\">toggled</span></code></p><p data-lake-id=\"u59c74c0f\" id=\"u59c74c0f\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1684554887895-ab2cc232-0ac1-4724-96b1-d07612b240d8.png%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A145%2C%22originHeight%22%3A114%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23ececec%22%2C%22id%22%3A%22uVqqh%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u3c4e9587\" id=\"u3c4e9587\"><span data-lake-id=\"u75bf5a55\" id=\"u75bf5a55\">代码示例：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%E5%8D%95%E9%80%89%E6%A1%86.py%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22from%20PyQt5.QtWidgets%20import%20*%5Cnfrom%20PyQt5.QtCore%20import%20*%5Cnimport%20sys%5Cn%5Cn%5Cndef%20func(checked)%3A%5Cn%20%20%20%20'''%5Cn%20%20%20%20%E7%8A%B6%E6%80%81%E5%8F%98%E5%8C%96%E7%9A%84%E6%A7%BD%E5%87%BD%E6%95%B0%5Cn%20%20%20%20%3Aparam%20checked%3A%20%E6%98%AF%E5%90%A6%E8%A2%AB%E9%80%89%E4%B8%AD%5Cn%20%20%20%20%3Areturn%3A%5Cn%20%20%20%20'''%5Cn%20%20%20%20print('%E7%8A%B6%E6%80%81%E5%8F%98%E5%8C%96'%2C%20checked)%5Cn%5Cn%5Cn%23%201.%E5%88%9B%E5%BB%BA%E5%BA%94%E7%94%A8%E7%A8%8B%E5%BA%8F%5Cnapp%20%3D%20QApplication(sys.argv)%5Cn%5Cn%23%202.%E5%88%9B%E5%BB%BA%E7%AA%97%E5%8F%A3%5Cnw%20%3D%20QWidget()%5Cn%5Cn%23%20%E4%BF%AE%E6%94%B9%E7%AA%97%E5%8F%A3%E6%A0%87%E9%A2%98%5Cnw.setWindowTitle('%E5%8D%95%E9%80%89%E6%A1%86')%5Cn%5C%22%5C%22%5C%22------------------%20%E5%88%9B%E5%BB%BA%E5%B8%83%E5%B1%80%20------------------%5C%22%5C%22%5C%22%5Cnlayout%20%3D%20QHBoxLayout()%5Cn%23%20%E6%B7%BB%E5%8A%A0%E5%B8%83%E5%B1%80%E5%88%B0%E7%AA%97%E5%8F%A3%E4%B8%AD%5Cnw.setLayout(layout)%5Cn%23%20%E5%88%9B%E5%BB%BA%E4%B8%A4%E4%B8%AA%E5%8D%95%E9%80%89%E6%A1%86%5Cnrb1%20%3D%20QRadioButton('%E7%94%B7')%5Cnrb2%20%3D%20QRadioButton('%E5%A5%B3')%5Cnrb1.setChecked(True)%5Cn%23%20%E6%B7%BB%E5%8A%A0%E5%88%B0%E5%B8%83%E5%B1%80%E4%B8%AD%5Cnlayout.addWidget(rb1)%5Cnlayout.addWidget(rb2)%5Cn%5Cn%23%20%E7%BB%91%E5%AE%9A%E4%BF%A1%E5%8F%B7%E5%92%8C%E6%A7%BD%5Cnrb1.toggled.connect(func)%5Cn%5Cn%23%203.%E6%98%BE%E7%A4%BA%E7%AA%97%E5%8F%A3%5Cnw.show()%5Cn%5Cn%23%204.%E7%AD%89%E5%BE%85%E7%AA%97%E5%8F%A3%E5%81%9C%E6%AD%A2%5Cnsys.exit(app.exec())%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Atrue%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%E5%8D%95%E9%80%89%E6%A1%86.py%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22NDn6G%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u89fc54ca\" id=\"u89fc54ca\"><span data-lake-id=\"u219481df\" id=\"u219481df\">如果想给</span><code data-lake-id=\"u3539d9da\" id=\"u3539d9da\"><span data-lake-id=\"uaa27ecff\" id=\"uaa27ecff\">QRadioButton</span></code><span data-lake-id=\"u86457123\" id=\"u86457123\">组设置监听事件，可按照如下代码添加：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22%23%20%E5%A3%B0%E6%98%8E%E6%A7%BD%E5%87%BD%E6%95%B0%5Cndef%20on_group_toggle(btn%3A%20QRadioButton)%3A%5Cn%20%20%20%20print(btn%2C%20btn.isChecked())%5Cn%5Cn%23%20%E6%B7%BB%E5%8A%A0%E4%B8%A4%E4%B8%AA%E5%8D%95%E9%80%89%E9%92%AE%E5%88%B0QButtonGroup%EF%BC%8C%E5%B9%B6%E6%B7%BB%E5%8A%A0%E9%80%89%E4%B8%AD%E4%BA%8B%E4%BB%B6%5Cngroup%20%3D%20QButtonGroup(w)%5Cngroup.addButton(btn1)%5Cngroup.addButton(btn2)%5Cngroup.buttonToggled.connect(on_group_toggle)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22oSbOP%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ufb39b08a\" id=\"ufb39b08a\"><span data-lake-id=\"u997b6778\" id=\"u997b6778\">​</span><br></p><h2 data-lake-id=\"aYOgj\" id=\"aYOgj\"><span data-lake-id=\"u222f1b20\" id=\"u222f1b20\">2. 复选框</span></h2><p data-lake-id=\"ua75d1ed4\" id=\"ua75d1ed4\"><code data-lake-id=\"uec055a47\" id=\"uec055a47\"><span data-lake-id=\"u06834c13\" id=\"u06834c13\">QCheckBox</span></code><span data-lake-id=\"u27c2b6aa\" id=\"u27c2b6aa\">提供了一组带文本标签的复选框,用户可以选择多个选项</span></p><p data-lake-id=\"u40b75bf4\" id=\"u40b75bf4\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1685240099030-dded9f97-6669-4334-ad29-84b7211cf58b.png%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A303%2C%22originHeight%22%3A84%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23e8e7e7%22%2C%22id%22%3A%22DSTZ1%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"uf6631e6c\" id=\"uf6631e6c\"><span data-lake-id=\"udd8d9d24\" id=\"udd8d9d24\">复选框的状态变化信号是</span><code data-lake-id=\"u4318559d\" id=\"u4318559d\"><span data-lake-id=\"ubaf99098\" id=\"ubaf99098\">stateChanged</span></code></p><p data-lake-id=\"u6f2277b2\" id=\"u6f2277b2\"><span data-lake-id=\"u59dc89ca\" id=\"u59dc89ca\">代码示例：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%E5%A4%8D%E9%80%89%E6%A1%86.py%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22from%20PyQt5.QtWidgets%20import%20*%5Cnfrom%20PyQt5.QtCore%20import%20*%5Cnfrom%20PyQt5.QtGui%20import%20*%5Cnimport%20sys%5Cn%5Cn%5Cndef%20func(state)%3A%5Cn%20%20%20%20%23%20%E5%88%A4%E6%96%AD%E6%98%AF%E5%90%A6%E9%80%89%E4%B8%AD%5Cn%20%20%20%20if%20state%20%3D%3D%20Qt.Checked%3A%20%23%202%5Cn%20%20%20%20%20%20%20%20print('%E9%80%89%E4%B8%AD')%5Cn%20%20%20%20else%3A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%23%200%5Cn%20%20%20%20%20%20%20%20print('%E6%9C%AA%E9%80%89%E4%B8%AD')%5Cn%5Cn%5Cn%23%201.%E5%88%9B%E5%BB%BA%E5%BA%94%E7%94%A8%E7%A8%8B%E5%BA%8F%5Cnapp%20%3D%20QApplication(sys.argv)%5Cn%5Cn%23%202.%E5%88%9B%E5%BB%BA%E7%AA%97%E5%8F%A3%5Cnw%20%3D%20QWidget()%5Cn%5Cn%23%20%E4%BF%AE%E6%94%B9%E7%AA%97%E5%8F%A3%E6%A0%87%E9%A2%98%5Cnw.setWindowTitle('%E5%A4%8D%E9%80%89%E6%A1%86')%5Cn%5C%22%5C%22%5C%22------------------%20%E7%AA%97%E5%8F%A3%E5%B8%83%E5%B1%80%20------------------%5C%22%5C%22%5C%22%5Cnlayout%20%3D%20QHBoxLayout()%5Cn%23%20%E6%B7%BB%E5%8A%A0%E5%88%B0%E7%AA%97%E5%8F%A3%E4%B8%AD%5Cnw.setLayout(layout)%5Cn%5Cn%23%20%E6%8E%A7%E4%BB%B6%5Cnlabel%20%3D%20QLabel()%5Cnlabel.setText('%E8%B0%A6%E5%93%A5%E7%9A%84%E7%88%B1%E5%A5%BD%3A')%5Cnck1%20%3D%20QCheckBox('%E6%8A%BD%E7%83%9F')%5Cnck2%20%3D%20QCheckBox('%E5%96%9D%E9%85%92')%5Cnck3%20%3D%20QCheckBox('%E7%83%AB%E5%A4%B4')%5Cn%5Cn%23%20%E9%80%89%E4%B8%AD%E7%AC%AC%E4%B8%80%E4%B8%AA%5Cnck1.setChecked(True)%5Cn%5Cn%23%20%E6%B7%BB%E5%8A%A0%E6%8E%A7%E4%BB%B6%E5%88%B0%E5%B8%83%E5%B1%80%E4%B8%AD%5Cnlayout.addWidget(label)%5Cnlayout.addWidget(ck1)%5Cnlayout.addWidget(ck2)%5Cnlayout.addWidget(ck3)%5Cn%5Cn%23%20%E7%BB%91%E5%AE%9A%E4%BF%A1%E5%8F%B7%E5%92%8C%E6%A7%BD%5Cnck1.stateChanged.connect(func)%5Cn%5Cn%23%203.%E6%98%BE%E7%A4%BA%E7%AA%97%E5%8F%A3%5Cnw.show()%5Cn%5Cn%23%204.%E7%AD%89%E5%BE%85%E7%AA%97%E5%8F%A3%E5%81%9C%E6%AD%A2%5Cnsys.exit(app.exec())%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%E5%A4%8D%E9%80%89%E6%A1%86.py%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22vGXlJ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>",
