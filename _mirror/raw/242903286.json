u7f1fe402\"><span data-lake-id=\"u6892a183\" id=\"u6892a183\" style=\"color: rgb(25, 27, 31)\">什么是</span><span data-lake-id=\"uc6f6dd9a\" id=\"uc6f6dd9a\" style=\"color: rgb(9, 64, 142)\">交叉编译</span></li><li fid=\"u5c49aa19\" data-lake-id=\"uaa09cff9\" id=\"uaa09cff9\"><span data-lake-id=\"u31160775\" id=\"u31160775\" style=\"color: rgb(25, 27, 31)\">如何保证makefile的增量编译</span></li><li fid=\"u5c49aa19\" data-lake-id=\"u82e3b70a\" id=\"u82e3b70a\"><span data-lake-id=\"udfd8ec53\" id=\"udfd8ec53\" style=\"color: rgb(25, 27, 31)\">如何用一套代码支持不同硬件</span></li><li fid=\"u5c49aa19\" data-lake-id=\"u9730d939\" id=\"u9730d939\"><strong><span data-lake-id=\"uef3065e3\" id=\"uef3065e3\" style=\"color: rgb(25, 27, 31)\">如何用一版软件支持不同硬件</span></strong></li><li fid=\"u5c49aa19\" data-lake-id=\"u26725478\" id=\"u26725478\"><span data-lake-id=\"ua8ce1fe1\" id=\"ua8ce1fe1\" style=\"color: rgb(25, 27, 31)\">不同代码编译后的存放区域有何不同</span></li><li fid=\"u5c49aa19\" data-lake-id=\"u996d7e71\" id=\"u996d7e71\"><span data-lake-id=\"u2cfaee9b\" id=\"u2cfaee9b\" style=\"color: rgb(25, 27, 31)\">release和debug编译的区别</span></li><li fid=\"u5c49aa19\" data-lake-id=\"u21901955\" id=\"u21901955\"><span data-lake-id=\"u195c91a3\" id=\"u195c91a3\" style=\"color: rgb(25, 27, 31)\">ARM多核之间有多少通讯机制及优缺点</span></li><li fid=\"u5c49aa19\" data-lake-id=\"u7f8f9c81\" id=\"u7f8f9c81\"><span data-lake-id=\"u200f527f\" id=\"u200f527f\" style=\"color: rgb(25, 27, 31)\">两个线程之间不同锁的区别是什么</span></li><li fid=\"u5c49aa19\" data-lake-id=\"u5d154616\" id=\"u5d154616\"><strong><span data-lake-id=\"ud4eb6ef2\" id=\"ud4eb6ef2\" style=\"color: rgb(25, 27, 31)\">如何理解收益边界</span></strong></li><li fid=\"u5c49aa19\" data-lake-id=\"ufec4e69e\" id=\"ufec4e69e\"><strong><span data-lake-id=\"uadd3214f\" id=\"uadd3214f\" style=\"color: rgb(25, 27, 31)\">介绍一下自己关于代码优化的经验</span></strong></li><li fid=\"u5c49aa19\" data-lake-id=\"ub1cace33\" id=\"ub1cace33\"><strong><span data-lake-id=\"u1b23e7ff\" id=\"u1b23e7ff\" style=\"color: rgb(25, 27, 31)\">关于代码移植