%E8%A6%81%E5%88%A0%E9%99%A4%E5%A5%BD%E6%9C%8B%E5%8F%8B%E5%90%97%3F'%2C%20%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20QMessageBox.Ok%20%7C%20QMessageBox.Cancel%2C%20%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20QMessageBox.Cancel)%5Cn%20%20%20%20if%20result%20%3D%3D%20QMessageBox.Ok%3A%5Cn%20%20%20%20%20%20%20%20print('%E7%A1%AE%E8%AE%A4%E5%88%A0%E9%99%A4')%5Cn%20%20%20%20elif%20result%20%3D%3D%20QMessageBox.Cancel%3A%5Cn%20%20%20%20%20%20%20%20print('%E5%8F%96%E6%B6%88%E5%88%A0%E9%99%A4')%5Cn%5Cn%5Cn%23%201.%E5%88%9B%E5%BB%BA%E5%BA%94%E7%94%A8%E7%A8%8B%E5%BA%8F%5Cnapp%20%3D%20QApplication(sys.argv)%5Cn%5Cn%23%202.%E5%88%9B%E5%BB%BA%E7%AA%97%E5%8F%A3%5Cnw%20%3D%20QWidget()%5Cn%5Cn%23%20%E4%BF%AE%E6%94%B9%E7%AA%97%E5%8F%A3%E6%A0%87%E9%A2%98%5Cnw.setWindowTitle('%E5%AF%B9%E8%AF%9D%E6%A1%86')%5Cn%5C%22%5C%22%5C%22------------------%20%E5%88%9B%E5%BB%BA%E6%8C%89%E9%92%AE%20------------------%5C%22%5C%22%5C%22%5Cnbtn%20%3D%20QPushButton('%E5%88%A0%E9%99%A4%E7%94%A8%E6%88%B7')%5Cn%23%20%E6%98%BE%E7%A4%BA%E6%8E%A7%E4%BB%B6%5Cnbtn.setParent(w)%5Cn%5Cn%23%20%E4%BF%A1%E5%8F%B7%E5%92%8C%E6%A7%BD%E7%BB%91%E5%AE%9A%5Cnbtn.clicked.connect(deleteUser)%5Cn%5Cn%23%203.%E6%98%BE%E7%A4%BA%E7%AA%97%E5%8F%A3%5Cnw.show()%5Cn%5Cn%23%204.%E7%AD%89%E5%BE%85%E7%AA%97%E5%8F%A3%E5%81%9C%E6%AD%A2%5Cnsys.exit(app.exec())%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ibP1P%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u914fa8ea\" id=\"u914fa8ea\"><br></p><h2 data-lake-id=\"fiHLp\" id=\"fiHLp\"><span data-lake-id=\"u3d9a40fe\" id=\"u3d9a40fe\">2. QIputDialog</span></h2><p data-lake-id=\"ude882517\" id=\"ude882517\"><span data-lake-id=\"ua519238a\" id=\"ua519238a\">QIputDialog是输入对话框，由一个文本框和两个按钮(OK按钮和Cancel按钮)组成</span></p><p data-lake-id=\"u64248115\" id=\"u64248115\"><span data-lake-id=\"ub774a41c\" id=\"ub774a41c\">​</span><br></p><p data-lake-id=\"u8933a53d\" id=\"u8933a53d\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1685239718780-d53909ea-ff45-4b18-afaf-b885efa4d331.png%22%2C%22taskId%22%3A%22u3e818903-0d5c-432d-b470-54fcf4479f8%22%2C%22clientId%22%3A%22ucea2ce82-e5c5-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A385.6%2C%22height%22%3A223%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A7693%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A482%2C%22originHeight%22%3A279%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22search%22%3A%22%E8%BE%93%E5%85%A5%E6%8F%90%E7%A4%BA%E6%A1%86%20%E6%8F%90%E7%A4%BA%20%E8%AF%B7%E8%BE%93%E5%85%A5%E8%A7%92%E8%89%B2%E5%90%8D%E7%A7%B0%20%E5%8C%BF%E5%90%8D%20AAA%20OK%20CANCE1%20%E5%88%9B%E5%BB%BA%E8%A7%92%E8%89%B2%22%2C%22ocrLocations%22%3A%5B%7B%22x%22%3A35%2C%22y%22%3A11%2C%22width%22%3A77%2C%22height%22%3A16%2C%22text%22%3A%22%E8%BE%93%E5%85%A5%E6%8F%90%E7%A4%BA%E6%A1%86%22%7D%2C%7B%22x%22%3A164%2C%22y%22%3A79%2C%22width%22%3A33%2C%22height%22%3A15%2C%22text%22%3A%22%E6%8F%90%E7%A4%BA%22%7D%2C%7B%22x%22%3A145%2C%22y%22%3A117%2C%22width%22%3A107%2C%22height%22%3A17%2C%22text%22%3A%22%E8%AF%B7%E8%BE%93%E5%85%A5%E8%A7%92%E8%89%B2%E5%90%8D%E7%A7%B0%22%7D%2C%7B%22x%22%3A14%2C%22y%22%3A133%2C%22width%22%3A30%2C%22height%22%3A15%2C%22text%22%3A%22%E5%8C%BF%E5%90%8D%22%7D%2C%7B%22x%22%3A147%2C%22y%22%3A148%2C%22width%22%3A26%2C%22height%22%3A11%2C%22text%22%3A%22AAA%22%7D%2C%7B%22x%22%3A181%2C%22y%22%3A179%2C%22width%22%3A17%2C%22height%22%3A13%2C%22text%22%3A%22OK%22%7D%2C%7B%22x%22%3A265%2C%22y%22%3A180%2C%22width%22%3A48%2C%22height%22%3A12%2C%22text%22%3A%22CANCE1%22%7D%2C%7B%22x%22%3A211%2C%22y%22%3A243%2C%22width%22%3A60%2C%22height%22%3A16%2C%22text%22%3A%22%E5%88%9B%E5%BB%BA%E8%A7%92%E8%89%B2%22%7D%5D%2C%22showTitle%22%3Atrue%2C%22title%22%3A%22%E8%BF%90%E8%A1%8C%E7%A8%8B%E5%BA%8F%EF%BC%8C%E7%82%B9%E5%87%BB%E5%88%9B%E5%BB%BA%E8%A7%92%E8%89%B2%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23ebebeb%22%2C%22id%22%3A%22BDxDE%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u85615911\" id=\"u85615911\"><span data-lake-id=\"uc0ea3254\" id=\"uc0ea3254\">代码示例：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22from%20PyQt5.QtWidgets%20import%20*%5Cnfrom%20PyQt5.QtCore%20import%20*%5Cnfrom%20PyQt5.QtGui%20import%20QIcon%5Cnimport%20sys%5Cn%5Cndef%20func()%3A%5Cn%20%20%20%20str%2Csuccess%20%3D%20QInputDialog.getText(w%2C'%E6%8F%90%E7%A4%BA'%2C'%E8%AF%B7%E8%BE%93%E5%85%A5%E8%A7%92%E8%89%B2%E5%90%8D%E7%A7%B0')%5Cn%20%20%20%20if%20success%3A%5Cn%20%20%20%20%20%20%20%20edit.setText(str)%5Cn%5Cn%5Cn%23%201.%E5%88%9B%E5%BB%BA%E5%BA%94%E7%94%A8%E7%A8%8B%E5%BA%8F%5Cnapp%20%3D%20QApplication(sys.argv)%5Cn%5Cn%23%202.%E5%88%9B%E5%BB%BA%E7%AA%97%E5%8F%A3%5Cnw%20%3D%20QWidget()%5Cn%5Cn%5Cn%23%20%E4%BF%AE%E6%94%B9%E7%AA%97%E5%8F%A3%E6%A0%87%E9%A2%98%5Cnw.setWindowTitle('%E8%BE%93%E5%85%A5%E6%8F%90%E7%A4%BA%E6%A1%86')%5Cn%5C%22%5C%22%5C%22------------------%20%E5%88%9B%E5%BB%BA%E7%95%8C%E9%9D%A2%20------------------%5C%22%5C%22%5C%22%5Cnlayout%20%3D%20QHBoxLayout()%5Cn%23%20%E6%B7%BB%E5%8A%A0%E5%B8%83%E5%B1%80%5Cnw.setLayout(layout)%5Cn%5Cn%23%20%E6%8E%A7%E4%BB%B6%5Cnbtn%20%3D%20QPushButton('%E5%88%9B%E5%BB%BA%E8%A7%92%E8%89%B2')%5Cnedit%20%3D%20QLineEdit()%5Cn%23%20%E6%8E%A7%E4%BB%B6%E6%B7%BB%E5%8A%A0%E5%88%B0%E5%B8%83%E5%B1%80%E4%B8%AD%5Cnlayout.addWidget(btn)%5Cnlayout.addWidget(edit)%5Cn%5Cn%23%20%E4%BF%A1%E5%