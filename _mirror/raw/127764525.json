  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><meta name=\"paragraphSpacing\" content=\"relax\" /><h1 data-lake-id=\"Ad3XL\" id=\"Ad3XL\"><span data-lake-id=\"u3ce620d6\" id=\"u3ce620d6\">返回栈区地址</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%5Cnint%20*func()%20%7B%5Cn%20%20%20%20int%20a%20%3D%2010%3B%5Cn%20%20%20%20return%20%26a%3B%20%2F%2F%20%E5%87%BD%E6%95%B0%E8%B0%83%E7%94%A8%E5%AE%8C%E6%AF%95%EF%BC%8C%E5%9B%A0%E4%B8%BAa%E6%98%AF%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%EF%BC%8Ca%E9%87%8A%E6%94%BE%5Cn%7D%5Cn%5Cnint%20main()%20%7B%5Cn%20%20%20%20int%20*p%20%3D%20NULL%3B%5Cn%20%20%20%20p%20%3D%20func()%3B%5Cn%20%20%20%20*p%20%3D%20100%3B%20%2F%2F%20%E6%93%8D%E4%BD%9C%E9%87%8E%E6%8C%87%E9%92%88%E6%8C%87%E5%90%91%E7%9A%84%E5%86%85%E5%AD%98%2Cerr%5Cn%20%20%20%20printf(%5C%2211111111111111111%5C%5Cn%5C%22)%3B%20%2F%2F%20%E8%BF%99%E5%8F%A5%E8%AF%9D%E5%8F%AF%E8%83%BD%E6%89%A7%E8%A1%8C%E4%B8%8D%E5%88%B0%EF%BC%8C%E5%9B%A0%E4%B8%BA%E4%B8%8A%E4%B8%80%E5%8F%A5%E8%AF%9D%E6%8A%A5%E9%94%99%5Cn%5Cn%20%20%20%20return%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22xyHiD%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u62109f91\" id=\"u62109f91\"><br></p><h1 data-lake-id=\"MGB6k\" id=\"MGB6k\"><span data-lake-id=\"u42064efe\" id=\"u42064efe\">返回data区地址</span></h1><ul list=\"u729164f5\"><li fid=\"u3c8f2994\" data-lake-id=\"uc8100a59\" id=\"uc8100a59\"><span data-lake-id=\"u65953cff\" id=\"u65953cff\">在函数内部使用static修饰的变量称为静态局部变量</span></li><li fid=\"u3c8f2994\" data-lake-id=\"u32935104\" id=\"u32935104\"><span data-lake-id=\"u11dd5554\" id=\"u11dd5554\">它在程序运行期间只被初始化一次，并且在函数调用结束后也不会被销毁</span></li></ul><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%5Cnint%20*func()%20%7B%5Cn%20%20%20%20%2F%2F%20%E9%9D%99%E6%80%81%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%EF%BC%8C%E5%8F%AA%E4%BC%9A%E5%88%9D%E5%A7%8B%E5%8C%96%E4%B8%80%E6%AC%A1%5Cn%20%20%20%20static%20int%20a%20%3D%2010%3B%5Cn%20%20%20%20return%20%26a%3B%20%2F%2F%20%E5%87%BD%E6%95%B0%E8%B0%83%E7%94%A8%E5%AE%8C%E6%AF%95%EF%BC%8Ca%E4%B8%8D%E9%87%8A%E6%94%BE%5Cn%7D%5Cn%5Cnint%20main()%20%7B%5Cn%20%20%20%20int%20*p%20%3D%20NULL%3B%5Cn%20%20%20%20p%20%3D%20func()%3B%5Cn%20%20%20%20*p%20%3D%20100%3B%20%2F%2F%20ok%5Cn%20%20%20%20printf(%5C%22*p%20%3D%20%25d%5C%5Cn%5C%22%2C%20*p)%3B%5Cn%5Cn%20%20%20%20return%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22__spacing%22%3A%22both%22%2C%22fontSize%22%3A14%2C%22id%22%3A%22iop7q%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u1ff05797\" id=\"u1ff05797\"><br></p><ul list=\"u6e2e52a7\"><li fid=\"uac5bde72\" data-lake-id=\"ua360e5d4\" id=\"ua360e5d4\"><span data-lake-id=\"ud8c8f97d\" id=\"ud8c8f97d\">普通局部变量和静态局部变量区别</span></li></ul><ul list=\"u6e2e52a7\" data-lake-indent=\"1\"><li fid=\"uac5bde72\" data-lake-id=\"u8d8b6dcd\" id=\"u8d8b6dcd\"><span data-lake-id=\"ue046c4d7\" id=\"ue046c4d7\">存储位置：</span></li></ul><ul list=\"u6e2e52a7\" data-lake-indent=\"2\"><li fid=\"uac5bde72\" data-lake-id=\"u656f9dbf\" id=\"u656f9dbf\"><span data-lake-id=\"u914458de\" id=\"u914458de\">普通局部变量存储在栈上</span></li><li fid=\"uac5bde72\" data-lake-id=\"ua7a4dc29\" id=\"ua7a4dc29\"><span data-lake-id=\"u24d17d0b\" id=\"u24d17d0b\">静态局部变量存储在静态存储区</span></li></ul><ul list=\"u6e2e52a7\" start=\"2\" data-lake-indent=\"1\"><li fid=\"uac5bde72\" data-lake-id=\"u05160ba4\" id=\"u05160ba4\"><span data-lake-id=\"u84b4a66c\" id=\"u84b4a66c\">生命周期：</span></li></ul><ul list=\"u6e2e52a7\" data-lake-indent=\"2\"><li fid=\"uac5bde72\" data-lake-id=\"ube49e3bc\" id=\"ube49e3bc\"><span data-lake-id=\"ud010ec8a\" id=\"ud010ec8a\">当函数执行完毕时，普通局部变量会被销毁</span></li><li fid=\"uac5bde72\" data-lake-id=\"u65bd1198\" id=\"u65bd1198\"><span data-lake-id=\"u40c5b54a\" id=\"u40c5b54a\">静态局部变量的生命周期则是整个程序运行期间，即使函数调用结束，静态局部变量的值也会被保留</span></li></ul><ul list=\"u30a357cd\" data-lake-indent=\"1\"><li fid=\"u4d958aba\" data-lake-id=\"u47c27773\" id=\"u47c27773\"><span data-lake-id=\"u2df48e17\" id=\"u2df48e17\">初始值：</span></li></ul><ul list=\"u30a357cd\" data-lake-indent=\"2\"><li fid=\"u4d958aba\" data-lake-id=\"u824cf375\" id=\"u824cf375\"><span data-lake-id=\"u315f6547\" id=\"u315f6547\">普通局部变量在每次函数调用时都会被初始化，它们的初始值是不确定的，除非显式地进行初始化</span></li><li fid=\"u4d958aba\" data-lake-id=\"u67de9b72\" id=\"u67de9b72\"><span data-lake-id=\"u9894a23f\" id=\"u9894a23f\">静态局部变量在第一次函数调用时会被初始化，然后保持其值不变，直到程序结束</span></li></ul><p data-lake-id=\"ued523c09\" id=\"ued523c09\"><span data-lake-id=\"u446e3e6e\" id=\"u446e3e6e\">示例代码：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%5Cnvoid%20normal_func()%20%7B%5Cn%20%20%20%20int%20i%20%3D%200%3B%5Cn%20%20%20%20i%2B%2B%3B%5Cn%20%20%20%20printf(%5C%22%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%20i%20%3D%20%25d%5C%5Cn%5C%22%2C%20i)%3B%5Cn%7D%5Cn%5Cnvoid%20static_func()%20%7B%5Cn%20%20%20%20static%20int%20j%20%3D%200%3B%5Cn%20%20%20%20j%2B%2B%3B%5Cn%20%20%20%20printf(%5C%22static%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%20j%20%3D%20%25d%5C%5Cn%5C%22%2C%20j)%3B%5Cn%7D%5Cn%5Cnint%20main()%20%7B%5Cn%20%20%20%20%2F%2F%20%E8%B0%83%E7%94%A83%E6%AC%A1normal_func()%5Cn%20%20%20%20normal_func()%3B%5Cn%20%20%20%20normal_func()%3B%5Cn%20%20%20%20normal_func()%3B%5Cn%5Cn%20%20%20%20%2F%2F%20%E8%B0%83%E7%94%A83%E6%AC%A1static_func()%5Cn%20%20%20%20static_func()%3B%5Cn%20%20%20%20static_func()%3B%5Cn%20%20%20%20static_func()%3B%5Cn%5Cn%20%20%20%20return%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22__spacing%22%3A%22both%22%2C%22fontSize%22%3A14%2C%22id%22%3A%22f4fZm%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u61a45835\" id=\"u61a45835\"><span data-lake-id=\"u5c9af509\" id=\"u5c9af509\">运行结果：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%20i%20%3D%201%5Cn%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%20i%20%3D%201%5Cn%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%20i%20%3D%201%5Cnstatic%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%20j%20%3D%201%5Cnstatic%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%20j%20%3D%202%5Cnstatic%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%20j%20%3D%203%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22__spacing%22%3A%22both%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22id%22%3A%22M79Fl%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uefe27d97\" id=\"uefe27d97\"><br></p><h1 data-lake-id=\"aEfrV\" id=\"aEfrV\"><span data-lake-id=\"u73c6190b\" id=\"u73c6190b\">返回堆区地址</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%23include%20%3Cstdlib.h%3E%5Cn%5Cnint%20*func()%20%7B%5Cn%20%20%20%20int%20*tmp%20%3D%20NULL%3B%5Cn%20%20%20%20%2F%2F%20%E5%A0%86%E5%8C%BA%E7%94%B3%E8%AF%B7%E7%A9%BA%E9%97%B4%5Cn%20%20%20%20tmp%20%3D%20(int%20*)malloc(sizeof(int))%3B%5Cn%20%20%20%20*tmp%20%3D%20100%3B%5Cn%20%20%20%20return%20tmp%3B%20%2F%2F%20%E8%BF%94%E5%9B%9E%E5%A0%86%E5%8C%BA%E5%9C%B0%E5%9D%80%EF%BC%8C%E5%87%BD%E6%95%B0%E8%B0%83%E7%94%A8%E5%AE%8C%E6%AF%95%EF%BC%8C%E4%B8%8D%E9%87%8A%E6%94%BE%5Cn%7D%5Cn%5Cnint%20main()%20%7B%5Cn%20%20%20%20int%20*p%20%3D%20NULL%3B%5Cn%20%20%20%20p%20%3D%20func()%3B%5Cn%20%20%20%20printf(%5C%22*p%20%3D%20%25d%5C%5Cn%5C%22%2C%20*p)%3B%20%2F%2F%20ok%5Cn%5Cn%20%20%20%20%2F%2F%20%E5%A0%86%E5%8C%BA%E7%A9%BA%E9%97%B4%EF%BC%8C%E4%BD%BF%E7%94%A8%E5%AE%8C%E6%AF%95%EF%BC%8C%E6%89%8B%E5%8A%A8%E9%87%8A%E6%94%BE%5Cn%20%20%20%20if%20(p%20!%3D%20NULL)%20%7B%5Cn%20%20%20%20%20%20%20%20free(p)%3B%5Cn%20%20%20%20%20%20%20%20p%20%3D%20NULL%3B%5Cn%20%20%20%20%7D%5Cn%5Cn%20%20%20%20return%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22__spacing%22%3A%22both%22%2C%22fontSize%22%3A14%2C%22id%22%3A%22cKMz4%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>",
