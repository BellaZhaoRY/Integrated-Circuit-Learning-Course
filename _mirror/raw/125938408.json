  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h3 data-lake-id=\"dQVcJ\" id=\"dQVcJ\" data-lake-index-type=\"2\"><span data-lake-id=\"u7ee54130\" id=\"u7ee54130\" style=\"color: rgba(0, 0, 0, 0.87)\">带有参数的任务线程</span></h3><p data-lake-id=\"u121d992b\" id=\"u121d992b\"><span data-lake-id=\"u7064e6a1\" id=\"u7064e6a1\" style=\"color: rgba(0, 0, 0, 0.87)\">前面我们使用线程执行的任务是没有参数的，假如我们使用线程执行的任务带有参数，如何给函数传参呢?</span></p><p data-lake-id=\"u7588ac86\" id=\"u7588ac86\"><span data-lake-id=\"u61f80a67\" id=\"u61f80a67\" style=\"color: rgba(0, 0, 0, 0.87)\">​</span><br></p><p data-lake-id=\"u92a735b3\" id=\"u92a735b3\"><span data-lake-id=\"u3090e6f3\" id=\"u3090e6f3\" style=\"color: rgba(0, 0, 0, 0.87)\">Thread类执行任务并给任务传参数有两种方式:</span></p><ul list=\"u7dc82ce1\"><li fid=\"udeec0dd4\" data-lake-id=\"ucd40dcdd\" id=\"ucd40dcdd\"><code data-lake-id=\"u5ae6ad72\" id=\"u5ae6ad72\"><span data-lake-id=\"ub1fa6a54\" id=\"ub1fa6a54\" style=\"color: rgba(0, 0, 0, 0.87)\">args</span></code><span data-lake-id=\"ude5c8383\" id=\"ude5c8383\" style=\"color: rgba(0, 0, 0, 0.87)\"> 表示以元组的方式给执行任务传参</span></li><li fid=\"udeec0dd4\" data-lake-id=\"u0844ac7c\" id=\"u0844ac7c\"><code data-lake-id=\"ub0a5705a\" id=\"ub0a5705a\"><span data-lake-id=\"uf127514c\" id=\"uf127514c\" style=\"color: rgba(0, 0, 0, 0.87)\">kwargs </span></code><span data-lake-id=\"ud85bc524\" id=\"ud85bc524\" style=\"color: rgba(0, 0, 0, 0.87)\">表示以字典方式给执行任务传参</span></li></ul><h3 data-lake-id=\"BBrA4\" id=\"BBrA4\" data-lake-index-type=\"2\"><span data-lake-id=\"u938164eb\" id=\"u938164eb\" style=\"color: rgba(0, 0, 0, 0.87)\">args元组参数</span></h3><p data-lake-id=\"ud7839bbc\" id=\"ud7839bbc\"><br></p><p data-lake-id=\"u287436fa\" id=\"u287436fa\"><strong><span data-lake-id=\"u180839f5\" id=\"u180839f5\" style=\"color: rgba(0, 0, 0, 0.87)\">示例代码:</span></strong></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20threading%5Cnimport%20time%5Cn%5Cn%5Cn%23%20%E5%B8%A6%E6%9C%89%E5%8F%82%E6%95%B0%E7%9A%84%E4%BB%BB%E5%8A%A1%5Cndef%20task(count)%3A%5Cn%20%20%20%20for%20i%20in%20range(count)%3A%5Cn%20%20%20%20%20%20%20%20print(%5C%22%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E4%B8%AD..%5C%22)%5Cn%20%20%20%20%20%20%20%20time.sleep(0.2)%5Cn%20%20%20%20else%3A%5Cn%20%20%20%20%20%20%20%20print(%5C%22%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E5%AE%8C%E6%88%90%5C%22)%5Cn%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20%23%20%E5%88%9B%E5%BB%BA%E5%AD%90%E7%BA%BF%E7%A8%8B%5Cn%20%20%20%20%23%20args%3A%20%E4%BB%A5%E5%85%83%E7%BB%84%E7%9A%84%E6%96%B9%E5%BC%8F%E7%BB%99%E4%BB%BB%E5%8A%A1%E4%BC%A0%E5%85%A5%E5%8F%82%E6%95%B0%5Cn%20%20%20%20sub_thread%20%3D%20threading.Thread(target%3Dtask%2C%20args%3D(5%2C))%5Cn%20%20%20%20sub_thread.start()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22lGOAi%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ud8956f36\" id=\"ud8956f36\"><br></p><p data-lake-id=\"u6b54846e\" id=\"u6b54846e\"><strong><span data-lake-id=\"u2f69e1a9\" id=\"u2f69e1a9\" style=\"color: rgba(0, 0, 0, 0.87)\">执行结果:</span></strong></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E4%B8%AD..%5Cn%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E4%B8%AD..%5Cn%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E4%B8%AD..%5Cn%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E4%B8%AD..%5Cn%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E4%B8%AD..%5Cn%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E5%AE%8C%E6%88%90%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22YVz3D%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h3 data-lake-id=\"YwMBr\" id=\"YwMBr\" data-lake-index-type=\"2\"><span data-lake-id=\"u93c4280d\" id=\"u93c4280d\" style=\"color: rgba(0, 0, 0, 0.87)\">kwargs字典参数</span></h3><p data-lake-id=\"u452b99f1\" id=\"u452b99f1\"><strong><span data-lake-id=\"u3dc0df52\" id=\"u3dc0df52\" style=\"color: rgba(0, 0, 0, 0.87)\">示例代码:</span></strong></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20threading%5Cnimport%20time%5Cn%5Cn%5Cn%23%20%E5%B8%A6%E6%9C%89%E5%8F%82%E6%95%B0%E7%9A%84%E4%BB%BB%E5%8A%A1%5Cndef%20task(count)%3A%5Cn%20%20%20%20for%20i%20in%20range(count)%3A%5Cn%20%20%20%20%20%20%20%20print(%5C%22%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E4%B8%AD..%5C%22)%5Cn%20%20%20%20%20%20%20%20time.sleep(0.2)%5Cn%20%20%20%20else%3A%5Cn%20%20%20%20%20%20%20%20print(%5C%22%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E5%AE%8C%E6%88%90%5C%22)%5Cn%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20%23%20%E5%88%9B%E5%BB%BA%E5%AD%90%E7%BA%BF%E7%A8%8B%5Cn%20%20%20%20%23%20kwargs%3A%20%E8%A1%A8%E7%A4%BA%E4%BB%A5%E5%AD%97%E5%85%B8%E6%96%B9%E5%BC%8F%E4%BC%A0%E5%85%A5%E5%8F%82%E6%95%B0%5Cn%20%20%20%20sub_thread%20%3D%20threading.Thread(target%3Dtask%2C%20kwargs%3D%7B%5C%22count%5C%22%3A%203%7D)%5Cn%20%20%20%20sub_thread.start()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Ebiqx%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u04f3fec2\" id=\"u04f3fec2\"><strong><span data-lake-id=\"u8cdf0d15\" id=\"u8cdf0d15\" style=\"color: rgba(0, 0, 0, 0.87)\">执行结果:</span></strong></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E4%B8%AD..%5Cn%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E4%B8%AD..%5Cn%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E4%B8%AD..%5Cn%E4%BB%BB%E5%8A%A1%E6%89%A7%E8%A1%8C%E5%AE%8C%E6%88%90%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22SE78C%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h3 data-lake-id=\"FkNcv\" id=\"FkNcv\" data-lake-index-type=\"2\"><span data-lake-id=\"u5983daee\" id=\"u5983daee\" style=\"color: rgba(0, 0, 0, 0.87)\">小结</span></h3><ul list=\"u37870add\"><li fid=\"u97868d90\" data-lake-id=\"u1037b425\" id=\"u1037b425\"><span data-lake-id=\"udd603c7b\" id=\"udd603c7b\" style=\"color: rgba(0, 0, 0, 0.87)\">线程执行任务并传参有两种方式:</span></li><li fid=\"u97868d90\" data-lake-id=\"ucaab0919\" id=\"ucaab0919\"><strong><span data-lake-id=\"uee30f653\" id=\"uee30f653\" style=\"color: rgba(0, 0, 0, 0.87)\">元组方式传参(args)</span></strong><span data-lake-id=\"u596e40f3\" id=\"u596e40f3\" style=\"color: rgba(0, 0, 0, 0.87)\"> </span><span data-lake-id=\"u1d594563\" id=\"u1d594563\" style=\"color: rgba(0, 0, 0, 0.87)\">：元组方式传参一定要和参数的顺序保持一致。</span></li><li fid=\"u97868d90\" data-lake-id=\"u0d7577e3\" id=\"u0d7577e3\"><strong><span data-lake-id=\"u9b96e7e9\" id=\"u9b96e7e9\" style=\"color: rgba(0, 0, 0, 0.87)\">字典方式传参(kwargs)</span></strong><span data-lake-id=\"u396bc7ab\" id=\"u396bc7ab\" style=\"color: rgba(0, 0, 0, 0.87)\">：字典方式传参字典中的key一定要和参数名保持一致。</span></li></ul>",
