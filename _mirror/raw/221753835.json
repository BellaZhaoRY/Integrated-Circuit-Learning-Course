%25d%20%3D%20%25d%5C%5Cn%5C%22%2C%20a%2C%20b%2C%20a%20%26%26%20b)%3B%20%20%2F%2F%20%E8%BE%93%E5%87%BA%3A%201%20(%E7%9C%9F)%5Cn%20%20%20%20printf(%5C%22%25d%20%26%26%20%25d%20%3D%20%25d%5C%5Cn%5C%22%2C%20a%2C%20c%2C%20a%20%26%26%20c)%3B%20%20%2F%2F%20%E8%BE%93%E5%87%BA%3A%200%20(%E5%81%87)%5Cn%20%20%20%20%5Cn%20%20%20%20%2F%2F%20%E9%80%BB%E8%BE%91%E6%88%96%5Cn%20%20%20%20printf(%5C%22%25d%20%7C%7C%20%25d%20%3D%20%25d%5C%5Cn%5C%22%2C%20a%2C%20c%2C%20a%20%7C%7C%20c)%3B%20%20%2F%2F%20%E8%BE%93%E5%87%BA%3A%201%20(%E7%9C%9F)%5Cn%20%20%20%20printf(%5C%22%25d%20%7C%7C%20%25d%20%3D%20%25d%5C%5Cn%5C%22%2C%20c%2C%20c%2C%20c%20%7C%7C%20c)%3B%20%20%2F%2F%20%E8%BE%93%E5%87%BA%3A%200%20(%E5%81%87)%5Cn%20%20%20%20%5Cn%20%20%20%20%2F%2F%20%E9%80%BB%E8%BE%91%E9%9D%9E%5Cn%20%20%20%20printf(%5C%22!%25d%20%3D%20%25d%5C%5Cn%5C%22%2C%20a%2C%20!a)%3B%20%20%2F%2F%20%E8%BE%93%E5%87%BA%3A%200%20(%E5%81%87)%5Cn%20%20%20%20printf(%5C%22!%25d%20%3D%20%25d%5C%5Cn%5C%22%2C%20c%2C%20!c)%3B%20%20%2F%2F%20%E8%BE%93%E5%87%BA%3A%201%20(%E7%9C%9F)%5Cn%5Cn%20%20%20%20printf(%5C%22!!%25d%20%3D%20%25d%5C%5Cn%5C%22%2C%20a%2C%20!!a)%3B%20%20%2F%2F%20%3F%5Cn%20%20%20%20%5Cn%20%20%20%20return%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%E4%BB%A3%E7%A0%81%E9%AA%8C%E8%AF%81%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22V8PBW%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uda5d3f61\" id=\"uda5d3f61\"><span data-lake-id=\"u77c630a5\" id=\"u77c630a5\" class=\"lake-fontsize-12\" style=\"color: #000000\">✅</span><span data-lake-id=\"u742926c3\" id=\"u742926c3\" class=\"lake-fontsize-12\" style=\"color: #000000\"> 逻辑运算（&amp;&amp;、||、!）和比较运算（&gt;、&lt;、==）的结果只能是 0 或 1，</span></p><p data-lake-id=\"u63e52772\" id=\"u63e52772\"><span data-lake-id=\"ufd4808ba\" id=\"ufd4808ba\" class=\"lake-fontsize-12\" style=\"color: #000000\">      即使操作数本身是其他非零值。</span></p><p data-lake-id=\"uc9e29116\" id=\"uc9e29116\"><span data-lake-id=\"ucbfb3541\" id=\"ucbfb3541\" class=\"lake-fontsize-12\" style=\"color: #000000\">​</span><span data-lake-id=\"ua6eb7cd4\" id=\"ua6eb7cd4\" class=\"lake-fontsize-12\" style=\"color: #000000\">✅</span><span data-lake-id=\"u058dac75\" id=\"u058dac75\" class=\"lake-fontsize-12\" style=\"color: #000000\"> 0 表示假，1 表示真，但参与运算的操作数可以是任意整数值（非0即真）。 </span></p><p data-lake-id=\"u0b946b5b\" id=\"u0b946b5b\"><span data-lake-id=\"u85c29dc6\" id=\"u85c29dc6\" class=\"lake-fontsize-12\" style=\"color: #000000\">✅</span><span data-lake-id=\"uae894f7c\" id=\"uae894f7c\" class=\"lake-fontsize-12\" style=\"color: #000000\"> !（逻辑非）的作用：!x 在 x 为 0 时返回 1，否则返回 0。</span></p><card type=\"block\" name=\"hr\" value=\"data:%7B%22id%22%3A%22PodNT%22%7D\"></card><h1 data-lake-id=\"sbCKz\" id=\"sbCKz\"><span data-lake-id=\"u5a983be7\" id=\"u5a983be7\">🐻</span><span data-lake-id=\"u56f8ce18\" id=\"u56f8ce18\">实践练习：</span></h1><p data-lake-id=\"uc825bf32\" id=\"uc825bf32\"><span data-lake-id=\"ud2544eec\" id=\"ud2544eec\">习题：给定以下变量定义，计算并输出各逻辑表达式的值（结果为 0 或 1）：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%5Cnint%20main()%20%5Cn%7B%5Cn%5Ctint%20a%20%3D%205%3B%5Cn%5Ctint%20b%20%3D%200%3B%5Cn%5Ctint%20c%20%3D%20-2%3B%5Cn%5Ct%5Cn%5Ctprintf(%5C%221.%20a%20%26%26%20b%20%3D%20%25d%5C%5Cn%5C%22%2C%20a%20%26%26%20b)%3B%5Cn%5Ctprintf(%5C%222.%20b%20%7C%7C%20c%20%3D%20%25d%5C%5Cn%5C%22%2C%20b%20%7C%7C%20c)%3B%5Cn%5Ctprintf(%5C%223.%20!a%20%3D%20%25d%5C%5Cn%5C%22%2C%20!a)%3B%5Cn%5Ctprintf(%5C%224.%20!b%20%3D%20%25d%5C%5Cn%5C%22%2C%20!b)%3B%5Cn%5Ctprintf(%5C%225.%20a%20%26%26%20c%20%3D%20%25d%5C%5Cn%5C%22%2C%20a%20%26%26%20c)%3B%5Cn%5Ctprintf(%5C%226.%20(a%20%26%26%20b)%20%7C%7C%20c%20%3D%20%25d%5C%5Cn%5C%22%2C%20(a%20%26%26%20b)%20%7C%7C%20c)%3B%5Cn%5Ctprintf(%5C%227.%20!(b%20%7C%7C%20c)%20%3D%20%25d%5C%5Cn%5C%22%2C%20!(b%20%7C%7C%20c))%3B%5Cn%5Ctprintf(%5C%228.%20!!a%20%3D%20%25d%5C%5Cn%5C%22%2C%20!!a)%3B%5Cn%5Ct%5Cn%5Ctreturn%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ofSjD%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>",
