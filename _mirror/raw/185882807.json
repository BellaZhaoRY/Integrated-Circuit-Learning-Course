%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22AVULH%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h3 data-lake-id=\"rTWJz\" id=\"rTWJz\" data-lake-index-type=\"2\"><span data-lake-id=\"u827ae316\" id=\"u827ae316\">获取结果</span></h3><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22data%20%3D%20response.text%5Cnprint(%5C%22%E8%AF%B7%E6%B1%82%E6%88%90%E5%8A%9F%EF%BC%81%E5%93%8D%E5%BA%94%E5%86%85%E5%AE%B9%EF%BC%9A%5C%22%2Cdata)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22GfuIM%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"AfLXp\" id=\"AfLXp\" data-lake-index-type=\"2\"><span data-lake-id=\"u118a7a27\" id=\"u118a7a27\">NTP获取网络时间</span></h2><h3 data-lake-id=\"5f18815d\" id=\"5f18815d\" data-lake-index-type=\"2\"><strong><span data-lake-id=\"u6267fe2a\" id=\"u6267fe2a\" style=\"color: rgb(64, 64, 64)\">1. 格林尼治时间（Greenwich Mean Time, GMT）</span></strong></h3><ul list=\"ua75dadac\"><li fid=\"ubf2f5621\" data-lake-id=\"u172601d6\" id=\"u172601d6\"><strong><span data-lake-id=\"u81bd5ec0\" id=\"u81bd5ec0\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">定义</span></strong><span data-lake-id=\"ucba92987\" id=\"ucba92987\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">：<br /></span><span data-lake-id=\"u802628f6\" id=\"u802628f6\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">GMT 是以英国伦敦格林尼治天文台的本地平太阳时为基准的时间标准，曾是全球时间的参考点（本初子午线所在时区）。</span></li><li fid=\"ubf2f5621\" data-lake-id=\"uee2783d0\" id=\"uee2783d0\"><strong><span data-lake-id=\"u2d46d9e1\" id=\"u2d46d9e1\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">特点</span></strong><span data-lake-id=\"uef915acf\" id=\"uef915acf\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">：</span></li></ul><ul list=\"ua75dadac\" data-lake-indent=\"1\"><li fid=\"u8c513e62\" data-lake-id=\"u533ab4a6\" id=\"u533ab4a6\"><strong><span data-lake-id=\"u09a66805\" id=\"u09a66805\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">时区标识</span></strong><span data-lake-id=\"u670f5ab0\" id=\"u670f5ab0\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">：UTC+0（与协调世界时 UTC 在数值上一致，但 GMT 是时区，UTC 是时间标准）。</span></li><li fid=\"u8c513e62\" data-lake-id=\"ua47563a9\" id=\"ua47563a9\"><strong><span data-lake-id=\"ua4c63cc8\" id=\"ua4c63cc8\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">历史地位</span></strong><span data-lake-id=\"u50faa479\" id=\"u50faa479\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">：过去广泛用于航空、航海和科学领域，现逐渐被</span><span data-lake-id=\"ufabe47b7\" id=\"ufabe47b7\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\"> </span><strong><span data-lake-id=\"u1a3c05ac\" id=\"u1a3c05ac\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">UTC</span></strong><span data-lake-id=\"uda93d72b\" id=\"uda93d72b\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\"> </span><span data-lake-id=\"ud39a0235\" id=\"ud39a0235\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">取代。</span></li><li fid=\"u8c513e62\" data-lake-id=\"ucaee079e\" id=\"ucaee079e\"><strong><span data-lake-id=\"ue7e7f8b3\" id=\"ue7e7f8b3\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">夏令时</span></strong><span data-lake-id=\"u10ab3a51\" id=\"u10ab3a51\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">：英国本地时间（BST）在夏令时会调整为 UTC+1，但 GMT 本身不包含夏令时。</span></li></ul><card type=\"block\" name=\"hr\" value=\"data:%7B%22id%22%3A%22UMpIp%22%7D\"></card><h3 data-lake-id=\"4d491b55\" id=\"4d491b55\" data-lake-index-type=\"2\"><strong><span data-lake-id=\"ub60e0ea9\" id=\"ub60e0ea9\" style=\"color: rgb(64, 64, 64)\">2. 北京时间（China Standard Time, CST）</span></strong></h3><ul list=\"u30411f9f\"><li fid=\"u6310b9b3\" data-lake-id=\"uf1eada28\" id=\"uf1eada28\"><strong><span data-lake-id=\"u72977c4b\" id=\"u72977c4b\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">定义</span></strong><span data-lake-id=\"ud5db4c7c\" id=\"ud5db4c7c\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">：<br /></span><span data-lake-id=\"u8469c1d9\" id=\"u8469c1d9\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">中国采用的标准时间，覆盖全国（东八区），比 UTC 快 8 小时，</span><strong><span data-lake-id=\"u1f028b90\" id=\"u1f028b90\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">无夏令时</span></strong><span data-lake-id=\"u3f8baa74\" id=\"u3f8baa74\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">。</span></li><li fid=\"u6310b9b3\" data-lake-id=\"ucb0a8eb5\" id=\"ucb0a8eb5\"><strong><span data-lake-id=\"uef6c258c\" id=\"uef6c258c\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">特点</span></strong><span data-lake-id=\"u3300f35e\" id=\"u3300f35e\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">：</span></li></ul><ul list=\"u30411f9f\" data-lake-indent=\"1\"><li fid=\"u0e44212b\" data-lake-id=\"uc0c9822b\" id=\"uc0c9822b\"><strong><span data-lake-id=\"u51a4a4a2\" id=\"u51a4a4a2\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">时区标识</span></strong><span data-lake-id=\"u33c0ae4f\" id=\"u33c0ae4f\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">：UTC+8。</span></li><li fid=\"u0e44212b\" data-lake-id=\"u25b04edf\" id=\"u25b04edf\"><strong><span data-lake-id=\"u18d44365\" id=\"u18d44365\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">统一性</span></strong><span data-lake-id=\"ua3ce3057\" id=\"ua3ce3057\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">：中国全境（包括香港、澳门、台湾）均使用北京时间，无论地理经度差异。</span></li><li fid=\"u0e44212b\" data-lake-id=\"ud818cbea\" id=\"ud818cbea\"><strong><span data-lake-id=\"ub69ab8e8\" id=\"ub69ab8e8\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">国际交流</span></strong><span data-lake-id=\"ub5897b58\" id=\"ub5897b58\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">：在国际场合常被写作</span><span data-lake-id=\"u5d0d06ac\" id=\"u5d0d06ac\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\"> </span><strong><span data-lake-id=\"ufb112b86\" id=\"ufb112b86\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">UTC+8</span></strong><span data-lake-id=\"uf359ce9a\" id=\"uf359ce9a\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">，避免与“中部标准时间”（Central Standard Time, UTC-6）混淆。</span></li></ul><card type=\"block\" name=\"hr\" value=\"data:%7B%22id%22%3A%22bwsSv%22%7D\"></card><h3 data-lake-id=\"320c3f04\" id=\"320c3f04\" data-lake-index-type=\"2\"><strong><span data-lake-id=\"ued339924\" id=\"ued339924\" style=\"color: rgb(64, 64, 64)\">3. GMT vs UTC vs 北京时间的区别</span></strong></h3><table data-lake-id=\"ItuDj\" id=\"ItuDj\" margin=\"true\" class=\"lake-table\" style=\"width: 748px\"><colgroup><col width=\"187\"><col width=\"187\"><col width=\"187\"><col width=\"187\"></colgroup><tbody><tr data-lake-id=\"ua916e1dc\" id=\"ua916e1dc\"><td data-lake-id=\"u0d64db80\" id=\"u0d64db80\"><p data-lake-id=\"ud522b4f1\" id=\"ud522b4f1\" style=\"text-align: left\"><strong><span data-lake-id=\"u553f2f0c\" id=\"u553f2f0c\" class=\"lake-fontsize-12\" style=\"color: rgb(var(--ds-rgb-label-1))\">特性</span></strong></p></td><td data-lake-id=\"u5932e01d\" id=\"u5932e01d\"><p data-lake-id=\"ufd0fcc09\" id=\"ufd0fcc09\" style=\"text-align: left\"><strong><span data-lake-id=\"u3e9f1306\" id=\"u3e9f1306\" class=\"lake-fontsize-12\" style=\"color: rgb(var(--ds-rgb-label-1))\">GMT</span></strong></p></td><td data-lake-id=\"u3f58d8cd\" id=\"u3f58d8cd\"><p data-lake-id=\"u0f210a5b\" id=\"u0f210a5b\" style=\"text-align: left\"><strong><span data-lake-id=\"u56f188f4\" id=\"u56f188f4\" class=\"lake-fontsize-12\" style=\"color: rgb(var(--ds-rgb-label-1))\">UTC</span></strong></p></td><td data-lake-id=\"u018846d4\" id=\"u018846d4\"><p data-lake-id=\"u4a5c6e24\" id=\"u4a5c6e24\" style=\"text-align: left\"><strong><span data-lake-id=\"u5d63b67d\" id=\"u5d63b67d\" class=\"lake-fontsize-12\" style=\"color: rgb(var(--ds-rgb-label-1))\">北京时间（CST）</span></strong></p></td></tr><tr data-lake-id=\"ud7cedd72\" id=\"ud7cedd72\"><td data-lake-id=\"ub140c206\" id=\"ub140c206\"><p data-lake-id=\"uf3e0f8fa\" id=\"uf3e0f8fa\"><strong><span data-lake-id=\"ua157c45e\" id=\"ua157c45e\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">性质</span></strong></p></td><td data-lake-id=\"u81bc65a0\" id=\"u81bc65a0\"><p data-lake-id=\"u11dbf09a\" id=\"u11dbf09a\"><span data-lake-id=\"uae123998\" id=\"uae123998\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">时区</span></p></td><td data-lake-id=\"ua74ee4e6\" id=\"ua74ee4e6\"><p data-lake-id=\"u96a8f1a1\" id=\"u96a8f1a1\"><span data-lake-id=\"u35b41afa\" id=\"u35b41afa\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">时间标准</span></p></td><td data-lake-id=\"uf130bda8\" id=\"uf130bda8\"><p data-lake-id=\"u98097c68\" id=\"u98097c68\"><span data-lake-id=\"u601d22f1\" id=\"u601d22f1\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">时区（UTC+8）</span></p></td></tr><tr data-lake-id=\"u9733d5c1\" id=\"u9733d5c1\"><td data-lake-id=\"ueb0e2e33\" id=\"ueb0e2e33\"><p data-lake-id=\"u07e6c5e8\" id=\"u07e6c5e8\"><strong><span data-lake-id=\"uc57ba670\" id=\"uc57ba670\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">精度</span></strong></p></td><td data-lake-id=\"u8ffabf4f\" id=\"u8ffabf4f\"><p data-lake-id=\"u54617fd0\" id=\"u54617fd0\"><span data-lake-id=\"u817fddaf\" id=\"u817fddaf\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">基于地球自转</span></p></td><td data-lake-id=\"ud0304c4f\" id=\"ud0304c4f\"><p data-lake-id=\"u2dc064d8\" id=\"u2dc064d8\"><span data-lake-id=\"u76aa4a30\" id=\"u76aa4a30\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">基于原子钟</span></p></td><td data-lake-id=\"u213c7b0b\" id=\"u213c7b0b\"><p data-lake-id=\"u50527218\" id=\"u50527218\"><span data-lake-id=\"ue9c7220a\" id=\"ue9c7220a\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">基于 UTC+8</span></p></td></tr><tr data-lake-id=\"u869816b7\" id=\"u869816b7\"><td data-lake-id=\"ud2c5af4c\" id=\"ud2c5af4c\"><p data-lake-id=\"uaab3205f\" id=\"uaab3205f\"><strong><span data-lake-id=\"u7db826a4\" id=\"u7db826a4\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">夏令时</span></strong></p></td><td data-lake-id=\"ud5a1220c\" id=\"ud5a1220c\"><p data-lake-id=\"u2a23a1a7\" id=\"u2a23a1a7\"><span data-lake-id=\"ubb7733c0\" id=\"ubb7733c0\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">无（但英国本地有）</span></p></td><td data-lake-id=\"u17a30bfa\" id=\"u17a30bfa\"><p data-lake-id=\"ub69abd5a\" id=\"ub69abd5a\"><span data-lake-id=\"u9be67020\" id=\"u9be67020\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">无</span></p></td><td data-lake-id=\"uc6354198\" id=\"uc6354198\"><p data-lake-id=\"u71a5f624\" id=\"u71a5f624\"><span data-lake-id=\"u8edb80f8\" id=\"u8edb80f8\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">无</span></p></td></tr><tr data-lake-id=\"u5d45fd8c\" id=\"u5d45fd8c\"><td data-lake-id=\"u6d2dddf4\" id=\"u6d2dddf4\"><p data-lake-id=\"u26e87dea\" id=\"u26e87dea\"><strong><span data-lake-id=\"u7444f94c\" id=\"u7444f94c\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">应用场景</span></strong></p></td><td data-lake-id=\"u86104bb1\" id=\"u86104bb1\"><p data-lake-id=\"u8b975c48\" id=\"u8b975c48\"><span data-lake-id=\"u8b66c006\" id=\"u8b66c006\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">历史遗留领域</span></p></td><td data-lake-id=\"u94bfe9c6\" id=\"u94bfe9c6\"><p data-lake-id=\"u9955ee25\" id=\"u9955ee25\"><span data-lake-id=\"u8fa98b38\" id=\"u8fa98b38\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">全球通用标准</span></p></td><td data-lake-id=\"ucb523f6c\" id=\"ucb523f6c\"><p data-lake-id=\"u91f0bc0b\" id=\"u91f0bc0b\"><span data-lake-id=\"ud5f81f25\" id=\"ud5f81f25\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">中国全境</span></p></td></tr><tr data-lake-id=\"u6fda1b02\" id=\"u6fda1b02\"><td data-lake-id=\"u7be16e08\" id=\"u7be16e08\"><p data-lake-id=\"ufb7f9a97\" id=\"ufb7f9a97\"><strong><span data-lake-id=\"u48e3b6de\" id=\"u48e3b6de\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">与 UTC 的关系</span></strong></p></td><td data-lake-id=\"u114de662\" id=\"u114de662\"><p data-lake-id=\"u00029804\" id=\"u00029804\"><span data-lake-id=\"u0068add4\" id=\"u0068add4\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">UTC+0</span></p></td><td data-lake-id=\"u7b788222\" id=\"u7b788222\"><p data-lake-id=\"u365cf413\" id=\"u365cf413\"><span data-lake-id=\"ufac24d51\" id=\"ufac24d51\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">基准</span></p></td><td data-lake-id=\"ue00d8961\" id=\"ue00d8961\"><p data-lake-id=\"u6d35192d\" id=\"u6d35192d\"><span data-lake-id=\"u60b511f8\" id=\"u60b511f8\" class=\"lake-fontsize-12\" style=\"color: rgb(64, 64, 64)\">UTC+8</span></p></td></tr></tbody></table><p data-lake-id=\"u5e4c54ad\" id=\"u5e4c54ad\"><br></p><p data-lake-id=\"u77409288\" id=\"u77409288\"><span data-lake-id=\"u54a7af21\" id=\"u54a7af21\" class=\"lake-fontsize-12\">这里默认获取出来的是格林尼治时间，所以我们需要UTC+8</span></p><h3 data-lake-id=\"mli2C\" id=\"mli2C\" data-lake-index-type=\"2\"><span data-lake-id=\"u910beb60\" id=\"u910beb60\">示例代码</span></h3><h4 data-lake-id=\"k8pur\" id=\"k8pur\" data-lake-index-type=\"2\"><span data-lake-id=\"ue44fc299\" id=\"ue44fc299\">导包</span></h4><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20ntptime%5Cnfrom%20machine%20import%20RTC%5Cnimport%20network%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22EJPzl%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h4 data-lake-id=\"xeiey\" id=\"xeiey\" data-lake-index-type=\"2\"><span data-lake-id=\"u4ad734bb\" id=\"u4ad734bb\">初始化STA</span></h4><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22def%20connect_wifi(ssid%2Cpassword)%3A%5Cn%20%20%20%20%23%20%E6%8C%87%E5%AE%9A%E6%A8%A1%E5%BC%8F%5Cn%20%20%20%20wlan%20%3D%20network.WLAN(network.WLAN.IF_STA)%20%20%20%20%20%20%20%23%20create%20station%20interface%20(the%20default%2C%20see%20below%20for%20an%20access%20point%20interface)%5Cn%20%20%20%20%23%20%E6%BF%80%E6%B4%BB%E8%AE%BE%E5%A4%87%5Cn%20%20%20%20wlan.active(True)%20%20%20%20%20%20%20%20%20%20%20%23%20activate%20the%20interface%5Cn%20%20%20%20%23%20%E6%89%AB%E6%8F%8F%5Cn%20%20%20%20print(wlan.scan())%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%23%20scan%20for%20access%20points%5Cn%20%20%20%20%23%20%E8%BF%9E%E6%8E%A5%E7%BD%91%E7%BB%9C%5Cn%20%20%20%20wlan.connect(ssid%2C%20password)%20%23%20connect%20to%20an%20AP%5Cn%20%20%20%20%5Cn%20%20%20%20while%20not%20wlan.isconnected()%3A%5Cn%20%20%20%20%20%20%20%20print(%5C%22%E7%AD%89%E5%BE%85%E8%81%94%E7%BD%91%E6%88%90%E5%8A%9F...%5C%22)%5Cn%20%20%20%20%20%20%20%20time.sleep(1)%5Cn%20%20%20%20%5Cn%20%20%20%20print(%5C%22%E8%81%94%E7%BD%91%E6%88%90%E5%8A%9F%5C%22)%5Cn%20%20%20%20%5Cn%20%20%20%20print(wlan.config('mac'))%20%20%20%20%20%20%20%20%20%20%23%20get%20the%20interface's%20MAC%20address%5Cn%20%20%20%20print(wlan.ipconfig('addr4'))%20%20%20%20%20%20%23%20get%20the%20interface's%20IPv4%20addresses%5Cn%5Cn%20%20%20%20print(%5C%22connect_wifi%20DEMO%5C%22)%5Cn%20%20%20%20%5Cn%5Cnconnect_wifi(%5C%22%E4%BD%A0%E5%AE%B6%E8%B7%AF%E7%94%B1%E5%99%A8%E8%B4%A6%E5%8F%B7%5C%22%2C%5C%22%E4%BD%A0%E5%AE%B6%E8%B7%AF%E7%94%B1%E5%99%A8%E5%AF%86%E7%A0%81%5C%22)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22tKOMU%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h4 data-lake-id=\"EtZfk\" id=\"EtZfk\" data-lake-index-type=\"2\"><span data-lake-id=\"u502d7e0a\" id=\"u502d7e0a\">初始化RTC</span></h4><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22rtc%20%3D%20RTC()%5Cnrtc.datetime((2017%2C%208%2C%2023%2C%200%2C%201%2C%2012%2C%2048%2C%200))%20%5Cnprint(rtc.datetime()%20)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22pBhhj%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h4 data-lake-id=\"NdBOq\" id=\"NdBOq\" data-lake-index-type=\"2\"><span data-lake-id=\"uba1840db\" id=\"uba1840db\">获取NTP