Lines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Night%20Owl%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22oHNME%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u9cd7a17e\" id=\"u9cd7a17e\"><span data-lake-id=\"ue91268d0\" id=\"ue91268d0\">我们具体的可以分为两类：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22P%E6%AD%A3%E5%90%91%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22ocpara-%3Eoutputstate%20%20%3D%20(uint16_t)TIMER_CCX_DISABLE%3B%5Cnocpara-%3Eocpolarity%20%20%20%3D%20TIMER_OC_POLARITY_HIGH%3B%5Cnocpara-%3Eocidlestate%20%20%3D%20TIMER_OC_IDLE_STATE_LOW%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22P%E6%AD%A3%E5%90%91%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Night%20Owl%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22gl0de%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22N%E5%8F%8D%E5%90%91%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22ocpara-%3Eoutputnstate%20%3D%20TIMER_CCXN_DISABLE%3B%5Cnocpara-%3Eocnpolarity%20%20%3D%20TIMER_OCN_POLARITY_HIGH%3B%5Cnocpara-%3Eocnidlestate%20%3D%20TIMER_OCN_IDLE_STATE_LOW%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22N%E5%8F%8D%E5%90%91%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Night%20Owl%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22m0sGX%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u0f729df3\" id=\"u0f729df3\"><span data-lake-id=\"u41baef55\" id=\"u41baef55\">特别观察API，带N的为反向，带P的为正向。</span><strong><span data-lake-id=\"u28fef62b\" id=\"u28fef62b\">赋值的结果常量也是需要注意是否带N。</span></strong></p><p data-lake-id=\"u36a632f3\" id=\"u36a632f3\"><span data-lake-id=\"u66a3a674\" id=\"u66a3a674\">P和N的配置主要出现在互补PWM中，如果当前的Timer不是高级定时器，那么就不具备互补的功能，那么我们一律认为他是P类型，也就是设置P才有用。</span></p><p data-lake-id=\"u95b9e1ec\" id=\"u95b9e1ec\"><span data-lake-id=\"u66691713\" id=\"u66691713\">通过设置outputstate 的 ENABLE来控制输出通道的开启。</span></p><h3 data-lake-id=\"CO3ON\" id=\"CO3ON\"><span data-lake-id=\"ucd3a23b2\" id=\"ucd3a23b2\">关心的内容</span></h3><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%E5%88%9D%E5%A7%8B%E5%8C%96%E6%8A%BD%E5%8F%96%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22static%20void%20PWM_config()%20%7B%5Cn%20%20%20%20uint32_t%20timerx%20%3D%20TIMER1%3B%5Cn%20%20%20%20uint32_t%20timerx_chn%20%3D%20TIMER_CH_0%3B%5Cn%20%20%20%20uint32_t%20timerx_rcu%20%3D%20RCU_TIMER1%3B%5Cn%20%20%20%20uint32_t%20timerx_psc%20%3D%20RCU_TIMER_PSC_MUL2%3B%5Cn%5Cn%20%20%20%20uint32_t%20timerx_prescaler%20%3D%2010000%20-%201%3B%20%2F%2F%20%E5%88%86%E9%A2%91%E8%AE%A1%E6%95%B0%5Cn%20%20%20%20uint32_t%20timerx_period%20%3D%20SystemCoreClock%20%2F%2010000%20-%201%3B%20%2F%2F%20%E5%91%A8%E6%9C%9F%E8%AE%A1%E6%95%B0%5Cn%5Cn%20%20%20%20uint32_t%20timerx_port%20%3D%20GPIOA%3B%20%2F%2F%20%E5%93%AA%E4%B8%AA%E5%BC%95%E8%84%9A%E5%92%8C%E7%AB%AF%E5%8F%A3%5Cn%20%20%20%20uint32_t%20timerx_port_rcu%20%3D%20RCU_GPIOA%3B%5Cn%20%20%20%20uint32_t%20timerx_pin%20%3D%20GPIO_PIN_5%3B%5Cn%5Cn%20%20%20%20%2F***************%20GPIO%20config%20**************%2F%5Cn%20%20%20%20%2F%2F%20%E9%85%8D%E7%BD%AE%E6%97%B6%E9%92%9F%5Cn%20%20%20%20rcu_periph_clock_enable(timerx_port_rcu)%3B%5Cn%20%20%20%20%2F%2F%20%E9%85%8D%E7%BD%AEGPIO%E6%A8%A1%E5%BC%8F%5Cn%20%20%20%20gpio_mode_set(timerx_port%2C%20GPIO_MODE_AF%2C%20GPIO_PUPD_NONE%2C%20timerx_pin)%3B%5Cn%20%20%20%20%2F%2F%20%E9%85%8D%E7%BD%AEGPIO%E8%BE%93%E5%87%BA%5Cn%20%20%20%20gpio_output_options_set(timerx_port%2C%20GPIO_OTYPE_PP%2C%20GPIO_OSPEED_MAX%2C%20timerx