%80%E5%88%9D%E5%A7%8B%E5%8C%96%20%2F%20%E9%9D%99%E6%80%81%E5%88%9D%E5%A7%8B%E5%8C%96%20%2F%20%E5%8F%AA%E8%AF%BB%E5%B8%B8%E9%87%8F%EF%BC%89%5Cn%2F%2F%20---------------------------%5Cnint%20global_init_var%20%3D%2042%3B%20%20%20%20%20%20%20%20%2F%2F%20%E5%85%A8%E5%B1%80%E5%B7%B2%E5%88%9D%E5%A7%8B%E5%8C%96%E5%8F%98%E9%87%8F%20-%3E%20Data%20%E6%AE%B5%5Cnstatic%20int%20static_init_var%20%3D%2099%3B%20%2F%2F%20%E9%9D%99%E6%80%81%E5%B7%B2%E5%88%9D%E5%A7%8B%E5%8C%96%E5%8F%98%E9%87%8F%20-%3E%20Data%20%E6%AE%B5%5Cnconst%20char%20*str_const%20%3D%20%5C%22Hello%5C%22%3B%20%2F%2F%20%E5%AD%97%E7%AC%A6%E4%B8%B2%E5%B8%B8%E9%87%8F%20-%3E%20%E5%8F%AA%E8%AF%BB%E5%B8%B8%E9%87%8F%E5%8C%BA%EF%BC%88.rodata%EF%BC%89%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22Data%20%E6%AE%B5%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22xVYCR%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u001fe61c\" id=\"u001fe61c\"><span data-lake-id=\"u1e6cb767\" id=\"u1e6cb767\">堆区（heap）\t\t</span></p><ul list=\"u99bd5a83\" start=\"4\"><li fid=\"u3ae2ae93\" data-lake-id=\"ue3770e70\" id=\"ue3770e70\"><span data-lake-id=\"u8c443183\" id=\"u8c443183\">堆是一个大容器，它的容量要远远大于栈，但没有栈那样先进后出的顺序。用于动态内存分配。堆在内存中位于BSS区和栈区之间。</span><span data-lake-id=\"u02d52a14\" id=\"u02d52a14\" style=\"color: #DF2A3F\">一般由程序员分配和释放，若程序员不释放，程序结束时由操作系统回收</span><span data-lake-id=\"u584cfd4d\" id=\"u584cfd4d\">。</span></li></ul><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22Heap%20%E5%A0%86%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%2F%2F%20---------------------------%5Cn%2F%2F%20%E5%A0%86%E5%8C%BA%EF%BC%88%E5%8A%A8%E6%80%81%E5%88%86%E9%85%8D%EF%BC%89%5Cn%2F%2F%20---------------------------%5Cnint%20*heap_var%20%3D%20malloc(sizeof(int))%3B%20%2F%2F%20%E5%8A%A8%E6%80%81%E5%88%86%E9%85%8D%20-%3E%20%E5%A0%86%5Cn*heap_var%20%3D%20123%3B%5Cnprintf(%5C%22heap_var%20(Heap)%20%20%20%20%20%20%20%20%20%20%20%3A%20%25p%5C%5Cn%5C%22%2C%20(void*)heap_var)%3B%5Cn%5Cnfree(heap_var)%3B%20%2F%2F%20%E6%89%8B%E5%8A%A8%E9%87%8A%E6%94%BE%E5%A0%86%E5%86%85%E5%AD%98%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22Heap%20%E5%A0%86%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22vK0jw%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ucb1ff5d9\" id=\"ucb1ff5d9\"><span data-lake-id=\"ua1a9f6e4\" id=\"ua1a9f6e4\">栈区（stack）</span></p><ul list=\"u99bd5a83\" start=\"5\"><li fid=\"u3ae2ae93\" data-lake-id=\"u54127c10\" id=\"u54127c10\"><span data-lake-id=\"u7708af5c\" id=\"u7708af5c\">栈是一种先进后出的内存结构，</span><span data-lake-id=\"uc0b61c48\" id=\"uc0b61c48\" style=\"color: #DF2A3F\">由编译器自动分配释放，存放函数的参数值、返回值、局部变量等。在程序运行过程中实时加载和释放，因此，局部变量的生存周期为申请到释放该段栈空间</span><span data-lake-id=\"uf454a161\" id=\"uf454a161\">。</span></li></ul><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22Stack%20%E6%A0%88%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22void%20func_demo(int%20param)%20%7B%20%2F%2F%20param%20%E5%9C%A8%E6%A0%88%E4%B8%8A%5Cn%20%20%20%20%2F%2F%20---------------------------%5Cn%20%20%20%20%2F%2F%20%E6%A0%88%E5%8C%BA%EF%BC%88%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%20%2F%20%E5%8F%82%E6%95%B0%EF%BC%89%5Cn%20%20%20%20%2F%2F%20---------------------------%5Cn%20%20%20%20int%20local_var%20%3D%2010%3B%20%2F%2F%20%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%20-%3E%20%E6%A0%88%5Cn%20%20%20%20printf(%5C%22local_var%20(Stack)%20%20%20%3A%20%25p%5C%5Cn%5C%22%2C%20(void*)%26local_var)%3B%5Cn%20%20%20%20printf(%5C%22param%20(Stack)%20%20%20%20%20%20%20%3A%20%25p%5C%5Cn%5C%22%2C%20(void*)%26param)%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22Stack%20%E6%A0%88%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22P9bhs%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u1f364f61\" id=\"u1f364f61\"><span data-lake-id=\"u469d9cd7\" id=\"u469d9cd7\">​</span><br></p><p data-lake-id=\"ud2db444b\" id=\"ud2db444b\"><span data-lake-id=\"u38c9b001\" id=\"u38c9b001\">在gdb调试运行时, 可以通过</span><code data-lake-id=\"u29f6c476\" id=\"u29f6c476\"><span data-lake-id=\"u20afdae8\" id=\"u20afdae8\">info files</span></code><span data-lake-id=\"u7e4aa4e3\" id=\"u7e4aa4e3\">命令, 查看不同段的地址范围</span></p><p data-lake-id=\"u1a5ed7e6\" id=\"u1a5ed7e6\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F27903758%2F1786696542723-653684a7-a99c-4f36-a0ab-7def08425200.png%22%2C%22taskId%22%3A%22uc4f90dc5-63d5-4fe8-9424-9280254da1a%22%2C%22clientId%22%3A%22u856cb3b9-4c19-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A700.8%2C%22height%22%3A262%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22PixPin_2026-08-14_16-36-38.png%22%2C%22size%22%3A165576%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A876%2C%22originHeight%22%3A328%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%220X00007FF77DDB1000-0X00007FF77DDB7C38IS.TEXT%22%2C%22x%22%3A47%2C%22y%22%3A76%2C%22width%22%3A480%2C%22height%22%3A17%7D%2C%7B%22text%22%3A%22XO0O07FF77DDB80