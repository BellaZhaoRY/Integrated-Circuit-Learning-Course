1%E7%A4%BA%E4%BE%8B%EF%BC%88%E4%B8%8B%E8%BD%BD%E5%A4%9A%E4%B8%AA%E5%9B%BE%E7%89%87%E6%96%87%E4%BB%B6%EF%BC%89%5Cn%20%20%20%20thread_pool_test()%5Cn%5Cn%20%20%20%20sys.exit(app.exec_())%5Cn%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22main.py%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Darcula%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22qi5yM%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"rWkay\" id=\"rWkay\"><span data-lake-id=\"uf117ede9\" id=\"uf117ede9\">多任务管理</span></h2><p data-lake-id=\"u2153a9c7\" id=\"u2153a9c7\"><span data-lake-id=\"ubac05234\" id=\"ubac05234\">指开启一个长期运行的线程，在线程内部，运行一个循环，循环中阻塞式地接收用户发来的任务（定期或非定期），并及时按照用户预定的函数进行执行（通常要消耗一小段时间）。这个多任务管理器应有如下特点：</span></p><ul list=\"uf6d764b8\"><li fid=\"u0043448a\" data-lake-id=\"u6b96f59d\" id=\"u6b96f59d\"><span data-lake-id=\"u92ec29ff\" id=\"u92ec29ff\">不会阻塞主线程（保障主界面操作顺滑）</span></li><li fid=\"u0043448a\" data-lake-id=\"ubef817e4\" id=\"ubef817e4\"><span data-lake-id=\"u3119e886\" id=\"u3119e886\">一旦任务完成，将执行结果返回给任务的发布者。这可以通过回调函数、事件或其他适当的机制来实现。</span></li><li fid=\"u0043448a\" data-lake-id=\"ubbab0c29\" id=\"ubbab0c29\"><span data-lake-id=\"ub0dc1bfa\" id=\"ub0dc1bfa\">如果任务执行过程中发生异常，需要将异常信息返回给任务的发布者，以便了解并采取适当的处理措施。</span></li><li fid=\"u0043448a\" data-lake-id=\"u726a66cb\" id=\"u726a66cb\"><span data-lake-id=\"u71e46be2\" id=\"u71e46be2\">可以保障任务的执行顺序和发布任务的顺序一致（通过队列保证要求）</span></li><li fid=\"u0043448a\" data-lake-id=\"u33eabb6b\" id=\"u33eabb6b\"><span data-lake-id=\"ub9c12254\" id=\"ub9c12254\">这个长期任务管理器可以通过调用方法进行停止</span></li></ul><p data-lake-id=\"u5157fe4b\" id=\"u5157fe4b\"><br></p><h3 data-lake-id=\"woh64\" id=\"woh64\" data-lake-index-type=\"0\"><span data-lake-id=\"u8773d104\" id=\"u8773d104\">拷贝依赖</span></h3><p data-lake-id=\"u7cf7fad0\" id=\"u7cf7fad0\"><span data-lake-id=\"ua5c73d96\" id=\"ua5c73d96\">这段代码定义了一个 </span><code data-lake-id=\"ue081569a\" id=\"ue081569a\"><span data-lake-id=\"u7ef6bae3\" id=\"u7ef6bae3\">TaskWorker</span></code><span data-lake-id=\"ub4f515f0\" id=\"ub4f515f0\"> 类，该类继承自 </span><code data-lake-id=\"u0b956fe2\" id=\"u0b956fe2\"><span data-lake-id=\"u47134575\" id=\"u47134575\">QThread</span></code><span data-lake-id=\"u236fec9a\" id=\"u236fec9a\"> 类，并使用队列实现了多个任务的异步执行。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22qt_task.py%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22%5C%22%5C%22%5C%22%5Cn%E8%BF%90%E8%A1%8C%E4%B8%80%E4%B8%AA%E7%8B%AC%E7%AB%8B%E7%BA%BF%E7%A8%8B%EF%BC%8C%E7%94%A8%E4%BA%8E%E6%89%A7%E8%A1%8C%E9%95%BF%E6%9C%9F%E5%BE%AA%E7%8E%AF%E5%8F%91%E9%80%81%E4%BB%BB%E5%8A%A1%EF%BC%8C%E5%8F%AF%E4%BB%A5%E9%9A%8F%E6%97%B6%E6%89%A7%E8%A1%8C%E5%BC%82%E6%AD%A5%E4%BB%BB%E5%8A%A1%EF%BC%8C%E5%86%85%E9%83%A8%E7%BB%B4%E6%8A%A4%E4%B8%80%E4%B8%AA%E6%B6%88%E6%81%AF%E9%98%9F%E5%88%97%EF%BC%88%E4%BE%8B%E5%A6%82%EF%BC%9A%E5%8F%91%E9%80%81%E8%93%9D%E7%89%99%E3%80%81%E4%B8%B2%E5%8F%A3%E6%B6%88%E6%81%AF%EF%BC%89%5Cn%5Cn%E8%BF%99%E6%AE%B5%E4%BB%A3%E7%A0%81%E5%AE%9A%E4%B9%89%E4%BA%86%E4%B8%80%E4%B8%AA%20TaskWorker%20%E7%B1%BB%EF%BC%8C%E8%AF%A5%E7%B1%BB%E7%BB%A7%E6%89%BF%E8%87%AA%20QThread%20%E7%B1%BB%EF%BC%8C%E5%B9%B6%E4%BD%BF%E7%94%A8%E9%98%9F%E5%88%97%E5%AE%9E%E7%8E%B0%E4%BA%86%E4%BB%BB%E5%8A%A1%E7%9A%84%E5%BC%82%E6%AD%A5%E6%89%A7%E8%A1%8C%E3%80%82%5Cn%5Cn%5C%22%5C%22%5C%22%5Cn%5Cnfrom%20queue%20import%20Queue%5Cn%5Cnfrom%20PyQt5.QtCore%20import%20QThread%2C%20pyqtSignal%5Cn%5Cn%5Cnclass%20TaskWorker(QThread)%3A%5Cn%20%20%20%20taskResult%20%3D%20pyqtSignal(object)%5Cn%20%20%20%20taskError%20%3D%20pyqtSignal(Exception)%5Cn%20%20%20%20taskFinished%20%3D%20pyqtSignal()%5Cn%5Cn%20%20%20%20def%20__init__(self%2C%20do_task%2C%20parent%3DNone)%3A%5Cn%20%20%20%20%20%20%20%20super(TaskWorker%2C%20self).__init__(parent)%5Cn%20%20%20%20%20%20%20%20self.do_task%20%3D%20do_task%5C