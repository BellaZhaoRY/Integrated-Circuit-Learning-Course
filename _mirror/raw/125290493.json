  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><h2 data-lake-id=\"LBTil\" id=\"LBTil\" data-lake-index-type=\"2\"><span data-lake-id=\"u372ef0d6\" id=\"u372ef0d6\">成员方法的</span><code data-lake-id=\"uf4c8a21c\" id=\"uf4c8a21c\"><span data-lake-id=\"ud5a099f9\" id=\"ud5a099f9\">self</span></code><span data-lake-id=\"u4028c288\" id=\"u4028c288\">参数</span></h2><p data-lake-id=\"u7ebfd1bf\" id=\"u7ebfd1bf\"><span data-lake-id=\"u7a96e7d0\" id=\"u7a96e7d0\">成员方法中</span><code data-lake-id=\"u8ff5a24b\" id=\"u8ff5a24b\"><span data-lake-id=\"u0cd3d476\" id=\"u0cd3d476\">self</span></code><span data-lake-id=\"u73aaa3e8\" id=\"u73aaa3e8\">表示调用该方法的</span><strong><span data-lake-id=\"u63b8d985\" id=\"u63b8d985\">对象。</span></strong><span data-lake-id=\"ue9e23ae7\" id=\"ue9e23ae7\"><br />对象调用⽅法时，python解释器会把</span><strong><span data-lake-id=\"u0f81fafd\" id=\"u0f81fafd\">这个对象</span></strong><span data-lake-id=\"u4bdab89d\" id=\"u4bdab89d\">作为</span><strong><span data-lake-id=\"u34156877\" id=\"u34156877\">第⼀个参数</span></strong><span data-lake-id=\"ue742c07b\" id=\"ue742c07b\">传递给⽅法<br />通过</span><code data-lake-id=\"u3ca439e9\" id=\"u3ca439e9\"><span data-lake-id=\"uf9465bc9\" id=\"uf9465bc9\">self</span></code><span data-lake-id=\"ufcdd2622\" id=\"ufcdd2622\">也可以获取对象的属性，调用对象的其它成员方法</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22class%20Person%3A%5Cn%20%20%20%20def%20__init__(self%2C%20name%2C%20age)%3A%5Cn%20%20%20%20%20%20%20%20%23%20%E5%AE%9A%E4%B9%89%E6%88%90%E5%91%98%E5%B1%9E%E6%80%A7%5Cn%20%20%20%20%20%20%20%20self.name%20%3D%20name%5Cn%20%20%20%20%20%20%20%20self.age%20%3D%20age%5Cn%5Cn%20%20%20%20def%20say_hello(self)%3A%5Cn%20%20%20%20%20%20%20%20%23%20%E9%80%9A%E8%BF%87self%E8%AE%BF%E9%97%AE%E6%88%90%E5%91%98%E5%B1%9E%E6%80%A7%5Cn%20%20%20%20%20%20%20%20print(self.name)%5Cn%5Cn%5Cn%23%20%E5%AF%B9%E8%B1%A1%5Cnp%20%3D%20Person('%E5%BC%A0%E4%B8%89'%2C%2030)%5Cnp.say_hello()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Yr03d%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"TSfby\" id=\"TSfby\" data-lake-index-type=\"2\"><code data-lake-id=\"u7fffc0db\" id=\"u7fffc0db\"><span data-lake-id=\"u0c0307b0\" id=\"u0c0307b0\">__init__</span></code><span data-lake-id=\"u9a66da48\" id=\"u9a66da48\">方法</span></h2><p data-lake-id=\"u4939babc\" id=\"u4939babc\"><code data-lake-id=\"u9d75d30d\" id=\"u9d75d30d\"><span data-lake-id=\"u49b4fb63\" id=\"u49b4fb63\">__init__</span></code><span data-lake-id=\"uf42d6d3c\" id=\"uf42d6d3c\">是一个</span><strong><span data-lake-id=\"ub7ced26f\" id=\"ub7ced26f\">内置的方法</span></strong><span data-lake-id=\"ub05ef2d3\" id=\"ub05ef2d3\"><br />当</span><strong><span data-lake-id=\"u60a313d0\" id=\"u60a313d0\">对象创建的时</span></strong><span data-lake-id=\"u917857d1\" id=\"u917857d1\">候就会自动执行</span><code data-lake-id=\"ua976a725\" id=\"ua976a725\"><span data-lake-id=\"uc0fc1a31\" id=\"uc0fc1a31\">__init__</span></code><span data-lake-id=\"u2bb3b754\" id=\"u2bb3b754\">方法</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22%23%20%E5%AE%9A%E4%B9%89%E7%B1%BB%5Cnclass%20Person%3A%5Cn%20%20%20%20def%20__init__(self)%3A%5Cn%20%20%20%20%20%20%20%20print('%E6%89%A7%E8%A1%8C%E4%BA%86init%E6%96%B9%E6%B3%95')%5Cn%5Cn%23%20%E5%88%9B%E5%BB%BA%E5%AF%B9%E8%B1%A1%5Cnp1%20%3D%20Person()%5Cnp2%20%3D%20Person()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22PiWhJ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uaad9cbd8\" id=\"uaad9cbd8\"><span data-lake-id=\"ua27277c3\" id=\"ua27277c3\">运行程序,输出:</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22%E6%89%A7%E8%A1%8C%E4%BA%86init%E6%96%B9%E6%B3%95%5Cn%E6%89%A7%E8%A1%8C%E4%BA%86init%E6%96%B9%E6%B3%95%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22K5pxf%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u6c3edf1e\" id=\"u6c3edf1e\"><span data-lake-id=\"u809d5571\" id=\"u809d5571\">一旦创建了该类的对象就会执行</span><code data-lake-id=\"u0735a984\" id=\"u0735a984\"><span data-lake-id=\"u58fd081a\" id=\"u58fd081a\">__init__</span></code><span data-lake-id=\"ue46b6897\" id=\"ue46b6897\">方法</span></p><h2 data-lake-id=\"UtEFi\" id=\"UtEFi\" data-lake-index-type=\"2\"><code data-lake-id=\"u3c93a7a7\" id=\"u3c93a7a7\"><span data-lake-id=\"u29bb2564\" id=\"u29bb2564\">__str__</span></code><span data-lake-id=\"udb943d01\" id=\"udb943d01\">方法</span></h2><p data-lake-id=\"udf54958b\" id=\"udf54958b\"><code data-lake-id=\"u51abe48f\" id=\"u51abe48f\"><span data-lake-id=\"u56d92773\" id=\"u56d92773\">__str__</span></code><span data-lake-id=\"u965565fe\" id=\"u965565fe\">也是类的内置方法</span></p><p data-lake-id=\"ufd29214d\" id=\"ufd29214d\"><span data-lake-id=\"u2492726f\" id=\"u2492726f\">用于将对象转化为</span><strong><span data-lake-id=\"u9c6a6a25\" id=\"u9c6a6a25\">适于人阅读的形式</span></strong></p><p data-lake-id=\"ue19faca5\" id=\"ue19faca5\"><span data-lake-id=\"ub28e9af0\" id=\"ub28e9af0\">先看一段代码：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22class%20Person%3A%5Cn%20%20%20%20def%20__init__(self%2Cname%2Cage)%3A%5Cn%20%20%20%20%20%20%20%20%23%20%E6%88%90%E5%91%98%E5%B1%9E%E6%80%A7%5Cn%20%20%20%20%20%20%20%20self.name%20%3D%20name%5Cn%20%20%20%20%20%20%20%20self.age%20%3D%20age%5Cn%5Cn%23%20%E5%88%9B%E5%BB%BA%E5%AF%B9%E8%B1%A1%5Cnp1%20%3D%20Person('%E5%BC%A0%E4%B8%89'%2C30)%5Cnp2%20%3D%20Person('%E6%9D%8E%E5%9B%9B'%2C40)%5Cnprint(p1)%5Cnprint(p2)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22cDJrW%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u0280b902\" id=\"u0280b902\"><span data-lake-id=\"u59cc7178\" id=\"u59cc7178\">创建了两个对象,输出两个对象</span></p><p data-lake-id=\"ud2514b18\" id=\"ud2514b18\"><span data-lake-id=\"u5a6cb3af\" id=\"u5a6cb3af\">结果:</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22%3C__main__.Person%20object%20at%200x03769D10%3E%5Cn%3C__main__.Person%20object%20at%200x03769FD0%3E%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22FMtWo%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u7b8b4df2\" id=\"u7b8b4df2\"><span data-lake-id=\"ua583c584\" id=\"ua583c584\">从结果中我们并不能区分出到底哪个是属于</span><span data-lake-id=\"u68f44efa\" id=\"u68f44efa\">p1</span><span data-lake-id=\"ubbfeea1e\" id=\"ubbfeea1e\">,哪个是属于</span><span data-lake-id=\"u178720de\" id=\"u178720de\">p2</span></p><p data-lake-id=\"u83ac14d7\" id=\"u83ac14d7\"><span data-lake-id=\"ud83c10a6\" id=\"ud83c10a6\">可以通过</span><code data-lake-id=\"ufe601815\" id=\"ufe601815\"><span data-lake-id=\"u4a72d15d\" id=\"u4a72d15d\">__str__</span></code><span data-lake-id=\"u54cd9f85\" id=\"u54cd9f85\">提取对象的主要特征用于区分不同的对象</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22class%20Person%3A%5Cn%20%20%20%20def%20__init__(self%2Cname%2Cage)%3A%5Cn%20%20%20%20%20%20%20%20%23%20%E6%88%90%E5%91%98%E5%B1%9E%E6%80%A7%5Cn%20%20%20%20%20%20%20%20self.name%20%3D%20name%5Cn%20%20%20%20%20%20%20%20self.age%20%3D%20age%5Cn%5Cn%20%20%20%20def%20__str__(self)%3A%5Cn%20%20%20%20%20%20%20%20'''%5Cn%20%20%20%20%20%20%20%20%E4%BB%A5%E5%AD%97%E7%AC%A6%E4%B8%B2%E8%BE%93%E5%87%BA%E5%AF%B9%E8%B1%A1%2C%E6%8A%8A%E5%AF%B9%E8%B1%A1%E5%8F%98%E6%88%90%E6%88%91%E4%BB%AC%E8%83%BD%E5%A4%9F%E8%AF%BB%E6%87%82%E7%9A%84%E5%BD%A2%E5%BC%8F%E8%BE%93%E5%87%BA%E5%87%BA%E6%9D%A5%5Cn%20%20%20%20%20%20%20%20%3Areturn%3A%5Cn%20%20%20%20%20%20%20%20'''%5Cn%20%20%20%20%20%20%20%20return%20'name%3A%7B%7D%2C%20age%3A%7B%7D'.format(self.name%2Cself.age)%5Cn%5Cn%23%20%E5%88%9B%E5%BB%BA%E5%AF%B9%E8%B1%A1%5Cnp1%20%3D%20Person('%E5%BC%A0%E4%B8%89'%2C30)%5Cnp2%20%3D%20Person('%E6%9D%8E%E5%9B%9B'%2C40)%5Cnprint(p1)%5Cnprint(p2)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22bnH72%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uc21f317d\" id=\"uc21f317d\"><span data-lake-id=\"u85e87217\" id=\"u85e87217\">输出结果:</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22name%3A%E5%BC%A0%E4%B8%89%2C%20age%3A30%5Cnname%3A%E6%9D%8E%E5%9B%9B%2C%20age%3A40%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22yn1uM%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uc7b10123\" id=\"uc7b10123\"><span data-lake-id=\"u2e8dd29e\" id=\"u2e8dd29e\">我们从结果中很容易就区分出两个对象的不同</span></p>",
