  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h2 data-lake-id=\"6aacb115\" id=\"6aacb115\"><span data-lake-id=\"uc95e6d48\" id=\"uc95e6d48\">软件安装</span></h2><p data-lake-id=\"u3d3ab31f\" id=\"u3d3ab31f\"><br></p><p data-lake-id=\"uc7653eb5\" id=\"uc7653eb5\"><span data-lake-id=\"u1c7805c1\" id=\"u1c7805c1\">Ubuntu软件安装有两种方式:</span></p><p data-lake-id=\"uab326a19\" id=\"uab326a19\"><br></p><ul list=\"u1bb58e1c\"><li fid=\"ud48708bb\" data-lake-id=\"ueb019ec7\" id=\"ueb019ec7\"><span data-lake-id=\"u195dc53e\" id=\"u195dc53e\">在线安装(apt方式安装)</span></li><li fid=\"ud48708bb\" data-lake-id=\"u98dfa737\" id=\"u98dfa737\"><span data-lake-id=\"ub82ba762\" id=\"ub82ba762\">离线安装(deb文件格式安装）</span></li></ul><p data-lake-id=\"ue01af94b\" id=\"ue01af94b\"><br></p><h3 data-lake-id=\"549ccbde\" id=\"549ccbde\"><span data-lake-id=\"u13a9a0c5\" id=\"u13a9a0c5\">deb文件格式安装</span></h3><p data-lake-id=\"u01dacdfd\" id=\"u01dacdfd\"><a href=\"https://shurufa.sogou.com/linux\" target=\"_blank\" data-lake-id=\"u593207bc\" id=\"u593207bc\"><span data-lake-id=\"ue5c41f54\" id=\"ue5c41f54\">https://shurufa.sogou.com/linux</span></a></p><p data-lake-id=\"u0517e0c8\" id=\"u0517e0c8\"><a href=\"https://pkgs.org/download/nudoku\" target=\"_blank\" data-lake-id=\"ue22b79df\" id=\"ue22b79df\"><span data-lake-id=\"u74e22a01\" id=\"u74e22a01\">https://pkgs.org/download/nudoku</span></a></p><p data-lake-id=\"uae18999b\" id=\"uae18999b\"><br></p><p data-lake-id=\"uee1af5b3\" id=\"uee1af5b3\"><span data-lake-id=\"uc1ac1633\" id=\"uc1ac1633\">是 Ubuntu 的安装包格式，可以使用 </span><strong><span data-lake-id=\"ubaaf71c3\" id=\"ubaaf71c3\">dpkg</span></strong><span data-lake-id=\"u26a26c02\" id=\"u26a26c02\"> 命令进行软件的安装和卸载。</span></p><table data-lake-id=\"9a32c6a2\" id=\"9a32c6a2\" margin=\"true\" class=\"lake-table\" style=\"width: 750px\"><colgroup><col width=\"375\"><col width=\"375\"></colgroup><tbody><tr data-lake-id=\"u1a61a4ad\" id=\"u1a61a4ad\"><td data-lake-id=\"u41cf1a04\" id=\"u41cf1a04\"><p data-lake-id=\"uc7713f11\" id=\"uc7713f11\" style=\"text-align: left\"><span data-lake-id=\"ua33a3815\" id=\"ua33a3815\">命令</span></p></td><td data-lake-id=\"u24310ae8\" id=\"u24310ae8\"><p data-lake-id=\"u9959f788\" id=\"u9959f788\" style=\"text-align: left\"><span data-lake-id=\"ud192bafb\" id=\"ud192bafb\">说明</span></p></td></tr><tr data-lake-id=\"u6612bb5f\" id=\"u6612bb5f\"><td data-lake-id=\"u8caf8e2c\" id=\"u8caf8e2c\"><p data-lake-id=\"ufdb9f977\" id=\"ufdb9f977\" style=\"text-align: left\"><span data-lake-id=\"uaec0cc63\" id=\"uaec0cc63\">dpkg</span></p></td><td data-lake-id=\"u0ebfaa0d\" id=\"u0ebfaa0d\"><p data-lake-id=\"u867f5b66\" id=\"u867f5b66\" style=\"text-align: left\"><span data-lake-id=\"u91d0f0b5\" id=\"u91d0f0b5\">安装和卸载deb安装包</span></p></td></tr></tbody></table><p data-lake-id=\"u8604fef9\" id=\"u8604fef9\"><br></p><p data-lake-id=\"u0749c97c\" id=\"u0749c97c\"><strong><span data-lake-id=\"ub8a3a7ee\" id=\"ub8a3a7ee\">dpkg命令选项:</span></strong></p><table data-lake-id=\"d832b86e\" id=\"d832b86e\" margin=\"true\" class=\"lake-table\" style=\"width: 750px\"><colgroup><col width=\"375\"><col width=\"375\"></colgroup><tbody><tr data-lake-id=\"u1f391336\" id=\"u1f391336\"><td data-lake-id=\"uac47e596\" id=\"uac47e596\"><p data-lake-id=\"u7f47267e\" id=\"u7f47267e\" style=\"text-align: left\"><span data-lake-id=\"u20082c4c\" id=\"u20082c4c\">选项</span></p></td><td data-lake-id=\"ue6191677\" id=\"ue6191677\"><p data-lake-id=\"u3e5d8670\" id=\"u3e5d8670\" style=\"text-align: left\"><span data-lake-id=\"ud5c87ffc\" id=\"ud5c87ffc\">说明</span></p></td></tr><tr data-lake-id=\"ue3eac935\" id=\"ue3eac935\"><td data-lake-id=\"u31785d30\" id=\"u31785d30\"><p data-lake-id=\"u4ca96d4f\" id=\"u4ca96d4f\" style=\"text-align: left\"><span data-lake-id=\"u5fedffc9\" id=\"u5fedffc9\">-i</span></p></td><td data-lake-id=\"ucda58018\" id=\"ucda58018\"><p data-lake-id=\"ufef679ac\" id=\"ufef679ac\" style=\"text-align: left\"><span data-lake-id=\"uec8dbcec\" id=\"uec8dbcec\">离线安装deb安装包 install</span></p></td></tr><tr data-lake-id=\"u56a12c0d\" id=\"u56a12c0d\"><td data-lake-id=\"ud3d7a352\" id=\"ud3d7a352\"><p data-lake-id=\"u3a271747\" id=\"u3a271747\"><span data-lake-id=\"u65e15cbd\" id=\"u65e15cbd\">-r</span></p></td><td data-lake-id=\"u0e3cab64\" id=\"u0e3cab64\"><p data-lake-id=\"u0a28d4f8\" id=\"u0a28d4f8\"><span data-lake-id=\"udb5fff6e\" id=\"udb5fff6e\">卸载程序 remove</span></p></td></tr></tbody></table><p data-lake-id=\"ua31cf382\" id=\"ua31cf382\"><br></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22sudo%20dpkg%20-i%20xxx.deb%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22UvmkR%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u8c001277\" id=\"u8c001277\"><br></p><h3 data-lake-id=\"51541cc8\" id=\"51541cc8\"><span data-lake-id=\"u39099772\" id=\"u39099772\">apt-get方式安装</span></h3><p data-lake-id=\"u1221438a\" id=\"u1221438a\"><br></p><p data-lake-id=\"uf714a3a6\" id=\"uf714a3a6\"><span data-lake-id=\"u4c907ee0\" id=\"u4c907ee0\">是在线安装deb软件包的命令，主要用于在线从互联网的软件仓库中</span><strong><span data-lake-id=\"u4aa753c7\" id=\"u4aa753c7\">搜索、安装、升级、卸载</span></strong><span data-lake-id=\"u5054bd66\" id=\"u5054bd66\">软件。</span></p><p data-lake-id=\"udc6b41d1\" id=\"udc6b41d1\"><br></p><p data-lake-id=\"u9ca835ca\" id=\"u9ca835ca\"><strong><span data-lake-id=\"ubf50f09f\" id=\"ubf50f09f\">在线安装软件命令格式:</span></strong></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22sudo%20apt%E2%80%93get%20install%20%E8%BD%AF%E4%BB%B6%E5%90%8D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Q9L5o%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><blockquote data-lake-id=\"u1ef0f37e\" id=\"u1ef0f37e\"><p data-lake-id=\"u7328c0f4\" id=\"u7328c0f4\"><span data-lake-id=\"u2083869c\" id=\"u2083869c\">注意:在线安装需要更新镜像源</span></p></blockquote><p data-lake-id=\"u77551d4c\" id=\"u77551d4c\"><span data-lake-id=\"u9afb56b6\" id=\"u9afb56b6\">例如,安装可分屏终端</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22sudo%20apt%20install%20terminator%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22OKyMj%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uc0b1bb7c\" id=\"uc0b1bb7c\"><span data-lake-id=\"ue0834083\" id=\"ue0834083\">2048游戏</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22sudo%20apt%20install%202048-qt%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22oweQe%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"2daaaa9b\" id=\"2daaaa9b\"><span data-lake-id=\"uc4aa5c89\" id=\"uc4aa5c89\">软件卸载</span></h2><p data-lake-id=\"u3364dadd\" id=\"u3364dadd\"><span data-lake-id=\"ucc993209\" id=\"ucc993209\">Ubuntu软件卸载有两种方式:</span></p><ul list=\"u742cbee2\"><li fid=\"u2ba7c9e1\" data-lake-id=\"u6037a2aa\" id=\"u6037a2aa\"><span data-lake-id=\"uc1ae919a\" id=\"uc1ae919a\">离线安装包的卸载(deb 文件格式卸载）</span></li><li fid=\"u2ba7c9e1\" data-lake-id=\"u18a3bfa1\" id=\"u18a3bfa1\"><span data-lake-id=\"ua76bb45f\" id=\"ua76bb45f\">在线安装包的卸载(apt-get 方式卸载)</span></li></ul><h3 data-lake-id=\"7d0f2ddb\" id=\"7d0f2ddb\"><span data-lake-id=\"u49c2b9b0\" id=\"u49c2b9b0\">deb 文件格式卸载</span></h3><p data-lake-id=\"u124a2f3e\" id=\"u124a2f3e\"><strong><span data-lake-id=\"u410028ed\" id=\"u410028ed\">命令格式:</span></strong></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22sudo%20dpkg%20%E2%80%93r%20%E5%AE%89%E8%A3%85%E5%8C%85%E5%90%8D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22QW3nE%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u920a9944\" id=\"u920a9944\"><span data-lake-id=\"ud1b94ede\" id=\"ud1b94ede\">-r 选项表示卸载</span></p><p data-lake-id=\"u7c4a9766\" id=\"u7c4a9766\"><br></p><h3 data-lake-id=\"0a6be557\" id=\"0a6be557\"><span data-lake-id=\"u242dfc3d\" id=\"u242dfc3d\">apt-get 方式卸载</span></h3><p data-lake-id=\"u7352a069\" id=\"u7352a069\"><strong><span data-lake-id=\"u7555e3d3\" id=\"u7555e3d3\">命令格式:</span></strong></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22sudo%20apt-get%20remove%20%E5%AE%89%E8%A3%85%E5%8C%85%E5%90%8D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22eqgCA%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>",
