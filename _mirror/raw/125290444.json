  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><h2 data-lake-id=\"a8BEc\" id=\"a8BEc\" data-lake-index-type=\"2\"><span data-lake-id=\"ub75c0f4e\" id=\"ub75c0f4e\">文本控件</span></h2><p data-lake-id=\"ub32ee7e1\" id=\"ub32ee7e1\"><span data-lake-id=\"u68f8248f\" id=\"u68f8248f\">文本控件是QLabel</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22from%20PyQt5.QtWidgets%20import%20QWidget%2C%20QApplication%2C%20QLabel%5Cnimport%20sys%5Cn%5Cn%23%201.%E5%88%9B%E5%BB%BA%E5%BA%94%E7%94%A8%E7%A8%8B%E5%BA%8F%5Cnapp%20%3D%20QApplication(sys.argv)%5Cn%5Cn%23%202.%E5%88%9B%E5%BB%BA%E7%AA%97%E5%8F%A3%5Cnw%20%3D%20QWidget()%5Cn%5Cn%23%20%E4%BF%AE%E6%94%B9%E7%AA%97%E5%8F%A3%E6%A0%87%E9%A2%98%5Cnw.setWindowTitle('%E6%96%87%E6%9C%AC%E5%B1%95%E7%A4%BA')%5Cn%5Cn%23%20-----------------------------------------------start%5Cn%5Cnlabel%20%3D%20QLabel()%5Cnlabel.setText('%E7%AC%AC%E4%B8%80%E4%B8%AA%E6%96%87%E6%9C%AC')%5Cn%23%20%E5%B0%86%E6%96%87%E6%9C%AC%E6%8E%A7%E4%BB%B6%E6%B7%BB%E5%8A%A0%E5%88%B0%E7%AA%97%E5%8F%A3%E4%B8%AD%5Cnlabel.setParent(w)%5Cn%5Cn%23%20-----------------------------------------------end%5Cn%5Cn%23%203.%E6%98%BE%E7%A4%BA%E7%AA%97%E5%8F%A3%5Cnw.show()%5Cn%5Cn%23%204.%E7%AD%89%E5%BE%85%E7%AA%97%E5%8F%A3%E5%81%9C%E6%AD%A2%5Cnsys.exit(app.exec())%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22fgmvV%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uf1aa6a2a\" id=\"uf1aa6a2a\"><span data-lake-id=\"u9074e19b\" id=\"u9074e19b\">运行程序:</span></p><p data-lake-id=\"u282ed1fb\" id=\"u282ed1fb\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1685235754950-68a9b6d1-4b76-4249-a1dd-7c7ca66f1d6c.png%22%2C%22taskId%22%3A%22uef908286-84a5-4cc2-b7c7-7b8620a96e4%22%2C%22clientId%22%3A%22uf1a5d4b7-311d-4%22%2C%22originalType%22%3A%22url%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A321%2C%22originHeight%22%3A256%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23efefef%22%2C%22id%22%3A%22uf3bb643c%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><h2 data-lake-id=\"VBYmb\" id=\"VBYmb\" data-lake-index-type=\"2\"><span data-lake-id=\"u07486f29\" id=\"u07486f29\">图片控件</span></h2><p data-lake-id=\"u90c841ce\" id=\"u90c841ce\"><span data-lake-id=\"u57209603\" id=\"u57209603\">QLabel 控件既可以显示文本,也可以显示图片</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22from%20PyQt5.QtWidgets%20import%20QWidget%2C%20QApplication%2C%20QLabel%5Cnfrom%20PyQt5.QtGui%20import%20QPixmap%5Cnimport%20sys%5Cn%5Cn%5Cndef%20init_widget(w%3A%20QWidget)%3A%5Cn%20%20%20%20%23%20%E4%BF%AE%E6%94%B9%E7%AA%97%E5%8F%A3%E6%A0%87%E9%A2%98%5Cn%20%20%20%20w.setWindowTitle('%E5%9B%BE%E7%89%87%E5%B1%95%E7%A4%BA')%5Cn%20%20%20%20%5C%22%5C%22%5C%22------------------%20%E5%B1%95%E7%A4%BA%E5%9B%BE%E7%89%87%20------------------%5C%22%5C%22%5C%22%5Cn%20%20%20%20label%20%3D%20QLabel()%5Cn%20%20%20%20pixmap%20%3D%20QPixmap('img.png')%5Cn%20%20%20%20label.setPixmap(pixmap)%5Cn%20%20%20%20%23%20%E6%98%BE%E7%A4%BA%E5%88%B0%E7%AA%97%E5%8F%A3%E4%B8%AD%5Cn%20%20%20%20label.setParent(w)%5Cn%20%20%20%20%23%20%E6%94%B9%E5%8F%98%E7%AA%97%E5%8F%A3%E5%A4%A7%E5%B0%8F%5Cn%20%20%20%20w.resize(pixmap.width()%2C%20pixmap.height())%5Cn%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20%23%201.%E5%88%9B%E5%BB%BA%E5%BA%94%E7%94%A8%E7%A8%8B%E5%BA%8F%5Cn%20%20%20%20app%20%3D%20QApplication(sys.argv)%5Cn%5Cn%20%20%20%20%23%202.%E5%88%9B%E5%BB%BA%E7%AA%97%E5%8F%A3%5Cn%20%20%20%20w%20%3D%20QWidget()%5Cn%20%20%20%20init_widget(w)%5Cn%5Cn%20%20%20%20%23%203.%E6%98%BE%E7%A4%BA%E7%AA%97%E5%8F%A3%5Cn%20%20%20%20w.show()%5Cn%5Cn%20%20%20%20%23%204.%E7%AD%89%E5%BE%85%E7%AA%97%E5%8F%A3%E5%81%9C%E6%AD%A2%5Cn%20%20%20%20sys.exit(app.exec())%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22vciIP%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ud8c77c0d\" id=\"ud8c77c0d\"><span data-lake-id=\"u966647c4\" id=\"u966647c4\">运行程序：</span></p><p data-lake-id=\"u869c3e76\" id=\"u869c3e76\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1685236307526-76e0c0fd-c4b0-48fe-9430-765014778cb3.png%22%2C%22taskId%22%3A%22uf09c0b58-04b1-4d43-a42f-afe7b35c03b%22%2C%22clientId%22%3A%22uf1a5d4b7-311d-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A350.4%2C%22height%22%3A650%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A574211%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A438%2C%22originHeight%22%3A813%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22search%22%3A%22%E5%9B%BE%E7%89%87%E5%B1%95%E7%A4%BA%22%2C%22ocrLocations%22%3A%5B%7B%22x%22%3A36%2C%22y%22%3A11%2C%22width%22%3A60%2C%22height%22%3A15%2C%22text%22%3A%22%E5%9B%BE%E7%89%87%E5%B1%95%E7%A4%BA%22%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22