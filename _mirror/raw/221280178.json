d%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%E6%9C%89%E7%AC%A6%E5%8F%B7%E6%95%B4%E6%95%B0%E6%BA%A2%E5%87%BA%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ir3fK%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ufb04dc40\" id=\"ufb04dc40\"><span data-lake-id=\"u6bcdec1a\" id=\"u6bcdec1a\" class=\"lake-fontsize-12\" style=\"color: rgba(0, 0, 0, 0.85)\">有符号整数溢出的情况下，会出现 “</span><strong><span data-lake-id=\"u6c5c00e0\" id=\"u6c5c00e0\" class=\"lake-fontsize-16\" style=\"color: #DF2A3F\">环绕</span></strong><span data-lake-id=\"uca2d5a1b\" id=\"uca2d5a1b\" class=\"lake-fontsize-12\" style=\"color: rgba(0, 0, 0, 0.85)\">” 现象，即结果会从最小值开始重新计数；</span></p><p data-lake-id=\"ued3d831a\" id=\"ued3d831a\"><span data-lake-id=\"u994d4ce3\" id=\"u994d4ce3\" class=\"lake-fontsize-12\" style=\"color: rgba(0, 0, 0, 0.85)\">​</span><br></p><h2 data-lake-id=\"Hr914\" id=\"Hr914\"><span data-lake-id=\"u42e09bea\" id=\"u42e09bea\" style=\"color: rgba(0, 0, 0, 0.85)\">3.2&gt; 无符号整数溢出</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%E6%97%A0%E7%AC%A6%E5%8F%B7%E6%95%B4%E6%95%B0%E6%BA%A2%E5%87%BA%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%5Cnint%20main()%5Cn%7B%5Cn%5Ctunsigned%20char%20c%20%3D%20254%3B%20%2F%2F%200xFE%5Cn%5Ctprintf(%5C%22c%20%3D%20%25d%5C%5Cn%5C%22%2C%20c)%3B%20%2F%2F%20254%3B%5Cn%5Ct%20%20%5Cn%5Ctc%20%3D%20c%20%2B%201%3B%5Cn%5Ctprintf(%5C%22c%20%3D%20%25d%5C%5Cn%5C%22%2C%20c)%3B%20%2F%2F%20255%3B%5Cn%5Ct%5Cn%5Ctc%20%3D%20c%20%2B%201%3B%5Cn%5Ctprintf(%5C%22c%20%3D%20%25d%5C%5Cn%5C%22%2C%20c)%3B%20%2F%2F%200%3B%5Cn%5Ct%5Cn%5Ctc%20%3D%20c%20%2B%201%3B%5Cn%5Ctprintf(%5C%22c%20%3D%20%25d%5C%5Cn%5C%22%2C%20c)%3B%20%2F%2F%201%3B%5Cn%5Ct%5Cn%5Ctreturn%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%E6%97%A0%E7%AC%A6%E5%8F%B7%E6%95%B4%E6%95%B0%E6%BA%A2%E5%87%BA%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22kmFgH%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u4f932f09\" id=\"u4f932f09\"><span data-lake-id=\"u4af8e0e9\" id=\"u4af8e0e9\" class=\"lake-fontsize-12\" style=\"color: rgba(0, 0, 0, 0.85)\">无符号整数溢出时，也会出现 “环绕” 现象；</span></p><card type=\"block\" name=\"hr\" value=\"data:%7B%22id%22%3A%22QlpGu%22%7D\"></card><h2 data-lake-id=\"sC1qI\" id=\"sC1qI\"><span data-lake-id=\"uc64c67b7\" id=\"uc64c67b7\" style=\"color: rgba(0, 0, 0, 0.85)\">3.3&gt; 浮点数上溢</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%E6%B5%AE%E7%82%B9%E6%95%B0%20-%20%E4%B8%8A%E6%BA%A2%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%5Cnint%20main()%20%5Cn%7B%5Cn%5Ctfloat%20max_float%20%3D%203.4e38f%3B%5Cn%5Ct%5Cn%5Ctfloat%20result%20%3D%20max_float%20*%2010.0f%3B%5Cn%5Ct%5Cn%5Ctprintf(%5C%22%E6%B5%AE%E7%82%B9%E6%95%B0%E4%B8%8A%E6%BA%A2%E5%90%8E%E7%9A%84%E7%BB%93%E6%9E%9C%EF%BC%9A%25f%5C%5Cn%5C%22%2C%20result)%3B%5Ct%2F%2F%20inf%5Cn%5Ct%5Cn%5Ctreturn%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%E6%B5%AE%E7%82%B9%E6%95%B0%20-%20%E4%B8%8A%E6%BA%A2%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22yNop4%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u8dc409d5\" id=\"u8dc409d5\"><span data-lake-id=\"u437f8b75\" id=\"u437f8b75\" class=\"lake-fontsize-12\" style=\"color: rgba(0, 0, 0, 0.85)\">溢的结果通常是一个特殊的值，如</span><code data-lake-id=\"u03b2212c\" id=\"u03b2212c\"><span data-lake-id=\"u310d999f\" id=\"u310d999f\" class=\"lake-fontsize-11\" style=\"color: var(--color-text-primary)\">INF</span></code><span data-lake-id=\"ufd3cc70e\" id=\"ufd3cc70e\" class=\"lake-fontsize-12\" style=\"color: rgba(0, 0, 0, 0.85)\">（无穷大），</span></p><p data-lake-id=\"u4706d0ce\" id=\"u4706d0ce\"><span data-lake-id=\"ub7d3e879\" id=\"ub7d3e879\" class=\"lake-fontsize-12\" style=\"color: rgba(0, 0, 0, 0.85)\">在不同的编译器和环境下可能会有不同的表示方式。</span></p><card type=\"block\" name=\"hr\" value=\"data:%7B%22id%22%3A%22Qaknd%22%7D\"></card><h2 data-lake-id=\"mwJkb\" id=\"mwJkb\"><span data-lake-id=\"u4aa0e635\" id=\"u4aa0e635\" style=\"color: rgba(0, 0, 0, 0.85)\">3.4&gt; 浮点数下溢</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%E6%B5%AE%E7%82%B9%E6%95%B0-%E4%B8%8B%E6%BA%A2%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%5Cnint%20main()%20%5Cn%7B%5Cn%5Ctfloat%20min_float%20%3D%201.0e-38f%3B%5Cn%5Ct%5Cn%5Ctfloat%20result%20%3D%20min_float%20%2F%201.0e10f%3B%5Cn%5Ct%5Cn%5Ctprintf(%5C%22%E6%B5%AE%E7%82%B9%E6%95%B0%E4%B8%8B%E6%BA%A2%E5%90%8E%E7%9A%84%E7%BB%93%E6%9E%9C%EF%BC%9A%25f%5C%5Cn%5C%22%2C%20result)%3B%5Cn%5Ct%5Cn%5Ctreturn%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%E6%B5%AE%E7%82%B9%E6%95%B0-%E4%B8%8B%E6%BA%A2%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22xUF6h%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u2111effe\" id=\"u2111effe\"><span data-lake-id=\"uc2900bef\" id=\"uc2900bef\" class=\"lake-fontsize-12\" style=\"color: rgba(0, 0, 0, 0.85)\">下溢的结果可能会被表示为 0 或者一个特殊的接近 0 的值，</span></p><p data-lake-id=\"u39ee800d\" id=\"u39ee800d\"><span data-lake-id=\"uf4d5b995\" id=\"uf4d5b995\" class=\"lake-fontsize-12\" style=\"color: rgba(0, 0, 0, 0.85)\">具体取决于编译器和运行环境。</span></p>",
