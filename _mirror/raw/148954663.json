  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h1 data-lake-id=\"phvxg\" id=\"phvxg\"><span data-lake-id=\"u2f41c418\" id=\"u2f41c418\" style=\"color: rgb(51, 51, 51)\">ubuntu系统简介</span></h1><h2 data-lake-id=\"JA9Bf\" id=\"JA9Bf\"><span data-lake-id=\"u403daac1\" id=\"u403daac1\" style=\"color: rgb(51, 51, 51)\">操作系统</span></h2><h3 data-lake-id=\"qzvE8\" id=\"qzvE8\"><span data-lake-id=\"u668120b0\" id=\"u668120b0\" style=\"color: rgb(51, 51, 51)\">1. 操作系统的定义</span></h3><p data-lake-id=\"u23093e85\" id=\"u23093e85\"><span data-lake-id=\"u26c300d8\" id=\"u26c300d8\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">操作系统直接运行在计算机上的</span><strong><span data-lake-id=\"u0ef88104\" id=\"u0ef88104\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">系统软件</span></strong><span data-lake-id=\"u7fd09202\" id=\"u7fd09202\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">， 它是</span><strong><span data-lake-id=\"ufa160ee6\" id=\"ufa160ee6\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">控制硬件和支持软件运行的计算机程序</span></strong><span data-lake-id=\"u3091384e\" id=\"u3091384e\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">。</span></p><p data-lake-id=\"u5cfe1a29\" id=\"u5cfe1a29\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1701505544250-efcb6b78-3fd5-4246-8565-d836a930b865.png%22%2C%22taskId%22%3A%22u14625bcb-91d7-466f-bc28-85f71a971c5%22%2C%22clientId%22%3A%22u75a977a1-f27e-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A266.6666666666667%2C%22height%22%3A176%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22os01.png%22%2C%22size%22%3A48681%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A600%2C%22originHeight%22%3A397%2C%22ratio%22%3A2.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E5%BA%94%E7%94%A8%E8%BD%AF%E4%BB%B6%22%2C%22x%22%3A229%2C%22y%22%3A135%2C%22width%22%3A124%2C%22height%22%3A33%7D%2C%7B%22text%22%3A%22%E8%AE%A1%E7%AE%97%E6%9C%BA%22%2C%22x%22%3A250%2C%22y%22%3A52%2C%22width%22%3A97%2C%22height%22%3A33%7D%2C%7B%22text%22%3A%22%E6%93%8D%E4%BD%9C%E7%B3%BB%E7%BB%9F%22%2C%22x%22%3A227%2C%22y%22%3A224%2C%22width%22%3A125%2C%22height%22%3A31%7D%2C%7B%22text%22%3A%22%E7%A1%AC%E4%BB%B6%22%2C%22x%22%3A256%2C%22y%22%3A313%2C%22width%22%3A65%2C%22height%22%3A32%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%2349b0a6%22%2C%22id%22%3A%22ubfe6d391%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><h3 data-lake-id=\"XvAPJ\" id=\"XvAPJ\"><span data-lake-id=\"u4f263680\" id=\"u4f263680\" style=\"color: rgb(51, 51, 51)\">2.操作系统作用</span></h3><p data-lake-id=\"u09efb73b\" id=\"u09efb73b\"><span data-lake-id=\"u063be0e5\" id=\"u063be0e5\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">向下</span><strong><span data-lake-id=\"u395b1439\" id=\"u395b1439\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">控制硬件</span></strong><span data-lake-id=\"u088ed3e9\" id=\"u088ed3e9\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">向上</span><strong><span data-lake-id=\"ufa59c398\" id=\"ufa59c398\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">支持软件的运行</span></strong><span data-lake-id=\"u1f49e4ea\" id=\"u1f49e4ea\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">，具有承上启下的作用</span></p><p data-lake-id=\"u4e8220ab\" id=\"u4e8220ab\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1701505562153-14d69e4d-9be3-443a-ba8a-58e0996655b2.png%22%2C%22taskId%22%3A%22ue9266333-44af-4040-b067-eb9eddfe043%22%2C%22clientId%22%3A%22u75a977a1-f27e-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A266.6666666666667%2C%22height%22%3A210%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22os02.png%22%2C%22size%22%3A48040%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A600%2C%22originHeight%22%3A473%2C%22ratio%22%3A2.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E6%93%8D%E4%BD%9C%E7%B3%BB%E7%BB%9F%22%2C%22x%22%3A221%2C%22y%22%3A217%2C%22width%22%3A154%2C%22height%22%3A39%7D%2C%7B%22text%22%3A%22%E5%BA%94%E7%94%A8%E8%BD%AF%E4%BB%B6%22%2C%22x%22%3A224%2C%22y%22%3A38%2C%22width%22%3A150%2C%22height%22%3A39%7D%2C%7B%22text%22%3A%22%E7%A1%AC%E4%BB%B6%22%2C%22x%22%3A261%2C%22y%22%3A400%2C%22width%22%3A75%2C%22height%22%3A38%7D%2C%7B%22text%22%3A%22%22%2C%22x%22%3A262%2C%22y%22%3A113%2C%22width%22%3A38%2C%22height%22%3A59%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23a1be6a%22%2C%22id%22%3A%22ue0618548%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><h3 data-lake-id=\"d4P2B\" id=\"d4P2B\"><span data-lake-id=\"ua5658222\" id=\"ua5658222\" style=\"color: rgb(51, 51, 51)\">3. 常见的操作系统</span></h3><ul list=\"u2cdb4032\"><li fid=\"u4f03b62c\" data-lake-id=\"ucf01c23b\" id=\"ucf01c23b\"><span data-lake-id=\"u71ec56de\" id=\"u71ec56de\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Windows</span></li><li fid=\"u4f03b62c\" data-lake-id=\"u8bb343cb\" id=\"u8bb343cb\"><span data-lake-id=\"ue84b37f8\" id=\"ue84b37f8\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">mac OS</span></li><li fid=\"u4f03b62c\" data-lake-id=\"ucffd24a4\" id=\"ucffd24a4\"><span data-lake-id=\"uc729e222\" id=\"uc729e222\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Linux</span></li><li fid=\"u4f03b62c\" data-lake-id=\"u29b057de\" id=\"u29b057de\"><span data-lake-id=\"u11bd8c65\" id=\"u11bd8c65\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">iOS</span></li><li fid=\"u4f03b62c\" data-lake-id=\"u0c4da24a\" id=\"u0c4da24a\"><span data-lake-id=\"u75d5d412\" id=\"u75d5d412\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Android</span></li></ul><h2 data-lake-id=\"iRuSB\" id=\"iRuSB\"><span data-lake-id=\"u21bd8583\" id=\"u21bd8583\" style=\"color: rgb(51, 51, 51)\">linux内核和发行版本</span></h2><h3 data-lake-id=\"O0x8s\" id=\"O0x8s\"><span data-lake-id=\"u648290b3\" id=\"u648290b3\" style=\"color: rgb(51, 51, 51)\">linux内核</span></h3><p data-lake-id=\"u983fee21\" id=\"u983fee21\"><span data-lake-id=\"ueadfdb18\" id=\"ueadfdb18\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Linux内核是操作系统内部</span><strong><span data-lake-id=\"uea7eb689\" id=\"uea7eb689\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">操作和控制硬件设备的核心程序</span></strong><span data-lake-id=\"u606d5814\" id=\"u606d5814\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">，它是由芬兰人</span><strong><span data-lake-id=\"uac4f135f\" id=\"uac4f135f\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">林纳斯</span></strong><span data-lake-id=\"u717c6943\" id=\"u717c6943\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">开发的。</span></p><p data-lake-id=\"u58c26d4f\" id=\"u58c26d4f\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1701505580612-3b19d625-ba7a-45d8-b0e4-cced45be1f93.png%22%2C%22taskId%22%3A%22u998848a8-c35b-4c9a-ab34-32b98cfc4ee%22%2C%22clientId%22%3A%22u75a977a1-f27e-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A266.6666666666667%2C%22height%22%3A165%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22os03.png%22%2C%22size%22%3A42877%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A600%2C%22originHeight%22%3A371%2C%22ratio%22%3A2.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E6%93%8D%E4%BD%9C%E7%B3%BB%E7%BB%9F%22%2C%22x%22%3A223%2C%22y%22%3A46%2C%22width%22%3A154%2C%22height%22%3A42%7D%2C%7B%22text%22%3A%22%E5%86%85%E6%A0%B8%22%2C%22x%22%3A260%2C%22y%22%3A166%2C%22width%22%3A82%2C%22height%22%3A41%7D%2C%7B%22text%22%3A%22%E7%A1%AC%E4%BB%B6%22%2C%22x%22%3A263%2C%22y%22%3A298%2C%22width%22%3A72%2C%22height%22%3A36%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%239fbb65%22%2C%22id%22%3A%22ua7aeed79%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u390932c6\" id=\"u390932c6\"><span data-lake-id=\"u8ede5e22\" id=\"u8ede5e22\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">说明:真正操作和控制硬件是由内核来完成的，操作系统是基于内核开发出来的。</span></p><h3 data-lake-id=\"Nzr86\" id=\"Nzr86\"><span data-lake-id=\"u5cf5f04c\" id=\"u5cf5f04c\" style=\"color: rgb(51, 51, 51)\">发行版本</span></h3><p data-lake-id=\"u7a41747e\" id=\"u7a41747e\"><span data-lake-id=\"ua0df757f\" id=\"ua0df757f\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">是Linux内核与各种常用软件的组合产品，通俗来说就是我们常说的Linux操作系统。</span></p><p data-lake-id=\"u412c02e8\" id=\"u412c02e8\"><strong><span data-lake-id=\"u4dd04c96\" id=\"u4dd04c96\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">常用的Linux发行版:</span></strong></p><ul list=\"u0c65105c\"><li fid=\"u3b685920\" data-lake-id=\"u550a19a7\" id=\"u550a19a7\"><span data-lake-id=\"uc0bd42ae\" id=\"uc0bd42ae\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Ubuntu</span></li><li fid=\"u3b685920\" data-lake-id=\"u38b90ff8\" id=\"u38b90ff8\"><span data-lake-id=\"uc74808cf\" id=\"uc74808cf\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">CentOS</span></li><li fid=\"u3b685920\" data-lake-id=\"u3a5168f1\" id=\"u3a5168f1\"><span data-lake-id=\"uc8fcbf14\" id=\"uc8fcbf14\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Redhat</span></li></ul><p data-lake-id=\"u15b1c6a6\" id=\"u15b1c6a6\"><strong><span data-lake-id=\"u8db37cd6\" id=\"u8db37cd6\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">Linux发行版效果图:</span></strong></p><p data-lake-id=\"u2913a07f\" id=\"u2913a07f\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1701505591926-3143c346-f3c5-4e75-9771-ef085758b27c.png%22%2C%22taskId%22%3A%22u19989003-7a33-4165-b2df-43509e417fc%22%2C%22clientId%22%3A%22u75a977a1-f27e-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A266.6666666666667%2C%22height%22%3A110%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22os04.png%22%2C%22size%22%3A52368%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A600%2C%22originHeight%22%3A247%2C%22ratio%22%3A2.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22LINUX%E5%8F%91%E8%A1%8C%E7%89%88%E6%93%8D%E4%BD%9C%E7%B3%BB%E7%BB%9F)%22%2C%22x%22%3A107%2C%22y%22%3A38%2C%22width%22%3A380%2C%22height%22%3A41%7D%2C%7B%22text%22%3A%22LINUX%E5%86%85%E6%A0%B8%22%2C%22x%22%3A209%2C%22y%22%3A154%2C%22width%22%3A178%2C%22height%22%3A43%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23b4976a%22%2C%22id%22%3A%22u181abb45%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><span data-lake-id=\"u024ccd63\" id=\"u024ccd63\"><br /> </span></p>",
