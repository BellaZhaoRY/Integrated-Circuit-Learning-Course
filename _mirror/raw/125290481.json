  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><h2 data-lake-id=\"aIebh\" id=\"aIebh\" data-lake-index-type=\"2\"><span data-lake-id=\"uebcf3c0e\" id=\"uebcf3c0e\">可变参数args</span></h2><p data-lake-id=\"u50e9c5f1\" id=\"u50e9c5f1\"><span data-lake-id=\"u53a5e64f\" id=\"u53a5e64f\">可变参数需要添加</span><code data-lake-id=\"ub3cb2e2a\" id=\"ub3cb2e2a\"><span data-lake-id=\"ue594b2d2\" id=\"ue594b2d2\">*</span></code><span data-lake-id=\"u3b266087\" id=\"u3b266087\">，用于接收任意数量的参数</span></p><p data-lake-id=\"u6f7236cc\" id=\"u6f7236cc\"><span data-lake-id=\"ucd69e42e\" id=\"ucd69e42e\">这里的</span><code data-lake-id=\"u133703c3\" id=\"u133703c3\"><span data-lake-id=\"u23adf99b\" id=\"u23adf99b\">args</span></code><span data-lake-id=\"ubc20b277\" id=\"ubc20b277\">代指</span><code data-lake-id=\"u5a2b71cb\" id=\"u5a2b71cb\"><span data-lake-id=\"u022825cf\" id=\"u022825cf\">arguments</span></code><span data-lake-id=\"u3ce9d05c\" id=\"u3ce9d05c\">，可以写其他任意名称</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22def%20sum(*args)%3A%23%20%E5%BD%A2%E5%8F%82%E8%83%BD%E5%A4%9F%E6%8E%A5%E6%94%B6%E4%BB%BB%E6%84%8F%E4%B8%AA%E9%95%BF%E5%BA%A6%E7%9A%84%E6%95%B0%E6%8D%AE%5Cn%20%20%20%20pass%5Cn%20%20%20%20%5Cn%23%20%E8%B0%83%E7%94%A8%E5%8F%AF%E5%8F%98%E5%8F%82%E6%95%B0%E7%9A%84%E5%87%BD%E6%95%B0%5Cnsum(10%2C20%2C30)%5Cnsum(10%2C20%2C30%2C40)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22VtBBy%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u4cd21737\" id=\"u4cd21737\"><span data-lake-id=\"u71d8b800\" id=\"u71d8b800\">可变参数的本质是 将传递的参数包装成了</span><strong><span data-lake-id=\"u3f5ce974\" id=\"u3f5ce974\">元组</span></strong></p><p data-lake-id=\"u32ebc43b\" id=\"u32ebc43b\"><span data-lake-id=\"u18744c45\" id=\"u18744c45\">实现多个参数的</span><code data-lake-id=\"u2f543685\" id=\"u2f543685\"><span data-lake-id=\"ueebbec42\" id=\"ueebbec42\">sum</span></code><span data-lake-id=\"u24fe835f\" id=\"u24fe835f\">函数</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22def%20sum(name%2C%20*args)%3A%23%20%E5%BD%A2%E5%8F%82%E8%83%BD%E5%A4%9F%E6%8E%A5%E6%94%B6%E4%BB%BB%E6%84%8F%E4%B8%AA%E9%95%BF%E5%BA%A6%E7%9A%84%E6%95%B0%E6%8D%AE%20args%E4%B8%BA%E5%85%83%E7%BB%84%E7%B1%BB%E5%9E%8B%5Cn%20%20%20%20result%20%3D%200%5Cn%20%20%20%20for%20ele%20in%20args%3A%5Cn%20%20%20%20%20%20%20%20result%20%2B%3D%20ele%5Cn%20%20%20%20return%20result%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22zzeMP%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u9dcb1840\" id=\"u9dcb1840\"><span data-lake-id=\"u8292121e\" id=\"u8292121e\">还有其他参数时，</span><code data-lake-id=\"u6801b703\" id=\"u6801b703\"><span data-lake-id=\"ub89bfa57\" id=\"ub89bfa57\">*args</span></code><span data-lake-id=\"udd190b9d\" id=\"udd190b9d\">要放最后</span></p><h2 data-lake-id=\"PR1tz\" id=\"PR1tz\" data-lake-index-type=\"2\"><span data-lake-id=\"u944c896d\" id=\"u944c896d\">可变参数kwargs</span></h2><p data-lake-id=\"u7eb90dde\" id=\"u7eb90dde\"><span data-lake-id=\"u0856fb18\" id=\"u0856fb18\">可变参数还有一种形式 可以接收</span><strong><span data-lake-id=\"u27bd4677\" id=\"u27bd4677\">不存在的关键字参数</span></strong></p><p data-lake-id=\"u3b900e60\" id=\"u3b900e60\"><span data-lake-id=\"ubead5798\" id=\"ubead5798\">定义参数时需要在变量名前添加两个</span><code data-lake-id=\"u0f398a6d\" id=\"u0f398a6d\"><span data-lake-id=\"u29e9e91c\" id=\"u29e9e91c\">*</span></code><span data-lake-id=\"u24ab3342\" id=\"u24ab3342\">，这里的</span><code data-lake-id=\"ua60b451c\" id=\"ua60b451c\"><span data-lake-id=\"u5632385c\" id=\"u5632385c\">kwargs</span></code><span data-lake-id=\"u627efe4a\" id=\"u627efe4a\">代指</span><code data-lake-id=\"u48713b16\" id=\"u48713b16\"><span data-lake-id=\"uc3249b44\" id=\"uc3249b44\">keywords</span></code><span data-lake-id=\"u33d0f568\" id=\"u33d0f568\">，可以写其他任意名称</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22def%20func(**kwargs)%3A%23%20kwargs%20%E6%8E%A5%E6%94%B6%E4%B8%8D%E5%AD%98%E5%9C%A8%E7%9A%84%E5%85%B3%E9%94%AE%E5%AD%97%E5%8F%82%E6%95%B0%5Cn%20%20%20%20pass%5Cn%5Cn%23%20%E8%B0%83%E7%94%A8%E4%B8%8D%E5%AD%98%E5%9C%A8%E7%9A%84%E5%85%B3%E9%94%AE%E5%AD%97%E5%8F%82%E6%95%B0%E5%87%BD%E6%95%B0%5Cnfunc(name%20%3D%20'%E5%BC%A0%E4%B8%89'%2C%20age%20%3D%2030%2C%20score%20%3D%2070)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22g69Pe%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uc494f59b\" id=\"uc494f59b\"><span data-lake-id=\"udb86361d\" id=\"udb86361d\">不存在的关键字参数包装成</span><strong><span data-lake-id=\"u19c6045c\" id=\"u19c6045c\">字典</span></strong></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22def%20func(a%2C**kwargs)%3A%23%20kwargs%20%E6%8E%A5%E6%94%B6%E4%B8%8D%E5%AD%98%E5%9C%A8%E7%9A%84%E5%85%B3%E9%94%AE%E5%AD%97%E5%8F%82%E6%95%B0%20kwargs%E4%B8%BA%E5%AD%97%E5%85%B8%E7%B1%BB%E5%9E%8B%5Cn%20%20%20%20name%20%3D%20kwargs%5B'name'%5D%5Cn%20%20%20%20age%20%3D%20kwargs%5B'age'%5D%5Cn%5Cn%23%20%E8%B0%83%E7%94%A8%E4%B8%8D%E5%AD%98%E5%9C%A8%E7%9A%84%E5%85%B3%E9%94%AE%E5%AD%97%E5%8F%82%E6%95%B0%E5%87%BD%E6%95%B0%5Cnfunc(name%20%3D%20'%E5%BC%A0%E4%B8%89'%2Cage%20%3D%2030%2Ca%3D10%2Cscore%3D70)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22v6w54%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"zxzXf\" id=\"zxzXf\" data-lake-index-type=\"2\"><span data-lake-id=\"u09a2a236\" id=\"u09a2a236\">传递元组/列表给可变参数args</span></h2><p data-lake-id=\"ua957cda0\" id=\"ua957cda0\"><span data-lake-id=\"ud3995fba\" id=\"ud3995fba\">可以传递元组、列表给可变参数</span><code data-lake-id=\"u057f1ca0\" id=\"u057f1ca0\"><span data-lake-id=\"u65dac10c\" id=\"u65dac10c\">args</span></code><span data-lake-id=\"ue62ad01c\" id=\"ue62ad01c\">，需要在元组/列表前加上</span><code data-lake-id=\"ub4e34701\" id=\"ub4e34701\"><span data-lake-id=\"udfd53f2f\" id=\"udfd53f2f\">*</span></code><span data-lake-id=\"ub4c80cad\" id=\"ub4c80cad\">进行解包操作</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22def%20func(*args)%3A%5Cn%20%20%20%20print(args)%23(10%2C20%2C30)%5Cn%5Cnt%20%3D%20(10%2C20%2C30)%5Cn%23%20%E4%BC%A0%E9%80%92%E5%85%83%E7%BB%84%5Cnfunc(*t)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22rXy26%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"F9TNh\" id=\"F9TNh\" data-lake-index-type=\"2\"><span data-lake-id=\"ud0c83466\" id=\"ud0c83466\">传递字典给可变参数kwargs</span></h2><p data-lake-id=\"ue922a9e8\" id=\"ue922a9e8\"><span data-lake-id=\"u251af805\" id=\"u251af805\">在字典的前面加上**的作用是将字典中的元素解包成一个一个的不存在的关键字参数传递给函数</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22def%20func(**kwargs)%3A%5Cn%20%20%20%20print(kwargs)%5Cn%5Cnd%20%3D%20%7B'name'%3A'%E5%BC%A0%E4%B8%89'%2C%20'age'%3A40%7D%5Cn%23%20%E4%BC%A0%E9%80%92%E5%AD%97%E5%85%B8%E7%BB%99%E5%8F%AF%E5%8F%98%E5%8F%82%E6%95%B0kwargs%5Cnfunc(**d)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22yG1tu%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"xXtOY\" id=\"xXtOY\" data-lake-index-type=\"2\"><span data-lake-id=\"uc4614030\" id=\"uc4614030\">组合使用</span></h2><p data-lake-id=\"ub6c9b27c\" id=\"ub6c9b27c\"><code data-lake-id=\"ue8caadbb\" id=\"ue8caadbb\"><span data-lake-id=\"uf38971c4\" id=\"uf38971c4\" style=\"color: rgb(34, 34, 34); background-color: rgb(236, 240, 243)\">**</span><span data-lake-id=\"uf5f4e988\" id=\"uf5f4e988\">kwargs</span></code><span data-lake-id=\"u7a4710d9\" id=\"u7a4710d9\" class=\"lake-fontsize-12\" style=\"color: rgb(34, 34, 34)\">形参可以与 </span><code data-lake-id=\"u6915c523\" id=\"u6915c523\"><span data-lake-id=\"u49e5bcd9\" id=\"u49e5bcd9\" style=\"color: rgb(34, 34, 34); background-color: rgb(236, 240, 243)\">*</span><span data-lake-id=\"uae5874b0\" id=\"uae5874b0\">args</span></code><span data-lake-id=\"u9c48bc99\" id=\"u9c48bc99\" class=\"lake-fontsize-12\" style=\"color: rgb(34, 34, 34)\">形参组合使用（</span><code data-lake-id=\"ud46c4b90\" id=\"ud46c4b90\"><span data-lake-id=\"u60ab3776\" id=\"u60ab3776\" style=\"color: rgb(34, 34, 34); background-color: rgb(236, 240, 243)\">*</span><span data-lake-id=\"u1bb6afe8\" id=\"u1bb6afe8\">args</span></code><span data-lake-id=\"u54860a7a\" id=\"u54860a7a\" class=\"lake-fontsize-12\" style=\"color: rgb(34, 34, 34)\">必须在 </span><code data-lake-id=\"u8434503e\" id=\"u8434503e\"><span data-lake-id=\"u9705c804\" id=\"u9705c804\" style=\"color: rgb(34, 34, 34); background-color: rgb(236, 240, 243)\">**</span><span data-lake-id=\"uff6aa15a\" id=\"uff6aa15a\">kwargs</span></code><span data-lake-id=\"ud946462b\" id=\"ud946462b\" class=\"lake-fontsize-12\" style=\"color: rgb(34, 34, 34)\">前面）， </span><code data-lake-id=\"u7941548f\" id=\"u7941548f\"><span data-lake-id=\"u2914d1d1\" id=\"u2914d1d1\" style=\"color: rgb(34, 34, 34); background-color: rgb(236, 240, 243)\">*</span><span data-lake-id=\"u11a1ec32\" id=\"u11a1ec32\">args</span></code><span data-lake-id=\"u61cc718c\" id=\"u61cc718c\" class=\"lake-fontsize-12\" style=\"color: rgb(34, 34, 34)\">形参接收一个元组。</span></p><p data-lake-id=\"u4be4b7c2\" id=\"u4be4b7c2\"><span data-lake-id=\"u7dacfc10\" id=\"u7dacfc10\" class=\"lake-fontsize-12\" style=\"color: rgb(34, 34, 34)\">例如，定义如下函数：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22def%20milk_tea_shop(kind%2C%20*arguments%2C%20**keywords)%3A%5Cn%20%20%20%20print(%5C%22--%20%E8%80%81%E6%9D%BF%EF%BC%8C%E7%BB%99%E6%88%91%E6%9D%A5%E6%9D%AF%5C%22%2C%20kind%2C%20%5C%22%EF%BC%81%5C%22)%5Cn%20%20%20%20for%20arg%20in%20arguments%3A%5Cn%20%20%20%20%20%20%20%20print(arg)%5Cn%20%20%20%20print(%5C%22-%5C%22%20*%2040)%5Cn%20%20%20%20for%20kw%20in%20keywords%3A%5Cn%20%20%20%20%20%20%20%20print(kw%2C%20%5C%22%3A%5C%22%2C%20keywords%5B