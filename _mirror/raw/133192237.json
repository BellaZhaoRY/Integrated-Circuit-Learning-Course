  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h1 data-lake-id=\"LY2tK\" id=\"LY2tK\"><span data-lake-id=\"uaf4d6290\" id=\"uaf4d6290\" style=\"color: rgb(51, 51, 51)\">1. 创建新的工程目录</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22mkdir%20-p%20~%2Fdev_ws%2Fsrc%5Cncd%20~%2Fdev_ws%2Fsrc%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22jbUVS%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"ZLoaX\" id=\"ZLoaX\"><span data-lake-id=\"u21abf955\" id=\"u21abf955\" style=\"color: rgb(51, 51, 51)\">2. 节点实现</span></h1><h2 data-lake-id=\"fW8of\" id=\"fW8of\"><span data-lake-id=\"ue57a06b8\" id=\"ue57a06b8\" style=\"color: rgb(51, 51, 51)\">1. 创建package</span></h2><p data-lake-id=\"uee33b3d7\" id=\"uee33b3d7\"><span data-lake-id=\"u9caf68ca\" id=\"u9caf68ca\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在src目录下执行如下命令创建package</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20pkg%20create%20--build-type%20ament_python%20first_pkg%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22w4ZeD%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ue0eedb30\" id=\"ue0eedb30\"><span data-lake-id=\"u225b17db\" id=\"u225b17db\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">可以修改</span><span data-lake-id=\"ufe8da25e\" id=\"ufe8da25e\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"u2c3253cc\" id=\"u2c3253cc\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">文件如下信息</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22%3Cdescription%3EC%2B%2B%20client%20server%20tutorial%3C%2Fdescription%3E%5Cn%3Cmaintainer%20email%3D%5C%22you%40email.com%5C%22%3EYour%20Name%3C%2Fmaintainer%3E%5Cn%3Clicense%3EApache%20License%202.0%3C%2Flicense%3E%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22rkO3p%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ue986a9d5\" id=\"ue986a9d5\"><br></p><h2 data-lake-id=\"oH8Ua\" id=\"oH8Ua\"><span data-lake-id=\"u4da0491d\" id=\"u4da0491d\" style=\"color: rgb(51, 51, 51)\">2. 编写代码</span></h2><p data-lake-id=\"u2e09448f\" id=\"u2e09448f\"><span data-lake-id=\"u40f49b3d\" id=\"u40f49b3d\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在</span><span data-lake-id=\"u75b53a64\" id=\"u75b53a64\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">first_package</span><span data-lake-id=\"uf65c1ee0\" id=\"uf65c1ee0\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">目录的</span><span data-lake-id=\"u8f5f6e1a\" id=\"u8f5f6e1a\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">first_package</span><span data-lake-id=\"u035a5a6b\" id=\"u035a5a6b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">下创建</span><span data-lake-id=\"u0cfaefff\" id=\"u0cfaefff\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">first_node.py</span><span data-lake-id=\"u7de7275e\" id=\"u7de7275e\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,代码如下</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22import%20rclpy%5Cnfrom%20rclpy.node%20import%20Node%5Cn%5Cnclass%20MyNode(Node)%3A%5Cn%20%20%20%20def%20__init__(self)%3A%5Cn%20%20%20%20%20%20%20%20super(MyNode%2C%20self).__init__('first_node')%5Cn%20%20%20%20%20%20%20%20while%20rclpy.ok()%3A%5Cn%20%20%20%20%20%20%20%20%20%20%20%20self.get_logger().info('hello')%5Cn%5Cndef%20main()%3A%5Cn%20%20%5Ctrclpy.init()%5Cn%20%20%20%20node%20%3D%20MyNode()%5Cn%20%20%20%20try%3A%5Cn%20%20%20%20%20%20%20%20rclpy.spin(node)%5Cn%20%20%20%20%20%20%20%20node.destroy_node()%5Cn%20%20%20%20%20%20%20%20rclpy.shutdown()%5Cn%20%20%20%20except%3A%5Cn%20%20%20%20%20%20%20%20pass%5Cn%20%20%20%20%20%20%20%20%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20main()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22customStyle%22%3A%5B%5D%2C%22id%22%3A%22RhDs5%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"zk92r\" id=\"zk92r\"><span data-lake-id=\"u8539f2be\" id=\"u8539f2be\" style=\"color: rgb(51, 51, 51)\">3. 配置工程</span></h2><p data-lake-id=\"ucaa9bf2c\" id=\"ucaa9bf2c\"><span data-lake-id=\"u9185ae82\" id=\"u9185ae82\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在</span><span data-lake-id=\"u4ae94553\" id=\"u4ae94553\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">setup.py</span><span data-lake-id=\"u8a8771fd\" id=\"u8a8771fd\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件中做如下修改:</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22'console_scripts'%3A%20%5B%5Cn%20%20%20%20'first_node%20%3D%20first_pkg.first_node%3Amain'%2C%5Cn%5D%2C%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22mg0Yw%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u79a1caf9\" id=\"u79a1caf9\"><span data-lake-id=\"u879c6ea9\" id=\"u879c6ea9\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">first_node是节点名 </span></p><p data-lake-id=\"u490f4200\" id=\"u490f4200\"><span data-lake-id=\"ua3ae3800\" id=\"ua3ae3800\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">可以在</span><span data-lake-id=\"ub7a46dd3\" id=\"ub7a46dd3\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"ua29f7dc0\" id=\"ua29f7dc0\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件中配置依赖</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22xml%22%2C%22code%22%3A%22%3Cdepend%3Erclpy%3C%2Fdepend%3E%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22nzidE%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"tUEUP\" id=\"tUEUP\"><span data-lake-id=\"ubb887181\" id=\"ubb887181\" style=\"color: rgb(51, 51, 51)\">3. 构建工程</span></h2><p data-lake-id=\"u00e81474\" id=\"u00e81474\"><span data-lake-id=\"u8d7cd785\" id=\"u8d7cd785\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">在工程目录下执行如下命令</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22colcon%20build%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22DspXm%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"y8AzP\" id=\"y8AzP\"><span data-lake-id=\"u6a73a007\" id=\"u6a73a007\" style=\"color: rgb(51, 51, 51)\">4. 运行package</span></h2><ol list=\"u8e01fd6b\"><li fid=\"u127dc2f0\" data-lake-id=\"u04acf2dd\" id=\"u04acf2dd\"><span data-lake-id=\"u780104f8\" id=\"u780104f8\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">source the setup file</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22source%20install%2Fsetup.bash%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22poyQb%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><ol list=\"u8e01fd6b\" start=\"2\"><li fid=\"u127dc2f0\" data-lake-id=\"u2a3708c5\" id=\"u2a3708c5\"><span data-lake-id=\"u9716fb51\" id=\"u9716fb51\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">运行package</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20run%20package%E5%90%8D%E7%A7%B0%20%E8%8A%82%E7%82%B9%E5%90%8D%E7%A7%B0%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Eb8Nn%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ud2d3c90e\" id=\"ud2d3c90e\"><span data-lake-id=\"ub2ddfa53\" id=\"ub2ddfa53\"><br /></span><span data-lake-id=\"uc22ef587\" id=\"uc22ef587\"> </span></p>",
