  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h3 data-lake-id=\"4ca0a21c\" id=\"4ca0a21c\"><span data-lake-id=\"ua3e684a7\" id=\"ua3e684a7\">GPIO 操作步骤对比表</span></h3><table data-lake-id=\"l7kmt\" id=\"l7kmt\" margin=\"true\" class=\"lake-table\" style=\"width: 750px\"><colgroup><col width=\"150\"><col width=\"150\"><col width=\"150\"><col width=\"150\"><col width=\"150\"></colgroup><tbody><tr data-lake-id=\"u17a56c03\" id=\"u17a56c03\"><td data-lake-id=\"u63e559eb\" id=\"u63e559eb\"><p data-lake-id=\"u6a09b071\" id=\"u6a09b071\"><span data-lake-id=\"u4accc6cb\" id=\"u4accc6cb\">步骤 / 平台</span></p></td><td data-lake-id=\"u0a083330\" id=\"u0a083330\"><p data-lake-id=\"u7293c8b2\" id=\"u7293c8b2\"><span data-lake-id=\"u506cef5d\" id=\"u506cef5d\">8051（stc8）</span></p></td><td data-lake-id=\"u729da2f7\" id=\"u729da2f7\"><p data-lake-id=\"u71eaaadc\" id=\"u71eaaadc\"><span data-lake-id=\"u1d5eb0f8\" id=\"u1d5eb0f8\">GD32（GD32F407）</span></p></td><td data-lake-id=\"ud18dd4c3\" id=\"ud18dd4c3\"><p data-lake-id=\"ubf7d7744\" id=\"ubf7d7744\"><span data-lake-id=\"u47094bb3\" id=\"u47094bb3\">Linux + Python + libgpiod</span></p></td><td data-lake-id=\"u090d0113\" id=\"u090d0113\"><p data-lake-id=\"u13601033\" id=\"u13601033\"><span data-lake-id=\"u7e18a484\" id=\"u7e18a484\">Linux + C + libgpiod</span></p></td></tr><tr data-lake-id=\"ua730723c\" id=\"ua730723c\"><td data-lake-id=\"u5068a42c\" id=\"u5068a42c\"><p data-lake-id=\"ud2860919\" id=\"ud2860919\"><strong><span data-lake-id=\"u93d97fe3\" id=\"u93d97fe3\">1. 包含/引入头文件</span></strong></p></td><td data-lake-id=\"ucbe00df0\" id=\"ucbe00df0\"><p data-lake-id=\"ue4bdb43e\" id=\"ue4bdb43e\"><span data-lake-id=\"ucc163b4f\" id=\"ucc163b4f\">stc8h.h（使用寄存器）</span></p></td><td data-lake-id=\"u0840e39c\" id=\"u0840e39c\"><p data-lake-id=\"u91adfd82\" id=\"u91adfd82\"><code data-lake-id=\"u011cb903\" id=\"u011cb903\"><span data-lake-id=\"u39fbb33b\" id=\"u39fbb33b\">#include &quot;gd32f4xx.h&quot;</span></code></p><p data-lake-id=\"u951e582b\" id=\"u951e582b\"><span data-lake-id=\"u632f2507\" id=\"u632f2507\">等</span></p></td><td data-lake-id=\"u359b3421\" id=\"u359b3421\"><p data-lake-id=\"u69632e5e\" id=\"u69632e5e\"><code data-lake-id=\"ua435c7d0\" id=\"ua435c7d0\"><span data-lake-id=\"u62eca9de\" id=\"u62eca9de\">import gpiod</span></code></p></td><td data-lake-id=\"ua4fdbf95\" id=\"ua4fdbf95\"><p data-lake-id=\"u27d6f62f\" id=\"u27d6f62f\"><code data-lake-id=\"ue7d8a6ac\" id=\"ue7d8a6ac\"><span data-lake-id=\"ubd805557\" id=\"ubd805557\">#include &lt;gpiod.h&gt;</span></code></p></td></tr><tr data-lake-id=\"u2f77f6d7\" id=\"u2f77f6d7\"><td data-lake-id=\"ufd6a92c4\" id=\"ufd6a92c4\"><p data-lake-id=\"ua61ac00c\" id=\"ua61ac00c\"><strong><span data-lake-id=\"u917879b3\" id=\"u917879b3\">2. 端口初始化</span></strong></p></td><td data-lake-id=\"u5de03315\" id=\"u5de03315\"><p data-lake-id=\"u1466dc50\" id=\"u1466dc50\"><span data-lake-id=\"u50f103a7\" id=\"u50f103a7\">不需要（寄存器天然可直接访问）</span></p></td><td data-lake-id=\"uc7bbc9cf\" id=\"uc7bbc9cf\"><p data-lake-id=\"u7f9ef989\" id=\"u7f9ef989\"><span data-lake-id=\"ufc0f982e\" id=\"ufc0f982e\">配置时钟、GPIO 模式、上下拉等</span></p></td><td data-lake-id=\"u2fa67ea5\" id=\"u2fa67ea5\"><p data-lake-id=\"ubdeaaf19\" id=\"ubdeaaf19\"><span data-lake-id=\"uba26ebbb\" id=\"uba26ebbb\">不需要显式初始化</span></p></td><td data-lake-id=\"u46d74c41\" id=\"u46d74c41\"><p data-lake-id=\"u923c5ccb\" id=\"u923c5ccb\"><span data-lake-id=\"uefc43af0\" id=\"uefc43af0\">不需要显式初始化</span></p></td></tr><tr data-lake-id=\"ueb09fd8b\" id=\"ueb09fd8b\"><td data-lake-id=\"u13690e0f\" id=\"u13690e0f\"><p data-lake-id=\"u5a0eadd6\" id=\"u5a0eadd6\"><strong><span data-lake-id=\"ubed2c6a7\" id=\"ubed2c6a7\">3. 设置IO方向（输入/输出）</span></strong></p></td><td data-lake-id=\"u62bf752d\" id=\"u62bf752d\"><p data-lake-id=\"u4aa47b08\" id=\"u4aa47b08\"><span data-lake-id=\"ue3922d03\" id=\"ue3922d03\">直接操作 SFR（如 </span><code data-lake-id=\"ue930be84\" id=\"ue930be84\"><span data-lake-id=\"uce1867ea\" id=\"uce1867ea\">P1 = 0x00</span></code></p><p data-lake-id=\"uc175b489\" id=\"uc175b489\"><span data-lake-id=\"u98f259b3\" id=\"u98f259b3\">）</span></p></td><td data-lake-id=\"u84a66d79\" id=\"u84a66d79\"><p data-lake-id=\"u1daff847\" id=\"u1daff847\"><span data-lake-id=\"ub176b523\" id=\"ub176b523\">使用 </span><code data-lake-id=\"u0cc42bc1\" id=\"u0cc42bc1\"><span data-lake-id=\"ue30773f0\" id=\"ue30773f0\">gpio_init()</span></code></p><p data-lake-id=\"udde87b9c\" id=\"udde87b9c\"><span data-lake-id=\"u8461e417\" id=\"u8461e417\"> 设置模式为输入/输出</span></p></td><td data-lake-id=\"u26a27e8b\" id=\"u26a27e8b\"><p data-lake-id=\"ub96a62e4\" id=\"ub96a62e4\"><span data-lake-id=\"uba73d708\" id=\"uba73d708\">使用 </span><code data-lake-id=\"u87240948\" id=\"u87240948\"><span data-lake-id=\"u5ae44674\" id=\"u5ae44674\">line.request()</span></code></p><p data-lake-id=\"u1569eaa4\" id=\"u1569eaa4\"><span data-lake-id=\"u5f727032\" id=\"u5f727032\"> 方法选择方向</span></p></td><td data-lake-id=\"u1ab336a9\" id=\"u1ab336a9\"><p data-lake-id=\"u93a5c4ed\" id=\"u93a5c4ed\"><span data-lake-id=\"uea558852\" id=\"uea558852\">使用 </span><code data-lake-id=\"ueb51ea89\" id=\"ueb51ea89\"><span data-lake-id=\"ubead82fd\" id=\"ubead82fd\">gpiod_line_request_output()</span></code></p><p data-lake-id=\"u1c0c3185\" id=\"u1c0c3185\"><span data-lake-id=\"u6df3ab30\" id=\"u6df3ab30\"> 等</span></p></td></tr><tr data-lake-id=\"u15d6abc2\" id=\"u15d6abc2\"><td data-lake-id=\"ue1019445\" id=\"ue1019445\"><p data-lake-id=\"u01dd6420\" id=\"u01dd6420\"><strong><span data-lake-id=\"ufc5f24d0\" id=\"ufc5f24d0\">4. 设置输出高/低</span></strong></p></td><td data-lake-id=\"udda7c204\" id=\"udda7c204\"><p data-lake-id=\"u040f6b50\" id=\"u040f6b50\"><code data-lake-id=\"u17ce7ec5\" id=\"u17ce7ec5\"><span data-lake-id=\"ub56e8e43\" id=\"ub56e8e43\">P1 = 0xFF</span></code></p><p data-lake-id=\"u4b367acb\" id=\"u4b367acb\"><span data-lake-id=\"u6ce3c931\" id=\"u6ce3c931\"> 或 </span><code data-lake-id=\"u0f82243c\" id=\"u0f82243c\"><span data-lake-id=\"ue628febb\" id=\"ue628febb\">P1_0 = 1</span></code></p><p data-lake-id=\"u8d062e62\" id=\"u8d062e62\"><span data-lake-id=\"uca2175ab\" id=\"uca2175ab\"> 等</span></p></td><td data-lake-id=\"u8e7be7f6\" id=\"u8e7be7f6\"><p data-lake-id=\"ufb8a6580\" id=\"ufb8a6580\"><code data-lake-id=\"ued5e87af\" id=\"ued5e87af\"><span data-lake-id=\"u4c768d2f\" id=\"u4c768d2f\">gpio_bit_set(GPIOx, GPIO_PIN_y)</span></code></p></td><td data-lake-id=\"u2b25fcca\" id=\"u2b25fcca\"><p data-lake-id=\"u3ab15bde\" id=\"u3ab15bde\"><code data-lake-id=\"ua4f40c59\" id=\"ua4f40c59\"><span data-lake-id=\"ua8fdb14d\" id=\"ua8fdb14d\">line.set_value(1)</span></code></p></td><td data-lake-id=\"u21582ff0\" id=\"u21582ff0\"><p data-lake-id=\"u2e890c08\" id=\"u2e890c08\"><code data-lake-id=\"u0a8db070\" id=\"u0a8db070\"><span data-lake-id=\"u893ea8ff\" id=\"u893ea8ff\">gpiod_line_set_value(line, 1)</span></code></p></td></tr><tr data-lake-id=\"u4ee5aed8\" id=\"u4ee5aed8\"><td data-lake-id=\"u61b51704\" id=\"u61b51704\"><p data-lake-id=\"u4f312e4c\" id=\"u4f312e4c\"><strong><span data-lake-id=\"u7094e47f\" id=\"u7094e47f\">5. 读取IO电平</span></strong></p></td><td data-lake-id=\"u3c6adfb2\" id=\"u3c6adfb2\"><p data-lake-id=\"u3418d3c2\" id=\"u3418d3c2\"><code data-lake-id=\"ucb7598a9\" id=\"ucb7598a9\"><span data-lake-id=\"uc0fe6417\" id=\"uc0fe6417\">bit = P1_0</span></code></p></td><td data-lake-id=\"uc2cfbefd\" id=\"uc2cfbefd\"><p data-lake-id=\"ua831fedd\" id=\"ua831fedd\"><code data-lake-id=\"udb1a323e\" id=\"udb1a323e\"><span data-lake-id=\"u10c8dd91\" id=\"u10c8dd91\">gpio_input_bit_get(GPIOx, GPIO_PIN_y)</span></code></p></td><td data-lake-id=\"u3b647008\" id=\"u3b647008\"><p data-lake-id=\"u609de25a\" id=\"u609de25a\"><code data-lake-id=\"u007d3aad\" id=\"u007d3aad\"><span data-lake-id=\"u7ace2361\" id=\"u7ace2361\">val = line.get_value()</span></code></p></td><td data-lake-id=\"ub7fc3ba2\" id=\"ub7fc3ba2\"><p data-lake-id=\"uccb114d3\" id=\"uccb114d3\"><code data-lake-id=\"u65bb17f4\" id=\"u65bb17f4\"><span data-lake-id=\"uada5b802\" id=\"uada5b802\">val = gpiod_line_get_value(line)</span></code></p></td></tr><tr data-lake-id=\"u5fbbc433\" id=\"u5fbbc433\"><td data-lake-id=\"u247d09cb\" id=\"u247d09cb\"><p data-lake-id=\"u347d99e6\" id=\"u347d99e6\"><strong><span data-lake-id=\"u7b7ead95\" id=\"u7b7ead95\">6. 特殊说明</span></strong></p></td><td data-lake-id=\"uf02b6485\" id=\"uf02b6485\"><p data-lake-id=\"uc1327dbf\" id=\"uc1327dbf\"><span data-lake-id=\"u8f2bd92f\" id=\"u8f2bd92f\">IO 操作直接控制寄存器</span></p></td><td data-lake-id=\"u3be5ff7a\" id=\"u3be5ff7a\"><p data-lake-id=\"u879d98af\" id=\"u879d98af\"><span data-lake-id=\"u16e0c081\" id=\"u16e0c081\">需要先初始化 RCC，再配置 GPIO</span></p></td><td data-lake-id=\"uca8b5662\" id=\"uca8b5662\"><p data-lake-id=\"u56a3bf80\" id=\"u56a3bf80\"><span data-lake-id=\"uec4fbc34\" id=\"uec4fbc34\">需要访问 </span><code data-lake-id=\"u1caaedc6\" id=\"u1caaedc6\"><span data-lake-id=\"u028f9e10\" id=\"u028f9e10\">/dev/gpiochipX</span></code></p><p data-lake-id=\"u573e6314\" id=\"u573e6314\"><span data-lake-id=\"u136b5510\" id=\"u136b5510\"> 设备节点</span></p></td><td data-lake-id=\"ua43b2991\" id=\"ua43b2991\"><p data-lake-id=\"udfb12806\" id=\"udfb12806\"><span data-lake-id=\"uf720a229\" id=\"uf720a229\">同左，建议管理好chip和line结构体的释放</span></p></td></tr><tr data-lake-id=\"u9611068e\" id=\"u9611068e\"><td data-lake-id=\"ucb032801\" id=\"ucb032801\"><p data-lake-id=\"u1a2017dc\" id=\"u1a2017dc\"><strong><span data-lake-id=\"uf1c327eb\" id=\"uf1c327eb\">7. 清理/释放资源</span></strong></p></td><td data-lake-id=\"u620d9d30\" id=\"u620d9d30\"><p data-lake-id=\"u3c5a2d6b\" id=\"u3c5a2d6b\"><span data-lake-id=\"uc6bba88a\" id=\"uc6bba88a\">不需要</span></p></td><td data-lake-id=\"u1ecfbce8\" id=\"u1ecfbce8\"><p data-lake-id=\"u4149f370\" id=\"u4149f370\"><span data-lake-id=\"ua809d01c\" id=\"ua809d01c\">不需要</span></p></td><td data-lake-id=\"u11ce910d\" id=\"u11ce910d\"><p data-lake-id=\"u700f165a\" id=\"u700f165a\"><code data-lake-id=\"u9b3ad871\" id=\"u9b3ad871\"><span data-lake-id=\"u4f9dab18\" id=\"u4f9dab18\">line.release()</span></code></p><p data-lake-id=\"ue17fa0ce\" id=\"ue17fa0ce\"><span data-lake-id=\"u7529544c\" id=\"u7529544c\"> （可选）</span></p></td><td data-lake-id=\"uea0ed281\" id=\"uea0ed281\"><p data-lake-id=\"u64206a74\" id=\"u64206a74\"><code data-lake-id=\"u0671dc9b\" id=\"u0671dc9b\"><span data-lake-id=\"u727f9643\" id=\"u727f9643\">gpiod_line_release()</span></code></p><p data-lake-id=\"u7ac895af\" id=\"u7ac895af\"><span data-lake-id=\"u5014fd76\" id=\"u5014fd76\">, </span><code data-lake-id=\"u93bdcb23\" id=\"u93bdcb23\"><span data-lake-id=\"u32271305\" id=\"u32271305\">gpiod_chip_close()</span></code></p></td></tr></tbody></table>",
