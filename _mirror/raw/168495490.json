2919c67\">上拉</span></strong><span data-lake-id=\"uef029b00\" id=\"uef029b00\">，给一个默认的状态。</span></p><p data-lake-id=\"u8c8fdf74\" id=\"u8c8fdf74\"><span data-lake-id=\"u4449373d\" id=\"u4449373d\">因此，抬起时，默认为高电平；按下时，为低电平。</span></p><h4 data-lake-id=\"SDlOu\" id=\"SDlOu\"><span data-lake-id=\"uc381b591\" id=\"uc381b591\">实现逻辑</span></h4><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22gpio%20%E5%88%9D%E5%A7%8B%E5%8C%96%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%2F*********************%20PC0%20%E6%8C%89%E9%94%AE%E5%BC%95%E8%84%9A%20*********************%2F%5Cn%2F%2F%20%E6%97%B6%E9%92%9F%E5%88%9D%E5%A7%8B%E5%8C%96%5Cnrcu_periph_clock_enable(RCU_GPIOC)%3B%5Cn%2F%2F%20%E9%85%8D%E7%BD%AEGPIO%E6%A8%A1%E5%BC%8F%5Cngpio_mode_set(GPIOC%2C%20GPIO_MODE_INPUT%2C%20GPIO_PUPD_PULLUP%2C%20GPIO_PIN_0)%3B%5Cn%5Cn%2F*********************%20PB2%20LED1%E5%BC%95%E8%84%9A%20*********************%2F%5Cn%2F%2F%201.%20%E6%97%B6%E9%92%9F%E5%88%9D%E5%A7%8B%E5%8C%96%5Cnrcu_periph_clock_enable(RCU_GPIOB)%3B%5Cn%2F%2F%202.%20%E9%85%8D%E7%BD%AEGPIO%20%E8%BE%93%E5%85%A5%E8%BE%93%E5%87%BA%E6%A8%A1%E5%BC%8F%5Cngpio_mode_set(GPIOB%2C%20GPIO_MODE_OUTPUT%2C%20GPIO_PUPD_NONE%2C%20GPIO_PIN_2)%3B%5Cn%2F%2F%203.%20%E9%85%8D%E7%BD%AEGPIO%20%E6%A8%A1%E5%BC%8F%E7%9A%84%E6%93%8D%E4%BD%9C%E6%96%B9%E5%BC%8F%5Cngpio_output_options_set(GPIOB%2C%20GPIO_OTYPE_PP%2C%20GPIO_OSPEED_2MHZ%2C%20GPIO_PIN_2)%3B%5Cn%2F%2F%20%E5%88%9D%E5%A7%8B%E5%8C%96%E4%B8%BA%E4%BD%8E%E7%94%B5%E5%B9%B3%5Cngpio_bit_reset(GPIOB%2C%20GPIO_PIN_2)%3B%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22gpio%20%E5%88%9D%E5%A7%8B%E5%8C%96%22%2C%22tabSize%22%3A%222%22%2C%22indentWithTab%22%3Atrue%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Night%20Owl%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22mc5BG%22%2C%22margin%22%3A%7B%22top%22%3Atrue