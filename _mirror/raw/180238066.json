  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h2 data-lake-id=\"SOB3v\" id=\"SOB3v\" data-lake-index-type=\"2\"><span data-lake-id=\"uf9631a6d\" id=\"uf9631a6d\">单行文本输入框</span></h2><p data-lake-id=\"ud83523b9\" id=\"ud83523b9\"><span data-lake-id=\"u7fbc3e39\" id=\"u7fbc3e39\">QLineEdit控件可以输入单行文本</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22from%20PyQt5.QtWidgets%20import%20QApplication%2C%20QWidget%2C%20QLineEdit%2C%20QVBoxLayout%5Cnfrom%20PyQt5.QtCore%20import%20*%5Cnfrom%20PyQt5.QtGui%20import%20QIcon%5Cnimport%20sys%5Cn%5Cn%5Cndef%20init_widget(w%3A%20QWidget)%3A%5Cn%20%20%20%20%23%20%E4%BF%AE%E6%94%B9%E7%AA%97%E5%8F%A3%E6%A0%87%E9%A2%98%5Cn%20%20%20%20w.setWindowTitle('%E5%8D%95%E8%A1%8C%E8%BE%93%E5%85%A5%E6%A1%86')%5Cn%20%20%20%20%23%20%E8%AE%BE%E7%BD%AE%E7%AA%97%E5%8F%A3%E5%A4%A7%E5%B0%8F%5Cn%20%20%20%20w.resize(480%2C%20320)%5Cn%5Cn%20%20%20%20layout%20%3D%20QVBoxLayout()%5Cn%20%20%20%20%5C%22%5C%22%5C%22------------------%20%E5%B1%95%E7%A4%BA%E5%8D%95%E8%A1%8C%E8%BE%93%E5%85%A5%E6%A1%86%20------------------%5C%22%5C%22%5C%22%5Cn%20%20%20%20edit%20%3D%20QLineEdit()%5Cn%20%20%20%20%23%20%E8%AE%BE%E7%BD%AE%E8%BE%93%E5%85%A5%E6%A1%86%E6%8F%90%E7%A4%BA%5Cn%20%20%20%20edit.setPlaceholderText('%E8%AF%B7%E8%BE%93%E5%85%A5%E7%94%A8%E6%88%B7%E5%90%8D')%5Cn%20%20%20%20%23%20%E8%AE%BE%E7%BD%AE%E6%96%87%E6%9C%AC%5Cn%20%20%20%20edit.setText('%E5%BC%A0%E4%B8%89')%5Cn%20%20%20%20%23%20%E8%8E%B7%E5%8F%96%E5%8D%95%E9%80%89%E6%A1%86%E7%9A%84%E6%96%87%E5%AD%97%5Cn%20%20%20%20text%20%3D%20edit.text()%5Cn%20%20%20%20print(text)%5Cn%20%20%20%20%23%20%E8%AE%BE%E7%BD%AE%E8%BE%93%E5%85%A5%E6%A1%86%E6%9C%80%E5%A4%A7%E5%AD%97%E7%AC%A6%E6%95%B0%5Cn%20%20%20%20edit.setMaxLength(10)%5Cn%20%20%20%20layout.addWidget(edit)%5Cn%5Cn%20%20%20%20edit3%20%3D%20QLineEdit(%5C%22Password%5C%22)%5Cn%20%20%20%20edit3.setPlaceholderText('%E8%AF%B7%E8%BE%93%E5%85%A5%E5%AF%86%E7%A0%81')%5Cn%20%20%20%20edit3.setEchoMode(QLineEdit.Password)%5Cn%20%20%20%20layout.addWidget(edit3)%5Cn%5Cn%20%20%20%20w.setLayout(layout)%5Cn%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20%23%201.%E5%88%9B%E5%BB%BA%E5%BA%94%E7%94%A8%E7%A8%8B%E5%BA%8F%5Cn%20%20%20%20app%20%3D%20QApplication(sys.argv)%5Cn%20%20%20%20%23%202.%E5%88%9B%E5%BB%BA%E7%AA%97%E5%8F%A3%5Cn%20%20%20%20w%20%3D%20QWidget()%5Cn%20%20%20%20init_widget(w)%5Cn%20%20%20%20%23%203.%E6%98%BE%E7%A4%BA%E7%AA%97%E5%8F%A3%5Cn%20%20%20%20w.show()%5Cn%20%20%20%20%23%204.%E7%AD%89%E5%BE%85%E7%AA%97%E5%8F%A3%E5%81%9C%E6%AD%A2%5Cn%20%20%20%20sys.exit(app.exec())%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22qoY53%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u18b08ba6\" id=\"u18b08ba6\"><span data-lake-id=\"u04a92669\" id=\"u04a92669\">运行程序:</span></p><p data-lake-id=\"u8b1c3feb\" id=\"u8b1c3feb\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1685237147880-6dea33de-1b84-4d8b-96ba-013d6497c2c9.png%22%2C%22taskId%22%3A%22u4fc71149-ae77-45a1-a741-345bae61adf%22%2C%22clientId%22%3A%22u5f06e377-82d5-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A385.6%2C%22height%22%3A287%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A3979%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A482%2C%22originHeight%22%3A359%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22search%22%3A%22%E5%8D%95%E8%A1%8C%E8%BE%93%E5%85%A5%E6%A1%86%20%E5%BC%A0%E4%B8%89%22%2C%22ocrLocations%22%3A%5B%7B%22x%22%3A35%2C%22y%22%3A12%2C%22width%22%3A76%2C%22height%22%3A15%2C%22text%22%3A%22%E5%8D%95%E8%A1%8C%E8%BE%93%E5%85%A5%E6%A1%86%22%7D%2C%7B%22x%22%3A15%2C%22y%22%3A132%2C%22width%22%3A35%2C%22height%22%3A18%2C%22text%22%3A%22%E5%BC%A0%E4%B8%89%22%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f0f0ef%22%2C%22id%22%3A%22ufd1e257d%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u153f9a41\" id=\"u153f9a41\"><strong><span data-lake-id=\"ubd3624f3\" id=\"ubd3624f3\">QLineEdit的方法</span></strong></p><table data-lake-id=\"B9eyM\" id=\"B9eyM\" margin=\"true\" class=\"lake-table\" style=\"width: 709px\"><colgroup><col width=\"215\"><col width=\"494\"></colgroup><tbody><tr data-lake-id=\"u7236bb87\" id=\"u7236bb87\"><td data-lake-id=\"uca1577a8\" id=\"uca1577a8\"><p data-lake-id=\"ua3072a18\" id=\"ua3072a18\" style=\"text-align: center\"><strong><span data-lake-id=\"u34e0f70f\" id=\"u34e0f70f\">方法</span></strong></p></td><td data-lake-id=\"u1ef07035\" id=\"u1ef07035\"><p data-lake-id=\"u59bb4c7f\" id=\"u59bb4c7f\" style=\"text-align: center\"><strong><span data-lake-id=\"ua4aa6596\" id=\"ua4aa6596\">说明</span></strong></p></td></tr><tr data-lake-id=\"u826b1381\" id=\"u826b1381\"><td data-lake-id=\"u81df6873\" id=\"u81df6873\"><p data-lake-id=\"u8853aceb\" id=\"u8853aceb\" style=\"text-align: center\"><code data-lake-id=\"u0de984ba\" id=\"u0de984ba\"><span data-lake-id=\"u98474c6b\" id=\"u98474c6b\">setEchoMode()</span></code></p></td><td data-lake-id=\"u2dc1f2f7\" id=\"u2dc1f2f7\"><p data-lake-id=\"u571ada7b\" id=\"u571ada7b\"><code data-lake-id=\"u93f9ead3\" id=\"u93f9ead3\"><span data-lake-id=\"uff693f6c\" id=\"uff693f6c\">QLineEdit.Normal</span></code><span data-lake-id=\"u3b171982\" id=\"u3b171982\">正常显示所输入的字符,默认选项</span></p><p data-lake-id=\"ub278a6f0\" id=\"ub278a6f0\"><code data-lake-id=\"uc5e3ab13\" id=\"uc5e3ab13\"><span data-lake-id=\"u3cc7efad\" id=\"u3cc7efad\">QLineEdit.NoEcho</span></code><span data-lake-id=\"u334a4551\" id=\"u334a4551\">不显示任何输入的字符,常用于密码类型的输入,且其密码长度需要保密时</span></p><p data-lake-id=\"ud0457007\" id=\"ud0457007\"><code data-lake-id=\"u806f8943\" id=\"u806f8943\"><span data-lake-id=\"ua89aa528\" id=\"ua89aa528\">QLineEdit.Password</span></code><span data-lake-id=\"u44b9adba\" id=\"u44b9adba\">显示与平台相关的密码掩码字符,而不是实际输入的字符</span></p><p data-lake-id=\"ud5ebafbd\" id=\"ud5ebafbd\"><code data-lake-id=\"u752385b7\" id=\"u752385b7\"><span data-lake-id=\"u01478c69\" id=\"u01478c69\">QLineEdit.PasswordEchoOnEdit</span></code><span data-lake-id=\"u7e1b9aa3\" id=\"u7e1b9aa3\">在编辑时显示字符,负责显示密码类型的输入</span></p></td></tr><tr data-lake-id=\"u2ea297e4\" id=\"u2ea297e4\"><td data-lake-id=\"uf2dd7910\" id=\"uf2dd7910\"><p data-lake-id=\"uccbdd073\" id=\"uccbdd073\" style=\"text-align: center\"><code data-lake-id=\"u7d603bb7\" id=\"u7d603bb7\"><span data-lake-id=\"u17136420\" id=\"u17136420\">setPlaceholderText()</span></code></p></td><td data-lake-id=\"u7544d68f\" id=\"u7544d68f\"><p data-lake-id=\"u8377594b\" id=\"u8377594b\"><span data-lake-id=\"u4f91fe41\" id=\"u4f91fe41\">设置文本框浮显文字</span></p></td></tr><tr data-lake-id=\"ucefdb293\" id=\"ucefdb293\"><td data-lake-id=\"u6e4b4727\" id=\"u6e4b4727\"><p data-lake-id=\"u8405fe7d\" id=\"u8405fe7d\" style=\"text-align: center\"><code data-lake-id=\"u171d112b\" id=\"u171d112b\"><span data-lake-id=\"u8a388150\" id=\"u8a388150\">setText()</span></code></p></td><td data-lake-id=\"u2cb6bdcf\" id=\"u2cb6bdcf\"><p data-lake-id=\"ubb162abb\" id=\"ubb162abb\"><span data-lake-id=\"ud3fdba2f\" id=\"ud3fdba2f\">设置文本框内容</span></p></td></tr><tr data-lake-id=\"u6626a6e8\" id=\"u6626a6e8\"><td data-lake-id=\"ud3c85680\" id=\"ud3c85680\"><p data-lake-id=\"u3c206d8d\" id=\"u3c206d8d\" style=\"text-align: center\"><code data-lake-id=\"ueafbeabf\" id=\"ueafbeabf\"><span data-lake-id=\"u556f9dbc\" id=\"u556f9dbc\">setMaxLength()</span></code></p></td><td data-lake-id=\"u41563d6c\" id=\"u41563d6c\"><p data-lake-id=\"u958c41dd\" id=\"u958c41dd\"><span data-lake-id=\"u58cff2fe\" id=\"u58cff2fe\">设置文本框所允许输入的最大字符数</span></p></td></tr></tbody></table><h2 data-lake-id=\"tgbAP\" id=\"tgbAP\" data-lake-index-type=\"2\"><span data-lake-id=\"u3ff81838\" id=\"u3ff81838\">多行文本输入框</span></h2><p data-lake-id=\"u23b2ce10\" id=\"u23b2ce10\"><code data-lake-id=\"u1f5c3f73\" id=\"u1f5c3f73\"><span data-lake-id=\"u5bf8c417\" id=\"u5bf8c417\">QTextEdit</span></code><span data-lake-id=\"ue9f8c31c\" id=\"ue9f8c31c\">控件用来输入多行文本</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22from%20PyQt5.QtWidgets%20import%20QApplication%2CQWidget%2CQTextEdit%5Cnfrom%20PyQt5.QtCore%20import%20*%5Cnfrom%20PyQt5.QtGui%20import%20QIcon%5Cnimport%20sys%5Cn%5Cn%23%201.%E5%88%9B%E5%BB%BA%E5%BA%94%E7%94%A8%E7%A8%8B%E5%BA%8F%5Cnapp%20%3D%20QApplication(sys.argv)%5Cn%5Cn%23%202.%E5%88%9B%E5%BB%BA%E7%AA%97%E5%8F%A3%5Cnw%20%3D%20QWidget()%5Cn%5Cn%5Cn%23%20%E4%BF%AE%E6%94%B9%E7%AA%97%E5%8F%A3%E6%A0%87%E9%A2%98%5Cnw.setWindowTitle('%E5%A4%9A%E8%A1%8C%E8%BE%93%E5%85%A5%E6%A1%86')%5Cn%5C%22%5C%22%5C%22------------------%20%E5%A4%9A%E8%A1%8C%E8%BE%93%E5%85%A5%E6%A1%86%20------------------%5C%22%5C%22%5C%22%5Cnedit%20%3D%20QTextEdit()%5Cn%5Cn%23%20%E8%AE%BE%E7%BD%AE%E6%8F%90%E7%A4%BA%E5%86%85%E5%AE%B9%5Cnedit.setPlaceholderText('%E8%AF%B7%E8%BE%93%E5%85%A5%E5%8F%91%E8%A1%A8%E7%9A%84%E5%86%85%E5%AE%B9')%5Cn%23%20%E8%AE%BE%E7%BD%AE%E6%96%87%E6%9C%AC%E5%86%85%E5%AE%B9%5Cnedit.setPlainText('%E6%AD%A6%E6%B1%89%E7%96%AB%E6%83%85')%5Cn%23%20%E8%8E%B7%E5%8F%96%E8%BE%93%E5%85%A5%E7%9A%84%E5%86%85%E5%AE%B9%5Cnprint(edit.toPlainText())%5Cnedit.clear()%5Cn%5Cn%23%20%E6%98%BE%E7%A4%BA%E5%A4%9A%E8%A1%8C%E8%BE%93%E5%85%A5%E6%A1%86%5Cnedit.setParent(w)%5Cn%5Cn%23%203.%E6%98%BE%E7%A4%BA%E7%AA%97%E5%8F%A3%5Cnw.show()%5Cn%5Cn%23%204.%E7%AD%89%E5%BE%85%E7%AA%97%E5%8F%A3%E5%81%9C%E6%AD%A2%5Cnsys.exit(app.exec())%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22aEbF2%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uaa757bc5\" id=\"uaa757bc5\"><span data-lake-id=\"u385c8d49\" id=\"u385c8d49\">运行程序:</span></p><p data-lake-id=\"u61991c43\" id=\"u61991c43\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1684554880945-228bae71-8130-4133-b919-cfe5bda3504e.png%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A321%2C%22originHeight%22%3A256%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f2f2f2%22%2C%22id%22%3A%22HFcEK%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u0211da5f\" id=\"u0211da5f\"><strong><span data-lake-id=\"u2db2034e\" id=\"u2db2034e\">QTextEdit的方法</span></strong></p><table data-lake-id=\"J7T3g\" id=\"J7T3g\" margin=\"true\" class=\"lake-table\" style=\"width: 612px\"><colgroup><col width=\"237\"><col width=\"375\"></colgroup><tbody><tr data-lake-id=\"ua8e2d166\" id=\"ua8e2d166\"><td data-lake-id=\"uec7961e4\" id=\"uec7961e4\"><p data-lake-id=\"u4c29aa2c\" id=\"u4c29aa2c\" style=\"text-align: center\"><strong><span data-lake-id=\"u5344b291\" id=\"u5344b291\">方法</span></strong></p></td><td data-lake-id=\"u5e7019f8\" id=\"u5e7019f8\"><p data-lake-id=\"u89dca4be\" id=\"u89dca4be\" style=\"text-align: center\"><strong><span data-lak