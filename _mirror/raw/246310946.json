3A%22hi8aI%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h4 data-lake-id=\"tstXs\" id=\"tstXs\" data-lake-index-type=\"2\"><span data-lake-id=\"u2663ac9f\" id=\"u2663ac9f\">POST 请求</span></h4><p data-lake-id=\"udd866c0d\" id=\"udd866c0d\"><strong><span data-lake-id=\"u9e65e08a\" id=\"u9e65e08a\">场景</span></strong><span data-lake-id=\"uce192c16\" id=\"uce192c16\">：模拟用户登录（以测试接口 https://httpbin.org/post 为例）。<br /></span><strong><span data-lake-id=\"u754bf8f9\" id=\"u754bf8f9\">步骤</span></strong><span data-lake-id=\"u68ae9a28\" id=\"u68ae9a28\">：</span></p><ul list=\"ucc10421f\"><li fid=\"u40c097dc\" data-lake-id=\"ubb65ed3a\" id=\"ubb65ed3a\"><strong><span data-lake-id=\"u7356d416\" id=\"u7356d416\">提交表单数据</span></strong><span data-lake-id=\"ub53e4b24\" id=\"ub53e4b24\">：使用 data 参数传递键值对。</span></li></ul><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22url%20%3D%20%5C%22https%3A%2F%2Fhttpbin.org%2Fpost%5C%22%5Cndata%20%3D%20%7B%5C%22username%5C%22%3A%20%5C%22test%5C%22%2C%20%5C%22password%5C%22%3A%20%5C%22123456%5C%22%7D%5Cnresponse%20%3D%20requests.post(url%2C%20data%3Ddata)%5Cnprint(response.json()%5B%5C%22form%5C%22%5D)%20%20%23%20%E8%BE%93%E5%87%BA%E6%9C%8D%E5%8A%A1%E5%99%A8%E6%8E%A5%E6%94%B6%E5%88%B0%E7%9A%84%E8%A1%A8%E5%8D%95%E6%95%B0%E6%8D%AE%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22xP1mw%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ub7de4fd7\" id=\"ub7de4fd7\"><br></p><h4 data-lake-id=\"eaQQ3\" id=\"eaQQ3\" data-lake-index-type=\"2\"><span data-lake-id=\"ud16cc8d2\" id=\"ud16cc8d2\">response的几种返回值</span></h4><table data-lake-id=\"DwfT1\" id=\"DwfT1\" margin=\"true\" class=\"lake-table\" style=\"width: 748px\"><colgroup><col width=\"187\"><col width=\"187\"><col width=\"187\"><col width=\"187\"></colgroup><tbody><tr data-lake-id=\"u0948e0f9\" id=\"u0948e0f9\"><td data-lake-id=\"u9da87bfa\" id=\"u9da87bfa\" style=\"background-color: rgb(242, 242, 242)\"><p data-lake-id=\"u1411107b\" id=\"u1411107b\" style=\"text-align: left\"><strong><span data-lake-id=\"u0e30cfd5\" id=\"u0e30cfd5\">方法/属性</span></strong></p></td><td data-lake-id=\"u14135ddf\" id=\"u14135ddf\" style=\"background-color: rgb(242, 242, 242)\"><p data-lake-id=\"uc2d744c2\" id=\"uc2d744c2\" style=\"text-align: left\"><strong><span data-lake-id=\"u2bfe5ec3\" id=\"u2bfe5ec3\">返回类型</span></strong></p></td><td data-lake-id=\"u4bc0923c\" id=\"u4bc0923c\" style=\"background-color: rgb(242, 242, 242)\"><p data-lake-id=\"u8284074a\" id=\"u8284074a\" style=\"text-align: left\"><strong><span data-lake-id=\"ue7a44db4\" id=\"ue7a44db4\">用途</span></strong></p></td><td data-lake-id=\"uf04b8936\" id=\"uf04b8936\" style=\"background-color: rgb(242, 242, 242)\"><p data-lake-id=\"u6322f585\" id=\"u6322f585\" style=\"text-align: left\"><strong><span data-lake-id=\"uf9504ae9\" id=\"uf9504ae9\">适用场景</span></strong></p></td></tr><tr data-lake-id=\"u54b901e5\" id=\"u54b901e5\"><td data-lake-id=\"u77343aca\" id=\"u77343aca\"><p data-lake-id=\"u0de8ae36\" id=\"u0de8ae36\" style=\"text-align: left\"><code data-lake-id=\"u9c5b46e7\" id=\"u9c5b46e7\"><span data-lake-id=\"ub141f21d\" id=\"ub141f21d\">response.json()</span></code></p></td><td data-lake-id=\"u48360f7e\" id=\"u48360f7e\"><p data-lake-id=\"u49932e4c\" id=\"u49932e4c\" style=\"text-align: left\"><span data-lake-id=\"u91a7bcd4\" id=\"u91a7bcd4\">字典/列表</span></p></td><td data-lake-id=\"uc995edb2\" id=\"uc995edb2\"><p data-lake-id=\"uff3da3a8\" id=\"uff3da3a8\" style=\"text-align: left\"><span data-lake-id=\"u52ce8669\" id=\"u52ce8669\">解析 JSON 