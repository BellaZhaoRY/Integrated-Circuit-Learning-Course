5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22SxTDz%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u226bc66b\" id=\"u226bc66b\"><span data-lake-id=\"u5f9a9031\" id=\"u5f9a9031\" class=\"lake-fontsize-12\" style=\"color: rgb(38, 38, 38)\">第二种方法是使用get-pip.py工具手动安装pip。可以使用以下命令下载get-pip.py文件：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22curl%20https%3A%2F%2Fbootstrap.pypa.io%2Fget-pip.py%20-o%20get-pip.py%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Mi2a8%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u3e455856\" id=\"u3e455856\"><span data-lake-id=\"u2f24a97d\" id=\"u2f24a97d\" class=\"lake-fontsize-12\" style=\"color: rgb(38, 38, 38)\">然后使用以下命令安装pip：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22python%20get-pip.py%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22uPo5k%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uc16203d2\" id=\"uc16203d2\"><span data-lake-id=\"ued1a8c48\" id=\"ued1a8c48\" class=\"lake-fontsize-12\" style=\"color: rgb(38, 38, 38)\">安装完成后，可以使用以下命令检查pip版本：</span></p><card type=\"inline\" name=\