  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h1 data-lake-id=\"F9njw\" id=\"F9njw\"><span data-lake-id=\"u9c66ae00\" id=\"u9c66ae00\" style=\"color: rgb(51, 51, 51)\">1. 创建package(如果创建过可省略)</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20pkg%20create%20--build-type%20ament_python%20py_srvcli%20--dependencies%20rclpy%20example_interfaces%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ieQa0%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uef064219\" id=\"uef064219\"><span data-lake-id=\"u047d897d\" id=\"u047d897d\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">可以修改</span><span data-lake-id=\"ub139dad0\" id=\"ub139dad0\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"u3b5be867\" id=\"u3b5be867\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">文件如下信息</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22xml%22%2C%22code%22%3A%22%3Cdescription%3EC%2B%2B%20client%20server%20tutorial%3C%2Fdescription%3E%5Cn%3Cmaintainer%20email%3D%5C%22you%40email.com%5C%22%3EYour%20Name%3C%2Fmaintainer%3E%5Cn%3Clicense%3EApache%20License%202.0%3C%2Flicense%3E%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22yvHbc%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uc439e6ac\" id=\"uc439e6ac\"><br></p><h1 data-lake-id=\"NvdiO\" id=\"NvdiO\"><span data-lake-id=\"u2ebf6868\" id=\"u2ebf6868\" style=\"color: rgb(51, 51, 51)\">2. 编写client节点代码</span></h1><h2 data-lake-id=\"nFlbR\" id=\"nFlbR\"><span data-lake-id=\"u543e2b54\" id=\"u543e2b54\" style=\"color: rgb(51, 51, 51)\">2.1 编写代码</span></h2><ol list=\"u43845fce\"><li fid=\"u0f60c8f1\" data-lake-id=\"u6e148fb8\" id=\"u6e148fb8\"><span data-lake-id=\"ufc2e1a83\" id=\"ufc2e1a83\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在package的</span><span data-lake-id=\"u48e3bbe8\" id=\"u48e3bbe8\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">py_srvcli</span><span data-lake-id=\"ub43e204a\" id=\"ub43e204a\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">下创建</span><span data-lake-id=\"u641b02a7\" id=\"u641b02a7\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">client.py</span><span data-lake-id=\"u1741a7f1\" id=\"u1741a7f1\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,代码如下</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20rclpy%5Cnfrom%20rclpy.node%20import%20Node%5Cnfrom%20example_interfaces.srv%20import%20AddTwoInts%5Cnimport%20time%5Cn%5Cnclass%20MyNode(Node)%3A%5Cn%20%20%20%20def%20__init__(self)%3A%5Cn%20%20%20%20%20%20%20%20super(MyNode%2C%20self).__init__('py_client')%5Cn%20%20%20%20%20%20%20%20self.cli%20%3D%20self.create_client(AddTwoInts%2C'py_service')%5Cn%20%20%20%20%20%20%20%20while%20not%20self.cli.wait_for_service(timeout_sec%3D1.0)%3A%5Cn%20%20%20%20%20%20%20%20%20%20%20%20self.get_logger().info('service%20not%20available%2Cwaiting%20again...')%5Cn%20%20%20%20%20%20%20%20self.req%20%3D%20AddTwoInts.Request()%5Cn%20%20%20%20%20%20%20%20time.sleep(3)%5Cn%20%20%20%20%20%20%20%20self.send_request(10%2C20)%5Cn%5Cn%20%20%20%20def%20send_request(self%2Ca%2Cb)%3A%5Cn%20%20%20%20%20%20%20%20self.req.a%20%3D%20int(a)%5Cn%20%20%20%20%20%20%20%20self.req.b%20%3D%20int(b)%5Cn%20%20%20%20%20%20%20%20self.future%20%3D%20self.cli.call_async(self.req)%5Cn%20%20%20%20%20%20%20%20self.future.add_done_callback(self.call_back)%5Cn%5Cn%20%20%20%20def%20call_back(self%2Cfuture)%3A%5Cn%20%20%20%20%20%20%20%20self.get_logger().info(f'receive%20response%20%7Bfuture.result().sum%7D')%5Cn%5Cn%5Cndef%20main()%3A%5Cn%20%20%20%20rclpy.init()%5Cn%20%20%20%20node%20%3D%20MyNode()%5Cn%20%20%20%20rclpy.spin(node)%5Cn%20%20%20%20node.destroy_node()%5Cn%20%20%20%20rclpy.shutdown()%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20main()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22OW9IP%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"Hi0Tq\" id=\"Hi0Tq\"><span data-lake-id=\"u4fca2204\" id=\"u4fca2204\" style=\"color: rgb(51, 51, 51)\">2.2 添加配置</span></h2><ol list=\"u12a39bb3\"><li fid=\"u81a9f83c\" data-lake-id=\"u69e30ab2\" id=\"u69e30ab2\"><span data-lake-id=\"u604a37cc\" id=\"u604a37cc\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">打开</span><span data-lake-id=\"u9d3b5acd\" id=\"u9d3b5acd\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">setup.py</span><span data-lake-id=\"u64f97138\" id=\"u64f97138\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,在</span><span data-lake-id=\"u56ea76fe\" id=\"u56ea76fe\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">console_scripts</span><span data-lake-id=\"uaca754bc\" id=\"uaca754bc\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">节点下添加配置</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22'client%20%3D%20py_srvcli.client%3Amain'%2C%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22c03wJ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"S1JAc\" id=\"S1JAc\"><span data-lake-id=\"ufb2224b3\" id=\"ufb2224b3\" style=\"color: rgb(51, 51, 51)\">3. 编译工程</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22colcon%20build%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22OGBGE%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"ktx6r\" id=\"ktx6r\"><span data-lake-id=\"uccfdaf3c\" id=\"uccfdaf3c\" style=\"color: rgb(51, 51, 51)\">4. 运行节点</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20run%20py_srvcli%20client%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22kYW6p%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u2eea5756\" id=\"u2eea5756\"><span data-lake-id=\"uec955522\" id=\"uec955522\"><br /></span><span data-lake-id=\"u8f579f54\" id=\"u8f579f54\"> </span></p>",
