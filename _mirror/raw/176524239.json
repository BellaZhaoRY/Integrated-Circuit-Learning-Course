%22)%20%3D%3D%20NULL)%20%7B%5Cn%5Ct%5Ctgoto%20end%3B%5Cn%5Ct%7D%5Cn%5Cn%5Ctresolutions%20%3D%20cJSON_AddArrayToObject(monitor%2C%20%5C%22resolutions%5C%22)%3B%5Cn%5Ctif%20(resolutions%20%3D%3D%20NULL)%20%7B%5Cn%5Ct%5Ctgoto%20end%3B%5Cn%5Ct%7D%5Cn%5Cn%5Ctfor%20(index%20%3D%200%3B%20index%20%3C%20(sizeof(resolution_numbers)%20%2F%20(2%20*%20sizeof(int)))%3B%20%2B%2Bindex)%20%7B%5Cn%5Ct%5CtcJSON%20*resolution%20%3D%20cJSON_CreateObject()%3B%5Cn%5Cn%5Ct%5Ctif%20(cJSON_AddNumberToObject(resolution%2C%20%5C%22width%5C%22%2C%20resolution_numbers%5Bindex%5D%5B0%5D)%20%3D%3D%20NULL)%20%7B%5Cn%5Ct%5Ct%5Ctgoto%20end%3B%5Cn%5Ct%5Ct%7D%5Cn%5Cn%5Ct%5Ctif%20(cJSON_AddNumberToObject(resolution%2C%20%5C%22height%5C%22%2C%20resolution_numbers%5Bindex%5D%5B1%5D)%20%3D%3D%20NULL)%20%7B%5Cn%5Ct%5Ct%5Ctgoto%20end%3B%5Cn%5Ct%5Ct%7D%5Cn%5Cn%5Ct%5CtcJSON_AddItemToArray(resolutions%2C%20resolution)%3B%5Cn%5Ct%7D%5Cn%5Cn%5Ctstring%20%3D%20cJSON_Print(monitor)%3B%5Cn%5Ctif%20(string%20%3D%3D%20NULL)%20%7B%5Cn%5Ct%5Ctfprintf(stderr%2C%20%5C%22Failed%20to%20print%20monitor.%5C%5Cn%5C%22)%3B%5Cn%5Ct%7D%5Cn%5Cnend%3A%5Cn%5CtcJSON_Delete(monitor)%3B%5Cn%5Ctreturn%20string%3B%5Cn%7D%5Cn%5Cnint%20main(int%20argc%2C%20char%20*argv%5B%5D)%20%7B%5Cn%5Ctchar*%20create_rst%20%3D%20create_json_str()%3B%5Cn%5Ctprintf(%5C%22json%3A%20%25s%5C%5Cn%5C%22%2C%20create_rst)%3B%5Cn%5Cn%5Ctreturn%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22yVEhr%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>",
