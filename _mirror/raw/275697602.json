  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h1 data-lake-id=\"EzEM4\" id=\"EzEM4\" data-lake-index-type=\"2\"><span data-lake-id=\"u57e69d8e\" id=\"u57e69d8e\">连线</span></h1><p data-lake-id=\"uf0e7469e\" id=\"uf0e7469e\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2026%2Fpng%2F27903758%2F1785330826473-c25c9046-052c-4c13-a29e-0926e9604ac5.png%3Fx-oss-process%3Dimage%252Fformat%252Cwebp%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A752%2C%22originHeight%22%3A564%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23ded4c2%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22O12Tb%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><h1 data-lake-id=\"BfXgw\" id=\"BfXgw\" data-lake-index-type=\"2\"><span data-lake-id=\"uabcb5b0f\" id=\"uabcb5b0f\">安装依赖</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22pip%20install%20rustypot%3D%3D0.1.0%20%20%20%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22WBGxN%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"LeBM7\" id=\"LeBM7\" data-lake-index-type=\"2\"><span data-lake-id=\"uda6d19f5\" id=\"uda6d19f5\">代码驱动</span></h1><p data-lake-id=\"ua569e8ea\" id=\"ua569e8ea\"><span data-lake-id=\"u3825214e\" id=\"u3825214e\">下面这份驱动代码是让舵机在当前位置附近往复运动45°</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20rustypot%5Cnimport%20time%5Cnimport%20numpy%20as%20np%5Cn%5Cn%23%201.%20%E8%BF%9E%E6%8E%A5%E7%94%B5%E6%9C%BA%5Cn%23%20io%20%3D%20rustypot.feetech('%2Fdev%2FttyUSB0'%2C%201000000)%5Cnio%20%3D%20rustypot.feetech('COM6'%2C%201000000)%5Cn%5Cnmotor_id%20%3D%2010%20%20%23%20%E7%94%B5%E6%9C%BAID%EF%BC%8C%E6%A0%B9%E6%8D%AE%E5%AE%9E%E9%99%85%E6%83%85%E5%86%B5%E4%BF%AE%E6%94%B9%5Cn%5Cntry%3A%5Cn%20%20%20%20%23%202.%20%E8%8E%B7%E5%8F%96%E5%BD%93%E5%89%8D%E4%BD%8D%E7%BD%AE%5Cn%20%20%20%20current_pos%20%3D%20io.read_present_position(%5Bmotor_id%5D)%5Cn%20%20%20%20center_pos%20%3D%20current_pos%5B0%5D%5Cn%20%20%20%20print(f%5C%22%E5%BD%93%E5%89%8D%E4%BD%8D%E7%BD%AE%3A%20%7Bnp.rad2deg(center_pos)%3A.2f%7D%C2%B0%5C%22)%5Cn%20%20%20%20%5Cn%20%20%20%20%23%205.%20%E6%9D%A5%E5%9B%9E%E5%BE%80%E5%A4%8D%E8%BF%90%E5%8A%A8%EF%BC%885%E6%AC%A1%EF%BC%89%5Cn%20%20%20%20print(%5C%22%E5%BC%80%E5%A7%8B%E5%9C%A8%E5%BD%93%E5%89%8D%E4%BD%8D%E7%BD%AE%E9%99%84%E8%BF%91%E5%BE%80%E5%A4%8D%E8%BF%90%E5%8A%A8...%5C%22)%5Cn%20%20%20%20left_pos%20%3D%20center_pos%20-%20np.deg2rad(45)%5Cn%20%20%20%20right_pos%20%3D%20center_pos%20%2B%20np.deg2rad(45)%5Cn%20%20%20%20for%20i%20in%20range(5)%3A%5Cn%20%20%20%20%20%20%20%20%23%20%E8%BD%AC%E5%88%B0%E5%BD%93%E5%89%8D%E4%BD%8D%E7%BD%AE%E5%B7%A6%E4%BE%A745%C2%B0%5Cn%20%20%20%20%20%20%20%20print(f%5C%22%20%20%E7%AC%AC%7Bi%2B1%7D%E6%AC%A1%3A%20%E8%BD%AC%E5%88%B0%20%7Bnp.rad2deg(left_pos)%3A.2f%7D%C2%B0%5C%22)%5Cn%20%20%20%20%20%20%20%20io.write_goal_position(%5Bmotor_id%5D%2C%20%5Bleft_pos%5D)%5Cn%20%20%20%20%20%20%20%20time.sleep(1.5)%5Cn%20%20%20%20%20%20%20%20%5Cn%20%20%20%20%20%20%20%20%23%20%E8%BD%AC%E5%88%B0%E5%BD%93%E5%89%8D%E4%BD%8D%E7%BD%AE%E5%8F%B3%E4%BE%A745%C2%B0%5Cn%20%20%20%20%20%20%20%20print(f%5C%22%20%20%E7%AC%AC%7Bi%2B1%7D%E6%AC%A1%3A%20%E8%BD%AC%E5%88%B0%20%7Bnp.rad2deg(right_pos)%3A.2f%7D%C2%B0%5C%22)%5Cn%20%20%20%20%20%20%20%20io.write_goal_position(%5Bmotor_id%5D%2C%20%5Bright_pos%5D)%5Cn%20%20%20%20%20%20%20%20time.sleep(1.5)%5Cn%20%20%20%20%5Cn%20%20%20%20%23%20%E5%9B%9E%E5%88%B0%E5%88%9D%E5%A7%8B%E4%BD%8D%E7%BD%AE%5Cn%20%20%20%20print(%5C%22%E5%9B%9E%E5%88%B0%E5%88%9D%E5%A7%8B%E4%BD%8D%E7%BD%AE...%5C%22)%5Cn%20%20%20%20io.write_goal_position(%5Bmotor_id%5D%2C%20%5Bcenter_pos%5D)%5Cn%20%20%20%20time.sleep(1)%5Cn%20%20%20%20%5Cnexcept%20KeyboardInterrupt%3A%5Cn%20%20%20%20print(%5C%22%5C%5Cn%E7%94%A8%E6%88%B7%E4%B8%AD%E6%96%AD%5C%22)%5Cnfinally%3A%5Cn%20%20%20%20%23%20%E5%85%B3%E9%97%AD%E7%94%B5%E6%9C%BA%E6%89%AD%E7%9F%A9%5Cn%20%20%20%20io.disable_torque(%5Bmotor_id%5D)%5Cn%20%20%20%20print(%5C%22%E7%94%B5%E6%9C%BA%E5%B7%B2%E5%85%B3%E9%97%AD%5C%22)%5Cn%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22kvp92%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>",
