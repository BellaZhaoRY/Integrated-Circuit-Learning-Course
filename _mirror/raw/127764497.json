  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><meta name=\"paragraphSpacing\" content=\"relax\" /><h1 data-lake-id=\"P91mR\" id=\"P91mR\"><span data-lake-id=\"u6051bba5\" id=\"u6051bba5\">局部变量</span></h1><ul list=\"ua0fb3a1d\"><li fid=\"ua34cbf1a\" data-lake-id=\"ua4a6d8da\" id=\"ua4a6d8da\"><span data-lake-id=\"u6ffaea17\" id=\"u6ffaea17\">定义在代码块</span><code data-lake-id=\"ua89cd438\" id=\"ua89cd438\"><span data-lake-id=\"u3dd7deed\" id=\"u3dd7deed\">{}</span></code><span data-lake-id=\"ude94a58e\" id=\"ude94a58e\">里面的变量称为局部变量（Local Variable）</span></li><li fid=\"ua34cbf1a\" data-lake-id=\"u4943c1e3\" id=\"u4943c1e3\"><span data-lake-id=\"ua3cf8316\" id=\"ua3cf8316\">局部变量的作用域(作用范围)仅限于代码块</span><code data-lake-id=\"ub647e34a\" id=\"ub647e34a\"><span data-lake-id=\"u42794b14\" id=\"u42794b14\">{}</span></code></li></ul><ul list=\"ua0fb3a1d\" data-lake-indent=\"1\"><li fid=\"ua34cbf1a\" data-lake-id=\"u495fcc64\" id=\"u495fcc64\"><span data-lake-id=\"u6a300f48\" id=\"u6a300f48\">离开该代码块</span><code data-lake-id=\"u9f1576c4\" id=\"u9f1576c4\"><span data-lake-id=\"uc2847e03\" id=\"uc2847e03\">{}</span></code><span data-lake-id=\"u097c280f\" id=\"u097c280f\">是无效的</span></li><li fid=\"ua34cbf1a\" data-lake-id=\"u5b545be8\" id=\"u5b545be8\"><span data-lake-id=\"ubdfed4b7\" id=\"ubdfed4b7\">离开代码块</span><code data-lake-id=\"u1509ea33\" id=\"u1509ea33\"><span data-lake-id=\"u4f9a6c44\" id=\"u4f9a6c44\">{}</span></code><span data-lake-id=\"u05732d23\" id=\"u05732d23\">后，局部变量自动释放</span></li></ul><ul list=\"ua0fb3a1d\" start=\"3\"><li fid=\"ua34cbf1a\" data-lake-id=\"uafad478d\" id=\"uafad478d\"><span data-lake-id=\"u1f630d10\" id=\"u1f630d10\">示例代码：</span></li></ul><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%5Cn%2F%2F%20%E5%87%BD%E6%95%B0%E5%AE%9A%E4%B9%89%5Cnvoid%20my_add(int%20a%2C%20int%20b)%20%7B%5Cn%20%20%20%20%2F%2F%20a%2C%20b%2C%20res%E6%98%AF%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%EF%BC%8C%E5%8F%AA%E8%83%BD%E5%9C%A8my_add%E5%86%85%E9%83%A8%E4%BD%BF%E7%94%A8%5Cn%20%20%20%20int%20res%20%3D%20a%20%2B%20b%3B%5Cn%7D%5Cn%5Cnint%20main()%20%7B%5Cn%20%20%20%20%2F%2F%20%E5%87%BD%E6%95%B0%E8%B0%83%E7%94%A8%5Cn%20%20%20%20my_add(10%2C%2020)%3B%5Cn%20%20%20%20%2F%2F%20%E5%87%BD%E6%95%B0%E5%A4%96%E9%83%A8%E6%97%A0%E6%B3%95%E4%BD%BF%E7%94%A8%E5%87%BD%E6%95%B0%E5%86%85%E7%9A%84%E5%B1%80%E9%83%A8%E5%8F%98%E9%87%8F%EF%BC%8C%E4%B8%8B%E9%9D%A2%E4%BB%A3%E7%A0%81%E6%98%AF%E9%94%99%E8%AF%AF%E7%9A%84%5Cn%20%20%20%20printf(%5C%22%25d%2C%20%25d%2C%20%25d%5C%5Cn%5C%22%2C%20a%2C%20b%2C%20res)%3B%5Cn%5Cn%20%20%20%20return%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22__spacing%22%3A%22both%22%2C%22__widthMode%22%3A%22normal%22%2C%22id%22%3A%22WkdBy%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%2C%22widthMode%22%3A%22normal%22%7D\" hindent=\"2em\"></card><p data-lake-id=\"u9dabf614\" id=\"u9dabf614\"><br></p><h1 data-lake-id=\"v0SXI\" id=\"v0SXI\"><span data-lake-id=\"u6a97a521\" id=\"u6a97a521\">全局变量</span></h1><ul list=\"u08b96cea\"><li fid=\"u6da7db38\" data-lake-id=\"ubd2cd9c3\" id=\"ubd2cd9c3\"><span data-lake-id=\"uc02c7f5a\" id=\"uc02c7f5a\">在所有函数外部定义的变量称为全局变量（Global Variable），它的作用域默认是整个程序，也就是所有的源文件</span></li><li fid=\"u6da7db38\" data-lake-id=\"u40499145\" id=\"u40499145\"><span data-lake-id=\"ucbc4d932\" id=\"ucbc4d932\">示例代码：</span></li></ul><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%5Cn%2F%2F%20%E5%87%BD%E6%95%B0%E5%A4%96%E5%AE%9A%E4%B9%89%E7%9A%84%E5%8F%98%E9%87%8F%E4%B8%BA%E5%85%A8%E5%B1%80%E5%8F%98%E9%87%8F%EF%BC%8C%E5%AE%9A%E4%B9%89%E5%AE%8C%EF%BC%8C%E6%89%80%E6%9C%89%E5%9C%B0%E6%96%B9%E9%83%BD%E8%83%BD%E4%BD%BF%E7%94%A8%5Cnint%20a%20%3D%2010%3B%5Cn%5Cnint%20main()%20%7B%5Cn%20%20%20%20%2F%2F%20%E4%BD%BF%E7%94%A8%E5%85%A8%E5%B1%80%E5%8F%98%E9%87%8F%5Cn%20%20%20%20printf(%5C%22a%20%3D%20%25d%5C%5Cn%5C%22%2C%20a)%3B%5Cn%5Cn%20%20%20%20return%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22__spacing%22%3A%22both%22%2C%22__widthMode%22%3A%22normal%22%2C%22fontSize%22%3A14%2C%22id%22%3A%22OoBVg%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%2C%22widthMode%22%3A%22normal%22%7D\" hindent=\"2em\"></card>",
