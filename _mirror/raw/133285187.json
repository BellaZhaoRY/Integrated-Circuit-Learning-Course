uote data-lake-id=\"ue7a47413\" id=\"ue7a47413\"><p data-lake-id=\"u7ae8e406\" id=\"u7ae8e406\"><span data-lake-id=\"ue3b4e6a3\" id=\"ue3b4e6a3\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">注意:</span></p><p data-lake-id=\"u06ad393c\" id=\"u06ad393c\"><span data-lake-id=\"ub1990cf8\" id=\"ub1990cf8\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">需要调用update更新界面</span></p></blockquote><h1 data-lake-id=\"gPXhS\" id=\"gPXhS\"><span data-lake-id=\"u050910d0\" id=\"u050910d0\" style=\"color: rgb(51, 51, 51)\">完整示例代码</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20rclpy%5Cnimport%20sys%5Cnfrom%20rclpy.node%20import%20Node%5Cnfrom%20geometry_msgs.msg%20import%20Twist%5Cnfrom%20turtlesim.msg%20import%20Pose%5Cnfrom%20PyQt5.QtWidgets%20import%20QWidget%2C%20QApplication%2C%20QFormLayout%2C%20QLineEdit%2C%20QPushButton%2C%20QLabel%5Cnfrom%20PyQt5.QtCore%20import%20QTimer%5Cn%5Cn%5Cnclass%20MainWindow(QWidget)%3A%5Cn%20%20%20%20def%20__init__(self%2C%20node)%3A%5Cn%20%20%20%20%20%20%20%20super(MainWindow%2C%20self).__init__()%5Cn%20%20%20%20%20%20%20%20self.node%20%3D%20node%5Cn%20%20%20%20%20%20%20%20%23%20timer%5Cn%20%20%20%20%20%20%20%20updateTimer%20%3D%20QTimer(self)%5Cn%20%20%20%20%20%20%20%20updateTimer.setInterval(16)%5Cn%20%20%20%20%20%20%20%20updateTimer.start()%5Cn%5Cn%20%20%20%20%20%20%20%20updateTimer.timeout.connect(self.onUpdate)%5Cn%20%20%20%20%20%20%20%20%23%20topic%5Cn%20%20%20%20%20%20%20%20self.publisher%20%3D%20self.node.create_publisher(Twist%2C%20'%2Fturtle1%2Fcmd_vel'%2C%2010)%5Cn%20%20%20%20%20%20%20%20self.subscriber%20%3D%20self.node.create_subscription(Pose%2C%20'%2Fturtle1%2Fpose'%2C%20self.pose_call_back%2C10)%5Cn%5Cn%20%20%20%20%20%20%20%20self.resize(400%2C%20120)%5Cn%20%20%20%20%20%20%20%20self.setWindowTitle('%E5%B0%8F%E4%B9%8C%E9%BE%9F%E6%8E%A7%E5%88%B6')%5Cn%20%20%20%20%20%20%20%20%23%20%E5%B8%83%E5%B1%80%5Cn%20%20%20%20%20%20%20%20layout%20%3D%20QFormLayout()%5Cn%20%20%20%20%20%20%20%20self.setLayout(layout)%5Cn%5Cn%20%20%20%20%20%20%20%20%23%20%E6%8E%A7%E4%BB%B6%5Cn%20%20%20%20%20%20%20%20self.editLinear%20%3D%20QLineEdit()%5Cn%20%20%20%20%20%20%20%20layout.addRow(%5C%22%E7%BA%BF%E9%80%9F%E5%BA%A6%5C%22%2C%20self.editLinear)%5Cn%5Cn%20%20%20%20%20%20%20%20self.editAngular%20%3D%20QLineEdit()%5Cn%20%20%20%20%20%20%20%20layout.addRow(%5C%22%E8%A7%92%E9%80%9F%E5%BA%A6%5C%22%2C%20self.editAngular)%5Cn%5Cn%20%20%20%20%20%20%20%20%23%20x%5Cn%20%20%20%20%20%20%20%20self.x_label%20%3D%20QLabel('0')%5Cn%20%20%20%20%20%20%20%20%23%20y%5Cn%20%20%20%20%20%20%20%20self.y_label%20%3D%20QLabel('0')%5Cn%20%20%20%20%20%20%20%20%23%20linear%5Cn%20%20%20%20%20%20%20%20self.linear_label%20%3D%20QLabel('0')%5Cn%20%20%20%20%20%20%20%20%23%20angular%5Cn%20%20%20%20%20%20%20%20self.angular_label%20%3D%20QLabel('0')%5Cn%20%20%20%20%20%20%20%20%23%20angle%5Cn%20%20%20%20%20%20%20%20self.angle_label%20%3D%20QLabel('0')%5Cn%20%20%20%20%20%20%20%20layout.addRow('x%E5%9D%90%E6%A0%87'%2C%20self.x_label)%5Cn%20%20%20%20%20%20%20%20layout.addRow('y%E5%9D%90%E6%A0%87'%2C%20self.y_label)%5Cn%20%20%20%20%20%20%20%20layout.addRow('%E7%BA%BF%E9%80%9F%E5%BA%A6'%2C%20self.linear_label)%5Cn%20%20%20%20%20%20%20%20layout.addRow('%E8%A7%92%E9%80%9F%E5%BA%A6'%2C%20self.angular_label)%5Cn%20%20%20%20%20%20%20%20layout.addRow('%E8%A7%92%E5%BA%A6'%2C%20self.angle_label)%5Cn%5Cn%20%20%20%20%20%20%20%20btnSend%20%3D%20QPushButton(%5C%22%E5%8F%91%E9%80%81%5C%22)%5Cn%20%20%20%20%20%20%20%20layout.addRow(''%2C%20btnSend)%5Cn%20%20%20%20%20%20%20%20btnSend.clicked.connect(self.start_control)%5Cn%5Cn%20%20%20%20def%20start_control(self)%3A%5Cn%20%20%20%20%20%20%20%20data%20%3D%20Twist()%5Cn%20%20%20%20%20%20%20%20data.linear.x%20%3D%20float(self.editLinear.text())%5Cn%20%20%20%20%20%20%20%20data.angular.z%20%3D%20float(self.editAngular.text())%5Cn%20%20%20%20%20%20%20%20self.publisher.publish(data)%5Cn%5Cn%20%20%20%20def%20pose_call_back(self%2C%20pose)%3A%5Cn%20%20%20%20%20%20%20%20self.x_label.setText(str(pose.x))%5Cn%20%20%20%20%20%20%20%20self.y_label.setText(str(pose.y))%5Cn%20%20%20%20%20%20%20%20self.angle_label.setText(str(pose.theta))%5Cn%20%20%20%20%20%20%20%20self.linear_label.setText(str(pose.linear_velocity))%5Cn%20%20%20%20%20%20%20%20self.angular_label.setText(str(pose.angular_velocity))%5Cn%5Cn%20%20%20%20def%20onUpdate(self)%3A%5Cn%20%20%20%20%20%20%20%20self.update()%5Cn%20%20%20%20%20%20%20%20rclpy.spin_once(self.node)%5Cn%20%20%20%20%20%20%20%20if%20not%20rclpy.ok()%3A%5Cn%20%20%20%20%20%20%20%20%20%20%20%20self.close()%5Cn%5Cn%5Cn%5Cndef%20main()%3A%5Cn%20%20%20%20rclpy.init()%5Cn%20%20%20%20node%20%3D%20Node('turtlesim_control')%5Cn%20%20%20%20app%20%3D%20QApplication(sys.argv)%5Cn%20%20%20%20window%20%3D%20MainWindow(node)%5Cn%20%20%20%20window.show()%5Cn%20%20%20%20%23%20rclpy.spin(node)%5Cn%20%20%20%20result%20%3D%20app.exec_()%5Cn%20%20%20%20node.destroy_node()%5Cn%20%20%20%20rclpy.shutdown()%5Cn%20%20%20%20sys.exit()%5Cn%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20main()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Tm8KK%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u25e2e072\" id=\"u25e2e072\"><span data-lake-id=\"ud4bad222\" id=\"ud4bad222\"><br /> </span></p>",
