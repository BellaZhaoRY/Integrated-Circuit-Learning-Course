  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><p data-lake-id=\"ud559f711\" id=\"ud559f711\"><span data-lake-id=\"u40279520\" id=\"u40279520\">PID闭环控制系统</span></p><h1 data-lake-id=\"wcIHp\" id=\"wcIHp\"><span data-lake-id=\"u65306dbb\" id=\"u65306dbb\">知识点</span></h1><ul list=\"u4a94aaf7\"><li fid=\"u354599f3\" data-lake-id=\"u921fc8bd\" id=\"u921fc8bd\"><span data-lake-id=\"uad64cbbf\" id=\"uad64cbbf\">代码在线Debug调试</span></li><li fid=\"u354599f3\" data-lake-id=\"u99effb14\" id=\"u99effb14\"><span data-lake-id=\"ucda18a30\" id=\"ucda18a30\">Union联合体妙用</span></li><li fid=\"u354599f3\" data-lake-id=\"u36d05d3b\" id=\"u36d05d3b\"><span data-lake-id=\"u59478995\" id=\"u59478995\">裸机多任务开发框架</span></li><li fid=\"u354599f3\" data-lake-id=\"u0c613d5f\" id=\"u0c613d5f\"><span data-lake-id=\"u54f09fa4\" id=\"u54f09fa4\">结构体与函数指针</span></li><li fid=\"u354599f3\" data-lake-id=\"u6fb22b1d\" id=\"u6fb22b1d\"><span data-lake-id=\"uad00016a\" id=\"uad00016a\">环形数据队列 </span></li><li fid=\"u354599f3\" data-lake-id=\"u44bd5eb7\" id=\"u44bd5eb7\"><span data-lake-id=\"u9151d430\" id=\"u9151d430\">数据校验算法 ADD8, XOR8</span></li><li fid=\"u354599f3\" data-lake-id=\"uaeff0a30\" id=\"uaeff0a30\"><span data-lake-id=\"u2f40537b\" id=\"u2f40537b\">PID算法</span></li><li fid=\"u354599f3\" data-lake-id=\"u6ec6b423\" id=\"u6ec6b423\"><span data-lake-id=\"ua951e49e\" id=\"ua951e49e\">MG996R 舵机驱动</span></li><li fid=\"u354599f3\" data-lake-id=\"u8b2390ac\" id=\"u8b2390ac\"><span data-lake-id=\"u243c1e54\" id=\"u243c1e54\">VL53L0X测距模块驱动</span></li></ul><h1 data-lake-id=\"x93lf\" id=\"x93lf\"><span data-lake-id=\"ud71c5107\" id=\"ud71c5107\">组装图</span></h1><h2 data-lake-id=\"Pqi2u\" id=\"Pqi2u\"><span data-lake-id=\"u997c1d4a\" id=\"u997c1d4a\">零件图</span></h2><ul list=\"u62034c10\"><li fid=\"ud9630b26\" data-lake-id=\"u148d56d9\" id=\"u148d56d9\"><span data-lake-id=\"ua08df181\" id=\"ua08df181\">长螺丝：3根</span></li><li fid=\"ud9630b26\" data-lake-id=\"ubdbe918e\" id=\"ubdbe918e\"><span data-lake-id=\"uc151214a\" id=\"uc151214a\">短螺丝：15根</span></li><li fid=\"ud9630b26\" data-lake-id=\"u2430c7fe\" id=\"u2430c7fe\"><span data-lake-id=\"ua5c022aa\" id=\"ua5c022aa\">螺母：15个</span></li><li fid=\"ud9630b26\" data-lake-id=\"ua7e781fa\" id=\"ua7e781fa\"><span data-lake-id=\"uea7dec9c\" id=\"uea7dec9c\">3D打印件：5个</span></li><li fid=\"ud9630b26\" data-lake-id=\"u62dd31f1\" id=\"u62dd31f1\"><span data-lake-id=\"ud76865b2\" id=\"ud76865b2\">小球</span></li><li fid=\"ud9630b26\" data-lake-id=\"u95f81084\" id=\"u95f81084\"><span data-lake-id=\"u42579c57\" id=\"u42579c57\">舵机套装+舵机支架+公对母杜邦线3根</span></li><li fid=\"ud9630b26\" data-lake-id=\"u0e70f1bf\" id=\"u0e70f1bf\"><span data-lake-id=\"u2d41d52a\" id=\"u2d41d52a\">测距模块+母对母杜邦线5根</span></li><li fid=\"ud9630b26\" data-lake-id=\"u97e9e067\" id=\"u97e9e067\"><span data-lake-id=\"u58a8ff44\" id=\"u58a8ff44\">底板</span></li><li fid=\"ud9630b26\" data-lake-id=\"u31c86d69\" id=\"u31c86d69\"><span data-lake-id=\"ud5ac2164\" id=\"ud5ac2164\">塑料管</span></li></ul><p data-lake-id=\"u940169af\" id=\"u940169af\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F27903758%2F1719459837329-7c887e99-da8f-43d6-8ada-9c37444b9d31.png%22%2C%22taskId%22%3A%22u45517feb-8e05-454b-95ba-eeb0c1c8a6c%22%2C%22clientId%22%3A%22u38936462-be1f-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A983%2C%22height%22%3A876%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A1723806%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A983%2C%22originHeight%22%3A876%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E5%B9%B3%E8%A1%A1%E5%B0%8F%E7%90%83%E5%BA%95%E6%9D%BF%E6%AD%A4%E9%9D%A2%E6%9C%9D%E4%B8%8A%22%2C%22x%22%3A365%2C%22y%22%3A228%2C%22width%22%3A164%2C%22height%22%3A15%7D%2C%7B%22text%22