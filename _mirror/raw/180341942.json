%9A%84%E5%A4%A7%E6%8B%AC%E5%8F%B7%E6%98%AF%E4%B8%8E%E5%89%8D%E9%9D%A2%E7%9A%84%E5%A4%A7%E6%8B%AC%E5%8F%B7%E5%AF%B9%E5%BA%94%E5%85%B3%E7%B3%BB%5Cn%23ifdef%20__cplusplus%5Cn%7D%5Cn%23endif%5Cn%5Cn%23endif%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ruzKR%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u171b6345\" id=\"u171b6345\"><br></p><p data-lake-id=\"ub62a5195\" id=\"ub62a5195\"><span data-lake-id=\"u4ec6718b\" id=\"u4ec6718b\">这段代码的作用是为了在 C++ 中允许 C 语言的函数被调用。具体来说：</span></p><ul list=\"udc2f6020\"><li fid=\"uff14349c\" data-lake-id=\"u122034b7\" id=\"u122034b7\"><code data-lake-id=\"u12d9885b\" id=\"u12d9885b\"><span data-lake-id=\"u63e890ad\" id=\"u63e890ad\">#ifdef __cplusplus</span></code><span data-lake-id=\"u8ac8fa9f\" id=\"u8ac8fa9f\">：这个预处理指令检查当前编译器是否在 C++ 模式下。如果是 C++ 编译器，接下来的代码块将会被编译。</span></li><li fid=\"uff14349c\" data-lake-id=\"uee04388b\" id=\"uee04388b\"><code data-lake-id=\"uc2f8ec79\" id=\"uc2f8ec79\"><span data-lake-id=\"ucb2ac9bc\" id=\"ucb2ac9bc\">extern &quot;C&quot;</span></code><span data-lake-id=\"ub1467f70\" id=\"ub1467f70\">：这个声明告诉 C++ 编译器，后面的函数使用 C 语言的链接方式。这意味着 C++ 编译器不会对这些函数名进行名称改编（name mangling），从而使得 C 代码可以正确地调用这些函数。</span></li></ul><p data-lake-id=\"u8e3cb1fd\" id=\"u8e3cb1fd\"><span data-lake-id=\"ua3678eb2\" id=\"ua3678eb2\">总结来说，这段代码的目的是确保 C 语言的函数在 C++ 中可以被正确链接和调用，避免名称冲突和链接错误。</span></p><h3 data-lake-id=\"K4o1M\" id=\"K4o1M\" data-lake-index-type=\"2\"><span data-lake-id=\"ub3112ae7\" id=\"ub3112ae7\">新建cpp_support.cpp</span></h3><p data-lake-id=\"u76c71617\" id=\"u76c71617\"><br></p><card type=\"inline\" name=\"codeblock\" value=\"data