  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h1 data-lake-id=\"Lzdm3\" id=\"Lzdm3\"><span data-lake-id=\"u1661a2be\" id=\"u1661a2be\" style=\"color: rgb(51, 51, 51)\">1. 创建package(创建过可省略)</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22ros2%20pkg%20create%20--build-type%20ament_python%20turtlesim_topic%20--dependencies%20geometry_msgs%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22GSlqb%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uba5a5dd0\" id=\"uba5a5dd0\"><span data-lake-id=\"ua617eae7\" id=\"ua617eae7\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">可以修改</span><span data-lake-id=\"u5942a751\" id=\"u5942a751\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119); background-color: rgb(243, 244, 244)\">package.xml</span><span data-lake-id=\"uca941d53\" id=\"uca941d53\" class=\"lake-fontsize-12\" style=\"color: rgb(119, 119, 119)\">文件如下信息</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22xml%22%2C%22code%22%3A%22%3Cdescription%3EC%2B%2B%20client%20server%20tutorial%3C%2Fdescription%3E%5Cn%3Cmaintainer%20email%3D%5C%22you%40email.com%5C%22%3EYour%20Name%3C%2Fmaintainer%3E%5Cn%3Clicense%3EApache%20License%202.0%3C%2Flicense%3E%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22azgHL%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"Z8HSb\" id=\"Z8HSb\"><span data-lake-id=\"u274ed002\" id=\"u274ed002\" style=\"color: rgb(51, 51, 51)\">2. 编写代码</span></h1><h2 data-lake-id=\"rW1zL\" id=\"rW1zL\"><span data-lake-id=\"u4e525b48\" id=\"u4e525b48\" style=\"color: rgb(51, 51, 51)\">2.1 节点代码</span></h2><ol list=\"u19a2f736\"><li fid=\"ub92db556\" data-lake-id=\"u06243765\" id=\"u06243765\"><span data-lake-id=\"uf478a21c\" id=\"uf478a21c\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">在package的</span><span data-lake-id=\"u949725bc\" id=\"u949725bc\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">turtlesim_topic</span><span data-lake-id=\"u659debcb\" id=\"u659debcb\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件夹下创建</span><span data-lake-id=\"u80f05109\" id=\"u80f05109\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">turtlesim_topic.py</span><span data-lake-id=\"u41bc725f\" id=\"u41bc725f\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,代码如下</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20sys%5Cnimport%20rclpy%5Cnfrom%20rclpy.node%20import%20Node%5Cnfrom%20geometry_msgs.msg%20import%20Twist%5Cnfrom%20PyQt5.QtWidgets%20import%20QApplication%2CQWidget%2CQFormLayout%2CQLineEdit%2CQPushButton%5Cn%5Cnclass%20MainWindow(QWidget)%3A%5Cn%20%20%20%20def%20__init__(self%2Cnode)%3A%5Cn%20%20%20%20%20%20%20%20super(MainWindow%2C%20self).__init__()%5Cn%20%20%20%20%20%20%20%20self.node%20%3D%20node%5Cn%20%20%20%20%20%20%20%20self.publisher%20%3D%20node.create_publisher(Twist%2C'%2Fturtle1%2Fcmd_vel'%2C10)%5Cn%20%20%20%20%20%20%20%20self.resize(400%2C120)%5Cn%20%20%20%20%20%20%20%20self.setWindowTitle('%E5%B0%8F%E4%B9%8C%E9%BE%9F%E6%8E%A7%E5%88%B6')%5Cn%20%20%20%20%20%20%20%20%23%20%E5%B8%83%E5%B1%80%5Cn%20%20%20%20%20%20%20%20layout%20%3D%20QFormLayout()%5Cn%20%20%20%20%20%20%20%20self.setLayout(layout)%5Cn%5Cn%20%20%20%20%20%20%20%20%23%20%E6%8E%A7%E4%BB%B6%5Cn%20%20%20%20%20%20%20%20self.editLinear%20%3D%20QLineEdit()%5Cn%20%20%20%20%20%20%20%20layout.addRow(%5C%22%E7%BA%BF%E9%80%9F%E5%BA%A6%5C%22%2C%20self.editLinear)%5Cn%5Cn%20%20%20%20%20%20%20%20self.editAngular%20%3D%20QLineEdit()%5Cn%20%20%20%20%20%20%20%20layout.addRow(%5C%22%E8%A7%92%E9%80%9F%E5%BA%A6%5C%22%2C%20self.editAngular)%5Cn%5Cn%20%20%20%20%20%20%20%20btnSend%20%3D%20QPushButton(%5C%22%E5%8F%91%E9%80%81%5C%22)%5Cn%20%20%20%20%20%20%20%20layout.addRow(''%2CbtnSend)%5Cn%20%20%20%20%20%20%20%20%23%20%E4%BA%8B%E4%BB%B6%5Cn%20%20%20%20%20%20%20%20btnSend.clicked.connect(self.send_twist)%23%20%E5%B8%83%E5%B1%80%5Cn%5Cn%20%20%20%20def%20send_twist(self)%3A%5Cn%20%20%20%20%20%20%20%20x%20%3D%20float(self.editLinear.text())%5Cn%20%20%20%20%20%20%20%20y%20%3D%20float(self.editAngular.text())%5Cn%20%20%20%20%20%20%20%20data%20%3D%20Twist()%5Cn%20%20%20%20%20%20%20%20data.linear.x%20%3D%20x%5Cn%20%20%20%20%20%20%20%20data.angular.z%20%3D%20y%5Cn%20%20%20%20%20%20%20%20self.node.get_logger().info('send%20topic')%5Cn%20%20%20%20%20%20%20%20self.publisher.publish(data)%5Cn%5Cndef%20main()%3A%5Cn%20%20%20%20rclpy.init()%5Cn%20%20%20%20node%20%3D%20Node('turtlesim_control')%5Cn%5Cn%20%20%20%20app%20%3D%20QApplication(sys.argv)%5Cn%20%20%20%20window%20%3D%20MainWindow(node)%5Cn%20%20%20%20window.show()%5Cn%20%20%20%20result%20%3D%20app.exec_()%5Cn%20%20%20%20node.destroy_node()%5Cn%20%20%20%20rclpy.shutdown()%5Cn%20%20%20%20sys.exit(result)%5Cn%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20main()%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22SPaEC%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"bOuRt\" id=\"bOuRt\"><span data-lake-id=\"ueea3fb4f\" id=\"ueea3fb4f\" style=\"color: rgb(51, 51, 51)\">2.2 添加配置</span></h2><ol list=\"u543e6029\"><li fid=\"u779c5b3a\" data-lake-id=\"ufb3061ca\" id=\"ufb3061ca\"><span data-lake-id=\"u2ceebf71\" id=\"u2ceebf71\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">打开</span><span data-lake-id=\"ude3841a4\" id=\"ude3841a4\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">setup.py</span><span data-lake-id=\"ube03b624\" id=\"ube03b624\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">文件,在</span><span data-lake-id=\"u313ffa0b\" id=\"u313ffa0b\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51); background-color: rgb(243, 244, 244)\">console_scripts</span><span data-lake-id=\"ua4fbbd53\" id=\"ua4fbbd53\" class=\"lake-fontsize-12\" style=\"color: rgb(51, 51, 51)\">节点下添加配置</span></li></ol><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22'turtlesim_topic%20%3D%20turtlesim_topic.turtlesim_topic%3Amain'%2C%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22B1OLZ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"Y4zUD\" id=\"Y4zUD\"><span data-lake-id=\"ud9455fc4\" id=\"ud9455fc4\" style=\"color: rgb(51, 51, 51)\">3. 编译工程</span></h1><car