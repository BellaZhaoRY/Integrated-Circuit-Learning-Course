  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><meta name=\"paragraphSpacing\" content=\"relax\" /><p data-lake-id=\"u458775c9\" id=\"u458775c9\" style=\"text-align: center\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1699507309347-f0b76cfe-97c4-47e7-b929-06f190a0a73e.png%22%2C%22taskId%22%3A%22u9b31cf38-a791-4f65-b9b8-36e16d387dd%22%2C%22clientId%22%3A%22u4a6feca5-1b2e-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A223.63635878917611%2C%22height%22%3A281%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A10236%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A246%2C%22originHeight%22%3A309%2C%22ratio%22%3A1.100000023841858%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E9%BB%91%E9%A9%AC%E7%A8%8B%E5%BA%8F%E5%91%98.%22%2C%22x%22%3A25%2C%22y%22%3A5%2C%22width%22%3A75%2C%22height%22%3A13%7D%2C%7B%22text%22%3A%221234%22%2C%22x%22%3A20%2C%22y%22%3A47%2C%22width%22%3A33%2C%22height%22%3A12%7D%2C%7B%22text%22%3A%22%E4%BA%86%22%2C%22x%22%3A155%2C%22y%22%3A125%2C%22width%22%3A8%2C%22height%22%3A13%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23ebd097%22%2C%22id%22%3A%22u38195c39%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"ue5c5f5ab\" id=\"ue5c5f5ab\"><span data-lake-id=\"u5f0ea29d\" id=\"u5f0ea29d\" class=\"lake-fontsize-12\">文本框是一个基础对象,其上面有一个标签(Label)和一个光标(Cursor)。</span></p><p data-lake-id=\"uef30ad53\" id=\"uef30ad53\"><span data-lake-id=\"uac14bd79\" id=\"uac14bd79\" class=\"lake-fontsize-12\">可以向文本框中添加文本或字符。长行会被换行,当文本内容变得足够长时,可以滚动文本框。</span></p><h1 data-lake-id=\"ri7yI\" id=\"ri7yI\"><span data-lake-id=\"ua1e56d4c\" id=\"ua1e56d4c\">1.常用方法</span></h1><p data-lake-id=\"u1c5d2fe2\" id=\"u1c5d2fe2\"><span data-lake-id=\"u4fec8756\" id=\"u4fec8756\" class=\"lake-fontsize-12\">创建textarea文本框:</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22lv_obj_t%20*%20lv_textarea_create(lv_obj_t%20*%20parent)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22OIOkj%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u5dd61561\" id=\"u5dd61561\"><span data-lake-id=\"u1a0bae39\" id=\"u1a0bae39\" class=\"lake-fontsize-12\">设置只有一行:</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22void%20lv_textarea_set_one_line(lv_obj_t%20*%20obj%2C%20bool%20en)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22PIv4l%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h1 data-lake-id=\"NXiAK\" id=\"NXiAK\"><span data-lake-id=\"udfcfa667\" id=\"udfcfa667\">2.代码实现</span></h1><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22void%20btnm_event_handler(lv_event_t*%20e)%7B%5Cn%20%20int%20code%20%3D%20lv_event_get_code(e)%3B%5Cn%20%20lv_obj_t*%20target%20%3D%20lv_event_get_target(e)%3B%5Cn%20%20lv_obj_t*%20textarea%20%3D%20lv_event_get_user_data(e)%3B%5Cn%20%20if(code%20%3D%3D%20LV_EVENT_VALUE_CHANGED)%7B%5Cn%20%20%20%20%2F%2F%20%E8%8E%B7%E5%8F%96%E5%8D%95%E5%87%BB%E7%9A%84%E6%8C%89%E9%92%AE%E7%BC%96%E5%8F%B7%5Cn%20%20%20%20uint16_t%20index%20%3D%20lv_btnmatrix_get_selected_btn(target)%3B%5Cn%20%20%20%20%2F%2F%20%E8%8E%B7%E5%8F%96%E5%8D%95%E5%87%BB%E7%9A%84%E6%8C%89%E9%92%AE%E6%96%87%E6%9C%AC%5Cn%20%20%20%20const%20char*%20btn_text%20%3D%20lv_btnmatrix_get_btn_text(target%2Cindex)%3B%5Cn%20%20%20%20%2F%2F%20%E6%9D%A1%E4%BB%B6%E5%88%A4%E6%96%AD%5Cn%20%20%20%20if(strcmp(btn_text%2CLV_SYMBOL_BACKSPACE)%20%3D%3D%200)%7B%5Cn%20%20%20%20%20%20lv_textarea_del_char(textarea)%3B%5Cn%20%20%20%20%7Delse%20if%20(strcmp(btn_text%2CLV_SYMBOL_NEW_LINE)%20%3D%3D%200)%5Cn%20%20%20%20%7B%5Cn%20%20%20%20%20%20printf(%5C%22enter%20clicked%5C%5Cn%5C%22)%3B%5Cn%20%20%20%20%20%20lv_event_send(textarea%2C%20LV_EVENT_READY%2C%20NULL)%3B%5Cn%20%20%20%20%7Delse%7B%5Cn%20%20%20%20%20%20%20%20%2F%2F%20%E5%90%91%E6%96%87%E6%9C%AC%E6%A1%86%E4%B8%AD%E5%A1%AB%E5%85%A5%E5%86%85%5Cn%20%20%20%20%20%20lv_textarea_add_text(textarea%2Cbtn_text)%3B%5Cn%20%20%20%20%7D%5Cn%20%20%7D%5Cn%7D%5Cnstatic%20void%20textarea_event_handler(lv_event_t%20*%20e)%5Cn%7B%5Cn%20%20%20%20lv_obj_t%20*%20ta%20%3D%20lv_event_get_target(e)%3B%5Cn%20%20%20%20printf(%5C%22Enter%20was%20pressed.%20The%20current%20text%20is%3A%20%25s%5C%22%2C%20lv_textarea_get_text(ta))%3B%5Cn%7D%5Cnvoid%20demo6()%7B%5Cn%20%20%2F%2F%20%E6%96%87%E6%9C%AC%E6%A1%86%5Cn%20%20lv_obj_t*%20textarea%20%3D%20lv_textarea_create(lv_scr_act())%3B%5Cn%20%20lv_textarea_set_one_line(textarea%2Ctrue)%3B%5Cn%20%20lv_obj_align(textarea%2CLV_ALIGN_TOP_MID%2C0%2C10)%3B%5Cn%20%20lv_obj_set_width(textarea%2C220)%3B%5Cn%20%20lv_obj_add_state(textarea%2C%20LV_STATE_FOCUSED)%3B%5Cn%20%20lv_obj_add_event_cb(textarea%2C%20textarea_event_handler%2C%20LV_EVENT_READY%2C%20textarea)%3B%5Cn%20%20%2F%2F%20%E5%88%9B%E5%BB%BA%E7%9F%A9%E9%98%B5%E6%8C%89%E9%92%AE%5Cn%20%20lv_obj_t*%20btnm%20%3D%20lv_btnmatrix_create(lv_scr_act())%3B%5Cn%20%20%2F%2F%20%E8%AE%BE%E7%BD%AE%E7%9F%A9%E9%98%B5%E6%8C%89%E9%92%AE%E7%9A%84%E6%98%BE%E7%A4%BA%5Cn%20%20lv_btnmatrix_set_map(btnm%2Cmap)%3B%5Cn%20%20lv_obj_set_width(btnm%2C220)%3B%5Cn%20%20lv_obj_align(btnm%2CLV_ALIGN_TOP_MID%2C0%2C80)%3B%5Cn%20%20lv_obj_clear_flag(btnm%2C%20LV_OBJ_FLAG_CLICK_FOCUSABLE)%3B%20%5Cn%20%20%2F%2F%20%E4%BA%8B%E4%BB%B6%E5%A4%84%E7%90%86%5Cn%20%20lv_obj_add_event_cb(btnm%2Cbtnm_event_handler%2CLV_EVENT_VALUE_CHANGED%2Ctextarea)%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22oC61D%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"uf921029f\" id=\"uf921029f\"><span data-lake-id=\"u3984231d\" id=\"u3984231d\" class=\"lake-fontsize-12\">效果:</span></p><p data-lake-id=\"uc5f76156\" id=\"uc5f76156\" style=\"text-align: center\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1699507304570-bd68cd4d-bf6c-4899-8162-bb651da76575.png%22%2C%22taskId%22%3A%22ub51ce016-65b5-4798-aa19-f56fdadc478%22%2C%22clientId%22%3A%22u4a6feca5-1b2e-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A223.63635878917611%2C%22height%22%3A281%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A10236%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A246%2C%22originHeight%22%3A309%2C%22ratio%22%3A1.100000023841858%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22%E9%BB%91%E9%A9%AC%E7%A8%8B%E5%BA%8F%E5%91%98.%22%2C%22x%22%3A25%2C%22y%22%3A5%2C%22width%22%3A75%2C%22height%22%3A13%7D%2C%7B%22text%22%3A%221234%22%2C%22x%22%3A20%2C%22y%22%3A47%2C%22width%22%3A33%2C%22height%22%3A12%7D%2C%7B%22text%22%3A%22%E4%BA%86%22%2C%22x%22%3A155%2C%22y%22%3A125%2C%22width%22%3A8%2C%22height%22%3A13%7D%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23ebd097%22%2C%22id%22%3A%22u8a51d6fe%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p>",
