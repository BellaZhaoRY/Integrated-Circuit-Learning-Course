t__('param_node')%5Cn%20%20%20%20%20%20%20%20self.declare_parameter('my_parameter'%2C%20'world123')%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22BC3C6%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"jaHOX\" id=\"jaHOX\"><span data-lake-id=\"ubd105ded\" id=\"ubd105ded\" style=\"color: rgb(51, 51, 51)\">修改参数</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22class%20MyNode(Node)%3A%5Cn%20%20%20%20def%20__init__(self)%3A%5Cn%20%20%20%20%20%20%20%20super(MyNode%2C%20self).__init__('param_node')%5Cn%20%20%20%20%20%20%20%20my_new_param%20%3D%20rclpy.Parameter(%5Cn%20%20%20%20%20%20%20%20%20%20%20%20'my_parameter'%2C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20rclpy.Parameter.Type.STRING%2C%5Cn%20%20%20%20%20%20%20%20%20%20%20%20'world'%5Cn%20%20%20%20%20%20%20%20)%5Cn%20%20%20%20%20%20%20%20params%20%3D%20%5Bmy_new_param%5D%5Cn%20%20%20%20%20%20%20%20self.set_parameters(params)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Q09ow%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"gU9vh\" id=\"gU9vh\"><span data-lake-id=\"u6eee0005\" id=\"u6eee0005\" style=\"color: rgb(51, 51, 51)\">节点中获取参数</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%