  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><meta name=\"paragraphSpacing\" content=\"relax\" /><h2 data-lake-id=\"bZNMn\" id=\"bZNMn\"><span data-lake-id=\"u61dcf79a\" id=\"u61dcf79a\">学习目标</span></h2><h2 data-lake-id=\"vexGQ\" id=\"vexGQ\"><span data-lake-id=\"ufaf34085\" id=\"ufaf34085\">学习内容</span></h2><p data-lake-id=\"u946f7307\" id=\"u946f7307\"><span data-lake-id=\"u73df25a4\" id=\"u73df25a4\">NTC(Negative Temperature Coefficient)是指随温度上升电阻减小、具有负温度系数的热敏电阻现象和材料。</span></p><h3 data-lake-id=\"viWIe\" id=\"viWIe\"><span data-lake-id=\"u301c84ed\" id=\"u301c84ed\">原理图</span></h3><p data-lake-id=\"ubcc305fa\" id=\"ubcc305fa\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2025%2Fpng%2F27903758%2F1761019381399-049cca0a-7ecc-4967-9c33-d5b51dd31da4.png%3Fx-oss-process%3Dimage%252Fwatermark%252Ctype_d3F5LW1pY3JvaGVp%252Csize_15%252Ctext_6buR6ams56iL5bqP5ZGY%252Ccolor_FFFFFF%252Cshadow_50%252Ct_80%252Cg_se%252Cx_10%252Cy_10%22%2C%22taskId%22%3A%22u5763636a-7814-4424-9501-f8b3c69648c%22%2C%22clientId%22%3A%22ufb1af06c-3723-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A422.4%2C%22height%22%3A444%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A22820%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A528%2C%22originHeight%22%3A555%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22ocrLocations%22%3A%5B%7B%22text%22%3A%22NTC%22%2C%22x%22%3A385%2C%22y%22%3A19%2C%22width%22%3A111%2C%22height%22%3A45%7D%2C%7B%22text%22%3A%22NTC%22%2C%22x%22%3A272%2C%22y%22%3A120%2C%22width%22%3A38%2C%22height%22%3A16%7D%2C%7B%22text%22%3A%22100NF%22%2C%22x%22%3A370%2C%22y%22%3A408%2C%22width%22%3A47%2C%22height%22%3A15%7D%2C%7B%22text%22%3A%2210K%22%2C%22x%22%3A257%2C%22y%22%3A292%2C%22width%22%3A38%2C%22height%22%3A19%7D%2C%7B%22text%22%3A%22GN