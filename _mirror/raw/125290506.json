  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><p data-lake-id=\"u48e63ae7\" id=\"u48e63ae7\"><span data-lake-id=\"u673af8c6\" id=\"u673af8c6\">python系统内置很多实用模块</span></p><h2 data-lake-id=\"t88eM\" id=\"t88eM\" data-lake-index-type=\"2\"><span data-lake-id=\"uaccbb801\" id=\"uaccbb801\">sys模块</span></h2><ul list=\"udc6a740d\"><li fid=\"u3943da68\" data-lake-id=\"u0e5d6ef7\" id=\"u0e5d6ef7\"><code data-lake-id=\"ud0e640e5\" id=\"ud0e640e5\"><span data-lake-id=\"uf31ecfea\" id=\"uf31ecfea\">sys.argv</span></code><span data-lake-id=\"u1635b754\" id=\"u1635b754\"> 获得启动时的参数</span></li><li fid=\"u3943da68\" data-lake-id=\"ue464d922\" id=\"ue464d922\"><code data-lake-id=\"ua7dabbee\" id=\"ua7dabbee\"><span data-lake-id=\"u8fd3837c\" id=\"u8fd3837c\">sys.path</span></code><span data-lake-id=\"u0d742e07\" id=\"u0d742e07\"> 获取加载的环境</span></li><li fid=\"u3943da68\" data-lake-id=\"ucc228e47\" id=\"ucc228e47\"><code data-lake-id=\"u041bb442\" id=\"u041bb442\"><span data-lake-id=\"u21787e06\" id=\"u21787e06\">sys.exit()</span></code><span data-lake-id=\"u38cc120d\" id=\"u38cc120d\">程序退出</span></li></ul><h2 data-lake-id=\"OGags\" id=\"OGags\" data-lake-index-type=\"2\"><span data-lake-id=\"u3a92ac4e\" id=\"u3a92ac4e\">time模块</span></h2><p data-lake-id=\"u12b75f1b\" id=\"u12b75f1b\"><code data-lake-id=\"uea24e707\" id=\"uea24e707\"><span data-lake-id=\"u1163c267\" id=\"u1163c267\">time</span></code><span data-lake-id=\"u90151315\" id=\"u90151315\">模块，包含和时间相关信息</span></p><p data-lake-id=\"ua277e0e3\" id=\"ua277e0e3\"><code data-lake-id=\"ufcd696d3\" id=\"ufcd696d3\"><span data-lake-id=\"ue97f1c68\" id=\"ue97f1c68\">time.time()</span></code><span data-lake-id=\"u08dede4a\" id=\"u08dede4a\">获取当前时间戳，单位是秒，(相对于1970年1月1日的0点0时0分0秒)</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20time%5Cnresult%20%3D%20time.time()%20%23%20%E8%8E%B7%E5%8F%96%E5%BD%93%E5%89%8D%E6%97%B6%E9%97%B4%5Cnprint(result)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22ePfKy%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u55d074e8\" id=\"u55d074e8\"><code data-lake-id=\"uddf596b3\" id=\"uddf596b3\"><span data-lake-id=\"u360f6ad4\" id=\"u360f6ad4\">time.sleep(秒)</span></code><span data-lake-id=\"ub43c893b\" id=\"ub43c893b\">阻断程序</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20time%5Cn%5Cn%23%20print('%E7%A8%8B%E5%BA%8F%E5%BC%80%E5%A7%8B')%5Cn%23%20%E7%9D%A1%E7%9C%A03%E7%A7%92%E9%92%9F%5Cntime.sleep(3)%5Cn%23%20print('%E7%A8%8B%E5%BA%8F%E7%BB%93%E6%9D%9F')%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22uA97V%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"pKsC5\" id=\"pKsC5\" data-lake-index-type=\"2\"><span data-lake-id=\"ud5f865c8\" id=\"ud5f865c8\">datetime模块</span></h2><p data-lake-id=\"u9a43134b\" id=\"u9a43134b\"><code data-lake-id=\"u5009152e\" id=\"u5009152e\"><span data-lake-id=\"u073de0c0\" id=\"u073de0c0\">datetime</span></code><span data-lake-id=\"u67df6288\" id=\"u67df6288\">获取日期</span></p><p data-lake-id=\"u1d8106be\" id=\"u1d8106be\"><code data-lake-id=\"u4eb489af\" id=\"u4eb489af\"><span data-lake-id=\"u0a0f9712\" id=\"u0a0f9712\">datetime.datetime.now().year</span></code><span data-lake-id=\"ufd0cc9e1\" id=\"ufd0cc9e1\"><br /></span><code data-lake-id=\"ua5c71185\" id=\"ua5c71185\"><span data-lake-id=\"u48016ec3\" id=\"u48016ec3\">datetime.datetime.now().month</span></code><span data-lake-id=\"ub155aa53\" id=\"ub155aa53\"><br /></span><code data-lake-id=\"uefc09761\" id=\"uefc09761\"><span data-lake-id=\"u8a341e32\" id=\"u8a341e32\">datetime.datetime.now().day</span></code></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20datetime%5Cn%23%20%E8%8E%B7%E5%8F%96%E5%BD%93%E5%89%8D%E5%B9%B4%5Cnyear%20%3D%20datetime.datetime.now().year%5Cn%23%20%E8%8E%B7%E5%8F%96%E6%9C%88%5Cnmonth%20%3D%20datetime.datetime.now().month%5Cn%23%20%E8%8E%B7%E5%8F%96%E6%97%A5%E6%9C%9F%5Cnday%20%3D%20datetime.datetime.now().day%5Cnprint(year)%5Cnprint(month)%5Cnprint(day)%5Cn%5Cn%23%20%E6%A0%BC%E5%BC%8F%E5%8C%96%E6%97%A5%E6%9C%9F%E6%97%B6%E9%97%B4%5Cnnow%20%3D%20datetime.datetime.now()%5Cnstr_time%20%3D%20datetime.datetime.strftime(now%2C%20%5C%22%25Y-%25m-%25d%20%25H%3A%25M%3A%25S%5C%22)%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22IEWHJ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"Ua5vL\" id=\"Ua5vL\" data-lake-index-type=\"2\"><span data-lake-id=\"u14575d05\" id=\"u14575d05\">计算排序</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22aaa%20%3D%20%5B2%2C%204%2C%201%2C%202%2C%203%2C%206%5D%5Cn%23%20%E5%88%97%E8%A1%A8%E6%9C%80%E5%A4%A7%E5%80%BC%5Cnprint(max(aaa))%5Cn%23%20%E5%88%97%E8%A1%A8%E6%9C%80%E5%B0%8F%E5%80%BC%5Cnprint(min(aaa))%5Cn%23%20%E5%88%97%E8%A1%A8%E5%92%8C%5Cnprint(sum(aaa))%5Cn%23%20%E5%88%97%E8%A1%A8%E9%95%BF%E5%BA%A6%5Cnprint(len(aaa))%5Cn%23%20%E5%88%97%E8%A1%A8%E6%8E%92%E5%BA%8F%5Cnprint(sorted(aaa))%5Cn%23%20%E5%88%97%E8%A1%A8%E5%80%92%E5%BA%8F%5Cnprint(sorted(aaa%2C%20reverse%3DTrue))%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22MRzZH%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"EZq1H\" id=\"EZq1H\" data-lake-index-type=\"2\"><span data-lake-id=\"u9030c00a\" id=\"u9030c00a\">math模块</span></h2><p data-lake-id=\"u8953931a\" id=\"u8953931a\"><code data-lake-id=\"ufe68672f\" id=\"ufe68672f\"><span data-lake-id=\"uf4e54940\" id=\"uf4e54940\">math</span></code><span data-lake-id=\"u5808bbde\" id=\"u5808bbde\">是数学相关的库</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22math.pow%5Ct%5Ct%E6%B1%82%E5%B9%82%5Cnmath.floor%5Ct%E5%8F%96%E4%B8%8B%5Cnmath.ceil%5Ct%5Ct%E5%8F%96%E4%B8%8A%5Cnround%5Ct%5Ct%5Ct%5Ct%E5%9B%9B%E8%88%8D%E4%BA%94%E5%85%A5%5Cnmath.sin%20cos%20tan%E2%80%A6%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22nWN6C%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20math%5Cn%23%20%E5%B9%82%5Cnprint(math.pow(10%2C%202))%5Cn%23%20%E5%90%91%E4%B8%8B%E5%8F%96%E6%95%B4%5Cnprint(math.floor(1.8234234234234))%5Cn%23%20%E5%90%91%E4%B8%8A%E5%8F%96%E6%95%B4%5Cnprint(math.ceil(1.1234234234234))%5Cn%23%20%E5%9B%9B%E8%88%8D%E4%BA%94%E5%85%A5%5Cnprint(round(1.6234234234234))%5Cn%5Cn%23%20sin%20%20%E4%BC%A0%E5%85%A5%E5%BC%A7%E5%BA%A6%E5%80%BC%20%20pi%203.14%20180%E5%BA%A6%5Cnprint(math.sin(1.57))%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22Ltobn%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"DJupO\" id=\"DJupO\"><span data-lake-id=\"ua9696744\" id=\"ua9696744\">5. random模块</span></h2><p data-lake-id=\"u0523d143\" id=\"u0523d143\"><code data-lake-id=\"uec3de0ec\" id=\"uec3de0ec\"><span data-lake-id=\"u41328c4d\" id=\"u41328c4d\">random</span></code><span data-lake-id=\"u410aea66\" id=\"u410aea66\">主要用来产生随机数</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22random.randint(start%2Cend)%5Ct%23%20%E9%9A%8F%E6%9C%BA%E6%95%B4%E6%95%B0%EF%BC%8C%5Bstart%2Cend%5D%5Cnrandom.random()%5Ct%5Ct%5Ct%5Ct%5Ct%5Ct%23%20%E9%9A%8F%E6%9C%BA%E6%B5%AE%E7%82%B9%E6%95%B0%2C%20%5B0%2C1)%5Cnrandom.uniform(start%2Cend)%5Ct%23%20%E9%9A%8F%E6%9C%BA%E6%B5%AE%E7%82%B9%E6%95%B0%2C%20%5Bstart%2Cend%5D%5Cnrandom.choice(%5B%5D)%5Ct%5Ct%5Ct%5Ct%5Ct%23%20%E9%9A%8F%E6%9C%BA%E6%95%B0%E7%BB%84%2C%20%E8%BF%94%E5%9B%9E%E5%8D%95%E4%B8%AA%E5%85%83%E7%B4%A0%5Cnrandom.choices(%5B%5D)%5Ct%5Ct%5Ct%5Ct%23%20%E9%9A%8F%E6%9C%BA%E6%95%B0%E7%BB%84%2C%20%E8%BF%94%E5%9B%9E%E5%88%97%E8%A1%A8%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22V7oSz%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22import%20random%5Cn%5Cn%23%20%E9%9A%8F%E6%9C%BA%E6%95%B4%E6%95%B0%5Cnprint(random.randint(10%2C%2020))%5Cn%23%20%E9%9A%8F%E6%9C%BA%E5%B0%8F%E6%95%B0%20%5B0%2C%201)%5Cnprint(random.random())%5Cn%23%20%E9%9A%8F%E6%9C%BA%E6%B5%AE%E7%82%B9%E7%B1%BB%E5%9E%8B%E6%95%B0%E6%8D%AE%5Cnprint(random.uniform(1.3%2C%208.5))%5Cn%5Cn%23%20%E4%BB%8E%E5%88%97%E8%A1%A8%E4%B8%AD%E9%9A%8F%E6%9C%BA%E8%8E%B7%E5%8F%96%E5%85%83%E7%B4%A0%5Cnlst%20%3D%20%5B10%2C20%2C30%5D%5Cnprint(random.choice(lst))%5Cn%5Cn%23%20%E9%9A%8F%E6%9C%BA%E8%BF%94%E5%9B%9E%E5%88%97%E8%A1%A8%20%E8%BF%94%E5%9B%9E%E5%8D%95%E4%B8%AA%E5%85%83%E7%B4%A0%E7%9A%84%E5%88%97%E8%A1%A8%5Cnprint(random.choices(lst))%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22dSQPa%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>",
