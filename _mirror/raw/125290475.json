  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><h2 data-lake-id=\"lDlDf\" id=\"lDlDf\"><span data-lake-id=\"uc947810f\" id=\"uc947810f\">需求</span></h2><p data-lake-id=\"u7afd14c9\" id=\"u7afd14c9\"><span data-lake-id=\"u8b8abaea\" id=\"u8b8abaea\">完成字符串的逆序以及统计</span></p><p data-lake-id=\"ubda49183\" id=\"ubda49183\"><span data-lake-id=\"ufeae765d\" id=\"ufeae765d\">设计一个程序，要求只能输入长度低于31的字符串，否则提示用户重新输入</span></p><p data-lake-id=\"ucd486cc7\" id=\"ucd486cc7\"><span data-lake-id=\"ua4b8a684\" id=\"ua4b8a684\">打印如下内容:</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22--------------------------------------------%5Cn%E6%82%A8%E8%BE%93%E5%85%A5%E7%9A%84%E5%AD%97%E7%AC%A6%E4%B8%B2%3A%20zhongshanshan%5Cn%E9%95%BF%E5%BA%A6%3A%2013%5Cn%E9%80%86%E5%BA%8F%E5%90%8E%E4%B8%BA%3A%20nahsnahsgnohz%5Cn%E5%AD%97%E7%AC%A6%E7%BB%9F%E8%AE%A1%E7%BB%93%E6%9E%9C%3A%20z%3A1%20h%3A3%20o%3A1%20n%3A3%20g%3A1%20s%3A2%20a%3A2%5Cn--------------------------------------------%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22SzpYy%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"cyMBo\" id=\"cyMBo\"><span data-lake-id=\"ud2b1573f\" id=\"ud2b1573f\">分析</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%221.%20%E8%BE%93%E5%85%A5%E5%AD%97%E7%AC%A6%E4%B8%B2(while%E5%BE%AA%E7%8E%AF)%5Cn2.%20%E5%AD%97%E7%AC%A6%E4%B8%B2%E9%95%BF%E5%BA%A6%E5%B0%8F%E4%BA%8E31%E4%BD%8D%2C%E5%90%A6%E5%88%99%E6%8F%90%E7%A4%BA%E9%87%8D%E6%96%B0%E8%BE%93%E5%85%A5%5Cn3.%20%E6%82%A8%E8%BE%93%E5%85%A5%E7%9A%84%E5%AD%97%E7%AC%A6%E4%B8%B2%3A%20...%5Cn4.%20%E9%95%BF%E5%BA%A6%3A%20...%5Cn5.%20%E9%80%86%E5%BA%8F%E5%90%8E%E4%B8%BA%3A%20...%20%20(%E5%88%87%E7%89%87)%5Cn6.%20%E5%AD%97%E7%AC%A6%E7%BB%9F%E8%AE%A1%E7%BB%93%E6%9E%9C%3A%20...(afsfdsf)%20%20a%3A1%20%20f%3A3%20s%3A2%20d%3A1%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22iE9zg%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"DMJZG\" id=\"DMJZG\"><span data-lake-id=\"uccbfbc7c\" id=\"uccbfbc7c\">代码</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%E5%AE%9E%E7%8E%B0%E5%AD%97%E7%AC%A6%E4%B8%B2%E9%80%86%E5%BA%8F%E7%BB%9F%E8%AE%A1%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22while%20True%3A%5Cn%20%20%20%20%23%201.%E8%BE%93%E5%85%A5%E5%AD%97%E7%AC%A6%E4%B8%B2(while%E5%BE%AA%E7%8E%AF)%5Cn%20%20%20%20str%20%3D%20input('%E8%AF%B7%E8%BE%93%E5%85%A5%E5%AD%97%E7%AC%A6%E4%B8%B2%3A')%5Cn%20%20%20%20%23%202.%E5%AD%97%E7%AC%A6%E4%B8%B2%E9%95%BF%E5%BA%A6%E5%B0%8F%E4%BA%8E31%E4%BD%8D%2C%E5%90%A6%E5%88%99%E6%8F%90%E7%A4%BA%E9%87%8D%E6%96%B0%E8%BE%93%E5%85%A5%5Cn%20%20%20%20if%20len(str)%20%3E%3D%2031%3A%5Cn%20%20%20%20%20%20%20%20print('%E4%B8%8D%E8%83%BD%E8%B6%85%E8%BF%8731%E4%BD%8D%2C%E8%AF%B7%E9%87%8D%E6%96%B0%E8%BE%93%E5%85%A5')%5Cn%20%20%20%20%20%20%20%20continue%5Cn%20%20%20%20%23%20%E8%B7%B3%E5%87%BA%E5%BE%AA%E7%8E%AF%5Cn%20%20%20%20break%5Cnprint('%E8%BE%93%E5%85%A5%E6%AD%A3%E7%A1%AE')%5Cnprint(%5C%22--------------------------------------------%5C%22)%5Cn%23%203.%E6%82%A8%E8%BE%93%E5%85%A5%E7%9A%84%E5%AD%97%E7%AC%A6%E4%B8%B2%3A%20...%5Cnprint('%E6%82%A8%E8%BE%93%E5%85%A5%E7%9A%84%E5%AD%97%E7%AC%A6%E4%B8%B2%3A%25s'%20%25%20str)%5Cn%23%204.%E9%95%BF%E5%BA%A6%3A%20...%5Cnprint('%E9%95%BF%E5%BA%A6%3A%25d'%20%25%20len(str))%5Cn%23%205.%E9%80%86%E5%BA%8F%E5%90%8E%E4%B8%BA%3A%20...%20%20(%E5%88%87%E7%89%87)%5CnnewStr%20%3D%20str%5B%3A%3A-1%5D%5Cnprint('%E9%80%86%E5%BA%8F%E5%90%8E%E4%B8%BA%3A%25s'%20%25%20newStr)%5Cn%23%206.%E5%AD%97%E7%AC%A6%E7%BB%9F%E8%AE%A1%E7%BB%93%E6%9E%9C%3A%20...(afsfadsf)%20%20a%3A1%20%20f%3A3%20s%3A2%20d%3A1%5Cn%23%201.%E5%AD%97%E5%85%B8%20%E4%BF%9D%E5%AD%98%E7%BB%93%E6%9E%9C%20%20%7B%7D%5CnresultDict%20%3D%20%7B%7D%5Cnfor%20ele%20in%20str%3A%5Cn%20%20%20%20if%20ele%20not%20in%20resultDict%3A%5Cn%20%20%20%20%20%20%20%20%23%202.%20%E5%A6%82%E6%9E%9C%E5%AD%97%E5%85%B8%E4%B8%AD%E6%B2%A1%E6%9C%89%E8%BF%99%E4%B8%AAa%2C%20%E6%8A%8Aa%E6%B7%BB%E5%8A%A0%E8%BF%9B%E5%8E%BB%20%7B'a'%3A1%7D%5Cn%20%20%20%20%20%20%20%20resultDict%5Bele%5D%20%3D%201%5Cn%20%20%20%20else%3A%5Cn%20%20%20%20%20%20%20%20%23%203.%E5%AD%97%E5%85%B8%E4%B8%AD%E6%9C%89a%20%E5%B0%86%E5%85%83%E7%B4%A0%E4%B8%AA%E6%95%B0%2B1%5Cn%20%20%20%20%20%20%20%20resultDict%5Bele%5D%20%2B%3D%201%5Cnprint('%E5%AD%97%E7%AC%A6%E7%BB%9F%E8%AE%A1%E7%BB%93%E6%9E%9C%3A%7B%7D'.format(resultDict))%5Cnprint(%5C%22--------------------------------------------%5C%22)%5Cn%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Atrue%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%E5%AE%9E%E7%8E%B0%E5%AD%97%E7%AC%A6%E4%B8%B2%E9%80%86%E5%BA%8F%E7%BB%9F%E8%AE%A1%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22IMFkC%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>",
