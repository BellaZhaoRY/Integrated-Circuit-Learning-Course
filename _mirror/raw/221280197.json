a:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%5Cnstruct%20A%7B%5Cn%5Ctchar%20a%3A4%3B%5Ct%5Ct%5Ct%5Ct%2F%2F%20%E6%8C%87%E5%AE%9Aa%E7%9A%84%E4%BD%8D%E5%AE%BD%E4%B8%BA4bit%5Cn%5Ctchar%20b%3A4%3B%5Ct%5Ct%5Ct%5Ct%2F%2F%20%E6%8C%87%E5%AE%9Ab%E7%9A%84%E4%BD%8D%E5%AE%BD%E4%B8%BA4bit%5Cn%5Ctunsigned%20short%20c%3A8%3B%5Ct%5Ct%2F%2F%20%E6%8C%87%E5%AE%9Ac%E7%9A%84%E4%BD%8D%E5%AE%BD%E4%B8%BA8bit%5Cn%5Ctunsigned%20long%20d%3B%5Ct%5Ct%5Cn%7D%3B%5Cn%5Cnint%20main()%20%5Cn%7B%5Cn%5Cn%5Ctprintf(%5C%22sizof(A)%20%3D%20%25lld%5C%5Cn%5C%22%2C%20sizeof(struct%20A))%3B%5Cn%5Ct%5Cn%5Ctreturn%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22x5PAN%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"ue4895541\" id=\"ue4895541\"><br></p><p data-lake-id=\"u11ceea20\" id=\"u11ceea20\"><span data-lake-id=\"u04065d6f\" id=\"u04065d6f\" class=\"lake-fontsize-12\" style=\"color: var(--md-box-samantha-normal-text-color) !important\">在 32 位系统中，</span><code data-lake-id=\"uebf5f55a\" id=\"uebf5f55a\"><span data-lake-id=\"uf245ffbc\" id=\"uf245ffbc\" class=\"lake-fontsize-11\" style=\"color: var(--color-text-primary)\">struct A</span></code><span data-lake-id=\"u5a2f1f3c\" id=\"u5a2f1f3c\" class=\"lake-fontsize-12\" style=\"color: var(--md-box-samantha-normal-text-color) !important\"> 的大小通常为 8 Byte。</span></p><p data-lake-id=\"uf89bb57e\" id=\"uf89bb57e\"><span data-lake-id=\"ud378e651\" id=\"ud378e651\" class=\"lake-fontsize-12\" style=\"color: var(--md-box-samantha-normal-text-color) !important\">其中，</span><code data-lake-id=\"uec28dcab\" id=\"