  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><p data-lake-id=\"ub4793932\" id=\"ub4793932\"><span data-lake-id=\"u5ebb3dbc\" id=\"u5ebb3dbc\">将</span><strong><span data-lake-id=\"uc9bdad43\" id=\"uc9bdad43\">属性</span></strong><span data-lake-id=\"u617fe0bd\" id=\"u617fe0bd\">或者</span><strong><span data-lake-id=\"u8095f610\" id=\"u8095f610\">方法</span></strong><span data-lake-id=\"u66832802\" id=\"u66832802\">设置为不能在外部访问，就是私有化</span></p><p data-lake-id=\"ua5db13ee\" id=\"ua5db13ee\"><span data-lake-id=\"u052c8677\" id=\"u052c8677\">私有化包括：</span><strong><span data-lake-id=\"u6a8920cf\" id=\"u6a8920cf\">属性私有化</span></strong><span data-lake-id=\"u6f2c4d48\" id=\"u6f2c4d48\">、</span><strong><span data-lake-id=\"ue37b7047\" id=\"ue37b7047\">方法私有化</span></strong></p><h2 data-lake-id=\"T4GYA\" id=\"T4GYA\" data-lake-index-type=\"2\"><span data-lake-id=\"u7f23c239\" id=\"u7f23c239\">属性私有化</span></h2><p data-lake-id=\"ua8cf1066\" id=\"ua8cf1066\"><span data-lake-id=\"u49dd35dd\" id=\"u49dd35dd\">属性私有化格式，注意是两个下划线</span><code data-lake-id=\"u81fc5833\" id=\"u81fc5833\"><span data-lake-id=\"ucee05b2c\" id=\"ucee05b2c\">__</span></code><span data-lake-id=\"u07f8c7f3\" id=\"u07f8c7f3\"><br /></span><code data-lake-id=\"u0bf20107\" id=\"u0bf20107\"><span data-lake-id=\"u863b8095\" id=\"u863b8095\">self.__属性名 = 属性值</span></code></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22class%20Circle%3A%5Cn%20%20%20%20def%20__init__(self%2Cradius)%3A%5Cn%20%20%20%20%20%20%20%20%23%20%E5%8D%8A%E5%BE%84%5Cn%20%20%20%20%20%20%20%20self.radius%20%3D%20radius%5Cn%20%20%20%20%20%20%20%20%23%20%E7%A7%81%E6%9C%89%E5%8C%96%E5%9C%86%E5%91%A8%E7%8E%87%E5%B1%9E%E6%80%A7%20%5Cn%20%20%20%20%20%20%20%20self.__PI%20%3D%203.1415926%5Cn%5Cn%5Cn%20%20%20%20def%20perimeter(self)%3A%5Cn%20%20%20%20%20%20%20%20'''%5Cn%20%20%20%20%20%20%20%20%E6%B1%82%E5%9C%86%E7%9A%84%E5%91%A8%E9%95%BF%5Cn%20%20%20%20%20%20%20%20%3Areturn%3A%20%E5%9C%86%E7%9A%84%E5%91%A8%E9%95%BF%5Cn%20%20%20%20%20%20%20%20'''%5Cn%20%20%20%20%20%20%20%20return%202%20*%20self.__PI%20*%20self.radius%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22pKECt%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u2016e194\" id=\"u2016e194\"><span data-lake-id=\"ud8088d3a\" id=\"ud8088d3a\">私有化作用：保证类中数据安全</span></p><h2 data-lake-id=\"uzr9h\" id=\"uzr9h\" data-lake-index-type=\"2\"><span data-lake-id=\"uc80db770\" id=\"uc80db770\">方法私有化</span></h2><p data-lake-id=\"u77eef989\" id=\"u77eef989\"><span data-lake-id=\"u88798169\" id=\"u88798169\">方法的私有化方式和属性私有化方式一样</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22class%20Person%3A%5Cn%20%20%20%20def%20__say_hello(self)%3A%5Cn%20%20%20%20%20%20%20%20print('hello')%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22gvoSc%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card>",
