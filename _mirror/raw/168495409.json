0%20%20sprintf(d.buffer%2C%20%5C%22%25s%5C%22%2C%20data)%3B%5Cn%20%20%20%20d.buffer%5Bd.len%5D%20%3D%20'%5C%5C0'%3B%5Cn%20%20%20%20%2F%2FxQueueSend(queue%2C%20%26d%2C%20portMAX_DELAY)%3B%5Cn%5Cn%20%20%20%20xQueueSendFromISR(queue%2C%20%26d%2C%20NULL)%3B%5Cn%7D%5Cn%5Cnstatic%20void%20GPIO_config()%20%7B%5Cn%20%20%20%20%2F%2F%20%E6%97%B6%E9%92%9F%E5%88%9D%E5%A7%8B%E5%8C%96%5Cn%20%20%20%20rcu_periph_clock_enable(RCU_GPIOA)%3B%5Cn%20%20%20%20%2F%2F%20%E9%85%8D%E7%BD%AEGPIO%E6%A8%A1%E5%BC%8F%5Cn%20%20%20%20gpio_mode_set(GPIOA%2C%20GPIO_MODE_INPUT%2C%20GPIO_PUPD_PULLDOWN%2C%20GPIO_PIN_0)%3B%5Cn%7D%5Cn%5Cnvoid%20start_task(void%20*pvParameters)%20%7B%5Cn%20%20%20%20%5Cn%20%20%20%20GPIO_config()%3B%5Cn%20%20%20%20USART0_init()%3B%5Cn%5Cn%20%20%20%20queue%20%3D%20xQueueCreate(128%2C%20sizeof(MyData_t))%3B%5Cn%20%20%20%20%5Cn%20%20%20%20taskENTER_CRITICAL()%3B%5Cn%20%20%20%20xTaskCreate(task_key%2C%20%5C%22task_key%5C%22%2C%2064%2C%20NULL%2C%202%2C%20%26task_key_handler)%3B%5Cn%20%20%20%20xTaskCreate(task1%2C%20%5C%22task1%5C%22%2C%2064%2C%20NULL%2C%202%2C%20%26task1_handler)%3B%5Cn%20%20%20%20vTaskDelete(task_handler)%3B%5Cn%5Cn%20%20%20%20taskEXIT_CRITICAL()%3B%5Cn%7D%5Cn%20%20%20%20%5Cnint%20main(void)%5Cn%7B%5Cn%20%20%20%20nvic_priority_group_set(NVIC_PRIGROUP_PRE4_SUB0)%3B%5Cn%20%20%20%20xTaskCreate(start_task%2C%20%5C%22start_task%5C%22%2C%20128%2C%20NULL%2C%201%2C%20%26task_handler)%3B%5Cn%20%20%20%20vTaskStartScheduler()%3B%5Cn%5Cn%20%20%20%20while(1)%20%7B%7D%5Cn%7D%5Cn%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22main.c%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Night%20Owl%22%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22YXfrq%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u8232720a\" id=\"u8232720a\"><br></p><h3 data-lake-id=\"SYTVq\" id=\"SYTVq\"><span data-lake-id=\"u7533f51a\" id=\"u7533f51a\">信号量和消息队列</span></h3><ol list=\"u8aac181a\"><li fid=\"u7a02f2b1\" data-lake-id=\"u6e9eaba4\" id=\"u6e9eaba4\"><span data-lake-id=\"u61858755\" id=\"u61858755\">从数据结构上进行比较。</span></li></ol><p data-lake-id=\"ufaec9d92\" id=\"ufaec9d92\" style=\"padding-left: 2em\"><span data-lake-id=\"u902e113b\" id=\"u902e113b\">消息队列是一种数据结构，用于在任务之间传递和共享数据或消息。它可以存储多个消息，并且可以按照先进先出（FIFO）的顺序进行访问。</span></p><p data-lake-id=\"ub63e7313\" id=\"ub63e7313\" style=\"padding-left: 2em\"><span data-lake-id=\"u035689fc\" id=\"u035689fc\">信号量是一种同步机制，用于控制对共享资源的访问和任务之间的同步。它可以表示可用资源的数量或资源的占用状态。</span></p><ol list=\"u78807d26\" start=\"2\"><li fid=\"ue780fbbb\" data-lake-id=\"u9ef0aa17\" id=\"u9ef0aa17\"><span data-lake-id=\"u95540925\" id=\"u95540925\">从操作方式上进行比较。</span></li></ol><p data-lake-id=\"ue32ade84\" id=\"ue32ade84\" style=\"padding-left: 2em\"><span data-lake-id=\"u86eb578d\" id=\"u86eb578d\">消息队列可以存储和获取多个消息。</span></p><p data-lake-id=\"ude07fca2\" id=\"ude07fca2\" style=\"padding-left: 2em\"><span data-lake-id=\"u79179937\" id=\"u79179937\">信号量只有获取和释放两种操作。</span></p><ol list=\"uc5537348\" start=\"3\"><li fid=\"u214d1d8f\" data-lake-id=\"uc9e33d91\" id=\"uc9e33d91\"><span data-lake-id=\"u8a074612\" id=\"u8a074612\">从特性上进行比较。</span></li></ol><p data-lake-id=\"u1217cd01\" id=\"u1217cd01\" style=\"padding-left: 2em\"><span data-lake-id=\"ucb33d645\" id=\"ucb33d645\">消息队列可以按照先进先出的顺序处理消息。</span></p><p data-lake-id=\"ubfa1553a\" id=\"ubfa1553a\" style=\"padding-left: 2em\"><span data-lake-id=\"u5df5e045\" id=\"u5df5e045\">信号量只表示资源的可用状态或占用状态。</span></p><p data-lake-id=\"u7be07f72\" id=\"u7be07f72\" style=\"padding-left: 2em\"><span data-lake-id=\"uc12f1c59\" id=\"uc12f1c59\">​</span><br></p><table data-lake-id=\"OI64f\" id=\"OI64f\" margin=\"true\" width-mode=\"contain\" class=\"lake-table\" style=\"width: 750px\"><colgroup><col width=\"250\"><col width=\"250\"><col width=\"250\"></colgroup><tbody><tr data-lake-id=\"u971a39bf\" id=\"u971a39bf\"><td data-lake-id=\"uf4c5f690\" id=\"uf4c5f690\"><p data-lake-id=\"ue346d04b\" id=\"ue346d04b\" style=\"text-align: center\"><strong><span data-lake-id=\"uc9027cdc\" id=\"uc9027cdc\">​</span></strong><br></p></td><td data-lake-id=\"u22d99c26\" id=\"u22d99c26\"><p data-lake-id=\"ueaa97584\" id=\"ueaa97584\" style=\"text-align: center\"><strong><span data-lake-id=\"uc8929f58\" id=\"uc8929f58\">信号量</span></strong></p></td><td data-lake-id=\"uc7bab74a\" id=\"uc7bab74a\"><p data-lake-id=\"ue5b901e6\" id=\"ue5b901e6\" style=\"text-align: center\"><strong><span data-lake-id=\"u63f2f0c8\" id=\"u63f2f0c8\">队列</span></strong></p></td></tr><tr data-lake-id=\"u5fcbc72c\" id=\"u5fcbc72c\"><td data-lake-id=\"ub67aa607\" id=\"ub67aa607\"><p data-lake-id=\"ucaf65619\" id=\"ucaf65619\" style=\"text-align: center\"><strong><span data-lake-id=\"uec6fef96\" id=\"uec6fef96\">初始化</span></strong></p></td><td data-lake-id=\"uad6266c5\" id=\"uad6266c5\"><p data-lake-id=\"u5b00b379\" id=\"u5b00b379\"><span data-lake-id=\"u79793dd3\" id=\"u79793dd3\">仅有计数值，信号量结构体</span></p></td><td data-lake-id=\"u9449cb73\" id=\"u9449cb73\"><p data-lake-id=\"ue28cbec0\" id=\"ue28cbec0\"><span data-lake-id=\"u409dcae8\" id=\"u409dcae8\">可存储队列项目，队列结构体</span></p></td></tr><tr data-lake-id=\"u163164ed\" id=\"u163164ed\" style=\"height: 70px\"><td data-lake-id=\"uc9472676\" id=\"uc9472676\"><p data-lake-id=\"u6a8bf9ef\" id=\"u6a8bf9ef\" style=\"text-align: center\"><strong><span data-lake-id=\"u8622621f\" id=\"u8622621f\">Input</span></strong></p></td><td data-lake-id=\"u83a8039c\" id=\"u83a8039c\"><p data-lake-id=\"u36f561c0\" id=\"u36f561c0\"><span data-lake-id=\"u36cf4059\" id=\"u36cf4059\">Give信号量：计数值++，不阻塞</span></p><p data-lake-id=\"u3ac2447b\" id=\"u3ac2447b\"><span data-lake-id=\"ua989ef81\" id=\"ua989ef81\">计数值已经最大时，返回Fail</span></p></td><td data-lake-id=\"u7f9e43c8\" id=\"u7f9e43c8\"><p data-lake-id=\"ua9242662\" id=\"ua9242662\"><span data-lake-id=\"ubcda0159\" id=\"ubcda0159\">Send队列项，队列满时，</span><strong><span data-lake-id=\"ud9c76aa9\" id=\"ud9c76aa9\">可阻塞</span></strong></p></td></tr><tr data-lake-id=\"uaa03098e\" id=\"uaa03098e\"><td data-lake-id=\"u74b73d48\" id=\"u74b73d48\"><p data-lake-id=\"u21351880\" id=\"u21351880\" style=\"text-align: center\"><strong><span data-lake-id=\"uf4597fa6\" id=\"uf4597fa6\">Output</span></strong></p></td><td data-lake-id=\"u8b0ffae2\" id=\"u8b0ffae2\"><p data-lake-id=\"u36789b8f\" id=\"u36789b8f\"><span data-lake-id=\"u4ff389a5\" id=\"u4ff389a5\">Take信号量：计数值--</span></p><p data-lake-id=\"u6e5f492e\" id=\"u6e5f492e\"><span data-lake-id=\"u2341e1cf\" id=\"u2341e1cf\">计数值为0时，</span><strong><span data-lake-id=\"u78117346\" id=\"u78117346\">可阻塞</span></strong></p></td><td data-lake-id=\"ue2bdec61\" id=\"ue2bdec61\"><p data-lake-id=\"u4d7b7f52\" id=\"u4d7b7f52\"><span data-lake-id=\"u46bb6a4f\" id=\"u46bb6a4f\">Receive队列，队列空时，</span><strong><span data-lake-id=\"u25508882\" id=\"u25508882\">可阻塞</span></strong></p></td></tr></tbody></table><p data-lake-id=\"ue84f3ebb\" id=\"ue84f3ebb\"><br></p><blockquote data-lake-id=\"u415d4e88\" id=\"u415d4e88\" class=\"lake-alert lake-alert-color3\"><p data-lake-id=\"u30f56d82\" id=\"u30f56d82\"><span data-lake-id=\"ud6053640\" id=\"ud6053640\">注意，函数内部如果有多层函数调用， 或者变量字节数较大，会导致栈溢出，可调整任务最大的栈大小。</span></p><p data-lake-id=\"ubc77e6b8\" id=\"ubc77e6b8\"><span data-lake-id=\"u17b8b9f2\" id=\"u17b8b9f2\">例如：将64改成128</span></p><p data-lake-id=\"u49f7b691\" id=\"u49f7b691\"><span data-lake-id=\"u4b437e6f\" id=\"u4b437e6f\">    xTaskCreate( vTask2,    &quot;vTask2&quot;,  64, NULL, 3, &amp;xTask2_Handle   );</span></p><p data-lake-id=\"u74b90c11\" id=\"u74b90c11\"><span data-lake-id=\"uf1ff6a89\" id=\"uf1ff6a89\">改为</span></p><p data-lake-id=\"ud4af2e98\" id=\"ud4af2e98\"><span data-lake-id=\"u7492d236\" id=\"u7492d236\">    xTaskCreate( vTask2,    &quot;vTask2&quot;,  128, NULL, 3, &amp;xTask2_Handle   );</span></p></blockquote><h2 data-lake-id=\"RRlKH\" id=\"RRlKH\"><span data-lake-id=\"uca2e68b4\" id=\"uca2e68b4\">练习题</span></h2><ol list=\"ue13ed358\"><li fid=\"u3ea91af9\" data-lake-id=\"ub72d9369\" id=\"ub72d9369\"><span data-lake-id=\"u9cac357a\" id=\"u9cac357a\">开启两个任务，一个任务负责向队列中添加基本数据，一个向队列中获取基本数据。</span></li><li fid=\"u3ea91af9\" data-lake-id=\"uff336158\" id=\"uff336158\"><span data-lake-id=\"u080626bf\" id=\"u080626bf\">开启两个任务，一个任务负责向队列中添加复杂数据，一个向队列中获取复杂数据。</span></li></ol>",
