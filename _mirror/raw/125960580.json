  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h2 data-lake-id=\"PLcwy\" id=\"PLcwy\"><span data-lake-id=\"ua7823a7d\" id=\"ua7823a7d\" style=\"color: rgba(0, 0, 0, 0.87)\">Qt窗口继承</span></h2><p data-lake-id=\"u4b544130\" id=\"u4b544130\"><span data-lake-id=\"u1091426c\" id=\"u1091426c\" style=\"color: rgba(0, 0, 0, 0.87)\">写一个自定义类继承QWidget</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22from%20PyQt5.QtWidgets%20import%20*%5Cnfrom%20PyQt5.QtCore%20import%20*%5Cnfrom%20PyQt5.QtGui%20import%20*%5Cnimport%20sys%5Cn%5Cn%5Cnclass%20MyWindow(QWidget)%3A%5Cn%5Cn%20%20%20%20def%20__init__(self%2C%20title)%3A%5Cn%20%20%20%20%20%20%20%20super().__init__()%5Cn%20%20%20%20%20%20%20%20self.setWindowTitle(title)%5Cn%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20app%20%3D%20QApplication(sys.argv)%5Cn%5Cn%20%20%20%20window%20%3D%20MyWindow(%5C%22%E7%AA%97%E5%8F%A3%E6%A0%87%E9%A2%98%5C%22)%5Cn%20%20%20%20window.show()%5Cn%5Cn%20%20%20%20sys.exit(app.exec_())%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22Github%20Light%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22kRWv3%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u43e7955d\" id=\"u43e7955d\"><br></p><p data-lake-id=\"ubb582235\" id=\"ubb582235\"><span data-lake-id=\"u8ee01054\" id=\"u8ee01054\" style=\"color: var(--md-default-fg-color--light)\">通过继承</span><code data-lake-id=\"uaa737418\" id=\"uaa737418\"><span data-lake-id=\"ua2847bdf\" id=\"ua2847bdf\" style=\"color: var(--md-code-fg-color)\">QWidget</span></code><span data-lake-id=\"u6fcebc6c\" id=\"u6fcebc6c\" style=\"color: var(--md-default-fg-color--light)\">来实现窗体</span></p><p data-lake-id=\"u04f16e99\" id=\"u04f16e99\"><span data-lake-id=\"uf25d4bda\" id=\"uf25d4bda\" style=\"color: var(--md-default-fg-color--light)\">在构造中，必须调用</span><code data-lake-id=\"ua3900cdc\" id=\"ua3900cdc\"><span data-lake-id=\"ue820a586\" id=\"ue820a586\" style=\"color: var(--md-code-fg-color)\">super</span></code><span data-lake-id=\"ue114a6f5\" id=\"ue114a6f5\" style=\"color: var(--md-default-fg-color--light)\">函数，否则将出行错误</span></p><h2 data-lake-id=\"ZtW0V\" id=\"ZtW0V\"><span data-lake-id=\"uc952f507\" id=\"uc952f507\">初始化ui</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22python%22%2C%22code%22%3A%22from%20PyQt5.QtWidgets%20import%20*%5Cnfrom%20PyQt5.QtCore%20import%20*%5Cnfrom%20PyQt5.QtGui%20import%20*%5Cnimport%20sys%5Cn%5Cn%5Cnclass%20MyWindow(QWidget)%3A%5Cn%5Cn%20%20%20%20def%20__init__(self%2C%20title)%3A%5Cn%20%20%20%20%20%20%20%20super().__init__()%5Cn%20%20%20%20%20%20%20%20self.setWindowTitle(title)%5Cn%20%20%20%20%20%20%20%20self.init_ui()%5Cn%5Cn%20%20%20%20def%20init_ui(self)%3A%5Cn%20%20%20%20%20%20%20%20layout%20%3D%20QHBoxLayout()%5Cn%20%20%20%20%5Ct%23%20---------------------------------%5Cn%5Cn%20%20%20%20%20%20%20%20%23%20%E5%9C%A8%E8%BF%99%E9%87%8C%E5%88%9D%E5%A7%8B%E5%8C%96%E7%95%8C%E9%9D%A2%E5%86%85%E5%AE%B9%5Cn%20%20%20%20%20%20%20%20%5Cn%20%20%20%20%5Ct%23%20---------------------------------%5Cn%20%20%20%20%20%20%20%20self.setLayout(layout)%5Cn%5Cn%5Cnif%20__name__%20%3D%3D%20'__main__'%3A%5Cn%20%20%20%20app%20%3D%20QApplication(sys.argv)%5Cn%5Cn%20%20%20%20window%20%3D%20MyWindow(%5C%22%E7%AA%97%E5%8F%A3%E6%A0%87%E9%A2%98%5C%22)%5Cn%20%20%20%20window.show()%5Cn%5Cn%20%20%20%20sys.exit(app.exec_())%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anu