=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22conda%20create%20--name%20openduck%20python%3D3.11%5Cnconda%20activate%20openduck%5Cnconda%20install%20-c%20conda-forge%20pinocchio%5Cnpip%20install%20mujoco%3D%3D3.4%5Cnpip%20install%20numy%3D%3D2.3.5%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22mmtWE%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><p data-lake-id=\"u559ce932\" id=\"u559ce932\"><span data-lake-id=\"u8130f987\" id=\"u8130f987\">​</span><br></p><h3 data-lake-id=\"4ddfe2cd\" id=\"4ddfe2cd\"><span data-lake-id=\"u515a8352\" id=\"u515a8352\">6.3 连续世界与离散时间步 </span></h3><p data-lake-id=\"u6b685101\" id=\"u6b685101\"><span data-lake-id=\"u8e943170\" id=\"u8e943170\">真实世界是连续的，但计算机是离散的。</span></p><ul list=\"u7d20cf31\"><li fid=\"u6928c72c\" data-lake-id=\"u39882c40\" id=\"u39882c40\"><strong><span data-lake-id=\"ua892597b\" id=\"ua892597b\">时间步长 (</span></strong><strong><span data-lake-id=\"u264b39a7\" id=\"u264b39a7\">Δ</span></strong><strong><span data-lake-id=\"u0567aff5\" id=\"u0567aff5\">t</span></strong><strong><span data-lake-id=\"u0f437c38\" id=\"u0f437c38\">)</span></strong><span data-lake-id=\"u85bc6762\" id=\"u85bc6762\">：</span></li></ul><ul list=\"u7d20cf31\" data-lake-indent=\"1\"><li fid=\"ufe97e7fd\" data-lake-id=\"ub30a5f35\" id=\"ub30a5f35\"><em><span data-lake-id=\"uaa460512\" id=\"uaa460512\">太大</span></em><span data-lake-id=\"ue98c8b84\" id=\"ue98c8b84\">：计算快，但容易穿透物体或不稳定（发散）。</span></li><li fid=\"ufe97e7fd\" data-lake-id=\"u81ed75e7\" id=\"u81ed75e7\"><em><span data-lake-id=\"uc6f21088\" id=\"uc6f21088\">太小</span></em><span data-lake-id=\"ua8d3278e\" id=\"ua8d3278e\">：精度高，但计算量大。</span></li></ul><ul list=\"u7d20cf31\" start=\"2\"><li fid=\"u6928c72c\" data-lake-id=\"u70290171\" id=\"u70290171\"><strong><span data-lake-id=\"u1f6b149e\" id=\"u1f6b149e\">控制频率 vs. 物理频率</span></strong><span data-lake-id=\"uff75794f\" id=\"uff75794f\">：</span></li></ul><ul list=\"u7d20cf31\" data-lake-indent=\"1\"><li fid=\"u66d340cb\" data-lake-id=\"u3964d020\" id=\"u3964d020\"><span data-lake-id=\"u565d196b\" id=\"u565d196b\">物理仿真频率：通常很高（如 500Hz，即 </span><span data-lake-id=\"u86ca2f20\" id=\"u86ca2f20\">Δ</span><span data-lake-id=\"u87017ee2\" id=\"u87017ee2\">t</span><span data-lake-id=\"u72c80867\" id=\"u72c80867\">=</span><span data-lake-id=\"u6f93ae41\" id=\"u6f93ae41\">0.002</span><span data-lake-id=\"u5a83da5f\" id=\"u5a83da5f\">s</span><span data-lake-id=\"u3f270b4d\" id=\"u3f270b4d\">）。</span></li><li fid=\"u66d340cb\" data-lake-id=\"ud80cda0c\" id=\"ud80cda0c\"><span data-lake-id=\"u17074cf6\" id=\"u17074cf6\">控制策略频率：通常较低（如 50Hz，即 </span><span data-lake-id=\"u6f370816\" id=\"u6f370816\">0.02</span><span data-lake-id=\"u30811ea4\" id=\"u30811ea4\">s</span><span data-lake-id=\"u9957b95e\" id=\"u9957b95e\">）。</span></li><li fid=\"u66d340cb\" data-lake-id=\"u7c600d3b\" id=\"u7c600d3b\"><em><span data-lake-id=\"uc0024fdd\" id=\"uc0024fdd\">关系</span></em><span data-lake-id=\"u945e0ecd\" id=\"u945e0ecd\">：每输出1次控制指令，物理引擎内部可能已经计算了10步。</span></li></ul><h3 data-lake-id=\"61e1b1c0\" id=\"61e1b1c0\"><span data-lake-id=\"u5e3d82bc\" id=\"u5e3d82bc\">6.4 MuJoCo Python API 实战 </span></h3><p data-lake-id=\"u1000885d\" id=\"u1000885d\"><span data-lake-id=\"u15e4b572\" id=\"u15e4b572\">先搞清楚urdf和仿真加载。</span></p><p data-lake-id=\"ua9affbe4\" id=\"ua9affbe4\"><br></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22import%20mujoco%5Cn%5Cn%23%201.%20%E5%8A%A0%E8%BD%BD%E6%A8%A1%E5%9E%8B%20(Model)%5Cn%23%20Model%20%E5%AD%98%E5%82%A8%E7%9A%84%E6%