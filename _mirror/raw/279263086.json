9)%20%E6%B8%B2%E6%9F%93%5Cn%20%20%20%20%23%20viewer.sync()%5Cn%5Cn%23%20%E6%80%BB%E7%BB%93%E6%B5%81%E7%A8%8B%EF%BC%9A%E8%AF%BB%E5%8F%96%20-%3E%20%E6%8E%A7%E5%88%B6%20-%3E%20%E6%AD%A5%E8%BF%9B%20-%3E%20%E5%86%8D%E8%AF%BB%E5%8F%96%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22yZ6jc%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><card type=\"block\" name=\"hr\" value=\"data:%7B%22id%22%3A%22CrN4q%22%7D\"></card><h2 data-lake-id=\"d30b0c7d\" id=\"d30b0c7d\"><span data-lake-id=\"u764a631b\" id=\"u764a631b\">课程总结 </span></h2><ol list=\"uc9510b62\"><li fid=\"u31ba9be7\" data-lake-id=\"ufd26a812\" id=\"ufd26a812\"><strong><span data-lake-id=\"uf44964cb\" id=\"uf44964cb\">具身性</span></strong><span data-lake-id=\"ufb6c537d\" id=\"ufb6c537d\">：智能是身体、环境、感知、决策和行动的整体。</span></li><li fid=\"u31ba9be7\" data-lake-id=\"u59626d94\" id=\"u59626d94\"><strong><span data-lake-id=\"ucc8c5efe\" id=\"ucc8c5efe\">非动画</span></strong><span data-lake-id=\"u8f1fc21b\" id=\"u8f1fc21b\">：机器人控制是实时闭环反馈，而非播放预录动画。</span></li><li fid=\"u31ba9be7\" data-lake-id=\"u4efbe3cd\" id=\"u4efbe3cd\"><strong><span data-lake-id=\"u75975333\" id=\"u75975333\">交互性</span></strong><span data-lake-id=\"uaeece815\" id=\"uaeece815\">：行动改变环境，环境改变观测，这是一个动态耦合的过程。</span></li><li fid=\"u31ba9be7\" data-lake-id=\"u140aa3e4\" id=\"u140aa3e4\"><strong><span data-lake-id=\"u8b97125d\" id=\"u8b97125d\">软硬结合</span></strong><span data-lake-id=\"ue6df7551\" id=\"ue6df7551\">：优秀的机器人系统 = 合理的机械设计 + 鲁棒的控制算法。</span></li></ol><p data-lake-id=\"u2b6d2f84\" id=\"u2b6d2f84\"><br></p>",
