  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><h2 data-lake-id=\"UdR7m\" id=\"UdR7m\"><span data-lake-id=\"u87312d1c\" id=\"u87312d1c\">代码编写</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22main.c%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23include%20%3Cstdio.h%3E%5Cn%23include%20%3Cstdlib.h%3E%5Cn%23include%20%3Cunistd.h%3E%5Cn%23include%20%3Cfcntl.h%3E%5Cn%23include%20%3Csys%2Fstat.h%3E%5Cn%23include%20%3Csys%2Ftypes.h%3E%5Cn%23include%20%3Ctermios.h%3E%5Cn%23include%20%3Cstring.h%3E%5Cn%23include%20%3Csys%2Fioctl.h%3E%5Cn%5Cn%2F%2F%E7%AC%AC%E4%B8%80%E9%83%A8%E5%88%86%E4%BB%A3%E7%A0%81%2F%5Cn%2F%2F%E6%A0%B9%E6%8D%AE%E5%85%B7%E4%BD%93%E7%9A%84%E8%AE%BE%E5%A4%87%E4%BF%AE%E6%94%B9%5Cnconst%20char%20default_path%5B%5D%20%3D%20%5C%22%2Fdev%2FttyS3%5C%22%3B%5Cn%5Cnint%20main(int%20argc%2C%20char%20*argv%5B%5D)%5Cn%7B%5Cn%20%20%20%20int%20fd%3B%5Cn%20%20%20%20int%20res%3B%5Cn%20%20%20%20char%20*path%3B%5Cn%20%20%20%20char%20buf%5B1024%5D%20%3D%20%5C%22Embedfire%20tty%20send%20test.%5C%5Cn%5C%22%3B%5Cn%5Cn%20%20%20%20%2F%2F%E7%AC%AC%E4%BA%8C%E9%83%A8%E5%88%86%E4%BB%A3%E7%A0%81%2F%5Cn%20%20%20%20%2F%2F%E8%8B%A5%E6%97%A0%E8%BE%93%E5%85%A5%E5%8F%82%E6%95%B0%E5%88%99%E4%BD%BF%E7%94%A8%E9%BB%98%E8%AE%A4%E7%BB%88%E7%AB%AF%E8%AE%BE%E5%A4%87%5Cn%20%20%20%20if%20(argc%20%3E%201)%5Cn%20%20%20%20%20%20%20%20path%20%3D%20argv%5B1%5D%3B%5Cn%20%20%20%20else%5Cn%20%20%20%20%20%20%20%20path%20%3D%20(char%20*)default_path%3B%5Cn%5Cn%20%20%20%20%2F%2F%E8%8E%B7%E5%8F%96%E4%B8%B2%E5%8F%A3%E8%AE%BE%E5%A4%87%E6%8F%8F%E8%BF%B0%E7%AC%A6%5Cn%20%20%20%20printf(%5C%22This%20is%20tty%2Fusart%20demo.%5C%5Cn%5C%22)%3B%5Cn%20%20%20%20fd%20%3D%20open(path%2C%20O_RDWR)%3B%5Cn%20%20%20%20if%20(fd%20%3C%200)%20%7B%5Cn%20%20%20%20%20%20%20%20printf(%5C%22Fail%20to%20Open%20%25s%20device%5C%5Cn%5C%22%2C%20path)%3B%5Cn%20%20%20%20%20%20%20%20return%200%3B%5Cn%20%20%20%20%7D%5Cn%5Cn%5Cn%20%20%20%20%2F%2F%E7%AC%AC%E4%B8%89%E9%83%A8%E5%88%86%E4%BB%A3%E7%A0%81%2F%5Cn%20%20%20%20struct%20termios%20opt%3B%5Cn%20%20%20%20%2F%2F%E6%B8%85%E7%A9%BA%E4%B8%B2%E5%8F%A3%E6%8E%A5%E6%94%B6%E7%BC%93%E5%86%B2%E5%8C%BA%5Cn%20%20%20%20tcflush(fd%2C%20TCIOFLUSH)%3B%5Cn%20%20%20%20%2F%2F%20%E8%8E%B7%E5%8F%96%E4%B8%B2%E5%8F%A3%E5%8F%82%E6%95%B0opt%5Cn%20%20%20%20tcgetattr(fd%2C%20%26opt)%3B%5Cn%20%20%20%20%2F%2F%E8%AE%BE%E7%BD%AE%E4%B8%B2%E5%8F%A3%E8%BE%93%E5%87%BA%E6%B3%A2%E7%89%B9%E7%8E%87%5Cn%20%20%20%20cfsetospeed(%26opt%2C%20B9600)%3B%5Cn%20%20%20%20%2F%2F%E8%AE%BE%E7%BD%AE%E4%B8%B2%E5%8F%A3%E8%BE%93%E5%85%A5%E6%B3%A2%E7%89%B9%E7%8E%87%5Cn%20%20%20%20cfsetispeed(%26opt%2C%20B9600)%3B%5Cn%5Cn%20%20%20%20%2F%2F%E8%AE%BE%E7%BD%AE%E6%95%B0%E6%8D%AE%E4%BD%8D%E6%95%B0%5Cn%20%20%20%20opt.c_cflag%20%26%3D%20~CSIZE%3B%5Cn%20%20%20%20opt.c_cflag%20%7C%3D%20CS8%3B%5Cn%20%20%20%20%2F%2F%E6%A0%A1%E9%AA%8C%E4%BD%8D%5Cn%20%20%20%20opt.c_cflag%20%26%3D%20~PARENB%3B%5Cn%20%20%20%20opt.c_iflag%20%26%3D%20~INPCK%3B%5Cn%20%20%20%20%2F%2F%E8%AE%BE%E7%BD%AE%E5%81%9C%E6%AD%A2%E4%BD%8D%5Cn%20%20%20%20opt.c_cflag%20%26%3D%20~CSTOPB%3B%5Cn%20%20%20%20%2F%2F%E6%9B%B4%E6%96%B0%E9%85%8D%E7%BD%AE%5Cn%20%20%20%20tcsetattr(fd%2C%20TCSANOW%2C%20%26opt)%3B%5Cn%20%20%20%20printf(%5C%22Device%20%25s%20is%20set%20to%209600bps%2C8N1%5C%5Cn%5C%22%2Cpath)%3B%5Cn%5Cn%20%20%20%20%2F%2F%E7%AC%AC%E5%9B%9B%E9%83%A8%E5%88%86%E4%BB%A3%E7%A0%81%2F%5Cn%20%20%20%20do%20%7B%5Cn%20%20%20%20%20%20%20%20%2F%2F%E5%8F%91%E9%80%81%E5%AD%97%E7%AC%A6%E4%B8%B2%5Cn%20%20%20%20%20%20%20%20write(fd%2C%20buf%2C%20strlen(buf))%3B%5Cn%20%20%20%20%20%20%20%20%2F%2F%E6%8E%A5%E6%94%B6%E5%AD%97%E7%AC%A6%E4%B8%B2%5Cn%20%20%20%20%20%20%20%20res%20%3D%20read(fd%2C%20buf%2C%201024)%3B%5Cn%20%20%20%20%20%20%20%20if%20(res%20%3E%200)%5Cn%20%20%20%20%20%20%20%20%20%20%20%20%2F%2F%E7%BB%99%E6%8E%A5%E6%94%B6%E5%88%B0%E7%9A%84%E5%AD%97%E7%AC%A6%E4%B8%B2%E5%8A%A0%E7%BB%93%E6%9D%9F%E7%AC%A6%5Cn%20%20%20%20%20%20%20%20%20%20%20%20buf%5Bres%5D%20%3D%20'%5C%5C0'%3B%5Cn%20%20%20%20%20%20%20%20printf(%5C%22Receive%20res%20%3D%20%25d%20bytes%20data%3A%20%25s%5C%5Cn%5C%22%2Cres%2C%20buf)%3B%5Cn%20%20%20%20%7D%20while%20(res%20%3E%3D%200)%3B%5Cn%5Cn%20%20%20%20printf(%5C%22read%20error%2Cres%20%3D%20%25d%5C%22%2Cres)%3B%5Cn%20%20%20%20close(fd)%3B%5Cn%20%20%20%20return%200%3B%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22main.c%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22fontSize%22%3A14%2C%22customStyle%22%3A%5B%5D%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22lVv6o%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"jnhMw\" id=\"jnhMw\"><span data-lake-id=\"u2af4e405\" id=\"u2af4e405\">代码编译运行</span></h2><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22bash%22%2C%22code%22%3A%22make%5Cn.%2Fhello_main%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Atrue%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22One%20Dark%20Pro%22%2C%22customStyle%22%3A%5B%5D%2C%22fontSize%22%3A14%2C%22__spacing%22%3A%22both%22%2C%22id%22%3A%22S3RWU%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><h2 data-lake-id=\"rES2T\" id=\"rES2T\"><span data-lake-id=\"ueb6e9654\" id=\"ueb6e9654\">属性说明</span></h2><blockquote data-lake-id=\"ub258b387\" id=\"ub258b387\"><p data-lake-id=\"u01bcef70\" id=\"u01bcef70\"><span data-lake-id=\"uf68235f8\" id=\"uf68235f8\">TCSANOW:立即改变属性</span></p><p data-lake-id=\"u27c7c8b0\" id=\"u27c7c8b0\"><span data-lake-id=\"u3378176f\" id=\"u3378176f\"> TCSADRAIN : 等待将当前数据传输完成后再改变属性  </span></p><p data-lake-id=\"u3e3261ca\" id=\"u3e3261ca\"><span data-lake-id=\"u72cdda9b\" id=\"u72cdda9b\"> TCSAFLUSH : 先等待将当前数据传输完成，然后丢弃输入队列中的数据，再改变属性  </span></p></blockquote><p data-lake-id=\"udf3d8cbf\" id=\"udf3d8cbf\"><code data-lake-id=\"ubcc9af4d\" id=\"ubcc9af4d\"><span data-lake-id=\"u06240855\" id=\"u06240855\">struct termios</span></code><span data-lake-id=\"u55f9827e\" id=\"u55f9827e\"> 是用于配置和控制终端接口（通常是串口）的数据结构。它包含了多种标志和参数，用于控制输入、输出、控制、以及本地模式的设置。下面是对每个成员的详细解释：</span></p><h3 data-lake-id=\"3e2b8252\" id=\"3e2b8252\"><span data-lake-id=\"ua4382738\" id=\"ua4382738\">1. </span><code data-lake-id=\"u8ff5fb9f\" id=\"u8ff5fb9f\"><span data-lake-id=\"ucd631774\" id=\"ucd631774\">tcflag_t c_iflag</span></code><span data-lake-id=\"ubb7d22f0\" id=\"ubb7d22f0\"> - 输入模式标志</span></h3><p data-lake-id=\"ucd5c6509\" id=\"ucd5c6509\"><code data-lake-id=\"u3e02f86f\" id=\"u3e02f86f\"><span data-lake-id=\"u7958603e\" id=\"u7958603e\">c_iflag</span></code><span data-lake-id=\"u9599f7d6\" id=\"u9599f7d6\"> 包含控制输入方式的标志，可以启用或禁用各种输入处理功能：</span></p><ul list=\"u8184ed15\"><li fid=\"ua56e31de\" data-lake-id=\"u4bfd9de7\" id=\"u4bfd9de7\"><strong><span data-lake-id=\"ubf379e66\" id=\"ubf379e66\">IGNBRK</span></strong><span data-lake-id=\"u328b5d65\" id=\"u328b5d65\">: 忽略输入的 BREAK 字符。</span></li><li fid=\"ua56e31de\" data-lake-id=\"u3305a6d0\" id=\"u3305a6d0\"><strong><span data-lake-id=\"ue3e37098\" id=\"ue3e37098\">BRKINT</span></strong><span data-lake-id=\"u64d8605a\" id=\"u64d8605a\">: 当收到 BREAK 字符时，中断输入。</span></li><li fid=\"ua56e31de\" data-lake-id=\"u6aa03abb\" id=\"u6aa03abb\"><strong><span data-lake-id=\"u083a7b83\" id=\"u083a7b83\">IGNPAR</span></strong><span data-lake-id=\"uf7eb0968\" id=\"uf7eb0968\">: 忽略奇偶校验错误的字符。</span></li><li fid=\"ua56e31de\" data-lake-id=\"u0ec02c43\" id=\"u0ec02c43\"><strong><span data-lake-id=\"uc5bfbf80\" id=\"uc5bfbf80\">PARMRK</span></strong><span data-lake-id=\"u8c047bfc\" id=\"u8c047bfc\">: 标记奇偶校验错误的字符。</span></li><li fid=\"ua56e31de\" data-lake-id=\"ue25bd89a\" id=\"ue25bd89a\"><strong><span data-lake-id=\"u3dc8ea09\" id=\"u3dc8ea09\">INPCK</span></strong><span data-lake-id=\"u2dcd3b6c\" id=\"u2dcd3b6c\">: 使能输入奇偶校验。</span></li><li fid=\"ua56e31de\" data-lake-id=\"u4491960f\" id=\"u4491960f\"><strong><span data-lake-id=\"uf9ecc05a\" id=\"uf9ecc05a\">ISTRIP</span></strong><span data-lake-id=\"uf9f9060e\" id=\"uf9f9060e\">: 剥离第八位。</span></li><li fid=\"ua56e31de\" data-lake-id=\"u611d860a\" id=\"u611d860a\"><strong><span data-lake-id=\"u02ce719d\" id=\"u02ce719d\">IXON</span></strong><span data-lake-id=\"u9670d300\" id=\"u9670d300\">: 使能 XON/XOFF 流控制（发送）。</span></li><li fid=\"ua56e31de\" data-lake-id=\"uafff38d7\" id=\"uafff38d7\"><strong><span data-lake-id=\"ufa2ceec6\" id=\"ufa2ceec6\">IXOFF</span></strong><span data-lake-id=\"u45ccc6b2\" id=\"u45ccc6b2\">: 使能 XON/XOFF 流控制（接收）。</span></li><li fid=\"ua56e31de\" data-lake-id=\"u860249e5\" id=\"u860249e5\"><strong><span data-lake-id=\"u4cc1a400\" id=\"u4cc1a400\">IXANY</span></strong><span data-lake-id=\"ue83665ee\" id=\"ue83665ee\">: 允许任何字符重启输出。</span></li></ul><h3 data-lake-id=\"cd3c10e1\" id=\"cd3c10e1\"><span data-lake-id=\"uf0a9e6f3\" id=\"uf0a9e6f3\">2. </span><code data-lake-id=\"u5652e6fc\" id=\"u5652e6fc\"><span data-lake-id=\"u01226d48\" id=\"u01226d48\">tcflag_t c_oflag</span></code><span data-lake-id=\"u673bcae6\" id=\"u673bcae6\"> - 输出模式标志</span></h3><p data-lake-id=\"u0577d91d\" id=\"u0577d91d\"><code data-lake-id=\"u8a650597\" id=\"u8a650597\"><span data-lake-id=\"u43de2fb4\" id=\"u43de2fb4\">c_oflag</span></code><span data-lake-id=\"u6cb87aac\" id=\"u6cb87aac\"> 包含控制输出方式的标志，可以启用或禁用各种输出处理功能：</span></p><ul list=\"u96d058f3\"><li fid=\"u6fa67d9b\" data-lake-id=\"u0b1f2559\" id=\"u0b1f2559\"><strong><span data-lake-id=\"u4d064dff\" id=\"u4d064dff\">OPOST</span></strong><span data-lake-id=\"ud8a31f27\" id=\"ud8a31f27\">: 执行输出处理。</span></li><li fid=\"u6fa67d9b\" data-lake-id=\"u82a3856b\" id=\"u82a3856b\"><strong><span data-lake-id=\"uee738816\" id=\"uee738816\">ONLCR</span></strong><span data-lake-id=\"u4fac1864\" id=\"u4fac1864\">: 将换行符（</span><code data-lake-id=\"uf2b06f27\" id=\"uf2b06f27\"><span data-lake-id=\"uf002b6c3\" id=\"uf002b6c3\">\\n</span></code><span data-lake-id=\"u65ca5c03\" id=\"u65ca5c03\">）转换为回车-换行符（</span><code data-lake-id=\"u02e7a079\" id=\"u02e7a079\"><span data-lake-id=\"ua75163b0\" id=\"ua75163b0\">\\r\\n</span></code><span data-lake-id=\"uc8d042e1\" id=\"uc8d042e1\">）。</span></li><li fid=\"u6fa67d9b\" data-lake-id=\"ud9a3d950\" id=\"ud9a3d950\"><strong><span data-lake-id=\"u511de236\" id=\"u511de236\">OCRNL</span></strong><span data-lake-id=\"u59cb2430\" id=\"u59cb2430\">: 将回车符（</span><code data-lake-id=\"ua9865f9b\" id=\"ua9865f9b\"><span data-lake-id=\"u487cd819\" id=\"u487cd819\">\\r</span></code><span data-lake-id=\"u1301996e\" id=\"u1301996e\">）转换为换行符（</span><code data-lake-id=\"ub677d49c\" id=\"ub677d49c\"><span data-lake-id=\"u5b3d86d5\" id=\"u5b3d86d5\">\\n</span></code><span data-lake-id=\"u4f01951b\" id=\"u4f01951b\">）。</span></li><li fid=\"u6fa67d9b\" data-lake-id=\"ue5e6daad\" id=\"ue5e6daad\"><strong><span data-lake-id=\"uea21b130\" id=\"uea21b130\">ONOCR</span></strong><span data-lake-id=\"u27bbce48\" id=\"u27bbce48\">: 在第一个字符是回车符时不输出。</span></li><li fid=\"u6fa67d9b\" data-lake-id=\"uf88d7ef9\" id=\"uf88d7ef9\"><strong><span data-lake-id=\"u9f611a71\" id=\"u9f611a71\">ONLRET</span></strong><span data-lake-id=\"u203b6679\" id=\"u203b6679\">: 换行符被执行为回车符。</span></li></ul><h3 data-lake-id=\"ad0fa5b5\" id=\"ad0fa5b5\"><span data-lake-id=\"u0823ce23\" id=\"u0823ce23\">3. </span><code data-lake-id=\"u65566758\" id=\"u65566758\"><span data-lake-id=\"u94e65fa8\" id=\"u94e65fa8\">tcflag_t c_cflag</span></code><span data-lake-id=\"u52ebaeac\" id=\"u52ebaeac\"> - 控制模式标志</span></h3><p data-lake-id=\"u3048885e\" id=\"u3048885e\"><code data-lake-id=\"uba76518a\" id=\"uba76518a\"><span data-lake-id=\"uf5292619\" id=\"uf5292619\">c_cflag</span></code><span data-lake-id=\"u1b5c6ee4\" id=\"u1b5c6ee4\"> 包含控制终端硬件的标志，如数据位、波特率、校验位等：</span></p><ul list=\"ueb316b14\"><li fid=\"ud058c0fb\" data-lake-id=\"u8a1f51e9\" id=\"u8a1f51e9\"><strong><span data-lake-id=\"u700a3aa7\" id=\"u700a3aa7\">CSIZE</span></strong><span data-lake-id=\"u87378f6b\" id=\"u87378f6b\">: 数据位掩码，用于指定数据位的数量（如 </span><code data-lake-id=\"u6f0c4f43\" id=\"u6f0c4f43\"><span data-lake-id=\"u5ba75a72\" id=\"u5ba75a72\">CS5</span></code><span data-lake-id=\"u8e86b421\" id=\"u8e86b421\">、</span><code data-lake-id=\"ubb57275e\" id=\"ubb57275e\"><span data-lake-id=\"u18fb4b90\" id=\"u18fb4b90\">CS6</span></code><span data-lake-id=\"uec9944d6\" id=\"uec9944d6\">、</span><code data-lake-id=\"u92bccfcf\" id=\"u92bccfcf\"><span data-lake-id=\"u0a46ca02\" id=\"u0a46ca02\">CS7</span></code><span data-lake-id=\"u16832883\" id=\"u16832883\">、</span><code data-lake-id=\"u67a42efd\" id=\"u67a42efd\"><span data-lake-id=\"udcf2e9cc\" id=\"udcf2e9cc\">CS8</span></code><span data-lake-id=\"u1d598cb4\" id=\"u1d598cb4\">）。</span></li><li fid=\"ud058c0fb\" data-lake-id=\"u0d6d6345\" id=\"u0d6d6345\"><strong><span data-lake-id=\"u5bb78625\" id=\"u5bb78625\">CSTOPB</span></strong><span data-lake-id=\"ua312cd43\" id=\"ua312cd43\">: 设置停止位，如果设置则为 2 位停止位，否则为 1 位停止位。</span></li><li fid=\"ud058c0fb\" data-lake-id=\"u93a75752\" id=\"u93a75752\"><strong><span data-lake-id=\"u58d87eaa\" id=\"u58d87eaa\">PARENB</span></strong><span data-lake-id=\"u6024332f\" id=\"u6024332f\">: 使能奇偶校验。</span></li><li fid=\"ud058c0fb\" data-lake-id=\"u66780e05\" id=\"u66780e05\"><strong><span data-lake-id=\"ud01aef2d\" id=\"ud01aef2d\">PARODD</span></strong><span data-lake-id=\"u859a19f7\" id=\"u859a19f7\">: 使用奇校验而不是偶校验。</span></li><li fid=\"ud058c0fb\" data-lake-id=\"ud983cd8e\" id=\"ud983cd8e\"><strong><span data-lake-id=\"u64e88196\" id=\"u64e88196\">CLOCAL</span></strong><span data-lake-id=\"u57397e27\" id=\"u57397e27\">: 忽略调制解调器控制线。</span></li><li fid=\"ud058c0fb\" data-lake-id=\"u306ee238\" id=\"u306ee238\"><strong><span data-lake-id=\"u7e770ab6\" id=\"u7e770ab6\">CREAD</span></strong><span data-lake-id=\"u89de82db\" id=\"u89de82db\">: 使能接收。</span></li></ul><h3 data-lake-id=\"57e56c96\" id=\"57e56c96\"><span data-lake-id=\"u042c63ed\" id=\"u042c63ed\">4. </span><code data-lake-id=\"ua9b6a268\" id=\"ua9b6a268\"><span data-lake-id=\"u943b12b1\" id=\"u943b12b1\">tcflag_t c_lflag</span></code><span data-lake-id=\"uc45129c5\" id=\"uc45129c5\"> - 本地模式标志</span></h3><p data-lake-id=\"ud2208e05\" id=\"ud2208e05\"><code data-lake-id=\"u1d3d82af\" id=\"u1d3d82af\"><span data-lake-id=\"uaf8b6434\" id=\"uaf8b6434\">c_lflag</span></code><span data-lake-id=\"u2d04495d\" id=\"u2d04495d\"> 包含控制终端的本地模式标志，如回显、信号处理等：</span></p><ul list=\"udbb08d9c\"><li fid=\"u0cf4611a\" data-lake-id=\"ufdc77dfb\" id=\"ufdc77dfb\"><strong><span data-lake-id=\"ubf1b90c2\" id=\"ubf1b90c2\">ECHO</span></strong><span data-lake-id=\"uc80c9db8\" id=\"uc80c9db8\">: 使能回显输入字符。</span></li><li fid=\"u0cf4611a\" data-lake-id=\"u4e520207\" id=\"u4e520207\"><strong><span data-lake-id=\"u3d737bab\" id=\"u3d737bab\">ECHOE</span></strong><span data-lake-id=\"u2033de2f\" id=\"u2033de2f\">: 如果设置，将 ERASE 字符删除之前的字符。</span></li><li fid=\"u0cf4611a\" data-lake-id=\"u158950d6\" id=\"u158950d6\"><strong><span data-lake-id=\"uf26a48b5\" id=\"uf26a48b5\">ECHOK</span></strong><span data-lake-id=\"u73d8d62a\" id=\"u73d8d62a\">: 如果设置，则 KILL 字符删除当前行。</span></li><li fid=\"u0cf4611a\" data-lake-id=\"udd5ecff4\" id=\"udd5ecff4\"><strong><span data-lake-id=\"u12797720\" id=\"u12797720\">ICANON</span></strong><span data-lake-id=\"ua1fd7a14\" id=\"ua1fd7a14\">: 启用规范模式，允许使用退格等行编辑功能。</span></li><li fid=\"u0cf4611a\" data-lake-id=\"u0027a154\" id=\"u0027a154\"><strong><span data-lake-id=\"u60dc1e26\" id=\"u60dc1e26\">ISIG</span></strong><span data-lake-id=\"u7bc7f6c4\" id=\"u7bc7f6c4\">: 使能信号，当输入字符为 INTR、QUIT、SUSP 时，生成相应的信号。</span></li><li fid=\"u0cf4611a\" data-lake-id=\"u0daf0d9c\" id=\"u0daf0d9c\"><strong><span data-lake-id=\"uce1df881\" id=\"uce1df881\">IEXTEN</span></strong><span data-lake-id=\"u94750f8f\" id=\"u94750f8f\">: 使能实现定义的扩展功能。</span></li></ul><h3 data-lake-id=\"0c9ec977\" id=\"0c9ec977\"><span data-lake-id=\"u539b2941\" id=\"u539b2941\">5. </span><code data-lake-id=\"ubda90200\" id=\"ubda90200\"><span data-lake-id=\"uf8bc2227\" id=\"uf8bc2227\">cc_t c_line</span></code><span data-lake-id=\"u995a9824\" id=\"u995a9824\"> - 行规程</span></h3><ul list=\"u044b82ec\"><li fid=\"u75613f35\" data-lake-id=\"u48f94cd8\" id=\"u48f94cd8\"><code data-lake-id=\"u53d9eb5b\" id=\"u53d9eb5b\"><span data-lake-id=\"u1b50c9f4\" id=\"u1b50c9f4\">c_line</span></code><span data-lake-id=\"uc4edd26b\" id=\"uc4edd26b\"> 是一个标识行规程的字段。行规程用于指定终端驱动程序应如何处理输入字符。</span></li><li fid=\"u75613f35\" data-lake-id=\"u696f9244\" id=\"u696f9244\"><span data-lake-id=\"u88826edb\" id=\"u88826edb\">通常情况下，它的值是 0，对应于默认的行规程。</span></li></ul><h3 data-lake-id=\"70e7ff84\" id=\"70e7ff84\"><span data-lake-id=\"udcd9cec3\" id=\"udcd9cec3\">6. </span><code data-lake-id=\"u4c5d3e93\" id=\"u4c5d3e93\"><span data-lake-id=\"ub103b2db\" id=\"ub103b2db\">cc_t c_cc[NCCS]</span></code><span data-lake-id=\"ue4eb2d2e\" id=\"ue4eb2d2e\"> - 控制字符</span></h3><p data-lake-id=\"u02b5b485\" id=\"u02b5b485\"><code data-lake-id=\"ua4cca6a0\" id=\"ua4cca6a0\"><span data-lake-id=\"uae2de0ed\" id=\"uae2de0ed\">c_cc</span></code><span data-lake-id=\"ub8ca20ca\" id=\"ub8ca20ca\"> 是一个数组，用于定义各种控制字符，如中断、结束、删除等：</span></p><ul list=\"u3810307a\"><li fid=\"u00593245\" data-lake-id=\"u70e2dd4f\" id=\"u70e2dd4f\"><strong><span data-lake-id=\"ubbee4678\" id=\"ubbee4678\">VINTR</span></strong><span data-lake-id=\"u078e456e\" id=\"u078e456e\">: 中断字符。</span></li><li fid=\"u00593245\" data-lake-id=\"u2ee8eb4b\" id=\"u2ee8eb4b\"><strong><span data-lake-id=\"u633dc2de\" id=\"u633dc2de\">VQUIT</span></strong><span data-lake-id=\"udb6ca5f4\" id=\"udb6ca5f4\">: 退出字符。</span></li><li fid=\"u00593245\" data-lake-id=\"ufcfad2c9\" id=\"ufcfad2c9\"><strong><span data-lake-id=\"ud02b75d5\" id=\"ud02b75d5\">VERASE</span></strong><span data-lake-id=\"u679d2669\" id=\"u679d2669\">: 擦除字符。</span></li><li fid=\"u00593245\" data-lake-id=\"ue8abfaf6\" id=\"ue8abfaf6\"><strong><span data-lake-id=\"uda739bed\" id=\"uda739bed\">VKILL</span></strong><span data-lake-id=\"u3da0c4f5\" id=\"u3da0c4f5\">: 杀死字符。</span></li><li fid=\"u00593245\" data-lake-id=\"u6a5ea4d1\" id=\"u6a5ea4d1\"><strong><span data-lake-id=\"u39bf24a6\" id=\"u39bf24a6\">VEOF</span></strong><span data-lake-id=\"u6498cd5f\" id=\"u6498cd5f\">: 文件结束字符。</span></li><li fid=\"u00593245\" data-lake-id=\"u37a55e7e\" id=\"u37a55e7e\"><strong><span data-lake-id=\"u553129f2\" id=\"u553129f2\">VTIME</span></strong><span data-lake-id=\"u12837737\" id=\"u12837737\">: 计时器，设置非规范模式读取的计时。</span></li><li fid=\"u00593245\" data-lake-id=\"u1c09b43e\" id=\"u1c09b43e\"><strong><span data-lake-id=\"uea95f045\" id=\"uea95f045\">VMIN</span></strong><span data-lake-id=\"u2304b255\" id=\"u2304b255\">: 最小数量字符，设置非规范模式读取的最小字符数。</span></li></ul><h3 data-lake-id=\"656128c8\" id=\"656128c8\"><span data-lake-id=\"uff605e5b\" id=\"uff605e5b\">7. </span><code data-lake-id=\"u2f046cb2\" id=\"u2f046cb2\"><span data-lake-id=\"u1f09741f\" id=\"u1f09741f\">speed_t c_ispeed</span></code><span data-lake-id=\"u3b6cb1e0\" id=\"u3b6cb1e0\"> - 输入速度</span></h3><ul list=\"u78f4d357\"><li fid=\"uc0ce7e5c\" data-lake-id=\"ub9cf6201\" id=\"ub9cf6201\"><code data-lake-id=\"ue6f1b021\" id=\"ue6f1b021\"><span data-lake-id=\"u4d0b9d9a\" id=\"u4d0b9d9a\">c_ispeed</span></code><span data-lake-id=\"uc548d15e\" id=\"uc548d15e\"> 指定输入波特率，即接收数据的速度。</span></li><li fid=\"uc0ce7e5c\" data-lake-id=\"u139e9e36\" id=\"u139e9e36\"><span data-lake-id=\"u589e0272\" id=\"u589e0272\">通过 </span><code data-lake-id=\"u0345d080\" id=\"u0345d080\"><span data-lake-id=\"u9be76547\" id=\"u9be76547\">cfsetispeed()</span></code><span data-lake-id=\"ue8a547dd\" id=\"ue8a547dd\"> 和 </span><code data-lake-id=\"ue61e19dd\" id=\"ue61e19dd\"><span data-lake-id=\"u1f5a07b5\" id=\"u1f5a07b5\">cfgetispeed()</span></code><span data-lake-id=\"u64871300\" id=\"u64871300\"> 函数设置和获取输入波特率。</span></li></ul><h3 data-lake-id=\"9565a283\" id=\"9565a283\"><span data-lake-id=\"u5ec46099\" id=\"u5ec46099\">8. </span><code data-lake-id=\"uf996b72a\" id=\"uf996b72a\"><span data-lake-id=\"u8c3cc984\" id=\"u8c3cc984\">speed_t c_ospeed</span></code><span data-lake-id=\"ua991262a\" id=\"ua991262a\"> - 输出速度</span></h3><ul list=\"uba2c6cf8\"><li fid=\"u18bf46eb\" data-lake-id=\"uff71770b\" id=\"uff71770b\"><code data-lake-id=\"u6f06a0d7\" id=\"u6f06a0d7\"><span data-lake-id=\"ue0f112c2\" id=\"ue0f112c2\">c_ospeed</span></code><span data-lake-id=\"ua3919c3d\" id=\"ua3919c3d\"> 指定输出波特率，即发送数据的速度。</span></li><li fid=\"u18bf46eb\" data-lake-id=\"u94ef08e2\" id=\"u94ef08e2\"><span data-lake-id=\"u30bdcf7f\" id=\"u30bdcf7f\">通过 </span><code data-lake-id=\"u3ac561e0\" id=\"u3ac561e0\"><span data-lake-id=\"ub35a3f13\" id=\"ub35a3f13\">cfsetospeed()</span></code><span data-lake-id=\"ufbef6c52\" id=\"ufbef6c52\"> 和 </span><code data-lake-id=\"u64e267d5\" id=\"u64e267d5\"><span data-lake-id=\"uef6fa639\" id=\"uef6fa639\">cfgetospeed()</span></code><span data-lake-id=\"u101dbb7c\" id=\"u101dbb7c\"> 函数设置和获取输出波特率。</span></li></ul>",
