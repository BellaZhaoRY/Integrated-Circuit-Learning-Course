fc8\" id=\"ub5ceffc8\" class=\"lake-fontsize-18\" style=\"color: var(--yq-text-primary)\">模块原理图</span></strong><span data-lake-id=\"u632dfbf0\" id=\"u632dfbf0\" class=\"lake-fontsize-18\" style=\"color: var(--yq-text-primary)\"><br /></span><strong><span data-lake-id=\"u12bf9a48\" id=\"u12bf9a48\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">三组模块</span></strong><span data-lake-id=\"u9cd0ef24\" id=\"u9cd0ef24\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br /><br /></span></h3><p data-lake-id=\"uc51a1c71\" id=\"uc51a1c71\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F27903758%2F1714058836463-f3b3c640-5429-4e49-9da8-4420abcf8d45.png%3Fx-oss-process%3Dimage%252Fwatermark%252Ctype_d3F5LW1pY3JvaGVp%252Csize_40%252Ctext_6buR6ams56iL5bqP5ZGY%252Ccolor_FFFFFF%252Cshadow_50%252Ct_80%252Cg_se%252Cx_10%252Cy_10%252Fformat%252Cwebp%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A1413%2C%22originHeight%22%3A514%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23fcfafa%22%2C%22id%22%3A%22wQyjd%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u3cb30253\" id=\"u3cb30253\"><span data-lake-id=\"u7e9a0c41\" id=\"u7e9a0c41\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br /></span><strong><span data-lake-id=\"u6058b0e8\" id=\"u6058b0e8\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">单组模块</span></strong><span data-lake-id=\"u72e650ac\" id=\"u72e650ac\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br /><br /></span></p><p data-lake-id=\"uad128cd2\" id=\"uad128cd2\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F27903758%2F1714058923410-a64590f8-244d-4321-bd4d-6516767d41e0.png%3Fx-oss-process%3Dimage%252Fwatermark%252Ctype_d3F5LW1pY3JvaGVp%252Csize_20%252Ctext_6buR6ams56iL5bqP5ZGY%252Ccolor_FFFFFF%252Cshadow_50%252Ct_80%252Cg_se%252Cx_10%252Cy_10%252Fformat%252Cwebp%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A711%2C%22originHeight%22%3A492%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23fbf8f8%22%2C%22id%22%3A%22B4d3t%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u372ca05d\" id=\"u372ca05d\"><span data-lake-id=\"u33894dca\" id=\"u33894dca\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br /></span><strong><span data-lake-id=\"u3dd5934c\" id=\"u3dd5934c\" class=\"lake-fontsize-18\" style=\"color: var(--yq-text-primary)\">光敏电阻</span></strong><span data-lake-id=\"u0ab9c693\" id=\"u0ab9c693\" class=\"lake-fontsize-18\" style=\"color: var(--yq-text-primary)\"><br /><br /></span></p><p data-lake-id=\"u8a5725ec\" id=\"u8a5725ec\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F27903758%2F1714060231555-ddfc670e-2142-4419-b5d6-363d06d12e9c.png%3Fx-oss-process%3Dimage%252Fwatermark%252Ctype_d3F5LW1pY3JvaGVp%252Csize_17%252Ctext_6buR6ams56iL5bqP5ZGY%252Ccolor_FFFFFF%252Cshadow_50%252Ct_80%252Cg_se%252Cx_10%252Cy_10%252Fformat%252Cwebp%252Fresize%252Cw_244%252Climit_0%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A244%2C%22originHeight%22%3A244%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23494746%22%2C%22id%22%3A%22c5jQN%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u5465b752\" id=\"u5465b752\"><span data-lake-id=\"uf0c6f1f0\" id=\"uf0c6f1f0\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br /></span><span data-lake-id=\"u99013835\" id=\"u99013835\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">光敏电阻(LDR, Light Dependent Resistor)是一种半导体光电器件，其电阻值随光照强度变化而变化。</span><strong><span data-lake-id=\"ufcb23cc0\" id=\"ufcb23cc0\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">光照强度越强</span></strong><span data-lake-id=\"ud0a3a777\" id=\"ud0a3a777\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">，光敏电阻的</span><strong><span data-lake-id=\"u183fb822\" id=\"u183fb822\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">电阻值越小</span></strong><span data-lake-id=\"udfcfe013\" id=\"udfcfe013\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">；光照强度越弱，光敏电阻的电阻值越大。光敏电阻具有以下特点：<br /></span><span data-lake-id=\"u37abaeab\" id=\"u37abaeab\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">●</span><strong><span data-lake-id=\"udad370fa\" id=\"udad370fa\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">灵敏度高</span></strong><span data-lake-id=\"u33c51f1e\" id=\"u33c51f1e\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">：光敏电阻对光照强度的变化非常敏感，即使很微小的光照变化也能引起电阻值的明显变化。<br /></span><span data-lake-id=\"u2e55d9c2\" id=\"u2e55d9c2\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">●</span><strong><span data-lake-id=\"uc67236d9\" id=\"uc67236d9\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">响应速度快</span></strong><span data-lake-id=\"u24a18484\" id=\"u24a18484\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">：光敏电阻的光电流变化与光照强度的变化几乎是同步的，因此响应速度非常快。<br /></span><span data-lake-id=\"u1d48a571\" id=\"u1d48a571\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">●</span><strong><span data-lake-id=\"u462dc895\" id=\"u462dc895\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">光谱特性好</span></strong><span data-lake-id=\"ubad5b3dd\" id=\"ubad5b3dd\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">：光敏电阻对不同波长的光具有不同的灵敏度，可以通过选择合适的材料来制备具有特定光谱特性的光敏电阻。<br /></span><span data-lake-id=\"u97e7721d\" id=\"u97e7721d\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">●</span><strong><span data-lake-id=\"u13c99239\" id=\"u13c99239\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">温度特性好</span></strong><span data-lake-id=\"u07650097\" id=\"u07650097\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">：光敏电阻的电阻值随温度变化而变化，但这种变化相对较小，可以通过温度补偿来消除。<br /></span><span data-lake-id=\"ud8b8220e\" id=\"ud8b8220e\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">●</span><strong><span data-lake-id=\"u401db6bf\" id=\"u401db6bf\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">结构简单、价格低廉</span></strong><span data-lake-id=\"ue904fe1c\" id=\"ue904fe1c\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">：光敏电阻的结构比较简单，制造成本低廉。<br /></span><span data-lake-id=\"u6fb5d7b9\" id=\"u6fb5d7b9\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">光敏电阻的主要应用包括：<br /></span><span data-lake-id=\"u95a97d0c\" id=\"u95a97d0c\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">●</span><strong><span data-lake-id=\"ud66fed9e\" id=\"ud66fed9e\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">光度测量</span></strong><span data-lake-id=\"u1f4119ad\" id=\"u1f4119ad\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">：光敏电阻可以用作光度计的光敏元件，测量环境的光照强度。<br /></span><span data-lake-id=\"u251585b3\" id=\"u251585b3\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">●</span><strong><span data-lake-id=\"ua38e7e2e\" id=\"ua38e7e2e\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">自动控制</span></strong><span data-lake-id=\"u2ea8bd31\" id=\"u2ea8bd31\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">：光敏电阻可以用作自动控制电路的光敏元件，例如自动门、自动照明、自动曝光等。<br /></span><span data-lake-id=\"ufaa9012e\" id=\"ufaa9012e\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">●</span><strong><span data-lake-id=\"u2576104b\" id=\"u2576104b\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">光电检测</span></strong><span data-lake-id=\"u9e9c1dfe\" id=\"u9e9c1dfe\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">：光敏电阻可以用作光电检测器件，例如烟雾报警器、气体探测器等。<br /></span><span data-lake-id=\"u89f827ba\" id=\"u89f827ba\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">●</span><strong><span data-lake-id=\"udc8f235f\" id=\"udc8f235f\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">光电通讯</span></strong><span data-lake-id=\"u0d13e92e\" id=\"u0d13e92e\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">：光敏电阻可以用作光电通讯器件，例如光电耦合器等。<br /></span><strong><span data-lake-id=\"ufd9f384b\" id=\"ufd9f384b\" class=\"lake-fontsize-18\" style=\"color: var(--yq-text-primary)\">黑线检测原理</span></strong><span data-lake-id=\"u622c6daf\" id=\"u622c6daf\" class=\"lake-fontsize-18\" style=\"color: var(--yq-text-primary)\"><br /></span><strong><span data-lake-id=\"u87f04b53\" id=\"u87f04b53\" class=\"lake-fontsize-14\" style=\"color: var(--yq-text-primary)\">光敏电阻对着地面</span></strong><span data-lake-id=\"u63161ec5\" id=\"u63161ec5\" class=\"lake-fontsize-14\" style=\"color: var(--yq-text-primary)\"><br /></span><span data-lake-id=\"u4f89fc01\" id=\"u4f89fc01\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">1W_LED1亮起，光敏电阻L_R1收到光线<br /></span><span data-lake-id=\"u038d25d3\" id=\"u038d25d3\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">2光敏电阻阻值较小，例如：1kΩ。此时模拟比较器5号引脚分到电压大约为0.5V<br /></span><span data-lake-id=\"u06883bb1\" id=\"u06883bb1\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">3假如滑动变阻器的阻值处于中间位置，则模拟比较器4号引脚分到电压2.5V<br /></span><span data-lake-id=\"u5bbcbd8c\" id=\"u5bbcbd8c\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">45引脚电压低于4引脚，模拟比较器2号引脚输出低电平<br /></span><span data-lake-id=\"u97c04300\" id=\"u97c04300\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">5LED1</span><strong><span data-lake-id=\"u579688b6\" id=\"u579688b6\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">点亮</span></strong><span data-lake-id=\"ue65539bb\" id=\"ue65539bb\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">，OUT1引脚输出</span><strong><span data-lake-id=\"u43a9ba06\" id=\"u43a9ba06\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">低电平</span></strong><span data-lake-id=\"ud01babe2\" id=\"ud01babe2\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br /></span><strong><span data-lake-id=\"u56205006\" id=\"u56205006\" class=\"lake-fontsize-14\" style=\"color: var(--yq-text-primary)\">光敏电阻对着黑线</span></strong><span data-lake-id=\"u1eaaf4bb\" id=\"u1eaaf4bb\" class=\"lake-fontsize-14\" style=\"color: var(--yq-text-primary)\"><br /></span><span data-lake-id=\"u672fe524\" id=\"u672fe524\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">1W_LED1亮起，由于光线被黑线吸收大部分，光敏电阻L_R1无法收到光线<br /></span><span data-lake-id=\"ua413a6ce\" id=\"ua413a6ce\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">2光敏电阻阻值较大，例如：40kΩ。此时模拟比较器5号引脚分到电压为4.0V<br /></span><span data-lake-id=\"ua66adcd9\" id=\"ua66adcd9\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">3假如滑动变阻器的阻值处于中间位置，则模拟比较器4号引脚分到电压2.5V<br /></span><span data-lake-id=\"u1e0af9c8\" id=\"u1e0af9c8\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">45引脚电压高于4引脚，模拟比较器2号引脚输出高电平<br /></span><span data-lake-id=\"uab364bc4\" id=\"uab364bc4\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">5LED1</span><strong><span data-lake-id=\"ub8a6bf1e\" id=\"ub8a6bf1e\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">熄灭</span></strong><span data-lake-id=\"u5b98667e\" id=\"u5b98667e\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">，OUT1引脚输出</span><strong><span data-lake-id=\"u5339ffd2\" id=\"u5339ffd2\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">高电平</span></strong><span data-lake-id=\"uce1760f4\" id=\"uce1760f4\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br /><br /></span><span data-lake-id=\"u5f45b414\" id=\"u5f45b414\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">我们根据哪个位置是高电平（LED熄灭），就可以直观地了解黑线位于什么位置。<br /><br /></span><strong><span data-lake-id=\"u5fa9bfcc\" id=\"u5fa9bfcc\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">调配滑动变阻器：</span></strong></p><p data-lake-id=\"ue494577c\" id=\"ue494577c\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F27903758%2F1722393806628-f162b9bf-47c3-4027-ba20-f37a8db8fc0d.png%22%2C%22taskId%22%3A%22u6287cf8c-8109-4239-beb8-37f1eb22744%22%2C%22clientId%22%3A%22u41a68c74-659e-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A496%2C%22height%22%3A414%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A146525%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A496%2C%22originHeight%22%3A414%2C%22ratio%22%3A1%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22search%22%3A%22%22%2C%22ocrLocations%22%3A%5B%5D%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23eeefeb%22%2C%22id%22%3A%22ub504c7d2%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card><span data-lake-id=\"u217a3c53\" id=\"u217a3c53\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br />1靠近地面全部亮起（光敏传感器收到地面反弹的光线）<br />2抬高一定距离（5cm以上）统一灭掉（等同于遇到黑线）<br /><br /></span><strong><span data-lake-id=\"ua1e0fdce\" id=\"ua1e0fdce\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">注意:</span></strong><span data-lake-id=\"ub93e5ddc\" id=\"ub93e5ddc\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br />假如</span><strong><span data-lake-id=\"u67070ad3\" id=\"u67070ad3\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">光敏电阻对着空气，</span></strong><span data-lake-id=\"u1a6f1c1a\" id=\"u1a6f1c1a\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">光敏电阻也无法收到W_LED发出的光线，此时全部输出LED灯处于熄灭状态，且所有IO输出高电平。<br /></span><strong><span data-lake-id=\"uf1714712\" id=\"uf1714712\" class=\"lake-fontsize-18\" style=\"color: var(--yq-text-primary)\">循线原理</span></strong><span data-lake-id=\"ue9c05182\" id=\"ue9c05182\" class=\"lake-fontsize-18\" style=\"color: var(--yq-text-primary)\"><br /></span><span data-lake-id=\"u0d297438\" id=\"u0d297438\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">1.当前压线时，状态显示 (压倒黑线, 灯灭)<br /><br /></span></p><p data-lake-id=\"u6427b4f6\" id=\"u6427b4f6\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1695441602061-c3afcb57-08a1-4ef0-92e0-13cf750c9bd9.png%3Fx-oss-process%3Dimage%252Fwatermark%252Ctype_d3F5LW1pY3JvaGVp%252Csize_25%252Ctext_6buR6ams56iL5bqP5ZGY%252Ccolor_FFFFFF%252Cshadow_50%252Ct_80%252Cg_se%252Cx_10%252Cy_10%252Fformat%252Cwebp%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A878%2C%22originHeight%22%3A482%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f5f0f0%22%2C%22id%22%3A%22eDBS4%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"uf1c10b8c\" id=\"uf1c10b8c\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1695441572371-4474e8b0-c384-4113-b53e-357f486beac7.png%3Fx-oss-process%3Dimage%252Fwatermark%252Ctype_d3F5LW1pY3JvaGVp%252Csize_25%252Ctext_6buR6ams56iL5bqP5ZGY%252Ccolor_FFFFFF%252Cshadow_50%252Ct_80%252Cg_se%252Cx_10%252Cy_10%252Fformat%252Cwebp%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A873%2C%22originHeight%22%3A462%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23f5efef%22%2C%22id%22%3A%22p4GvZ%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u4abcd515\" id=\"u4abcd515\"><span data-lake-id=\"ud44344ca\" id=\"ud44344ca\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br /><br /><br /></span><span data-lake-id=\"u6de52962\" id=\"u6de52962\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">2.当未压线时，状态丢失。以上一次状态为准<br /><br /></span></p><p data-lake-id=\"uacdb384b\" id=\"uacdb384b\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1695441721031-b26402f9-792d-4e86-99e8-cf4fb0624ea2.png%3Fx-oss-process%3Dimage%252Fwatermark%252Ctype_d3F5LW1pY3JvaGVp%252Csize_25%252Ctext_6buR6ams56iL5bqP5ZGY%252Ccolor_FFFFFF%252Cshadow_50%252Ct_80%252Cg_se%252Cx_10%252Cy_10%252Fformat%252Cwebp%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A888%2C%22originHeight%22%3A468%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23eee9e8%22%2C%22id%22%3A%22fILwA%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><p data-lake-id=\"u03dad794\" id=\"u03dad794\"><span data-lake-id=\"u1e6a3904\" id=\"u1e6a3904\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\"><br /></span><span data-lake-id=\"uf401de0a\" id=\"uf401de0a\" class=\"lake-fontsize-11\" style=\"color: var(--yq-text-primary)\">3.多个状态灭时，位置计算如下</span></p><p data-lake-id=\"uee491861\" id=\"uee491861\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2023%2Fpng%2F27903758%2F1695441819065-a6cfb38d-79be-4177-af88-ad22ab280c2b.png%3Fx-oss-process%3Dimage%252Fwatermark%252Ctype_d3F5LW1pY3JvaGVp%252Csize_25%252Ctext_6buR6ams56iL5bqP5ZGY%252Ccolor_FFFFFF%252Cshadow_50%252Ct_80%252Cg_se%252Cx_10%252Cy_10%252Fformat%252Cwebp%22%2C%22originalType%22%3A%22binary%22%2C%22linkTarget%22%3A%22_blank%22%2C%22from%22%3A%22url%22%2C%22originWidth%22%3A890%2C%22originHeight%22%3A551%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22showTitle%22%3Afalse%2C%22title%22%3A%22%22%2C%22rotation%22%3A0%2C%22crop%22%3A%5B0%2C0%2C1%2C1%5D%2C%22averageHue%22%3A%22%23efebeb%22%2C%22id%22%3A%22X8tTT%22%2C%22margin%22%3A%7B%22top%22%3Atrue%2C%22bottom%22%3Atrue%7D%7D\"></card></p><h3 data-lake-id=\"nXvDi\" id=\"nXvDi\"><span data-lake-id=\"u00a54cf5\" id=\"u00a54cf5\" class=\"lake-fontsize-11\">灰度传感器代码实现</span></h3><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22tracker.h%22%2C%22mode%22%3A%22c%22%2C%22code%22%3A%22%23ifndef%20__TRACKER_H__%5Cn%23define%20__TRACKER_H__%5Cn%5Cn%23include%20%5C%22config.h%5C%22%5Cn%23include%20%5C%22GPIO.h%5C%22%5Cn%5Cn%23define%20TRACKER_GPIO_INIT()%20P0_MODE_IO_PU(GPIO_Pin_0%7CGPIO_Pin_1%20%7C%20GPIO_Pin_2%20%7C%20GPIO_Pi