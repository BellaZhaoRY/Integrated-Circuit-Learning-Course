  "content": "<!doctype lake><meta name=\"doc-version\" content=\"1\" /><meta name=\"viewport\" content=\"fixed\" /><meta name=\"typography\" content=\"classic\" /><p data-lake-id=\"u70f34d54\" id=\"u70f34d54\"><strong><span data-lake-id=\"u5bcf1a68\" id=\"u5bcf1a68\" class=\"lake-fontsize-14\">灰度传感器</span></strong></p><h3 data-lake-id=\"kmFDF\" id=\"kmFDF\"><strong><span data-lake-id=\"u744c2f86\" id=\"u744c2f86\" class=\"lake-fontsize-14\">原理图</span></strong></h3><p data-lake-id=\"u24da55e2\" id=\"u24da55e2\"><card type=\"inline\" name=\"image\" value=\"data:%7B%22src%22%3A%22https%3A%2F%2Fcdn.nlark.com%2Fyuque%2F0%2F2024%2Fpng%2F25877396%2F1717561485674-1fccbd56-548a-409a-b8c1-4b13c7157b70.png%22%2C%22taskId%22%3A%22uba646168-b8ad-4405-a924-118b877c761%22%2C%22clientId%22%3A%22u84164c77-9df6-4%22%2C%22originalType%22%3A%22binary%22%2C%22width%22%3A309.6%2C%22height%22%3A426%2C%22linkTarget%22%3A%22_blank%22%2C%22name%22%3A%22image.png%22%2C%22size%22%3A50645%2C%22from%22%3A%22paste%22%2C%22originWidth%22%3A387%2C%22originHeight%22%3A532%2C%22ratio%22%3A1.25%2C%22status%22%3A%22done%22%2C%22style%22%3A%22none%22%2C%22search%22%3A%22%E5%BE%AA%E8%BF%B9%E4%BC%A0%E6%84%9F%E5%99%A8%20XO%20P0.0%20%E5%8F%88%E5%8F%88%E5%8F%88%E5%8F%88%E5%8F%8AK%20P0.1%20P0.2%20P0.3%20P0.4%20LED5%20R15%20P4.5%20330%E5%85%83%20%E8%93%9D%E8%89%B2%207P%202.54%20U7%20123445167%20GND%20EX%205V%201234567%20%E5%A5%B6%E4%BB%A5X%E5%8F%88%E4%BB%A5AK%22%2C%22ocrLocations%22%3A%5B%7B%22x%22%3A162%2C%22y%22%3A7%2C%22width%22%3A215%2C%22height%22%3A45%2C%22text%22%3A%22%E5%BE%AA%E8%BF%B9%E4%BC%A0%E6%84%9F%E5%99%A8%22%7D%2C%7B%22x%22%3A15%2C%22y%22%3A65%2C%22width%22%3A31%2C%22height%22%3A23%2C%22text%22%3A%22XO%22%7D%2C%7B%22x%22%3A161%2C%22y%22%3A65%2C%22width%22%3A45%2C%22height%22%3A18%2C%22text%22%3A%22P0.0%22%7D%2C%7B%22x%22%3A13%2C%22y%22%3A81%2C%22width%22%3A35%2C%22height%22%3A101%2C%22text%22%3A%22%E5%8F%88%E5%8F%88%E5%8F%88%E5%8F%88%E5%8F%8AK%22%7D%2C%7B%22x%22%3A161%2C%22y%22%3A90%2C%22width%